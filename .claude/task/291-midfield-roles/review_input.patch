+        position_group,
+        position_role
+    from {{ ref('int_player__page_profile') }}
+),
+
+code_counts as (
+    select
+        legs.player_sk,
+        legs.position_code,
+        count(*) as matches_in_code,
+        max(legs.kickoff_datetime) as last_match_in_code
+    from {{ ref('int_legs__player_match') }} as legs
+    inner join page
+        on legs.player_sk = page.player_sk and legs.season_sk = page.featured_season_sk
+    where legs.position_code in ('G', 'D', 'M', 'F')
+    group by legs.player_sk, legs.position_code
+),
+
+expected as (
+    select
+        c.player_sk,
+        array_agg(
+            c.position_code order by c.matches_in_code desc, c.last_match_in_code desc, c.position_code asc
+            limit 1
+        )[offset(0)] as position_code
+    from code_counts as c
+    group by c.player_sk
+)
+
+select
+    p.player_sk,
+    p.position_group,
+    e.position_code,
+    p.position_role,
+    r.midfield_role
+from page as p
+left join expected as e
+    on p.player_sk = e.player_sk
+left join {{ ref('int_player_season__metrics') }} as r
+    on p.player_sk = r.player_sk and p.featured_season_sk = r.season_sk
+where
+    p.position_group is distinct from case e.position_code
+        when 'G' then 'GK'
+        when 'D' then 'DEF'
+        when 'M' then 'MID'
+        when 'F' then 'ATT'
+    end
+    or p.position_role is distinct from if(e.position_code = 'M', r.midfield_role, null)
diff --git a/dbt_project/tests/assert_player_peer_pools_follow_the_season_role.sql b/dbt_project/tests/assert_player_peer_pools_follow_the_season_role.sql
new file mode 100644
index 00000000..0c88e3a9
--- /dev/null
+++ b/dbt_project/tests/assert_player_peer_pools_follow_the_season_role.sql
@@ -0,0 +1,75 @@
+{#
+  A midfielder is compared within his season role: every benchmark row in DM, CM or AM is the player's
+  own season midfield_role, a MID row belongs to a player without one, and no player has rows in two
+  midfield pools of one competition-season. A role row of a player whose page position is MID is
+  placed on his page exactly like a MID row would be. Returns the rows that break this.
+#}
+
+with benchmark_rows as (
+    select distinct
+        player_sk,
+        season_sk,
+        position_group,
+        page_tab
+    from {{ ref('mart_player_competition_benchmarks') }}
+    where position_group in ('DM', 'CM', 'AM', 'MID')
+),
+
+roles as (
+    select
+        player_sk,
+        season_sk,
+        midfield_role
+    from {{ ref('int_player_season__metrics') }}
+),
+
+wrong_pool as (
+    select
+        b.player_sk,
+        b.season_sk,
+        b.position_group,
+        'pool is not the season role' as problem
+    from benchmark_rows as b
+    left join roles as r
+        on b.player_sk = r.player_sk and b.season_sk = r.season_sk
+    where b.position_group != coalesce(r.midfield_role, 'MID')
+),
+
+two_pools as (
+    select
+        player_sk,
+        season_sk,
+        string_agg(distinct position_group) as position_group,
+        'two midfield pools' as problem
+    from benchmark_rows
+    group by player_sk, season_sk
+    having count(distinct position_group) > 1
+),
+
+page_windows as (
+    select
+        w.player_sk,
+        w.season_sk
+    from {{ ref('int_player_page__window_seasons') }} as w
+    inner join {{ ref('int_player__page_profile') }} as p
+        on w.player_sk = p.player_sk
+    where w.window_type in ('this_season', 'current_competitions') and p.position_group = 'MID'
+),
+
+off_the_page as (
+    select
+        b.player_sk,
+        b.season_sk,
+        b.position_group,
+        'midfield row of a page window without a page tab' as problem
+    from benchmark_rows as b
+    inner join page_windows as w
+        on b.player_sk = w.player_sk and b.season_sk = w.season_sk
+    where b.page_tab is null
+)
+
+select * from wrong_pool
+union all
+select * from two_pools
+union all
+select * from off_the_page
diff --git a/dbt_project/tests/assert_player_season_midfield_role_is_most_frequent.sql b/dbt_project/tests/assert_player_season_midfield_role_is_most_frequent.sql
new file mode 100644
index 00000000..afdf006b
--- /dev/null
+++ b/dbt_project/tests/assert_player_season_midfield_role_is_most_frequent.sql
@@ -0,0 +1,121 @@
+{#
+  A player's season midfield_role is his most frequent role over that competition-season's matches
+  whose sheet counts, then the role of his latest match, then the code. Without one, it is his most
+  frequent role over his matches in every other season, a tie going to the nearest season, then the
+  earlier. midfield_role_from names which. Recomputed here from the line-ups and the player's
+  matches; returns the player-seasons that disagree.
+#}
+
+with counted as (
+    select
+        legs.player_sk,
+        legs.season_sk,
+        legs.season_api_year,
+        legs.kickoff_datetime,
+        lineups.midfield_role
+    from {{ ref('int_legs__player_match') }} as legs
+    inner join {{ ref('fct_fixture_lineup') }} as lineups
+        on
+            legs.fixture_sk = lineups.fixture_sk
+            and legs.team_sk = lineups.team_sk
+            and legs.player_sk = lineups.player_sk
+    where lineups.midfield_role is not null and lineups.lineup_state in ('confirmed', 'researched')
+),
+
+own_counts as (
+    select
+        player_sk,
+        season_sk,
+        midfield_role,
+        count(*) as matches_in_role,
+        max(kickoff_datetime) as last_match_in_role
+    from counted
+    group by player_sk, season_sk, midfield_role
+),
+
+own as (
+    select
+        player_sk,
+        season_sk,
+        array_agg(
+            midfield_role order by matches_in_role desc, last_match_in_role desc, midfield_role asc limit 1
+        )[offset(0)] as role
+    from own_counts
+    group by player_sk, season_sk
+),
+
+seasons as (
+    select distinct
+        player_sk,
+        season_sk,
+        season_api_year
+    from {{ ref('int_legs__player_match') }}
+),
+
+other_counts as (
+    select
+        s.player_sk,
+        s.season_sk,
+        c.midfield_role,
+        count(*) as matches_in_role,
+        min(abs(c.season_api_year - s.season_api_year)) as nearest
+    from seasons as s
+    inner join counted as c
+        on s.player_sk = c.player_sk and s.season_sk != c.season_sk
+    group by s.player_sk, s.season_sk, c.midfield_role
+),
+
+nearest_earlier as (
+    select
+        s.player_sk,
+        s.season_sk,
+        c.midfield_role,
+        min(c.season_api_year - s.season_api_year) as signed_nearest
+    from seasons as s
+    inner join counted as c
+        on s.player_sk = c.player_sk and s.season_sk != c.season_sk
+    inner join other_counts as oc
+        on
+            s.player_sk = oc.player_sk
+            and s.season_sk = oc.season_sk
+            and c.midfield_role = oc.midfield_role
+            and abs(c.season_api_year - s.season_api_year) = oc.nearest
+    group by s.player_sk, s.season_sk, c.midfield_role
+),
+
+other as (
+    select
+        oc.player_sk,
+        oc.season_sk,
+        array_agg(
+            oc.midfield_role
+            order by oc.matches_in_role desc, oc.nearest asc, ne.signed_nearest < 0 desc, oc.midfield_role asc
+            limit 1
+        )[offset(0)] as role
+    from other_counts as oc
+    inner join nearest_earlier as ne
+        on
+            oc.player_sk = ne.player_sk
+            and oc.season_sk = ne.season_sk
+            and oc.midfield_role = ne.midfield_role
+    group by oc.player_sk, oc.season_sk
+)
+
+select
+    s.player_sk,
+    s.season_sk,
+    s.midfield_role,
+    s.midfield_role_from,
+    own.role as own_role,
+    other.role as other_role
+from {{ ref('int_player_season__metrics') }} as s
+left join own
+    on s.player_sk = own.player_sk and s.season_sk = own.season_sk
+left join other
+    on s.player_sk = other.player_sk and s.season_sk = other.season_sk
+where
+    s.midfield_role is distinct from coalesce(own.role, other.role)
+    or s.midfield_role_from is distinct from case
+        when own.role is not null then 'this_season'
+        when other.role is not null then 'other_seasons'
+    end
