@@ -361,6 +361,60 @@ models:
         description: "{{ doc('player_api_id') }}"
         tests: [not_null]
 
+  - name: base_apif__lineup_sheets
+    description: >
+      One row per player each team's latest fetch of the stg_apif__lineups model names on its
+      sheet: the starting eleven and the bench, in the provider's order. When the latest fetch has
+      no grid places, the latest earlier fetch that has them and names the same starting eleven
+      lends its starters' grid places and the formation. Known provider team-id defects are
+      corrected from the fixture_team_id_overrides seed before the latest fetch is chosen.
+      base_apif__lineups reads it.
+      Grain: (league_code, fixture_id, team_id, is_starter, sheet_index).
+
+      The provider sometimes files one player under two ids in a match. A sheet player whose id has
+      no stats line in that match takes the id of the same team's stats-line player with his shirt
+      number, when that player is on no sheet row. This holds for that match only. The ids in the
+      player_id_overrides seed come first, and an id a card or goal correction names in the match
+      keeps its own id there.
+    config:
+      tags: ["base", "api_football", "fixture_context"]
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [league_code, fixture_id, team_id, is_starter, sheet_index]
+    columns:
+      - name: league_code
+        description: "{{ doc('league_code') }}"
+        tests: [not_null]
+      - name: fixture_id
+        description: "{{ doc('fixture_api_id') }}"
+        tests: [not_null]
+      - name: team_id
+        description: "The provider's numeric team id for this sheet, after the known-defect corrections in the fixture_team_id_overrides seed."
