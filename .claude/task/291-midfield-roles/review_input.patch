diff --git a/dbt_project/tests/assert_lineup_fetch_keeps_grid_only_for_same_eleven.sql b/dbt_project/tests/assert_lineup_fetch_keeps_grid_only_for_same_eleven.sql
new file mode 100644
index 00000000..dfcec9cb
--- /dev/null
+++ b/dbt_project/tests/assert_lineup_fetch_keeps_grid_only_for_same_eleven.sql
@@ -0,0 +1,123 @@
+{#
+  base_apif__lineups reads each team's latest fetch. When that fetch has no grid places, its starters
+  take the grid places, and the sheet the formation, of the latest earlier fetch that has them, only
+  if both name the same starting eleven; nothing else comes from the earlier fetch. Recomputed here
+  from every stored fetch; returns the team sheets and starters that break this.
+#}
+
+with fetches as (
+    select
+        league_code,
+        fixture_id,
+        team_id,
+        raw_ingested_at,
+        formation,
+        start_xi_json,
+        (
+            select countif(json_value(el, '$.player.grid') is not null) > 0
+            from unnest(json_query_array(start_xi_json)) as el
+        ) as has_grid,
+        (
+            select string_agg(id, ',' order by id)
+            from unnest(json_query_array(start_xi_json)) as el,
+                unnest([coalesce(json_value(el, '$.player.id'), '')]) as id
+        ) as starting_eleven
+    from {{ ref('stg_apif__lineups') }}
+    where fixture_id is not null and team_id is not null
+),
+
+newest as (
+    select *
+    from fetches
+    qualify row_number() over (
+        partition by league_code, fixture_id, team_id order by raw_ingested_at desc
+    ) = 1
+),
+
+lender as (
+    select
+        f.league_code,
+        f.fixture_id,
+        f.team_id,
+        f.formation,
+        f.start_xi_json
+    from fetches as f
+    inner join newest as n
+        on f.league_code = n.league_code and f.fixture_id = n.fixture_id and f.team_id = n.team_id
+    where not n.has_grid and f.has_grid and f.starting_eleven = n.starting_eleven
+    qualify row_number() over (
+        partition by f.league_code, f.fixture_id, f.team_id order by f.raw_ingested_at desc
+    ) = 1
+),
+
+lent_places as (
+    select
+        lender.league_code,
+        lender.fixture_id,
+        lender.team_id,
+        safe_cast(json_value(el, '$.player.id') as int64) as player_id,
+        json_value(el, '$.player.grid') as grid_position
+    from lender, unnest(json_query_array(lender.start_xi_json)) as el
+),
+
+base_rows as (
+    select *
+    from {{ ref('base_apif__lineups') }}
+    where lineup_state != 'researched'
+),
+
+wrong_fetch as (
+    select
+        b.league_code,
+        b.fixture_id,
+        b.team_id,
+        b.player_id,
+        'not read from the latest fetch' as problem
+    from base_rows as b
+    inner join newest as n
+        on b.league_code = n.league_code and b.fixture_id = n.fixture_id and b.team_id = n.team_id
+    where b.raw_ingested_at != n.raw_ingested_at
+),
+
+wrong_formation as (
+    select distinct
+        b.league_code,
+        b.fixture_id,
+        b.team_id,
+        cast(null as int64) as player_id,
+        'formation is not the latest fetch''s, or the lender''s when it has none' as problem
+    from base_rows as b
+    inner join newest as n
+        on b.league_code = n.league_code and b.fixture_id = n.fixture_id and b.team_id = n.team_id
+    left join lender as l
+        on b.league_code = l.league_code and b.fixture_id = l.fixture_id and b.team_id = l.team_id
+    where b.team_formation is distinct from coalesce(n.formation, l.formation)
+),
+
+wrong_place as (
+    select
+        b.league_code,
+        b.fixture_id,
+        b.team_id,
+        b.player_id,
+        'starter''s grid place is not the lender''s' as problem
+    from base_rows as b
+    inner join newest as n
+        on b.league_code = n.league_code and b.fixture_id = n.fixture_id and b.team_id = n.team_id
+    left join lent_places as p
+        on
+            b.league_code = p.league_code
+            and b.fixture_id = p.fixture_id
+            and b.team_id = p.team_id
+            and b.player_id = p.player_id
+    where
+        b.is_starter
+        and not n.has_grid
+        and b.grid_position is distinct from p.grid_position
+)
+
+select * from wrong_fetch
+union all
+select * from wrong_formation
+union all
+select * from wrong_place
diff --git a/dbt_project/tests/assert_lineup_midfield_role_follows_the_grid.sql b/dbt_project/tests/assert_lineup_midfield_role_follows_the_grid.sql
new file mode 100644
index 00000000..014e9592
--- /dev/null
+++ b/dbt_project/tests/assert_lineup_midfield_role_follows_the_grid.sql
@@ -0,0 +1,162 @@
+{#
+  Every line-up row's midfield_role is the one its grid line gives, recomputed here from the
+  formation's digits: a starter's own line, a substitute's the line of the starter whose slot he took,
+  followed back through every substitution. The common formations give the roles the rule was
+  measured with. Returns the rows that disagree.
+#}
+
+with came_on as (
+    select
+        fixture_sk,
+        team_sk,
+        player_sk,
+        replaced_player_sk
+    from {{ ref('fct_fixture_lineup') }}
+    where is_starter = false and replaced_player_sk is not null
+),
+
+starters as (
+    select
+        fixture_sk,
+        team_sk,
+        player_sk,
+        player_sk as slot_player_sk
+    from {{ ref('fct_fixture_lineup') }}
+    where coalesce(is_starter, false)
+),
+
+hop_1 as (
+    select
+        c.fixture_sk,
+        c.team_sk,
+        c.player_sk,
+        s.slot_player_sk
+    from came_on as c
+    inner join starters as s
+        on c.fixture_sk = s.fixture_sk and c.team_sk = s.team_sk and c.replaced_player_sk = s.player_sk
+),
+
+hop_2 as (
+    select
+        c.fixture_sk,
+        c.team_sk,
+        c.player_sk,
+        h.slot_player_sk
+    from came_on as c
+    inner join hop_1 as h
+        on c.fixture_sk = h.fixture_sk and c.team_sk = h.team_sk and c.replaced_player_sk = h.player_sk
+),
+
+hop_3 as (
+    select
+        c.fixture_sk,
+        c.team_sk,
+        c.player_sk,
+        h.slot_player_sk
+    from came_on as c
+    inner join hop_2 as h
+        on c.fixture_sk = h.fixture_sk and c.team_sk = h.team_sk and c.replaced_player_sk = h.player_sk
+),
+
+hop_4 as (
+    select
+        c.fixture_sk,
+        c.team_sk,
+        c.player_sk,
+        h.slot_player_sk
+    from came_on as c
+    inner join hop_3 as h
+        on c.fixture_sk = h.fixture_sk and c.team_sk = h.team_sk and c.replaced_player_sk = h.player_sk
+),
+
+slots as (
+    select * from starters
+    union all
+    select * from hop_1
+    union all
+    select * from hop_2
+    union all
+    select * from hop_3
+    union all
+    select * from hop_4
+),
+
+rows_with_lines as (
+    select
+        l.fixture_sk,
+        l.team_sk,
+        l.player_sk,
+        l.team_formation,
+        l.midfield_role,
+        s.slot_player_sk is not null
+        and (
+            l.position_code = 'M'
+            or (l.position_code is null and coalesce(l.is_starter, false) and ps.position_code = 'M')
+        ) as is_midfield_slot,
+        safe_cast(regexp_extract(o.grid_position, r'^(\d+)(?::|$)') as int64) - 1 as line,
+        regexp_extract_all(l.team_formation, r'\d+') as digits,
+        regexp_contains(coalesce(l.team_formation, ''), r'^[1-9]\d*(-[1-9]\d*){2,}$') as is_formation
+    from {{ ref('fct_fixture_lineup') }} as l
+    left join slots as s
+        on l.fixture_sk = s.fixture_sk and l.team_sk = s.team_sk and l.player_sk = s.player_sk
+    left join {{ ref('fct_fixture_lineup') }} as o
+        on s.fixture_sk = o.fixture_sk and s.team_sk = o.team_sk and s.slot_player_sk = o.player_sk
+    left join {{ ref('fct_fixture_player_stats') }} as ps
+        on l.fixture_sk = ps.fixture_sk and l.team_sk = ps.team_sk and l.player_sk = ps.player_sk
+),
+
+expected as (
+    select
+        *,
+        case
+            when not coalesce(is_midfield_slot, false) or not is_formation or line is null then null
+            when line < 1 or line > array_length(digits) then null
+            when line = 1 then 'DM'
+            when line = array_length(digits) then 'AM'
+            when array_length(digits) = 3 then 'CM'
+            when line = 2 and cast(digits[offset(1)] as int64) <= 2 then 'DM'
+            when line = 2 then 'CM'
+            when line = array_length(digits) - 1 and cast(digits[offset(line - 1)] as int64) <= 3 then 'AM'
+            else 'CM'
+        end as expected_role
+    from rows_with_lines
+),
+
+known_formations as (
+    select *
+    from unnest([
+        struct('4-2-3-1' as team_formation, 2 as line, 'DM' as role),
+        ('4-2-3-1', 3, 'AM'),
+        ('4-4-2', 2, 'CM'),
+        ('4-3-3', 2, 'CM'),
+        ('3-5-2', 2, 'CM'),
+        ('4-1-4-1', 2, 'DM'),
+        ('4-1-4-1', 3, 'CM'),
+        ('4-4-1-1', 2, 'CM'),
+        ('4-4-1-1', 3, 'AM'),
+        ('3-4-2-1', 2, 'CM'),
+        ('3-4-2-1', 3, 'AM'),
+        ('4-3-1-2', 2, 'CM'),
+        ('4-3-1-2', 3, 'AM'),
+        ('4-2-2-2', 2, 'DM'),
+        ('4-2-2-2', 3, 'AM'),
+        ('4-4-2', 1, 'DM'),
+        ('4-4-2', 3, 'AM')
+    ])
+)
+
+select
+    e.fixture_sk,
+    e.team_sk,
+    e.player_sk,
+    e.team_formation,
+    e.line,
+    e.midfield_role,
+    e.expected_role,
+    k.role as known_role
+from expected as e
+left join known_formations as k
+    on e.team_formation = k.team_formation and e.line = k.line and e.is_midfield_slot
+where
+    e.midfield_role is distinct from e.expected_role
+    or (k.role is not null and e.midfield_role is distinct from k.role)
