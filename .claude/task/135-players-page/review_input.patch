diff --git a/site_v2/src/lib/playerIndex.mjs b/site_v2/src/lib/playerIndex.mjs
new file mode 100644
index 00000000..176e6439
--- /dev/null
+++ b/site_v2/src/lib/playerIndex.mjs
@@ -0,0 +1,85 @@
+// The Players page's lists and the nation pages, cut from players_index.json by the served orders
+// and flags. Nothing here ranks: a list is the served rows in their served place, and which rows the
+// Players page shows and which nations have a page are the warehouse's flags.
+
+/** The positions in the page's order: the filter slot, the position code the row's word uses and
+ *  the plural the lists and the filter use. */
+export const POSITIONS = [
+  { group: "ATT", slot: 1, code: "F", label: "squadFwd" },
+  { group: "MID", slot: 2, code: "M", label: "squadMid" },
+  { group: "DEF", slot: 3, code: "D", label: "squadDef" },
+  { group: "GK", slot: 4, code: "G", label: "squadGk" },
+];
+const BY_GROUP = new Map(POSITIONS.map((p) => [p.group, p]));
+
+/** The filter slot of a position, 0 for a player with none. */
+export const slotOf = (group) => BY_GROUP.get(group)?.slot ?? 0;
+/** The position code a row's word is read by, or null. */
+export const codeOf = (group) => BY_GROUP.get(group)?.code ?? null;
+
+const NATION_SLUG = /^[a-z]+(-[a-z]+)*$/;
+
+const byServed = (a, b) => a.nation_order - b.nation_order || a.order_in_nation - b.order_in_nation;
+
+/** World's best: one list per position in the page's order, its nominees in their served place;
+ *  a position without a nominee is absent. */
+export function worldsBest(data) {
+  const byId = new Map(data.players.map((p) => [p.player_id, p]));
+  return POSITIONS.map((p) => ({
+    ...p,
+    rows: data.worlds_best
+      .filter((w) => w.list === p.group)
+      .sort((a, b) => a.order - b.order)
+      .map((w) => byId.get(w.player_id))
+      .filter(Boolean),
+  })).filter((l) => l.rows.length > 0);
+}
+
+/** Which views of the Players page show a row: "all" with no position chosen, "pos" with its
+ *  position chosen, "both", or null when neither. */
+export function hubView(player) {
+  if (player.hub && player.hub_in_position) return "both";
+  if (player.hub) return "all";
+  if (player.hub_in_position) return "pos";
+  return null;
+}
+
+/** Players by nation: one group per nation in the served order, the players with no nation last.
+ *  A group holds the rows the Players page shows in any view, its count of all its players, its
+ *  count per position, and its page's slug when it has one. */
+export function nationGroups(data) {
+  const groups = new Map();
+  for (const p of [...data.players].sort(byServed)) {
+    const key = p.nation ?? "";
+    if (!groups.has(key)) {
+      groups.set(key, {
+        nation: p.nation, region: p.region_key, slug: p.nation_page ? p.nation_slug : null,
+        n: 0, perPosition: new Map(), rows: [],
+      });
+    }
+    const g = groups.get(key);
+    g.n += 1;
+    const slot = slotOf(p.position_group);
+    if (slot) g.perPosition.set(slot, (g.perPosition.get(slot) ?? 0) + 1);
+    if (hubView(p)) g.rows.push(p);
+  }
+  return [...groups.values()];
+}
+
+/** The nation pages: one per nation the warehouse gives a page, its players in the served order.
+ *  Throws when a slug is not letters and hyphens or is a player page's slug, so a clash with a
+ *  player page can never build. */
+export function nationPages(data, playerSlugs) {
+  const pages = new Map();
+  for (const p of [...data.players].sort(byServed)) {
+    if (!p.nation_page) continue;
+    if (!pages.has(p.nation_slug)) pages.set(p.nation_slug, { slug: p.nation_slug, nation: p.nation, region: p.region_key, rows: [] });
+    pages.get(p.nation_slug).rows.push(p);
+  }
+  const taken = new Set(playerSlugs);
+  for (const slug of pages.keys()) {
+    if (!NATION_SLUG.test(slug ?? "")) throw new Error(`nation page slug "${slug}" is not letters and hyphens`);
+    if (taken.has(slug)) throw new Error(`nation page slug "${slug}" is a player page's slug`);
+  }
+  return [...pages.values()];
+}
diff --git a/site_v2/src/lib/playerIndex.test.mjs b/site_v2/src/lib/playerIndex.test.mjs
new file mode 100644
index 00000000..6d039b79
--- /dev/null
+++ b/site_v2/src/lib/playerIndex.test.mjs
@@ -0,0 +1,87 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { readFileSync, existsSync } from "node:fs";
+import { join, dirname } from "node:path";
+import { fileURLToPath } from "node:url";
+import { worldsBest, nationGroups, nationPages, hubView, slotOf, codeOf } from "./playerIndex.mjs";
+import { readBuiltPlayers } from "./builtPlayers.mjs";
+
+const p = (over) => ({
+  player_id: 1, slug: "a-player-1", name: "A Player", photo: null, position_group: "ATT",
+  nation: "Spain", region_key: "UEFA", nation_order: 1, order_in_nation: 1, club: "Club",
+  nation_slug: "spain", hub: true, hub_in_position: true, nation_page: false, ...over,
+});
+
+test("World's best: one list per position in the page's order, nominees by their served place", () => {
+  const data = {
+    players: [p({ player_id: 1, position_group: "GK" }), p({ player_id: 2 }), p({ player_id: 3 })],
+    worlds_best: [
+      { player_id: 1, list: "GK", order: 1 },
+      { player_id: 3, list: "ATT", order: 1 },
+      { player_id: 2, list: "ATT", order: 2 },
+    ],
+  };
+  const lists = worldsBest(data);
+  assert.deepEqual(lists.map((l) => l.group), ["ATT", "GK"]);
+  assert.deepEqual(lists[0].rows.map((r) => r.player_id), [3, 2]);
+});
+
+test("a row's views follow the served flags", () => {
+  assert.equal(hubView(p({})), "both");
+  assert.equal(hubView(p({ hub_in_position: false })), "all");
+  assert.equal(hubView(p({ hub: false })), "pos");
+  assert.equal(hubView(p({ hub: false, hub_in_position: false })), null);
+  assert.equal(slotOf("DEF"), 3);
+  assert.equal(slotOf(null), 0);
+  assert.equal(codeOf("GK"), "G");
+});
+
+test("nation groups keep the served order, count every player and hold only shown rows", () => {
+  const data = {
+    players: [
+      p({ player_id: 3, nation: null, nation_slug: null, region_key: null, nation_order: 3 }),
+      p({ player_id: 2, nation: "France", nation_slug: "france", nation_order: 2 }),
+      p({ player_id: 12, order_in_nation: 2, position_group: "GK", nation_page: true }),
+      p({ player_id: 11, nation_page: true }),
+      p({ player_id: 13, order_in_nation: 3, hub: false, hub_in_position: false, nation_page: true }),
+    ],
+  };
+  const groups = nationGroups(data);
+  assert.deepEqual(groups.map((g) => g.nation), ["Spain", "France", null]);
+  const spain = groups[0];
+  assert.equal(spain.n, 3);
+  assert.equal(spain.slug, "spain");
+  assert.deepEqual(spain.rows.map((r) => r.player_id), [11, 12]);
+  assert.deepEqual([...spain.perPosition], [[1, 2], [4, 1]]);
+  assert.equal(groups[1].slug, null);
+});
+
+test("nation pages hold every player of a nation with a page, in the served order", () => {
+  const data = {
+    players: [
+      p({ player_id: 13, order_in_nation: 3, hub: false, nation_page: true }),
+      p({ player_id: 11, nation_page: true }),
+      p({ player_id: 2, nation: "France", nation_slug: "france", nation_order: 2 }),
+    ],
+  };
+  const pages = nationPages(data, ["a-player-1"]);
+  assert.deepEqual(pages.map((x) => x.slug), ["spain"]);
+  assert.deepEqual(pages[0].rows.map((r) => r.player_id), [11, 13]);
+});
+
+test("a nation page whose slug is a player page's slug, or not letters and hyphens, never builds", () => {
+  const clash = { players: [p({ nation_page: true, nation_slug: "spain" })] };
+  assert.throws(() => nationPages(clash, ["spain"]), /player page's slug/);
+  const digits = { players: [p({ nation_page: true, nation_slug: "spain-1" })] };
+  assert.throws(() => nationPages(digits, []), /letters and hyphens/);
+});
+
+test("the committed sample: no nation slug is a player slug, every player slug ends in its id or is it", () => {
+  const dataDir = join(dirname(fileURLToPath(import.meta.url)), "..", "data");
+  const file = join(dataDir, "players_index.json");
+  if (!existsSync(file)) return;
+  const data = JSON.parse(readFileSync(file, "utf8"));
+  const players = [...readBuiltPlayers(dataDir).values()];
+  for (const slug of players) assert.match(slug, /(^|-)\d+$/);
+  assert.doesNotThrow(() => nationPages(data, players));
+});
