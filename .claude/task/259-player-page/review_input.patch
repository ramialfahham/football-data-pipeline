diff --git a/site_v2/src/components/player/PlayerComparison.astro b/site_v2/src/components/player/PlayerComparison.astro
new file mode 100644
index 00000000..89acb3ef
--- /dev/null
+++ b/site_v2/src/components/player/PlayerComparison.astro
@@ -0,0 +1,157 @@
+---
+// Compared with other players: a filter of the competitions where the player reaches the minutes
+// floor, then Squad; its explainer, the switch, the legend, and each metric as a strip of the peer
+// set: every player a light dot, the player the solid dot, the median tick with its value, the rank
+// and value on the right. A goalkeeper's metrics all show, with no switch. Look from system.css.
+import SectionHead from "../ui/SectionHead.astro";
+import MetricSwitch from "../ui/MetricSwitch.astro";
+import ChartLegend from "../ui/ChartLegend.astro";
+import Chevron from "../fixture/Chevron.astro";
+import { stripInset } from "../../lib/chartTheme";
+import { formatValue, integer, ordinal } from "../../lib/format";
+import { t, metricLabel, boardTitle } from "../../i18n/strings";
+import { competitionInfo } from "../../lib/teamFixtures";
+import { medianAnchor, placeOnLine, playerGroups, positionWord, teamBeforeCompound } from "../../lib/playerPage";
+import type { Lang } from "../../lib/format";
+import type { PlayerMetric, PlayerTab } from "../../lib/playerPage";
+
+interface Props {
+  tab: PlayerTab;
+  /** metric -> every value of the competition's peer set, by the competition's list index. */
+  peers: Record<string, number[]>[];
+  name: string;
+  positionGroup: string | null;
+  lang: Lang;
+}
+const { tab, peers, name, positionGroup, lang } = Astro.props;
+
+// system.css carries one rule per slot.
+const COMPARISON_SLOTS = 8;
+const isGoalkeeper = positionGroup === "GK";
+const prefix = tab.tab === "club" ? "club" : "national";
+const positionText = positionWord(lang, "One", positionGroup);
+const self = positionText
+  ? `${name} · ${positionText.charAt(0).toLocaleUpperCase(lang)}${positionText.slice(1)}`
+  : name;
+const teamName = tab.squad?.team?.name ?? "";
+
+const comparisons = [
+  ...tab.competitions.map((c, i) => {
+    const comp = competitionInfo(c.league_code).name;
+    return {
+      label: comp,
+      metrics: c.metrics,
+      strip: (m: PlayerMetric) => peers[i]?.[m.metric_key] ?? [],
+      intro: t(lang, "playerPeerIntro", {
+        player: name,
+        n: integer(c.player_count, lang),
+        positions: positionWord(lang, "Peers", c.position_group),
+        comp,
+        season: c.season_label ?? "",
+      }),
+      others: t(lang, "playerOthers", { positions: positionWord(lang, "Others", c.position_group) }),
+    };
+  }),
+  ...(tab.squad && !isGoalkeeper
+    ? [{
+      label: t(lang, "playerSquad"),
+      metrics: tab.squad.metrics,
+      strip: (m: PlayerMetric) => m.others ?? [],
+      intro: t(lang, tab.tab === "club" ? "playerSquadClubIntro" : "playerSquadNationalIntro", {
+        player: name,
+        n: integer(tab.squad.player_count, lang),
+        team: teamBeforeCompound(lang, teamName),
+        season: tab.competitions[0]?.season_label ?? "",
+      }),
+      others: t(lang, "playerOtherTeam", { team: teamName }),
+    }]
+    : []),
+].map((c, i) => {
+  const byKey = new Map(c.metrics.map((m) => [m.metric_key, m]));
+  return { ...c, slot: i + 1, byKey, groups: playerGroups((id) => byKey.get(id)?.value != null, isGoalkeeper) };
+}).filter((c) => c.groups.length > 0);
+
+if (comparisons.length > COMPARISON_SLOTS) {
+  throw new Error(`PlayerComparison: ${comparisons.length} comparisons, system.css has rules for ${COMPARISON_SLOTS}`);
+}
+const allRows = comparisons.flatMap((c) => c.groups.flatMap((g) => g.rows));
+const showSwitch = !isGoalkeeper && allRows.some((r) => r.is_key_metric) && allRows.some((r) => !r.is_key_metric);
+const group = `${prefix}-compare`;
+const at = (x: number, lo: number, hi: number) => `${Number(placeOnLine(x, lo, hi, stripInset).toFixed(1))}%`;
+const aria = t(lang, "playerComparedWith");
+---
+
+{comparisons.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "playerVsOthers")} />
+    {comparisons.map((c) => (
+      <input class="seg-in" type="radio" name={group} id={`${group}-${c.slot}`} value={c.slot} data-cmp={c.slot} checked={c.slot === 1} />
+    ))}
+    {comparisons.length > 1 && (
+      <div class="fbar">
+        <div class="seg" role="group" aria-label={aria}>
+          {comparisons.map((c) => <label class="seg-btn" for={`${group}-${c.slot}`} data-cmp={c.slot}>{c.label}</label>)}
+        </div>
+        <div class="selbar">
+          <div class="seg sel">
+            <select class="sel-in" data-filter={group} aria-label={aria}>
+              {comparisons.map((c) => <option value={c.slot} selected={c.slot === 1}>{c.label}</option>)}
+            </select>
+            <Chevron />
+          </div>
+        </div>
+      </div>
+    )}
+    <div class="cmp-panels">
+      {comparisons.map((c) => <p class="bsub cmp-p" data-cmp={c.slot}>{`${c.intro} ${t(lang, "playerPer90")}`}</p>)}
+    </div>
+    {showSwitch && <MetricSwitch id={`${group}-switch`} lang={lang} />}
+    <div class="cmp-panels">
+      {comparisons.map((c) => (
+        <div class="cmp-p" data-cmp={c.slot}>
+          <div class="chart">
+            <ChartLegend keys={[
+              { mark: "team", label: self },
+              { mark: "other", label: c.others },
+              { mark: "median", label: t(lang, "playerMedian") },
+            ]} />
+            {c.groups.map((g) => (
+              <div class:list={["fxgroup", "rkgroup", { nonkey: showSwitch && !g.hasKey }]}>
+                <div class="gh"><span class="nm">{metricLabel(lang, `metricGroups.${g.key}.label`)}</span></div>
+                {g.rows.map((r) => {
+                  const m = c.byKey.get(r.metric_id)!;
+                  const v = m.value as number;
+                  const all = c.strip(m);
+                  const lo = Math.min(...all, v);
+                  const hi = Math.max(...all, v);
+                  const median = m.median != null ? at(m.median, lo, hi) : null;
+                  return (
+                    <div class:list={["rs-row", { nonkey: showSwitch && !r.is_key_metric }]} data-metric={r.metric_id}>
+                      <span class="chart-name">{boardTitle(lang, r.label_i18n_key, false)}</span>
+                      <span class="rs-band">
+                        <svg class="rs-plot" aria-hidden="true" focusable="false">
+                          <line class="chart-axis" x1="0" x2="100%" y1="50%" y2="50%"></line>
+                          <g class="rs-peers">{all.map((x) => <circle cx={at(x, lo, hi)}></circle>)}</g>
+                          {median != null && <line class="rs-tick" x1={median} x2={median} y1="2" y2="12"></line>}
+                          {median != null && (
+                            <text class="rs-tick-value" x={median} y="27" text-anchor={medianAnchor(parseFloat(median))}>{formatValue(m.median, r.format, lang)}</text>
+                          )}
+                          <circle class="chart-dot chart-me" cx={at(v, lo, hi)} cy="50%"></circle>
+                        </svg>
+                      </span>
+                      <span class="rs-val">{ordinal(m.rank, lang)}<small>{formatValue(v, r.format, lang)}</small></span>
+                    </div>
+                  );
+                })}
+              </div>
+            ))}
+          </div>
+        </div>
+      ))}
+    </div>
+  </section>
+)}
+
+<script>
+  import "../../lib/filterBar.mjs";
+</script>
diff --git a/site_v2/src/components/player/PlayerHeader.astro b/site_v2/src/components/player/PlayerHeader.astro
new file mode 100644
index 00000000..5b3ad972
--- /dev/null
+++ b/site_v2/src/components/player/PlayerHeader.astro
@@ -0,0 +1,48 @@
+---
+// The player's header: photo, full name and one line: position · club · nation · age · height ·
+// season. A missing value drops with its separator, and each item stays whole.
+import Crest from "../ui/Crest.astro";
+import { t } from "../../i18n/strings";
+import { localeHref, word } from "../../lib/href";
+import { positionWord, teamHasPage } from "../../lib/playerPage";
+import type { Lang } from "../../lib/format";
+import type { Player } from "../../lib/playerPage";
+
+interface Props {
+  player: Player;
+  lang: Lang;
+}
+const { player, lang } = Astro.props;
+
+const position = positionWord(lang, "One", player.position_group);
+const club = player.club;
+const clubHref = club?.slug && teamHasPage(club.team_id)
+  ? localeHref(lang, `${word(lang, "teams")}/${club.slug}/`)
+  : undefined;
+const after = [
+  player.nationality,
+  player.age != null ? t(lang, "playerAge", { age: player.age }) : null,
+  player.height ? t(lang, "playerHeight", { n: player.height }) : null,
+  player.season_label ? t(lang, "compSeason", { season: player.season_label }) : null,
+].filter((p): p is string => Boolean(p));
+const first = position ? position.charAt(0).toLocaleUpperCase(lang) + position.slice(1) : null;
+---
+
+<header class="thead">
+  <Crest name={player.name} crest={player.photo} />
+  <div class="tid">
+    <h1>{player.name}</h1>
+    <div class="meta">
+      {first && <span class="nb">{first}</span>}
+      {club?.name && (
+        <>
+          {first && <>&nbsp;· </>}
+          <b class="nb">{clubHref ? <a class="lnk" href={clubHref}>{club.name}</a> : club.name}</b>
+        </>
+      )}
+      {after.map((item, i) => (
+        <>{(i > 0 || first || club?.name) && <>&nbsp;· </>}<span class="nb">{item}</span></>
+      ))}
+    </div>
+  </div>
+</header>
diff --git a/site_v2/src/components/player/PlayerLastSeason.astro b/site_v2/src/components/player/PlayerLastSeason.astro
new file mode 100644
index 00000000..54d739f9
--- /dev/null
+++ b/site_v2/src/components/player/PlayerLastSeason.astro
@@ -0,0 +1,82 @@
+---
+// Compared with last season (Club tab): this season so far against the whole of last season, over
+// all club competitions, in the served metric list. The Team page's table and trend. Absent when the
+// player has no club minutes last season or every value is blank.
+import SectionHead from "../ui/SectionHead.astro";
+import MetricSwitch from "../ui/MetricSwitch.astro";
+import { DASH, formatValue, integer } from "../../lib/format";
+import { t, metricLabel, boardTitle } from "../../i18n/strings";
+import { betterSide } from "../../lib/bars";
+import { playerGroups } from "../../lib/playerPage";
+import type { Lang } from "../../lib/format";
+import type { PlayerLastSeason as LastSeason } from "../../lib/playerPage";
+
+interface Props {
+  lastSeason: LastSeason | null;
+  name: string;
+  isGoalkeeper: boolean;
+  lang: Lang;
+}
+const { lastSeason, name, isGoalkeeper, lang } = Astro.props;
+
+const byKey = new Map((lastSeason?.metrics ?? []).map((m) => [m.metric_key, m]));
+const has = (id: string) => byKey.get(id)?.value != null || byKey.get(id)?.value_prev != null;
+const groups = lastSeason?.minutes_prev ? playerGroups(has, isGoalkeeper) : [];
+const showSwitch = !isGoalkeeper && groups.flatMap((g) => g.rows).some((r) => r.is_key_metric)
+  && groups.flatMap((g) => g.rows).some((r) => !r.is_key_metric);
+const shown = (v: number | null | undefined, format: Parameters<typeof formatValue>[1]) =>
+  typeof v === "number" ? formatValue(v, format, lang) : DASH;
+---
+
+{groups.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "teamVsLastSeason")} />
+    <p class="bsub">
+      {t(lang, "playerLastSeasonIntro", {
+        player: name,
+        now: integer(lastSeason!.minutes, lang),
+        prev: integer(lastSeason!.minutes_prev, lang),
+        per90: t(lang, "playerPer90"),
+      })}
+    </p>
+    {showSwitch && <MetricSwitch id="player-last-season-switch" lang={lang} />}
+    <div class="yoy-list">
+      {groups.map((g) => (
+        <div class:list={["fxgroup", "rkgroup", { nonkey: showSwitch && !g.hasKey }]}>
+          <div class="gh"><span class="nm">{metricLabel(lang, `metricGroups.${g.key}.label`)}</span></div>
+          <div class="ctab yoyt">
+            <div class="ctab-head">
+              <span class="h nmh"></span>
+              <span class="h">{t(lang, "teamThisSeasonHead")}</span>
+              <span class="h">{t(lang, "teamLastSeasonHead")}</span>
+              <span class="h tr">{t(lang, "teamTrend")}</span>
+            </div>
+            {g.rows.map((r) => {
+              const m = byKey.get(r.metric_id)!;
+              const a = shown(m.value, r.format);
+              const b = shown(m.value_prev, r.format);
+              const blank = a === DASH || b === DASH;
+              const side = blank || a === b ? null : betterSide(m.value as number, m.value_prev as number, r.direction);
+              return (
+                <div class:list={["ctab-row", { nonkey: showSwitch && !r.is_key_metric }]}>
+                  <span class="tm"><span class="nm">{boardTitle(lang, r.label_i18n_key, false)}</span></span>
+                  <span class="n now">{a}</span>
+                  <span class="n prev">{b}</span>
+                  {blank || (r.direction === "neutral" && a !== b) ? (
+                    <span class="n tr"></span>
+                  ) : side === "home" ? (
+                    <span class="n tr up" role="img" aria-label={t(lang, "teamTrendBetter")}>▲</span>
+                  ) : side === "away" ? (
+                    <span class="n tr down" role="img" aria-label={t(lang, "teamTrendWorse")}>▼</span>
+                  ) : (
+                    <span class="n tr flat" role="img" aria-label={t(lang, "teamTrendSame")}>–</span>
+                  )}
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      ))}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/player/PlayerRecent.astro b/site_v2/src/components/player/PlayerRecent.astro
new file mode 100644
index 00000000..9f0d37a8
--- /dev/null
+++ b/site_v2/src/components/player/PlayerRecent.astro
@@ -0,0 +1,75 @@
+---
+// Recent matches: the Team page's result row with the player's own line under it: minutes, goals and
+// assists above 0, ball actions, or On the bench. Five rows show, the fold holds the rest. fitBlocks
+// keeps a row on one line while every row fits; otherwise the score sits right after the chip.
+import Crest from "../ui/Crest.astro";
+import Fold from "../ui/Fold.astro";
+import SectionHead from "../ui/SectionHead.astro";
+import { formatShortDate, integer } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { matchPageHref } from "../../lib/href";
+import { competitionInfo } from "../../lib/teamFixtures";
+import type { Lang } from "../../lib/format";
+import type { PlayerMatch } from "../../lib/playerPage";
+
+interface Props {
+  matches: PlayerMatch[];
+  id: string;
+  lang: Lang;
+}
+const { matches, id, lang } = Astro.props;
+
+const SHOWN = 5;
+const LETTER: Record<string, string> = { W: "compColWins", D: "compColDraws", L: "compColLosses" };
+const ha = (m: PlayerMatch) => (m.home_away === "home" ? t(lang, "haHome") : m.home_away === "away" ? t(lang, "haAway") : "");
+const count = (n: number, one: string, many: string) => ({ n: integer(n, lang), word: n === 1 ? one : many });
+const line = (m: PlayerMatch) => [
+  m.minutes != null ? { n: integer(m.minutes, lang), word: t(lang, "playerMin") } : null,
+  m.goals ? count(m.goals, t(lang, "goalOne"), t(lang, "goals")) : null,
+  m.assists ? count(m.assists, t(lang, "playerAssist"), t(lang, "playerAssists")) : null,
+  m.ball_actions != null ? count(m.ball_actions, t(lang, "playerBallAction"), t(lang, "playerBallActions")) : null,
+].filter((p): p is { n: string; word: string } => p !== null);
+const rows = matches.map((m) => ({
+  m,
+  result: m.result && LETTER[m.result] ? m.result : null,
+  href: matchPageHref(lang, m.played_fixture_sk),
+  parts: m.on_bench ? [] : line(m),
+}));
+---
+
+{rows.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "secRecent")} />
+    <div class="rlist pm">
+      {[rows.slice(0, SHOWN), rows.slice(SHOWN)].map((part, i) => {
+        const list = part.map(({ m, result, href, parts }) => {
+          const Row = href ? "a" : "div";
+          return (
+            <Row class="lrow" href={href}>
+              <div class="resrow">
+                {result && <span class:list={["pill", result]}>{t(lang, LETTER[result])}</span>}
+                <span class="rscore">{m.goals_for}–{m.goals_against}</span>
+                <span class="ropp">
+                  <span class="club"><Crest name={m.opponent_name} crest={m.opponent_logo_url} size="xs" /><span class="cn">{m.opponent_name}</span></span>
+                  {ha(m) && <span class="ha">{ha(m)}</span>}
+                </span>
+                <span class="rmeta">
+                  <span class="rm-c">
+                    <span class="nb">{competitionInfo(m.played_league_code ?? "").name}</span> · <span class="nb">{formatShortDate(m.played_kickoff_datetime, lang)}</span>
+                  </span>
+                  {(m.on_bench || parts.length > 0) && <span class="rm-p">
+                    {m.on_bench
+                      ? <span class="nb">{t(lang, "playerOnBench")}</span>
+                      : parts.map((p, k) => <>{k > 0 && " · "}<span class="nb"><b>{p.n}</b>{` ${p.word}`}</span></>)}
+                  </span>}
+                </span>
+              </div>
+            </Row>
+          );
+        });
+        if (i === 0) return list;
