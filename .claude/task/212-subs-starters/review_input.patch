diff --git a/dbt_project/tests/assert_player_leg_bench_follows_checked_sheet.sql b/dbt_project/tests/assert_player_leg_bench_follows_checked_sheet.sql
new file mode 100644
index 00000000..150a40f6
--- /dev/null
+++ b/dbt_project/tests/assert_player_leg_bench_follows_checked_sheet.sql
@@ -0,0 +1,26 @@
+{#
+  Wherever a confirmed or researched team sheet names a player, his match leg puts him on the bench
+  exactly when the sheet does, and counts a start only with minutes on the pitch. Returns each leg
+  that disagrees with its sheet.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+select
+    legs.fixture_sk,
+    legs.player_sk,
+    legs.league_code,
+    legs.season_api_year,
+    legs.minutes,
+    legs.is_starter,
+    legs.is_substitute,
+    sheet.is_starter as sheet_is_starter,
+    sheet.lineup_state
+from {{ ref('int_legs__player_match') }} as legs
+inner join {{ ref('fct_fixture_lineup') }} as sheet
+    on legs.fixture_sk = sheet.fixture_sk and legs.player_sk = sheet.player_sk
+where
+    sheet.lineup_state in ('confirmed', 'researched')
+    and (
+        legs.is_substitute is distinct from not sheet.is_starter
+        or legs.is_starter is distinct from (sheet.is_starter and coalesce(legs.minutes, 0) > 0)
+    )
diff --git a/dbt_project/tests/assert_player_season_starts_from_checked_sheets.sql b/dbt_project/tests/assert_player_season_starts_from_checked_sheets.sql
new file mode 100644
index 00000000..ca5b5013
--- /dev/null
+++ b/dbt_project/tests/assert_player_season_starts_from_checked_sheets.sql
@@ -0,0 +1,69 @@
+{#
+  Hand-worked starts and substitute appearances of a real player-season whose stat lines file him
+  as a starter in matches his team sheet has him on the bench. D. Ings (player 18955), Southampton,
+  Premier League 2019: the raw sheets of Southampton's 38 league matches list him in the starting
+  eleven 32 times and among the substitutes 6 times, and he has minutes in all 38; the stat lines
+  make 36 of them starts. Both season grains must return 32 starts and 6 substitute appearances.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with expected as (
+    select
+        'PL' as league_code,
+        2019 as season_api_year,
+        18955 as player_sk,
+        32 as starts,
+        6 as substitute_appearances,
+        38 as appearances
+),
+
+actual as (
+    select
+        'competition_season' as grain,
+        league_code,
+        season_api_year,
+        player_sk,
+        starts,
+        substitute_appearances,
+        appearances
+    from {{ ref('int_player_season__metrics') }}
+    union all
+    select
+        'club_season' as grain,
+        league_code,
+        season_api_year,
+        player_sk,
+        starts,
+        substitute_appearances,
+        appearances
+    from {{ ref('int_player_club_season__metrics') }}
+),
+
+grains as (
+    select grain from unnest(['competition_season', 'club_season']) as grain
+)
+
+select
+    g.grain,
+    e.league_code,
+    e.season_api_year,
+    e.player_sk,
+    e.starts as expected_starts,
+    a.starts as actual_starts,
+    e.substitute_appearances as expected_substitute_appearances,
+    a.substitute_appearances as actual_substitute_appearances,
+    e.appearances as expected_appearances,
+    a.appearances as actual_appearances
+from expected as e
+cross join grains as g
+left join actual as a
+    on
+        g.grain = a.grain
+        and e.league_code = a.league_code
+        and e.season_api_year = a.season_api_year
+        and e.player_sk = a.player_sk
+where
+    a.player_sk is null
+    or a.starts is distinct from e.starts
+    or a.substitute_appearances is distinct from e.substitute_appearances
+    or a.appearances is distinct from e.appearances
