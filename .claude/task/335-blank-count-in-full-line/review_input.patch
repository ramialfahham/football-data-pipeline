+++++-- A team's blank offsides count is a zero when its own line has fouls and possession (the
+++++-- cleaning_rules Blank rule), and stays blank in a line without them. Returns a row (= fails) for
+++++-- a full line with a blank offsides count, and for a thin line whose offsides is 0 with no value
+++++-- on the other team's line, which the clause must not produce.
+++++{{ config(store_failures = true) }}
+++++
+++++with lines as (
+++++    select
+++++        fixture_sk,
+++++        team_sk,
+++++        has_stat_line,
+++++        offsides,
+++++        fouls is not null and possession_pct is not null as is_full_line
+++++    from {{ ref('fct_fixture_team_stats') }}
+++++),
+++++
+++++full_line_blanks as (
+++++    select
+++++        l.fixture_sk,
+++++        l.team_sk,
+++++        'full line with a blank offsides count' as failure
+++++    from lines as l
+++++    where l.has_stat_line and l.is_full_line and l.offsides is null
+++++),
+++++
+++++thin_line_zeros as (
+++++    select
+++++        l.fixture_sk,
+++++        l.team_sk,
+++++        'thin line with offsides 0 and no value on the other team line' as failure
+++++    from lines as l
+++++    inner join lines as o
+++++        on l.fixture_sk = o.fixture_sk and l.team_sk != o.team_sk
+++++    where
+++++        l.has_stat_line
+++++        and not l.is_full_line
+++++        and l.offsides = 0
+++++        and o.offsides is null
+++++)
+++++
+++++select * from full_line_blanks
+++++union all
+++++select * from thin_line_zeros
