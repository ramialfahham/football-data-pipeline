diff --git a/dbt_project/tests/assert_mart_competition_fixtures_one_next_match_per_team.sql b/dbt_project/tests/assert_mart_competition_fixtures_one_next_match_per_team.sql
new file mode 100644
index 00000000..c3f806c5
--- /dev/null
+++ b/dbt_project/tests/assert_mart_competition_fixtures_one_next_match_per_team.sql
@@ -0,0 +1,17 @@
+-- A team has at most one next match: returns every team flagged on more than one fixture.
+with flagged as (
+    select home_team_sk as team_sk
+    from {{ ref('mart_competition_fixtures') }}
+    where is_home_team_next_match
+    union all
+    select away_team_sk as team_sk
+    from {{ ref('mart_competition_fixtures') }}
+    where is_away_team_next_match
+)
+
+select
+    team_sk,
+    count(*) as next_matches
+from flagged
+group by team_sk
+having count(*) > 1
