@@ -0,0 +1,35 @@
+version: 2
+
+models:
+  - name: int_round_names
+    description: >
+      Every distinct round text of a competition-season in fct_fixture, named the way the
+      competition names it: a copy key from the round_names seed (the competition-season's own
+      row, then the competition's, then the general one) with the number and group letter the
+      name shows. Grain: (league_code, season_api_year, round_name).
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [league_code, season_api_year, round_name]
+    columns:
+      - name: league_code
+        description: "{{ doc('league_code') }}"
+        tests: [not_null]
+      - name: season_api_year
+        description: "{{ doc('season_api_year') }}"
+        tests: [not_null]
+      - name: round_name
+        description: "{{ doc('round_name') }}"
+        tests: [not_null]
+      - name: round_label_i18n_key
+        description: The copy key a page names the round by. NULL when no round_names pattern covers the text.
+      - name: round_number
+        description: The number the round's name shows (the matchday, or the round in a cup's sequence); NULL when the name shows none.
+      - name: round_letter
+        description: The group letter the round's name shows; NULL when the name shows none.
+      - name: needs_number
+        description: True when the matched name shows a number.
+      - name: needs_letter
+        description: True when the matched name shows a group letter.
+      - name: is_latest_season
+        description: True for the competition's latest season in fct_fixture, the season the competition pages show.
+        tests: [not_null]
