+    "links": {
+      "inbound_hub": "competition",
+      "outbound": ["competition", "team", "player"]
+    },
+    "minimum_data": "The competition's latest served season in competitions/{league_code}/{season}.json carries at least one board in team_boards or player_boards, the top five of a board from mart_team_leaderboards or mart_leaderboards. A competition with no board served has no page here, and its Overview shows the tab as an inert label. Every team row links to the team page and every player row to the player page, which the build emits for every player a board names; the board headings and their full lists are the Leaderboards pages (#140) and stay plain names until those exist.",
