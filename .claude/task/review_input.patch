+def branch_hash(repo, base="main") -> str:
+    """The F11 hash CI recomputes: sha256 of `git diff base...HEAD` excluding the
+    bookkeeping artifacts (--no-renames), mirroring check_task_artifacts.py."""
+    import hashlib
