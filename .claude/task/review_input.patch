diff --git a/site_v2/src/components/competition/RankingBoard.astro b/site_v2/src/components/competition/RankingBoard.astro
new file mode 100644
index 00000000..430a80a1
--- /dev/null
+++ b/site_v2/src/components/competition/RankingBoard.astro
@@ -0,0 +1,63 @@
+---
+// One board of the competition page's Rankings tab (GitLab #129 board rules; #151 builds it): a
+// single-value table in the block standard's `.ctab.rkt` shape — the board's name in the head
+// row, then up to five rows of rank · crest · name · value. Everything shown is served: the dense
+// rank as the warehouse ranks it (equal values share a rank), the value in the catalogue's format,
+// the direction as `rank_order` ("fewest first" beside an ascending board), the club under a
+// player's name. The row is the link, to the team or the player page.
+//
+// The heading is a plain name until the Leaderboards pages exist (#140): a chevron says a heading
+// leads somewhere, and nothing here does yet.
+import Crest from "../ui/Crest.astro";
+import { formatValue } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t, metricLabel, boardTitle } from "../../i18n/strings";
+import { localeHref } from "../../lib/href";
+import type { CompetitionBoard } from "../../lib/types";
+
+interface Props {
+  board: CompetitionBoard;
+  entity: "team" | "player";
+  lang: Lang;
+}
+const { board, entity, lang } = Astro.props;
+
+// "Ø Goals" is a row label; as a board name the sigil is spelled out ("Goals per match"), and only
+// where the catalogue says the metric is per match — the export carries that fact.
+const title = board.per_match ? boardTitle(lang, board.label_i18n_key) : metricLabel(lang, board.label_i18n_key);
+
+function href(slug: string | null): string | undefined {
+  if (!slug) return undefined;
+  return localeHref(lang, entity === "team" ? `teams/${slug}/` : `players/${slug}/`);
+}
+---
+
+<div class="board">
+  <div class="ctab rkt">
+    <div class="ctab-head">
+      <span class="h rk"></span>
+      <span class="h nmh">
+        <span class="bt"><span class="nm">{title}</span></span>
+        {board.rank_order === "asc" && <span class="bnote">({t(lang, "compFewestFirst")})</span>}
+      </span>
+      <span class="h"></span>
+    </div>
+    {board.rows.map((row) => (
+      <a class="ctab-row" href={href(row.slug)}>
+        <span class="rk num">{row.rank}</span>
+        <span class="tm">
+          <Crest name={entity === "team" ? row.name : row.club} crest={row.crest} size="xs" />
+          {entity === "player" ? (
+            <span class="ent">
+              <span class="nm">{row.name}</span>
+              <span class="sub">{row.club}</span>
+            </span>
+          ) : (
+            <span class="nm">{row.name}</span>
+          )}
+        </span>
+        <span class="n num pts">{formatValue(row.value, board.format, lang)}</span>
+      </a>
+    ))}
+  </div>
+</div>
diff --git a/site_v2/src/components/competition/RankingsBlock.astro b/site_v2/src/components/competition/RankingsBlock.astro
new file mode 100644
index 00000000..3892f4b4
--- /dev/null
+++ b/site_v2/src/components/competition/RankingsBlock.astro
@@ -0,0 +1,35 @@
+---
+// One of the Rankings tab's two blocks, Team rankings or Player rankings (GitLab #129, #151): the
+// block name, then the served boards under their metric groups — the group key, order and name
+// from the catalogue (#152), the group heading the block standard's `.rkgroup` (the level-1 head
+// without its line), the boards inside a group in the order the export lists them. A group with
+// no board is absent; a block with no group renders nothing, and the page then has no tab.
+import SectionHead from "../ui/SectionHead.astro";
+import RankingBoard from "./RankingBoard.astro";
+import type { Lang } from "../../lib/format";
+import { metricLabel } from "../../i18n/strings";
+import { GROUP_KEYS_IN_ORDER } from "../../lib/metricRows";
+import { boardGroups } from "../../lib/competitionPayload.mjs";
+import type { CompetitionBoard } from "../../lib/types";
+
+interface Props {
+  label: string;
+  boards: CompetitionBoard[];
+  entity: "team" | "player";
+  lang: Lang;
+}
+const { label, boards, entity, lang } = Astro.props;
+const groups = boardGroups(boards, GROUP_KEYS_IN_ORDER) as { key: string; boards: CompetitionBoard[] }[];
+---
+
+{groups.length > 0 && (
+  <section>
+    <SectionHead label={label} />
+    {groups.map((group) => (
+      <div class="fxgroup rkgroup">
+        <div class="gh"><span class="nm">{metricLabel(lang, `metricGroups.${group.key}.label`)}</span></div>
+        {group.boards.map((board) => <RankingBoard board={board} entity={entity} lang={lang} />)}
+      </div>
+    ))}
+  </section>
+)}
