+  .mk-src td { padding: 1px 0; border: 0; }
+  .mk-src td:first-child { color: #f0d59a; font-weight: 600; }
+}
+#mk-src:checked ~ .mk-page .mk-src { display: block; }
+.mk-chg { outline: 2px dashed #d29922; outline-offset: 4px; }
