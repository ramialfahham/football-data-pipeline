+++ b/dbt_project/tests/assert_team_index_one_winner_per_cup_season.sql
@@ -0,0 +1,82 @@
+-- Every season the Teams page counts (a top club cup's last five finished seasons, the latest
+-- finished World Cup and championships) has exactly one winner in mart_team_competitions.
+
+with regions as (
+    select
+        top_club_competition,
+        continental_championship
+    from {{ ref('confederations') }}
+),
+
+world_championships as (
+    select league_code
+    from {{ ref('competition_registry') }}
+    where competition_type = 'world_championship'
+),
+
+finals as (
+    select
+        f.league_code,
+        f.season_api_year,
+        row_number() over (
+            partition by f.league_code order by f.season_api_year desc
+        ) as recency
+    from {{ ref('fct_fixture') }} as f
+    inner join {{ ref('int_round_names') }} as r
+        on
+            f.league_code = r.league_code
+            and f.season_api_year = r.season_api_year
+            and f.round_name = r.round_name
+    where r.round_stage_kind = 'final'
+    group by f.league_code, f.season_api_year
+    having logical_and(f.status_short in ('FT', 'AET', 'PEN', 'AWD', 'WO'))
+),
+
+counted_competitions as (
+    select
+        top_club_competition as league_code,
+        5 as seasons_counted
+    from regions
+    where top_club_competition is not null
+    union all
+    select
+        continental_championship as league_code,
+        1 as seasons_counted
+    from regions
+    where continental_championship is not null
+    union all
+    select
+        league_code,
+        1 as seasons_counted
+    from world_championships
+),
+
+counted_seasons as (
+    select
+        s.league_code,
+        s.season_api_year
+    from finals as s
+    inner join counted_competitions as c
+        on s.league_code = c.league_code
+    where s.recency <= c.seasons_counted
+),
+
+winners as (
+    select
+        league_code,
+        season_api_year,
+        countif(cup_status = 'winners') as winner_count
+    from {{ ref('mart_team_competitions') }}
+    group by league_code, season_api_year
+)
+
+select
+    c.league_code,
+    c.season_api_year,
+    coalesce(w.winner_count, 0) as winner_count
+from counted_seasons as c
+left join winners as w
+    on
+        c.league_code = w.league_code
+        and c.season_api_year = w.season_api_year
+where coalesce(w.winner_count, 0) != 1
diff --git a/dbt_project/tests/assert_team_index_stage_answer_key.sql b/dbt_project/tests/assert_team_index_stage_answer_key.sql
new file mode 100644
index 00000000..0136bb4a
--- /dev/null
+++ b/dbt_project/tests/assert_team_index_stage_answer_key.sql
@@ -0,0 +1,85 @@
+-- mart_team_index against team_index_answer_key: a club's cup_points is the sum of its rows in its
+-- region's top club competition; a national team's world_cup_stage and championship_stage are
+-- its World Cup row and its championship row.
+
+with answer_key as (
+    select * from {{ ref('team_index_answer_key') }}
+),
+
+regions as (
+    select
+        top_club_competition,
+        continental_championship
+    from {{ ref('confederations') }}
+),
+
+registry as (
+    select
+        league_code,
+        competition_type
+    from {{ ref('competition_registry') }}
+),
+
+team_index as (
+    select * from {{ ref('mart_team_index') }}
+),
+
+club_expected as (
+    select
+        k.team_id,
+        sum(k.stage_value) as expected_cup_points
+    from answer_key as k
+    inner join regions as g
+        on k.league_code = g.top_club_competition
+    group by k.team_id
+),
+
+national_expected as (
+    select
+        k.team_id,
+        max(if(r.competition_type = 'world_championship', k.stage_value, null))
+            as expected_world_cup_stage,
+        max(if(g.continental_championship is not null, k.stage_value, null))
+            as expected_championship_stage
+    from answer_key as k
+    inner join registry as r
+        on k.league_code = r.league_code
+    left join regions as g
+        on k.league_code = g.continental_championship
+    where r.competition_type = 'world_championship' or g.continental_championship is not null
+    group by k.team_id
+)
+
+select
+    c.team_id,
+    'cup_points' as served_column,
+    c.expected_cup_points as expected_value,
+    t.cup_points as served_value
+from club_expected as c
+left join team_index as t
+    on c.team_id = t.team_sk
+where t.cup_points is distinct from c.expected_cup_points
+
+union all
+
+select
+    n.team_id,
+    'world_cup_stage' as served_column,
+    n.expected_world_cup_stage as expected_value,
+    t.world_cup_stage as served_value
+from national_expected as n
+left join team_index as t
+    on n.team_id = t.team_sk
+where t.world_cup_stage is distinct from n.expected_world_cup_stage
+
+union all
+
+select
+    n.team_id,
+    'championship_stage' as served_column,
+    n.expected_championship_stage as expected_value,
+    t.championship_stage as served_value
+from national_expected as n
+left join team_index as t
+    on n.team_id = t.team_sk
+where t.championship_stage is distinct from n.expected_championship_stage
