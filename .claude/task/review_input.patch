diff --git a/site_v2/src/components/team/TeamHighsLows.astro b/site_v2/src/components/team/TeamHighsLows.astro
new file mode 100644
index 00000000..a3d5c2b0
--- /dev/null
+++ b/site_v2/src/components/team/TeamHighsLows.astro
@@ -0,0 +1,56 @@
+---
+// Highs and lows, fact rows: the biggest win and the heaviest defeat this season across the team's
+// competitions (score from the team's side, then the opponent, competition and date), and the
+// longest unbeaten and winless runs in the featured competition. Every value is mart_team_profile's;
+// a row without a value is absent, and so is the block without a row.
+import SectionHead from "../ui/SectionHead.astro";
+import type { Lang } from "../../lib/format";
+import { integer, formatShortDate } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { competitionInfo } from "../../lib/teamFixtures";
+import type { TeamSeason } from "../../lib/types";
+
+interface Props {
+  season: TeamSeason;
+  lang: Lang;
+}
+const { season: s, lang } = Astro.props;
+
+const match = (gf: number | null | undefined, ga: number | null | undefined, opp: string | null | undefined,
+               ha: string | null | undefined, code: string | null | undefined, kickoff: string | null | undefined) =>
+  gf == null || ga == null || !opp
+    ? null
+    : {
+        value: `${integer(gf, lang)}–${integer(ga, lang)}`,
+        sub: [
+          t(lang, ha === "away" ? "teamAtAway" : "teamVsHome", { opponent: opp }),
+          code ? competitionInfo(code).name : null,
+          formatShortDate(kickoff, lang),
+        ].filter(Boolean).join(", "),
+      };
+const run = (n: number | null | undefined) =>
+  n == null ? null : { value: t(lang, "compFactMatches", { n: integer(n, lang) }), sub: competitionInfo(s.league_code).name };
+
+const rows = [
+  { label: t(lang, "teamBiggestWin"), v: match(s.biggest_win_goals_for, s.biggest_win_goals_against, s.biggest_win_opponent_name,
+      s.biggest_win_home_away, s.biggest_win_league_code, s.biggest_win_kickoff_datetime) },
+  { label: t(lang, "teamHeaviestDefeat"), v: match(s.heaviest_defeat_goals_for, s.heaviest_defeat_goals_against,
+      s.heaviest_defeat_opponent_name, s.heaviest_defeat_home_away, s.heaviest_defeat_league_code, s.heaviest_defeat_kickoff_datetime) },
+  { label: t(lang, "compFactLongestUnbeaten"), v: run(s.longest_unbeaten_run) },
+  { label: t(lang, "compFactLongestWinless"), v: run(s.longest_winless_run) },
+].filter((r) => r.v !== null);
+---
+
+{rows.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "teamHighsLows")} />
+    <div class="facts">
+      {rows.map((r) => (
+        <div class="frow">
+          <span class="fl">{r.label}</span>
+          <span class="fv"><span class="fvv"><b>{r.v!.value}</b></span><span class="sub">{r.v!.sub}</span></span>
+        </div>
+      ))}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/team/TeamLastSeason.astro b/site_v2/src/components/team/TeamLastSeason.astro
new file mode 100644
index 00000000..ca000273
--- /dev/null
+++ b/site_v2/src/components/team/TeamLastSeason.astro
@@ -0,0 +1,82 @@
+---
+// Compared with last season: a table of the served metric list (the catalogue's groups and order),
+// this season and last season over their first N matches, then the trend: ▲ when this season is
+// better by the metric's direction, ▼ when worse, "–" when the shown values are equal. A row with
+// neither value is left out. The key metrics show; the switch shows every row in its place.
+// Data: mart_team_competition_benchmarks (metric_value, metric_value_prev_season).
+import SectionHead from "../ui/SectionHead.astro";
+import MetricSwitch from "../ui/MetricSwitch.astro";
+import type { Lang } from "../../lib/format";
+import { formatValue, integer, DASH } from "../../lib/format";
+import { t, metricLabel, boardTitle } from "../../i18n/strings";
+import { comparisonGroups, needsSwitch } from "../../lib/comparisonGroups";
+import { teamBinding } from "../../lib/metricRows";
+import { betterSide } from "../../lib/bars";
+import type { TeamSeason, WindowStats } from "../../lib/types";
+
+interface Props {
+  season: TeamSeason;
+  lang: Lang;
+}
+const { season: s, lang } = Astro.props;
+
+const bench = s.benchmarks ?? [];
+const now = Object.fromEntries(bench.map((b) => [b.metric_key, b.metric_value ?? null])) as WindowStats;
+const prev = Object.fromEntries(bench.map((b) => [b.metric_key, b.metric_value_prev_season ?? null])) as WindowStats;
+const has = (id: string) => now[id] != null || prev[id] != null;
+const groups = s.yoy_games_played_cutoff != null && bench.some((b) => b.metric_value_prev_season != null)
+  ? comparisonGroups(now, prev)
+    .map((g) => ({ ...g, rows: g.rows.map(teamBinding).filter((r) => has(r.metric_id)) }))
+    .filter((g) => g.rows.length > 0)
+  : [];
+const shown = (v: unknown, format: Parameters<typeof formatValue>[1]) =>
+  typeof v === "number" ? formatValue(v, format, lang) : DASH;
+---
+
+{groups.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "teamVsLastSeason")} />
+    <p class="bsub">{t(lang, "teamVsLastSeasonIntro", { n: integer(s.yoy_games_played_cutoff, lang) })}</p>
+    {needsSwitch(groups) && <MetricSwitch id="tsw-season" lang={lang} />}
+    <div class="yoy-list">
+      <div class="ctab yoyt yoyt-head">
+        <div class="ctab-head">
+          <span class="h nmh"></span>
+          <span class="h">{t(lang, "teamThisSeasonHead")}</span>
+          <span class="h">{t(lang, "teamLastSeasonHead")}</span>
+          <span class="h tr">{t(lang, "teamTrend")}</span>
+        </div>
+      </div>
+      {groups.map((g) => (
+        <div class:list={["fxgroup", "rkgroup", { nonkey: !g.hasKey }]}>
+          <div class="gh"><span class="nm">{metricLabel(lang, `metricGroups.${g.key}.label`)}</span></div>
+          <div class="ctab yoyt">
+            {g.rows.map((r) => {
+              const a = shown(now[r.metric_id], r.format);
+              const b = shown(prev[r.metric_id], r.format);
+              const side = a === DASH || b === DASH || a === b
+                ? null
+                : betterSide(now[r.metric_id] as number, prev[r.metric_id] as number, r.direction);
+              return (
+                <div class:list={["ctab-row", { nonkey: !r.is_key_metric }]}>
+                  <span class="tm"><span class="nm">{boardTitle(lang, r.label_i18n_key, r.per_match)}</span></span>
+                  <span class="n now">{a}</span>
+                  <span class="n prev">{b}</span>
+                  {a === DASH || b === DASH || (r.direction === "neutral" && a !== b) ? (
+                    <span class="n tr"></span>
+                  ) : side === "home" ? (
+                    <span class="n tr up" role="img" aria-label={t(lang, "teamTrendBetter")}>▲</span>
+                  ) : side === "away" ? (
+                    <span class="n tr down" role="img" aria-label={t(lang, "teamTrendWorse")}>▼</span>
+                  ) : (
+                    <span class="n tr flat" role="img" aria-label={t(lang, "teamTrendSame")}>–</span>
+                  )}
+                </div>
+              );
+            })}
+          </div>
+        </div>
+      ))}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/team/TeamLeagueStrips.astro b/site_v2/src/components/team/TeamLeagueStrips.astro
new file mode 100644
index 00000000..65bde2b0
--- /dev/null
+++ b/site_v2/src/components/team/TeamLeagueStrips.astro
@@ -0,0 +1,87 @@
+---
+// Compared with the league: the served metric list (metric_rows.json, the catalogue's groups and
+// order), each row a strip plot of the team's league this season. The line runs from the league's
+// lowest to its highest value, values growing to the right; every other club is a small light dot,
+// the team the one solid dot, the league median a tick with its value. The team's value and its
+// rank (the mart's, by the metric's direction) stand on the right; "better" points the metric's
+// way. A row without a value for the team is left out. The key metrics show; the switch shows
+// every row in its place. Data: mart_team_competition_benchmarks and its every-club strip.
+import SectionHead from "../ui/SectionHead.astro";
+import MetricSwitch from "../ui/MetricSwitch.astro";
+import type { Lang } from "../../lib/format";
+import { formatValue, ordinal } from "../../lib/format";
+import { t, metricLabel, boardTitle } from "../../i18n/strings";
+import { comparisonGroups, needsSwitch } from "../../lib/comparisonGroups";
+import { teamBinding } from "../../lib/metricRows";
+import type { TeamSeason, WindowStats } from "../../lib/types";
+
+interface Props {
+  season: TeamSeason;
+  teamName: string;
+  compName: string;
+  lang: Lang;
+}
+const { season: s, teamName, compName, lang } = Astro.props;
+
+const bench = new Map((s.benchmarks ?? []).map((b) => [b.metric_key, b]));
+const strips = new Map((s.league_strip ?? []).map((x) => [x.metric_key, x.clubs]));
+const values = Object.fromEntries([...bench].map(([k, b]) => [k, b.metric_value ?? null])) as WindowStats;
+const groups = comparisonGroups(values, null).map((g) => ({ ...g, rows: g.rows.map(teamBinding) }))
+  .map((g) => ({ ...g, rows: g.rows.filter((r) => bench.get(r.metric_id)?.metric_value != null) }))
+  .filter((g) => g.rows.length > 0);
+
+// A value's place on the line, inside 3%–97% so no dot is cut at an end.
+function place(v: number, lo: number, hi: number): number {
+  return hi === lo ? 50 : 3 + ((v - lo) / (hi - lo)) * 94;
+}
+---
+
+{groups.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "teamVsLeague")} />
+    <p class="bsub">{t(lang, "teamVsLeagueIntro", { competition: compName })}</p>
+    {needsSwitch(groups) && <MetricSwitch id="tsw-league" lang={lang} />}
+    <div class="rs-list">
+      <div class="rs-legend" aria-hidden="true">
+        <span><i class="rs-k-club"></i>{t(lang, "teamOtherTeams", { competition: compName })}</span>
+        <span><i class="rs-k-med"></i>{t(lang, "teamLeagueMedian")}</span>
+        <span><i class="rs-k-dot"></i>{teamName}</span>
+      </div>
+      {groups.map((g) => (
+        <div class:list={["fxgroup", "rkgroup", { nonkey: !g.hasKey }]}>
+          <div class="gh"><span class="nm">{metricLabel(lang, `metricGroups.${g.key}.label`)}</span></div>
+          {g.rows.map((r) => {
+            const b = bench.get(r.metric_id)!;
+            const v = b.metric_value as number;
+            const clubs = (strips.get(r.metric_id) ?? []).filter((c) => c.value != null) as { name: string; value: number; is_self: boolean }[];
+            const all = clubs.map((c) => c.value);
+            const lo = all.length ? Math.min(...all, v) : v;
+            const hi = all.length ? Math.max(...all, v) : v;
+            const med = b.league_median;
+            return (
+              <div class:list={["rs-row", { nonkey: !r.is_key_metric }]}>
+                <span class="rs-name">{boardTitle(lang, r.label_i18n_key, r.per_match)}</span>
+                <span class="rs-strip">
+                  <span class="rs-line"></span>
+                  {med != null && (
+                    <>
+                      <span class="rs-med" style={`left:${place(med, lo, hi)}%`}></span>
+                      <span class="rs-medv" style={`left:${place(med, lo, hi)}%`}>{formatValue(med, r.format, lang)}</span>
+                    </>
+                  )}
+                  {clubs.filter((c) => !c.is_self).map((c) => (
+                    <span class="rs-club" style={`left:${place(c.value, lo, hi)}%`} title={`${c.name}: ${formatValue(c.value, r.format, lang)}`}></span>
+                  ))}
+                  <span class="rs-dot" style={`left:${place(v, lo, hi)}%`} title={`${teamName}: ${formatValue(v, r.format, lang)}`}></span>
+                  {r.direction === "higher_better" && <span class="rs-dir r">{t(lang, "teamBetterRight")}</span>}
+                  {r.direction === "lower_better" && <span class="rs-dir">{t(lang, "teamBetterLeft")}</span>}
+                </span>
+                <span class="rs-val">{formatValue(v, r.format, lang)}<small>{ordinal(b.rank, lang)}</small></span>
+              </div>
+            );
+          })}
+        </div>
+      ))}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/team/TeamMatches.astro b/site_v2/src/components/team/TeamMatches.astro
