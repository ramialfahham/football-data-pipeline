+    monkeypatch.setattr(fixture_scheduling, "fetch_merged_paged", lambda *a, **k: payload)
+
+    rows, complete = fixture_scheduling.transfers_response_for_team({}, 1, [])
+
+    assert complete is expected_complete, (
