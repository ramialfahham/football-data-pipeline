+.fxgroup > .gh .cnt { font-size: 13px; font-weight: 600; color: var(--muted); white-space: nowrap; }
+.tblock > :is(.tview-all, .tview-region) > .comp-grid { margin-top: -8px; }
+.tview-region { display: none; }
+.seg-in[name="region-filter"]:not([value=""]):checked ~ .categories .tview-region { display: block; }
