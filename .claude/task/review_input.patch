+        return f'{gf}–{ga}', f'{"vs" if home else "at"} {E(opp)}, {E(cname(code))}, {short_date(k)}'
+
+    league_matches = sorted((m for m in played if m[4] == "BL1"), key=lambda m: m[5])
+
+    def longest(keep):
+        best = run = 0
+        for m in league_matches:
