+  lang: Lang;
+}
+const { fixture, lang } = Astro.props;
+const { home, away } = fixture;
+
+const dateStr = formatDate(fixture.kickoff, lang);
+const timeStr = fixture.status === "TBD" ? t(lang, "timeTBD") : formatTime(fixture.kickoff, lang);
+const kick = [fixture.round, dateStr, timeStr].filter(Boolean).join(" · ");
+---
+
+<header class="mast">
+  <div class="eyebrow" style="margin-top:14px">{t(lang, "eyebrowPreview")}</div>
+  <div class="kick">{kick}</div>
+  <div class="teams">
+    {[home, away].map((side, i) => (
+      <>
+        {i === 1 && <div class="vs">{t(lang, "vs")}</div>}
+        <div class="team">
+          <Crest name={side.name} crest={side.crest} />
+          <span class="tname">{side.name}</span>
+          {side.standing && (
+            <div class="stand num">
+              #<b>{side.standing.league_rank}</b> · <b>{side.standing.standing_points}</b>{" "}
+              {t(lang, "pts")} · GD <b>{signedInteger(side.standing.standing_goals_diff, lang)}</b>
+            </div>
+          )}
+        </div>
+      </>
+    ))}
+  </div>
+  {fixture.venue && <div class="venue">{fixture.venue}</div>}
+</header>
diff --git a/site_v2/src/components/fixture/MetricComparison.astro b/site_v2/src/components/fixture/MetricComparison.astro
new file mode 100644
index 0000000..6a1b0ee
--- /dev/null
+++ b/site_v2/src/components/fixture/MetricComparison.astro
@@ -0,0 +1,46 @@
+---
+// The LOCKED 16-row team comparison for one window (W1 or W2). Renders the groups
+// in the fixed order with a subhead, rows in the fixed order within each group
+// (metricRows.ts). A row whose value is missing on BOTH sides is hidden (avoid a
+// wall of dashes); a row missing on one side shows "-" there. No reordering by value.
+import MetricRow from "./MetricRow.astro";
+import { GROUP_ORDER, METRIC_ROWS } from "../../lib/metricRows";
+import type { MetricRowDef } from "../../lib/metricRows";
+import { asNumber } from "../../lib/types";
+import type { WindowStats } from "../../lib/types";
+import type { Lang } from "../../lib/format";
+
+interface Props {
+  home?: WindowStats | null;
+  away?: WindowStats | null;
+  windowKey: "w1" | "w2";
+  lang: Lang;
+  homeName?: string | null;
+  awayName?: string | null;
+}
+const { home, away, windowKey, lang, homeName, awayName } = Astro.props;
+
+const hasData = (def: MetricRowDef): boolean =>
+  asNumber(home?.[def.field]) !== null || asNumber(away?.[def.field]) !== null;
+
+const groups = GROUP_ORDER.map((group) => ({
+  group,
+  rows: METRIC_ROWS.filter((r) => r.group === group && hasData(r)),
+})).filter((g) => g.rows.length > 0);
+---
+
+<div class="cmp">
+  <div class="cmp-head">
+    <div class="h">{homeName}</div>
+    <div></div>
+    <div class="h">{awayName}</div>
+  </div>
+  {groups.map(({ group, rows }) => (
+    <>
+      <div class="mgroup">{group}</div>
+      {rows.map((def) => (
+        <MetricRow def={def} home={home} away={away} windowKey={windowKey} lang={lang} />
+      ))}
+    </>
+  ))}
+</div>
diff --git a/site_v2/src/components/fixture/MetricRow.astro b/site_v2/src/components/fixture/MetricRow.astro
new file mode 100644
index 0000000..47b61f7
--- /dev/null
+++ b/site_v2/src/components/fixture/MetricRow.astro
@@ -0,0 +1,53 @@
+---
+// One comparison row: home value · centred label + diverging bar · away value.
+// All arithmetic here is DISPLAY (format the served value; bar width = relative
+// share; green = the served `direction`'s better side) — no metric facts computed.
+import { formatValue, countFraction, DASH } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { barWidth, betterSide } from "../../lib/bars";
+import { asNumber } from "../../lib/types";
+import type { WindowStats } from "../../lib/types";
+import type { MetricRowDef } from "../../lib/metricRows";
+
+interface Props {
+  def: MetricRowDef;
+  home?: WindowStats | null;
+  away?: WindowStats | null;
+  windowKey: "w1" | "w2";
+  lang: Lang;
+}
+const { def, home, away, windowKey, lang } = Astro.props;
+
+const hv = asNumber(home?.[def.field]);
+const av = asNumber(away?.[def.field]);
+
+function display(side: WindowStats | null | undefined, v: number | null): string {
+  if (def.format === "count_fraction") {
+    const denomField = windowKey === "w1" ? def.denom!.w1 : def.denom!.w2;
+    return countFraction(v, asNumber(side?.[denomField]), lang);
+  }
+  return v == null ? DASH : formatValue(v, def.format, lang);
+}
+
+const hDisp = display(home, hv);
+const aDisp = display(away, av);
+const better = betterSide(hv, av, def.direction);
+const hWidth = barWidth(hv, av);
+const aWidth = barWidth(av, hv);
+---
+
+<div class="mrow">
+  <div class:list={["mval", "home", { better: better === "home" }]}>{hDisp}</div>
+  <div class="mmid">
+    <div class="mlabel">{def.label}{def.sublabel && <small>{def.sublabel}</small>}</div>
+    <div class="mbar" aria-hidden="true">
+      <div class="bside home">
+        <span class:list={["fill", { better: better === "home" }]} style={`width:${hWidth}%`}></span>
+      </div>
+      <div class="bside away">
+        <span class:list={["fill", { better: better === "away" }]} style={`width:${aWidth}%`}></span>
+      </div>
+    </div>
+  </div>
+  <div class:list={["mval", "away", { better: better === "away" }]}>{aDisp}</div>
+</div>
diff --git a/site_v2/src/components/fixture/NarrativeSlot.astro b/site_v2/src/components/fixture/NarrativeSlot.astro
new file mode 100644
index 0000000..49e257f
