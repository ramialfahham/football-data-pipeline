+
+    ci = _ci_module()
+
+    def fake_get(url, headers, timeout):
+        raise requests.ConnectionError("down")
+
+    monkeypatch.setenv("DESIGN_GATE_TOKEN", "test-token")
+    monkeypatch.setattr(requests, "get", fake_get)
+    assert ci.fetch_issue_labels(127) is None
+
