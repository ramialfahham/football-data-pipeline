--- /dev/null
+++ b/dbt_project/tests/assert_fixture_lineup_substitutions_pair_up.sql
@@ -0,0 +1,40 @@
+{#
+  Every substitution in a confirmed or researched line-up of fct_fixture_lineup pairs two players
+  of one match. Returns one row per broken line-up row:
+  - starter_came_on: a starter with a minute on;
+  - replaced_not_off: a substitute whose replaced player has no minute off, or a different one.
+#}
+{{ config(store_failures = true) }}
+
+with lineups as (
+    select * from {{ ref('fct_fixture_lineup') }}
+    where lineup_state in ('confirmed', 'researched')
+)
+
+select
+    'starter_came_on' as problem,
+    fixture_sk,
+    team_sk,
+    player_sk
+from lineups
+where is_starter and minute_on is not null
+
+union all
+
+select
+    'replaced_not_off' as problem,
+    came_on.fixture_sk,
+    came_on.team_sk,
+    came_on.player_sk
+from lineups as came_on
+left join lineups as went_off
+    on
+        came_on.fixture_sk = went_off.fixture_sk
+        and came_on.replaced_player_sk = went_off.player_sk
+where
+    came_on.replaced_player_sk is not null
+    and (
+        went_off.minute_off is null
+        or went_off.minute_off != came_on.minute_on
+        or coalesce(went_off.minute_off_extra, 0) != coalesce(came_on.minute_on_extra, 0)
+    )
diff --git a/dbt_project/tests/assert_lineup_research_list.sql b/dbt_project/tests/assert_lineup_research_list.sql
new file mode 100644
index 00000000..c9fc8d7e
--- /dev/null
+++ b/dbt_project/tests/assert_lineup_research_list.sql
@@ -0,0 +1,77 @@
+{#
+  The line-up research list: every played match the research priority of the cleaning rules
+  covers whose lineup_state is not_available, one row each, with its priority group:
+  1 our_league: a match of a domestic league in the competition registry;
+  2 national_team: a national-team match;
+  3 our_club: another competition's match with a club from such a league in that season.
+  A walkover not played has no line-ups and is left out. Warn only: the stored rows are the list
+  researchers work from, by group and then current season first.
+#}
+{{ config(store_failures = true, severity = 'warn') }}
+
+with registry as (
+    select
+        league_code,
+        competition_type
+    from {{ ref('competition_registry') }}
+),
+
+fixtures as (
+    select
+        f.fixture_sk,
+        f.league_code,
+        f.season_api_year,
+        f.kickoff_datetime,
+        f.home_team_sk,
+        f.home_team_name,
+        f.away_team_sk,
+        f.away_team_name,
+        f.lineup_state,
+        r.competition_type
+    from {{ ref('mart_competition_fixtures') }} as f
+    left join registry as r
+        on f.league_code = r.league_code
+    where
+        f.is_played
+        and coalesce(f.award_kind, '') != 'not_played'
+),
+
+our_clubs as (
+    select distinct
+        team_sk,
+        season_api_year
+    from fixtures,
+        unnest([home_team_sk, away_team_sk]) as team_sk
+    where competition_type = 'domestic_league'
+),
+
+grouped as (
+    select
+        fixtures.*,
+        case
+            when fixtures.competition_type = 'domestic_league' then 'our_league'
+            when exists (
+                select 1
+                from our_clubs
+                where
+                    our_clubs.season_api_year = fixtures.season_api_year
+                    and our_clubs.team_sk in (fixtures.home_team_sk, fixtures.away_team_sk)
+            ) then 'our_club'
+            when fixtures.competition_type in (
+                'qualifying', 'continental_championship', 'world_championship'
+            ) then 'national_team'
+        end as priority_group
+    from fixtures
+    where fixtures.lineup_state = 'not_available'
+)
+
+select
+    priority_group,
+    league_code,
+    season_api_year,
+    fixture_sk,
+    kickoff_datetime,
+    home_team_name,
+    away_team_name
+from grouped
+where priority_group is not null
diff --git a/dbt_project/tests/assert_lineup_researched_matches_hold.sql b/dbt_project/tests/assert_lineup_researched_matches_hold.sql
new file mode 100644
index 00000000..82c5fd42
--- /dev/null
+++ b/dbt_project/tests/assert_lineup_researched_matches_hold.sql
@@ -0,0 +1,78 @@
+{#
+  Every researched line-up in fixture_lineup_corrections is applied and holds. Returns one row
+  per broken match:
+  - not_applied: the match has seed rows but no researched rows in base_apif__lineups;
+  - fails_check: base_apif__lineups finds it failing a line-up check other than the squad lists,
+    which an official source outranks;
+  - source_not_valid: a source that is not https, or match reports from fewer than two sites.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with seeded_rows as (
+    select
+        fixture_id,
+        source_kind,
+        source as source_urls
+    from {{ ref('fixture_lineup_corrections') }}
+),
+
+seeded as (
+    select distinct fixture_id
+    from seeded_rows
+),
+
+applied as (
+    select
+        lineups.fixture_id,
+        logical_and(lineups.lineup_state = 'researched') as is_researched,
+        any_value(lineups.failed_checks) as failed_checks
+    from {{ ref('base_apif__lineups') }} as lineups
+    inner join seeded
+        on lineups.fixture_id = seeded.fixture_id
+    group by lineups.fixture_id
+),
+
+sources as (
+    select
+        seeded_rows.fixture_id,
+        seeded_rows.source_kind,
+        seeded_rows.source_urls,
+        countif(not starts_with(url, 'https://')) as n_not_https,
+        count(distinct net.host(url)) as n_sites
+    from seeded_rows,
+        unnest(split(seeded_rows.source_urls, ' ')) as url
+    where url != ''
+    group by seeded_rows.fixture_id, seeded_rows.source_kind, seeded_rows.source_urls
+),
+
+failing as (
+    select distinct applied.fixture_id
+    from applied,
+        unnest(applied.failed_checks) as failed_check
+    where failed_check != 'squad_lists'
+)
+
+select
+    seeded.fixture_id,
+    'not_applied' as problem
+from seeded
+left join applied
+    on seeded.fixture_id = applied.fixture_id
+where not coalesce(applied.is_researched, false)
+
+union all
+
+select
+    fixture_id,
+    'fails_check' as problem
+from failing
+
+union all
+
+select
+    sources.fixture_id,
+    'source_not_valid' as problem
+from sources
+where
+    sources.n_not_https > 0
+    or (sources.source_kind = 'match_reports' and sources.n_sites < 2)
diff --git a/dbt_project/tests/assert_mart_player_fixture_stats_keeps_every_stat_line.sql b/dbt_project/tests/assert_mart_player_fixture_stats_keeps_every_stat_line.sql
new file mode 100644
index 00000000..3cbf41cb
--- /dev/null
+++ b/dbt_project/tests/assert_mart_player_fixture_stats_keeps_every_stat_line.sql
@@ -0,0 +1,46 @@
+-- mart_player_fixture_stats serves every stat line of a finished match exactly once, flagged
+-- has_stat_line, and flags no row that has none. A join to the line-ups that drops, doubles or
+-- moves a stat line fails here.
+--
+-- Returns a row (= fails) per stat line missing from the mart, per flagged row with no stat line,
+-- and per stat line served more than once.
+{{ config(store_failures = true) }}
+
+with expected as (
+    select
+        s.fixture_sk,
+        s.team_sk,
+        s.player_sk
+    from {{ ref('fct_fixture_player_stats') }} as s
+    inner join {{ ref('fct_fixture') }} as f
+        on s.fixture_sk = f.fixture_sk
+    where f.status_short in ('FT', 'AET', 'PEN')
+),
+
+served as (
+    select
+        fixture_sk,
+        team_sk,
+        player_sk,
+        count(*) as n_served
+    from {{ ref('mart_player_fixture_stats') }}
+    where has_stat_line
+    group by fixture_sk, team_sk, player_sk
+)
+
+select
+    coalesce(e.fixture_sk, s.fixture_sk) as fixture_sk,
+    coalesce(e.team_sk, s.team_sk) as team_sk,
+    coalesce(e.player_sk, s.player_sk) as player_sk,
+    e.fixture_sk is not null as in_stat_lines,
+    coalesce(s.n_served, 0) as n_served
+from expected as e
+full outer join served as s
+    on
+        e.fixture_sk = s.fixture_sk
+        and e.team_sk = s.team_sk
+        and e.player_sk = s.player_sk
+where
+    e.fixture_sk is null
+    or s.fixture_sk is null
+    or s.n_served > 1

