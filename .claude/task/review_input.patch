+  const under = beside && right && cx - (gapText.length + 1) * labelChar < L;
+  const sx0 = Math.min(Math.max(cx, L + nameW / 2), W - R - nameW / 2);
+  const stack = (near: boolean) => (above ? `-${near ? offset.stackNear : offset.stackFar}` : near ? offset.stackNear : offset.stackFar);
   return {
     W, H, L, R, T, B, sx, sy, xTicks, yTicks,
     line: { x1: sx(x0), y1: sy(onLine(x0)), x2: sx(x1), y2: sy(onLine(x1)) },
-    me: {
-      cx, cy, cl,
-      dx: toRight(right), anchor: right ? "start" : "end",
+    me: beside ? {
+      cx, cy, cl, nx: cx, gx: cx,
+      dx: toRight(right), anchor: right ? "start" : "end", ndy: offset.middle,
       gdx: toRight(under ? right : !right), ganchor: (under ? right : !right) ? "start" : "end",
       gy: under ? cy : (cy + cl) / 2, gdy: under ? offset.under : offset.middle,
+    } : {
+      cx, cy, cl, nx: sx0, gx: sx0,
+      dx: "0", anchor: "middle", ndy: stack(!above),
+      gdx: "0", ganchor: "middle", gy: cy, gdy: stack(above),
     },
   };
 }
