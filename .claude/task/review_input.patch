+        for ct, ms in gs)
+    f_inputs, f_bar = filter_bar()
+    n_comps = sum(len(m) for _g, m in gs)
+    changed = sum(1 for _g, ms in gs for c in ms if region(c) != (c.get("country") or ""))
+
