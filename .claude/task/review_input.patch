+++ b/dbt_project/models/2_base/api_football/base.yml
@@ -21,6 +21,17 @@ models:
     description: >
       One row per team_api_id: latest ingest across (league_code, team_api_id) rows
       from base_apif__teams. Entity resolution for dim_team. Grain: team_api_id.
+
+      Also applies the CPO-owned display-name corrections from the team_name_overrides seed
+      (#850). This is the layer where they belong: base prepares the entity, the core dim
+      publishes an already-settled one (CPO ruling, 2026-07-27). It matters because the
+      provider's short name is the ONLY team name in the product — it drives the fixture
+      card, the page H1, the title, the meta description and the URL slug (#851) — so the
+      correction has to land once, upstream of all of them.
+
+      Note for anyone reading a historical row elsewhere: fct_fixture_event's
+      team_name_snapshot is written on insert and never revisited, so it deliberately keeps
+      the name as it stood at ingest time and will not reflect a later correction.
     config:
       tags: ["base", "api_football", "team_context"]
     tests:
diff --git a/dbt_project/models/2_base/api_football/base_apif__teams_global.sql b/dbt_project/models/2_base/api_football/base_apif__teams_global.sql
index 872bad1..797fd9d 100644
--- a/dbt_project/models/2_base/api_football/base_apif__teams_global.sql
+++ b/dbt_project/models/2_base/api_football/base_apif__teams_global.sql
@@ -1,9 +1,50 @@
 -- Global team entity: one row per team_api_id (latest ingest across league_code rows).
 -- Feeds dim_team. Grain: team_api_id.
+--
+-- Applies the CPO-owned name corrections here rather than in dim_team so the core
+-- dimension publishes an entity that is already settled (CPO ruling, 2026-07-27: base is
+-- where these preparations happen, the dim propagates the result). Why it matters beyond
+-- spelling: the provider's /teams endpoint sends a short label of unverified quality
+-- ("Rangers", "Lokomotiv"), and it is the ONLY team name in the product -- it drives the
+-- fixture card, the page H1, the <title>, the meta description and the URL slug, so 18
+-- teams in 9 groups were previously indistinguishable from one another (#850, #851).
 
-select *
-from {{ ref('base_apif__teams') }}
-qualify row_number() over (
-    partition by team_api_id
-    order by raw_ingested_at desc
-) = 1
+with import_base_apif__teams as (
+    select * from {{ ref('base_apif__teams') }}
+),
+
+import_team_name_overrides as (
+    select * from {{ ref('team_name_overrides') }}
+),
+
+latest_per_team as (
+    select *
+    from import_base_apif__teams
+    qualify row_number() over (
+        partition by team_api_id
+        order by raw_ingested_at desc
+    ) = 1
+)
+
+-- Columns are enumerated rather than passed through with a wildcard: adding the override
+-- join makes `select teams.* replace (...)` ambiguous to SQLFluff (AM04, "unknown number of
+-- result columns"), and this repo suppresses no lint rule anywhere -- there is not a single
+-- `noqa` in it. Nothing is lost by listing them: dim_team is the only consumer and already
+-- projects its columns explicitly, so a new upstream column needs an edit there regardless.
+select
+    teams.league_code,
+    teams.team_api_id,
+    teams.team_code,
+    teams.team_country,
+    teams.team_founded_year,
+    teams.team_logo_url,
+    teams.venue_api_id,
+    teams.venue_name,
+    teams.venue_address,
+    teams.venue_city,
+    teams.venue_capacity,
+    teams.raw_ingested_at,
+    coalesce(overrides.team_name, teams.team_name) as team_name
+from latest_per_team as teams
+left join import_team_name_overrides as overrides
+    on teams.team_api_id = overrides.team_api_id
diff --git a/dbt_project/seeds/schema.yml b/dbt_project/seeds/schema.yml
index 6c2efb0..19be6cd 100644
--- a/dbt_project/seeds/schema.yml
+++ b/dbt_project/seeds/schema.yml
@@ -256,3 +256,55 @@ seeds:
         description: "Human note + external-evidence reference for the correction (required — the governance control)."
         tests:
           - not_null
+
+  - name: team_name_overrides
+    description: >
+      CPO-owned corrections to a team's DISPLAY NAME, applied in base_apif__teams_global (#850).
+      The provider's /teams endpoint sends a short label of unverified quality ("Rangers",
+      "Lokomotiv") and it is the ONLY team name in the product — it drives the fixture card, the
+      page H1, the <title>, the meta description and the URL slug (#851) — so 18 teams in 9 groups
+      were previously indistinguishable from one another. Correcting the name here fixes every one
+      of those surfaces at once.
+
+      GOVERNANCE: add a row ONLY where an AUTHORITATIVE EXTERNAL SOURCE disagrees with the
+      provider, and record that source in the row. Never taste, never a nickname, and never a
+      locale preference — `Bayern München` is NOT corrected to `Bayern Munich` (CPO ruled one
+      locale-independent slug). An earlier draft asserted "Glasgow Rangers" from memory and was
+      wrong: Wikipedia states that has never been the club's official name. Verify externally, one
+      club at a time.
+
+      NOT the mechanism for duplicate provider ids — one club under two ids is
+      fixture_event_team_overrides.csv with mode=alias, because two URLs for one club is worse than
+      the collision. Nyasa Big Bullets (#4596/#4599) and Dragon (#3045/#21310) are therefore
+      deliberately absent, as is Warriors #4207 whose identity is unresolved.
+
+      assert_team_name_overrides_still_needed fails the build if a row's value equals the
+      provider's current name, so a correction the provider has since adopted is removed rather
+      than left to rot.
+    config:
+      column_types:
+        team_api_id: int64
+        team_name: string
+        source: string
+        note: string
+    columns:
+      - name: team_api_id
+        description: "The team whose display name is corrected. Must exist in dim_team."
+        tests:
+          - not_null
+          - unique
+          - relationships:
+              to: ref('dim_team')
+              field: team_api_id
+      - name: team_name
+        description: "The club's actual name, as established by the external source in `source`."
+        tests:
+          - not_null
+      - name: source
+        description: "URL of the external source of record establishing the name (required — the governance control)."
+        tests:
+          - not_null
+      - name: note
+        description: "Why the provider's value is wrong, and what this row collides with."
+        tests:
+          - not_null
