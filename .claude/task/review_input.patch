+  },
+  "blocks": [
+    {
+      "block": "Competition header",
+      "mart": ["mart_competition_index", "mart_competition_fixtures"],
+      "i18n_keys": ["crumbHome", "navCompetitions", "compSeason", "compTabsAria", "compTabOverview", "compTabMatchdays", "compTabRounds", "compTabRankings"]
