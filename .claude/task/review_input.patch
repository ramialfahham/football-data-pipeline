diff --git a/site_v2/src/lib/teamIndex.mjs b/site_v2/src/lib/teamIndex.mjs
new file mode 100644
index 00000000..88465f72
--- /dev/null
+++ b/site_v2/src/lib/teamIndex.mjs
@@ -0,0 +1,117 @@
+// The Teams page's lists, cut from teams_index.json by the served orders. Nothing here ranks: a
+// list is the served rows sorted by their served place, and rows sharing a place keep the export's
+// order. The region listed first is the first in the served region order.
+
+export const SHOWN = 6;
+export const TOP_SHOWN = 10;
+export const TOP_ALL = 20;
+
+const byPlace = (key) => (a, b) => a[key] - b[key];
+
+/** Rows that carry `key`, sorted by it; equal places keep their input order. */
+export function ranked(rows, key) {
+  return rows.filter((r) => r[key] != null).sort(byPlace(key));
+}
+
+/** Rows grouped by `key`, the groups in the served region order. */
+export function byRegion(rows, key = "region_key") {
+  const groups = new Map();
+  for (const r of rows) {
+    if (r[key] == null) continue;
+    if (!groups.has(r[key])) {
+      groups.set(r[key], { region: r[key], label: r.region_label_i18n_key, rank: r.region_rank, rows: [] });
+    }
+    groups.get(r[key]).rows.push(r);
+  }
+  return [...groups.values()].sort((a, b) => a.rank - b.rank);
+}
+
+const row = (team) => ({ kind: "row", team });
+const head = (props) => ({ kind: "head", ...props });
+
+/** A list cut at `shown` rows: the items before the cut, the items after it, and the row count.
+ *  A heading goes with the first row it heads. */
+export function cut(items, shown) {
+  let rows = 0;
+  let at = items.length;
+  for (let i = 0; i < items.length; i++) {
+    if (items[i].kind !== "row") continue;
+    if (rows === shown) {
+      at = i;
+      while (at > 0 && items[at - 1].kind === "head") at--;
+      break;
+    }
+    rows++;
+  }
+  const n = items.filter((i) => i.kind === "row").length;
+  return { visible: items.slice(0, at), rest: items.slice(at), n };
+}
+
+/** Top clubs. All regions: the first region's top TOP_SHOWN shown, then its places up to TOP_ALL
+ *  and each other region's top SHOWN under its name. A region: its own top list. */
+export function topClubs(teams) {
+  const regions = byRegion(ranked(teams.filter((t) => t.entity_type === "club"), "top_club_rank"));
+  if (regions.length === 0) return { all: null, regions: [] };
+  const [lead, ...others] = regions;
+  const items = [
+    ...lead.rows.slice(0, TOP_ALL).map(row),
+    ...others.flatMap((g) => [head({ region: g.region, label: g.label }), ...g.rows.slice(0, SHOWN).map(row)]),
+  ];
+  return {
+    all: cut(items, TOP_SHOWN),
+    regions: regions.map((g) => ({
+      region: g.region,
+      list: cut(g.rows.slice(0, g === lead ? TOP_SHOWN : SHOWN).map(row), TOP_SHOWN),
+    })),
+  };
+}
+
+/** Top national teams. All regions: the world's top TOP_ALL, TOP_SHOWN shown. A region: all its
+ *  teams, TOP_SHOWN shown. */
+export function topNationalTeams(teams) {
+  const national = teams.filter((t) => t.entity_type === "national");
+  const world = ranked(national, "national_team_rank").slice(0, TOP_ALL);
+  if (world.length === 0) return { all: null, regions: [] };
+  return {
+    all: cut(world.map(row), TOP_SHOWN),
+    regions: byRegion(ranked(national, "national_team_region_rank")).map((g) => ({
+      region: g.region,
+      list: cut(g.rows.map(row), TOP_SHOWN),
+    })),
+  };
+}
+
+/** Clubs by country: one group per country in the served country order (countries sharing a place
+ *  in the export's order); inside, the clubs in their served order under their covered league, then the others,
+ *  headed "Other clubs" only when a league heading comes before them. */
+export function clubsByCountry(teams) {
+  const groups = new Map();
+  for (const t of teams) {
+    if (t.entity_type !== "club") continue;
+    const key = t.team_country ?? "";
+    if (!groups.has(key)) {
+      groups.set(key, { country: t.team_country, order: t.country_order, region: t.country_region_key ?? "", rows: [] });
+    }
+    groups.get(key).rows.push(t);
+  }
+  return [...groups.values()]
+    .sort(byPlace("order"))
+    .map((g) => {
+      const items = [];
+      let league;
+      for (const t of g.rows.sort(byPlace("team_order_in_country"))) {
+        if (items.length === 0 ? t.league_code != null : t.league_code !== league) {
+          items.push(head({ league: t.league_code ?? null }));
+        }
+        league = t.league_code;
+        items.push(row(t));
+      }
+      return { country: g.country, region: g.region, n: g.rows.length, list: cut(items, SHOWN) };
+    });
+}
+
+/** National teams by region: one group per region, in the served region order and places. */
+export function nationalTeamsByRegion(teams) {
+  return byRegion(ranked(teams.filter((t) => t.entity_type === "national"), "national_team_region_rank"))
+    .map((g) => ({ region: g.region, label: g.label, n: g.rows.length, list: cut(g.rows.map(row), SHOWN) }));
+}
diff --git a/site_v2/src/lib/teamIndex.test.mjs b/site_v2/src/lib/teamIndex.test.mjs
new file mode 100644
index 00000000..296cb4bb
--- /dev/null
+++ b/site_v2/src/lib/teamIndex.test.mjs
@@ -0,0 +1,88 @@
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { cut, topClubs, topNationalTeams, clubsByCountry, nationalTeamsByRegion } from "./teamIndex.mjs";
+
+const REGIONS = { UEFA: 1, CONMEBOL: 2, CAF: 6 };
+
+function club(name, region, over = {}) {
+  return {
+    team_name: name, team_slug: name.toLowerCase(), entity_type: "club", region_key: region,
+    region_rank: REGIONS[region], region_label_i18n_key: `confed${region}`, team_country: "X",
+    country_region_key: region, country_order: 1, league_code: null, team_order_in_country: 1,
+    top_club_rank: null, national_team_rank: null, national_team_region_rank: null, crest: null, ...over,
+  };
+}
+
+function national(name, region, world, inRegion) {
+  return club(name, region, {
+    entity_type: "national", team_country: name, country_region_key: null, country_order: null,
+    team_order_in_country: null, national_team_rank: world, national_team_region_rank: inRegion,
+  });
+}
+
+const names = (items) => items.filter((i) => i.kind === "row").map((i) => i.team.team_name);
+
+test("a cut keeps a heading with the first row it heads", () => {
+  const items = [{ kind: "head" }, ...[1, 2].map((n) => ({ kind: "row", team: { team_name: `a${n}` } })),
+    { kind: "head" }, { kind: "row", team: { team_name: "b1" } }];
+  const { visible, rest, n } = cut(items, 2);
+  assert.equal(n, 3);
+  assert.deepEqual(visible.map((i) => i.kind), ["head", "row", "row"]);
+  assert.deepEqual(rest.map((i) => i.kind), ["head", "row"]);
+});
+
+test("top clubs: the first region's 10 shown, its 11-20 and each other region's 6 behind the fold", () => {
+  // Input order is the export's (by name); the served places decide the list.
+  const europe = Array.from({ length: 25 }, (_, i) => club(`E${String(25 - i).padStart(2, "0")}`, "UEFA", { top_club_rank: 25 - i }));
+  const southAmerica = Array.from({ length: 8 }, (_, i) => club(`S${i + 1}`, "CONMEBOL", { top_club_rank: i + 1 }));
+  const unranked = club("U", "UEFA");
+  const { all, regions } = topClubs([...southAmerica, unranked, ...europe]);
+  assert.deepEqual(names(all.visible), ["E01", "E02", "E03", "E04", "E05", "E06", "E07", "E08", "E09", "E10"]);
+  assert.equal(all.n, 26);
+  assert.deepEqual(all.rest.filter((i) => i.kind === "head").map((i) => i.region), ["CONMEBOL"]);
+  assert.deepEqual(names(all.rest).slice(-6), ["S1", "S2", "S3", "S4", "S5", "S6"]);
+  assert.deepEqual(regions.map((r) => [r.region, r.list.n, r.list.rest.length]), [["UEFA", 10, 0], ["CONMEBOL", 6, 0]]);
+});
+
+test("teams sharing a place keep the export's order", () => {
+  const { all } = topClubs([club("Alpha", "UEFA", { top_club_rank: 2 }), club("Beta", "UEFA", { top_club_rank: 1 }),
+    club("Gamma", "UEFA", { top_club_rank: 2 })]);
+  assert.deepEqual(names(all.visible), ["Beta", "Alpha", "Gamma"]);
+});
+
+test("top national teams: the world's 20, 10 shown; a region lists all its teams", () => {
+  const teams = Array.from({ length: 24 }, (_, i) => national(`N${i + 1}`, i % 2 ? "CAF" : "UEFA", i + 1, Math.floor(i / 2) + 1));
+  const { all, regions } = topNationalTeams(teams);
+  assert.equal(all.n, 20);
+  assert.equal(names(all.visible).length, 10);
+  assert.deepEqual(regions.map((r) => [r.region, r.list.n, names(r.list.visible).length]), [["UEFA", 12, 10], ["CAF", 12, 10]]);
+});
+
+test("clubs by country: served country order, leagues then Other clubs, 6 shown", () => {
+  const teams = [
+    club("Zed", "UEFA", { team_country: "Spain", country_order: 1, league_code: null, team_order_in_country: 8 }),
+    ...Array.from({ length: 7 }, (_, i) => club(`P${i + 1}`, "UEFA", { team_country: "Spain", country_order: 1, league_code: "PD", team_order_in_country: i + 1 })),
+    club("Only", "CAF", { team_country: "Sudan", country_order: 2 }),
+  ];
+  const [spain, sudan] = clubsByCountry(teams);
+  assert.equal(spain.country, "Spain");
+  assert.equal(spain.n, 8);
+  assert.deepEqual(spain.list.visible.filter((i) => i.kind === "head").map((i) => i.league), ["PD"]);
+  assert.deepEqual(spain.list.rest.map((i) => i.kind === "head" ? `head:${i.league}` : i.team.team_name), ["P7", "head:null", "Zed"]);
+  assert.deepEqual(sudan.list.visible.map((i) => i.kind), ["row"], "no Other clubs heading without a league before it");
+  assert.equal(sudan.region, "CAF");
+});
+
+test("countries sharing a place keep the export's order", () => {
+  const groups = clubsByCountry([
+    club("A", "UEFA", { team_country: "Portugal", country_order: 7 }),
+    club("B", "UEFA", { team_country: "Österreich", country_order: 7 }),
+    club("C", "UEFA", { team_country: "Spain", country_order: 1 }),
+  ]);
+  assert.deepEqual(groups.map((g) => g.country), ["Spain", "Portugal", "Österreich"]);
+});
+
+test("national teams by region: one group per region in the served region order", () => {
+  const groups = nationalTeamsByRegion([national("A", "CAF", 3, 1), national("B", "UEFA", 1, 1), national("C", "UEFA", 2, 2)]);
+  assert.deepEqual(groups.map((g) => [g.region, g.n, names(g.list.visible)]), [["UEFA", 2, ["B", "C"]], ["CAF", 1, ["A"]]]);
+});
diff --git a/site_v2/src/lib/types.ts b/site_v2/src/lib/types.ts
index 641896f2..1ae83787 100644
--- a/site_v2/src/lib/types.ts
+++ b/site_v2/src/lib/types.ts
@@ -558,6 +558,31 @@ export interface CompetitionIndex {
   competitions: CompetitionIndexRow[];
 }
 
+/** teams_index.json — mart_team_index, one row per team with a page, ordered by name. */
+export interface TeamIndexRow {
+  team_name: string;
+  team_slug: string;
+  team_country: string | null;
+  entity_type: "club" | "national";
