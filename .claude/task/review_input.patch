+    assert.ok(errors.mock.calls.some((c) => /fouls_per_match shows 18th, the payload serves 1st/.test(c.arguments[0])));
+    page("1st");
+    assert.equal(main(join(root, "dist"), join(root, "data")), 0);
+  } finally {
+    rmSync(root, { recursive: true, force: true });
