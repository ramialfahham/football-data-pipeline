++        tl.shots_inside_box,
++        tl.passes_total,
++        tl.passes_accurate,
++        tl.corner_kicks,
++        tl.opponent_corner_kicks,
++        tl.goalkeeper_saves,
++        pl.key_passes,
++        pl.tackles,
++        pl.interceptions,
++        pl.blocks,
++        pl.duels_total,
++        pl.duels_won,
++        pl.dribbles_attempts,
++        pl.dribbles_success,
++        tl.result,
