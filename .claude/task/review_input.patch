+    name: gcr.io/kaniko-project/executor:debug
+    entrypoint: [""]
+  <<: *gcp_job
+  stage: deploy
+  # Round-2 finding, platform-reviewer: `needs:` originally omitted `validate:secrets` (gitleaks)
+  # and `lint:python`. A job scheduled off `needs:` starts as soon as ITS OWN edges finish,
