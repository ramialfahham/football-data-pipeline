diff --git a/site_v2/src/lib/roundName.mjs b/site_v2/src/lib/roundName.mjs
new file mode 100644
index 00000000..2e1ab1df
--- /dev/null
+++ b/site_v2/src/lib/roundName.mjs
@@ -0,0 +1,12 @@
+// A round's name in the page's language, from what the warehouse serves (int_round_names): the
+// copy key that names the round the way its competition does, and the number and group letter
+// that name shows ("6. Spieltag", "A-lohko, 3. kierros"). The page never reads the provider's
+// round text.
+//
+// Plain JS so `roundName.test.mjs` imports it under bare `node --test`; the caller passes `t`.
+
+/** The name, or null when no key is served. */
+export function roundName(t, lang, key, number, letter) {
+  if (!key) return null;
+  return t(lang, key, { n: number ?? "", g: letter ?? "" });
+}
diff --git a/site_v2/src/lib/roundName.test.mjs b/site_v2/src/lib/roundName.test.mjs
new file mode 100644
index 00000000..a146dbaf
--- /dev/null
+++ b/site_v2/src/lib/roundName.test.mjs
@@ -0,0 +1,26 @@
+// Pins how a served round reads: its copy key in the page's language with the served number and
+// group letter filled in; no key served is no name.
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { roundName } from "./roundName.mjs";
+
+const COPY = {
+  de: { roundGroupStageMatchday: "{n}. Gruppenspieltag", roundFinal: "Finale" },
+  fi: { roundGroupMatchday: "{g}-lohko, {n}. kierros" },
+};
+const t = (lang, key, vars = {}) =>
+  COPY[lang][key].replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ""));
+
+test("the served key reads in the page's language with its number and letter", () => {
+  assert.equal(roundName(t, "de", "roundGroupStageMatchday", 3, null), "3. Gruppenspieltag");
+  assert.equal(roundName(t, "fi", "roundGroupMatchday", 2, "A"), "A-lohko, 2. kierros");
+});
+
+test("a name without a number or letter reads as it is", () => {
+  assert.equal(roundName(t, "de", "roundFinal", null, null), "Finale");
+});
+
+test("no served key is no name, never the provider's text", () => {
+  assert.equal(roundName(t, "de", null, 6, null), null);
+});
