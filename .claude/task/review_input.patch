+.mk-src th { color: #c9a85c; font-weight: 600; }
+.mk-src code { font: 11.5px/1.4 ui-monospace, Consolas, monospace; color: #f0d59a; overflow-wrap: anywhere; }
+.mk-gap { margin-top: 6px; }
