+<!doctype html>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Competition page, Overview -- groups (mock)</title>
+<style>
+/* ================================================================ *
+ *  MATCHDAY IQ — v2 DESIGN SYSTEM  (global; every screen imports it) *
+ *                                                                    *
+ *  Tokens + component classes transcribed VERBATIM from the LOCKED   *
+ *  reference mockup (artifact d70aae67; design memory                *
+ *  project_v2_frontend_design). Imported globally by Layout.astro so *
+ *  every page shares one system → consistency by construction. Do    *
+ *  NOT hand-style screens; emit these class names and style here.     *
+ *                                                                    *
+ *  COLOUR = MEANING ONLY (never hierarchy):                          *
+ *    --accent green = better value / Win · --loss red = Loss         *
+ *    --draw gray = Draw · neutrals = everything else. Green is       *
+ *    RESERVED — links/names/labels never get green.                  *
+ *  HIERARCHY = TONE + WEIGHT + SIZE (never hue). Three rungs:        *
+ *    1 --ink bold    → numbers that matter (values/scores/stats)     *
+ *    2 --ink regular → entity names (players, teams)                 *
+ *    3 --muted       → labels/metadata (metric names, positions,     *
+ *                      dates, section + group headers)               *
+ *  TYPE 11/13/15/18/20 + team-clamp · SPACING 8px base / 36px sec    *
+ *  Dark is default; light = the token swap below.                    *
+ * ================================================================ */
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+/* ---- token host (dark default) ---- */
+.fx {
+  --page: #0d0f13; --surface: #161920; --sunk: #1c1f27; --line: #272b33; --div: #333844;
+  --ink: #f1f3f7; --ink-2: #c1c6ce; --muted: #8b9099;                 /* cool-neutral gray ramp */
+  --accent: #3bb072;                 /* one green: better value · links */
+  --win: #1a854a; --draw: #6b7079; --loss: #b53b3b; --pill-ink: #fff; /* reserved status */
+  --track: #22262e;                                                   /* faint bar track */
+  --sp: 8px;
+  margin: 0;
+  background: var(--page); color: var(--ink);
+  font: 400 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  container-type: inline-size;
+}
+.fx[data-theme="light"] {
+  --page: #f3f3f0; --surface: #fbfbf9; --sunk: #edece7; --line: #e2e1da; --div: #cfcec5;
+  --ink: #141410; --ink-2: #4c4c45; --muted: #77776e;
+  --accent: #0a6e3a;
+  --win: #157f43; --draw: #6f756d; --loss: #b23b3b; --pill-ink: #fff;
+  --track: #e7e6e0;
+}
+
+img { max-width: 100%; }
+
+/* ---- primitives ---- */
+.fx a { color: inherit; text-decoration: none; }
+.fx a.lnk { color: inherit; font-weight: 600; }
+.fx a.lnk:hover { text-decoration: underline; text-underline-offset: 2px; }
+.fx a:focus-visible,
+.fx button:focus-visible,
+.fx .seg-in:focus-visible ~ .seg { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 9px; }
+.inner { max-width: 680px; margin: 0 auto; padding: 0 clamp(16px, 4cqw, 28px) 40px; }
+.num { font-variant-numeric: tabular-nums; }
+.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
+section { margin-top: 36px; }
+.sechead { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; }
+.sechead::after { content: ""; flex: 1; height: 1px; background: var(--line); }
+.win-note { font-size: 11px; font-weight: 600; color: var(--muted); }
+
+.crumb { font-size: 13px; color: var(--muted); padding: 18px 0 0; display: flex; gap: 8px; flex-wrap: wrap; }
+.crumb .sep { opacity: .4; }
+
+/* ---- masthead ---- */
+.mast { text-align: center; padding: 14px 0 26px; border-bottom: 1px solid var(--line); }
+.mast .kick { font-size: 13px; color: var(--muted); margin-top: 8px; }
+.mast .kick b { color: var(--ink-2); font-weight: 600; }
+.teams { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(8px, 3cqw, 20px); margin-top: 20px; }
+.team { display: flex; flex-direction: column; align-items: center; gap: 12px; min-width: 0; }
+.crest { width: 52px; height: 52px; border-radius: 6px; display: grid; place-items: center; background: var(--sunk); border: 1px solid var(--line); color: var(--ink); font-weight: 700; font-size: 17px; overflow: hidden; }
+.crest img { width: 100%; height: 100%; object-fit: contain; }
+.tname { font-size: clamp(20px, 4.4cqw, 27px); font-weight: 700; line-height: 1.05; text-wrap: balance; }
+.vs { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
+.stand { font-size: 13px; color: var(--muted); }
+.stand b { color: var(--ink); font-weight: 700; }
+.mast .venue { font-size: 13px; color: var(--muted); margin-top: 16px; }
+
+/* ---- lede (about, at top) ---- */
+.lede { margin-top: 22px; }
+.lede p { font-size: 16px; line-height: 1.66; margin: 0; color: var(--ink-2); }
+.lede b { color: var(--ink); font-weight: 700; }
+
+/* ---- segment (JS-free radio toggle) ---- */
+.seg-in { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.seg { display: flex; background: var(--sunk); border: 1px solid var(--line); border-radius: 9px; padding: 3px; margin-top: 4px; }
+.seg .seg-btn { flex: 1; font: inherit; font-size: 13px; font-weight: 600; color: var(--muted); padding: 9px 12px; border-radius: 6px; cursor: pointer; white-space: nowrap; text-align: center; user-select: none; }
+/* active label + which window shows — driven by the checked radio */
+.win { display: none; }
+#seg-w1:checked ~ .win-w1,
+#seg-w2:checked ~ .win-w2 { display: block; }
+#seg-w1:checked ~ .seg .seg-btn[for="seg-w1"],
+#seg-w2:checked ~ .seg .seg-btn[for="seg-w2"] { background: var(--surface); color: var(--ink); font-weight: 700; box-shadow: 0 1px 3px rgba(0, 0, 0, .25); }
+
+/* ---- form row (pills / counts) ---- */
+.formrow { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 18px; margin-top: 18px; }
+.formrow .side { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+.formrow .home { align-items: flex-end; }
+.formrow .away { align-items: flex-start; }
+.wmeta { font-size: 13px; color: var(--muted); }
+.wmeta b { color: var(--ink); font-weight: 700; }
+.pills { display: flex; gap: 5px; }
+.pill { width: 24px; height: 24px; border-radius: 5px; display: grid; place-items: center; font-size: 12px; font-weight: 700; color: var(--pill-ink); font-variant-numeric: tabular-nums; }
+.pill.W { background: var(--win); }
+.pill.D { background: var(--draw); }
+.pill.L { background: var(--loss); }
+.cchips { display: flex; gap: 6px; }
+.cchip { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px; border-radius: 5px; font-size: 12.5px; font-weight: 700; color: var(--pill-ink); font-variant-numeric: tabular-nums; }
+.cchip.W { background: var(--win); }
+.cchip.D { background: var(--draw); }
+.cchip.L { background: var(--loss); }
+.cchip small { font-weight: 600; opacity: .85; font-size: 11px; }
+.formrow .scope { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); text-align: center; max-width: 12ch; }
+.caption { font-size: 12px; color: var(--muted); text-align: center; margin: 16px 0 4px; }
+
+/* ============================================================ *
+ *  COMPARISON — 3 columns: home value · centred name+bar · away  *
+ *  value. Numbers aligned in their columns; better value green.  *
+ * ============================================================ */
+.cmp { margin-top: 22px; }
+.cmp-head,
+.mrow { display: grid; grid-template-columns: 1fr 1.5fr 1fr; align-items: center; gap: 12px; }
+.cmp-head { padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 2px; }
+.cmp-head .h { font-size: 12px; font-weight: 700; color: var(--muted); text-align: center; letter-spacing: .02em; }
+.mgroup { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); text-align: center; padding: 22px 0 8px; }
+.mrow { padding: 10px 0; }
+.mmid { display: flex; flex-direction: column; align-items: center; gap: 9px; min-width: 0; }
+.mlabel { font-size: 13px; color: var(--muted); line-height: 1.25; text-align: center; }
+.mlabel small { display: block; font-size: 11px; opacity: .8; }
+.mval { font-size: 18px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; text-align: center; }
+.mval.better { color: var(--accent); }
+.mval .sub { display: block; font-size: 11px; font-weight: 600; color: var(--muted); }
+.mbar { display: flex; align-items: center; height: 5px; width: 100%; max-width: 250px; }
+.bside { flex: 1; height: 100%; display: flex; background: var(--track); border-radius: 3px; }
+.bside.home { justify-content: flex-end; margin-right: 1px; }
+.bside.away { justify-content: flex-start; margin-left: 1px; }
+.bside.home .fill { border-radius: 3px 0 0 3px; }
+.bside.away .fill { border-radius: 0 3px 3px 0; }
+.fill { height: 100%; background: var(--ink); transition: width .45s cubic-bezier(.4, 0, .2, 1); }
+.fill.better { background: var(--accent); }
+
+/* ---- two-column sections ---- */
+.split { display: grid; grid-template-columns: 1fr; gap: 8px 30px; margin-top: 4px; }
+@container (min-width: 560px) { .split { grid-template-columns: 1fr 1fr; } }
+.colhead { font-size: 13px; font-weight: 700; color: var(--muted); margin: 14px 0 8px; }
+.rmatch { display: grid; grid-template-columns: 24px 42px 1fr auto; align-items: center; gap: 11px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
+.rmatch:last-child { border-bottom: 0; }
+.res { width: 24px; height: 24px; border-radius: 5px; display: grid; place-items: center; font-weight: 700; font-size: 11px; color: var(--pill-ink); }
+.res.W { background: var(--win); }
+.res.D { background: var(--draw); }
+.res.L { background: var(--loss); }
+.rscore { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; }
+.ropp { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
+.ropp .ha { color: var(--muted); font-weight: 600; font-size: 11px; margin-left: 5px; }
+.rmeta { color: var(--muted); white-space: nowrap; font-size: 12px; text-align: right; }
+.noclick .rscore,
+.noclick .ropp { opacity: .55; }
+
+.prow { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); }
+.prow:last-child { border-bottom: 0; }
+.pphoto { width: 34px; height: 34px; border-radius: 50%; background: var(--sunk); border: 1px solid var(--line); display: grid; place-items: center; font-weight: 700; font-size: 11px; color: var(--muted); overflow: hidden; }
+.pphoto img { width: 100%; height: 100%; object-fit: cover; }
+.pname { min-width: 0; }
+.pname .nm { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pname .ps { font-size: 11.5px; color: var(--muted); }
+.pstat { font-size: 13px; color: var(--muted); white-space: nowrap; text-align: right; font-variant-numeric: tabular-nums; }
+.pstat b { color: var(--ink); font-weight: 700; }
+/* Squad tab (mock f6348775): a TWO-LINE stat readout (l1 apps · mins/app, l2 goals ·
+   assists), SCOPED to .squad so the fixture PlayerRow's single-line .pstat above is
+   untouched. Inherits text-align/tabular-nums/colour from .pstat. */
+.squad .pstat { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; line-height: 1.2; }
+.squad .pstat .l1 { font-size: 13px; color: var(--muted); }
+.squad .pstat .l2 { font-size: 12px; color: var(--muted); }
+
+/* ---- h2h ---- */
+.h2h-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
+.h2h-rec { font-size: 15px; }
+.h2h-rec b { font-size: 20px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
+.h2h-rec b.cw { color: var(--win); }
+.h2h-rec b.cl { color: var(--loss); }
+.h2h-rec .nm { color: var(--muted); font-size: 13px; }
+.h2h-meta { font-size: 12px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
+.h2h-bar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; gap: 2px; background: var(--track); }
+.h2h-bar span { display: block; height: 100%; border-radius: 2px; }
+.h2h-bar .w { background: var(--win); }
+.h2h-bar .d { background: var(--draw); }
+.h2h-bar .l { background: var(--loss); }
+.h2h-last { margin-top: 12px; font-size: 13px; color: var(--muted); }
+.h2h-last b { color: var(--ink); font-weight: 700; }
+.h2h-list { margin-top: 14px; }
+
+/* ---- links / footer ---- */
+.linkrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
+.linkchip { font-size: 13px; font-weight: 600; color: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 8px 13px; }
+/* Hover is an affordance, so only something clickable may carry it. Every linkchip in the tree is
+   still an inert <span> (the fixture links footer and the team page both wait on page types that
+   are not built), and the unscoped rule invited a click on all of them. Anchor-scoped rather
+   than marker-scoped so a chip gets the affordance back the moment it becomes a link, with no
+   second edit and no class to remember. */
+a.linkchip:hover { border-color: var(--ink-2); color: var(--ink); }
+.footnote { margin-top: 30px; font-size: 11px; color: var(--muted); text-align: center; opacity: .8; }
+.err { padding: 40px; color: #f26d6d; font-size: 14px; white-space: pre-wrap; }
+
+/* ================================================================ *
+ *  TEAM PAGE — blocks transcribed from the approved mock             *
+ *  (artifact f6348775). Same token contract as above: colour =      *
+ *  meaning (green reserved for "better value"), hierarchy by         *
+ *  tone/weight/size. Shared blocks are REUSED from the system above  *
+ *  and not redefined here: .pills/.pill · .cchips/.cchip ·           *
+ *  .rmatch/.res/.rscore/.ropp/.rmeta · .linkrow/.linkchip ·          *
+ *  .sechead/.eyebrow/.win-note · .crest · .footnote. Two classes are *
+ *  additions, not in the mock, each carrying meaning the mock's      *
+ *  example did not need: `.sc .gap` draws the self dot's distance to  *
+ *  the trend line (= deserved_points_gap, ~0 in the mock's example), and   *
+ *  `.coming` is the honest coming-state for the not-yet-built         *
+ *  Performance/Squad tabs.                                            *
+ * ================================================================ */
+
+/* breadcrumb current page */
+.crumb .here { color: var(--ink-2); }
+
+/* team masthead */
+.thead { display: flex; align-items: center; gap: 16px; padding: 16px 0 18px; }
+.thead .crest { flex: none; }
+.tid { min-width: 0; flex: 1; }
+.tid h1 { font-size: clamp(22px, 5cqw, 28px); font-weight: 700; line-height: 1.03; margin: 0; text-wrap: balance; }
+.tid .meta { font-size: 13px; color: var(--muted); margin-top: 5px; }
+.tid .meta b { color: var(--ink-2); font-weight: 600; }
+.selector { display: inline-flex; align-items: center; gap: 9px; margin-top: 13px; font-size: 13px; font-weight: 600; color: var(--ink-2); background: var(--sunk); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
+.selector .yr { color: var(--muted); }
+.selector .chev { color: var(--muted); font-size: 11px; }
+
+/* tabs — JS-free radio toggle (same pattern as the fixture `.seg-in` control): the
+   checked `#tab-*` radio drives both the active label and which `.page` panel shows.
+   No client script → works with JavaScript disabled, keyboard-reachable via the radio
+   group. */
+.tab-in { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--line); }
+.tab { font-size: 14px; font-weight: 600; color: var(--muted); padding: 13px 16px 12px; cursor: pointer; white-space: nowrap; border-bottom: 2px solid transparent; margin-bottom: -1px; user-select: none; }
+.tab:hover { color: var(--ink-2); }
+#tab-overview:checked ~ .tabs .tab[for="tab-overview"],
+#tab-performance:checked ~ .tabs .tab[for="tab-performance"],
+#tab-squad:checked ~ .tabs .tab[for="tab-squad"] { color: var(--ink); font-weight: 700; border-bottom-color: var(--ink); }
+.fx .tab-in:focus-visible ~ .tabs { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
+.page { display: none; }
+#tab-overview:checked ~ .page[data-page="overview"],
+#tab-performance:checked ~ .page[data-page="performance"],
+#tab-squad:checked ~ .page[data-page="squad"] { display: block; }
+.pagecap { font-size: 12.5px; color: var(--muted); margin: 18px 0 0; }
+
+/* coming-state (Performance / Squad panels — their data export is pending) */
+.coming { margin: 44px 0; text-align: center; }
+.coming .ct { font-size: 15px; font-weight: 700; color: var(--ink-2); }
+.coming .cb { font-size: 13px; color: var(--muted); margin: 8px auto 0; max-width: 42ch; line-height: 1.6; }
+
+/* record strip: standing + status (count-chips + form pills) */
+.record { margin-top: 24px; display: flex; flex-direction: column; gap: 14px; }
+.record .stand { font-size: 15px; color: var(--muted); }
+.record .stand b { color: var(--ink); font-weight: 700; }
+.recrow { display: flex; align-items: center; justify-content: space-between; gap: 14px 18px; flex-wrap: wrap; }
+
+/* HERO: deserved vs actual scatter */
+.hero { background: var(--sunk); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }
+.hero .verdict { font-size: 16px; line-height: 1.6; color: var(--ink-2); margin: 0 0 16px; }
+.hero .verdict b { color: var(--ink); font-weight: 700; }
+.hero .heronums { display: flex; gap: 8px; margin: 0 0 18px; }
+.hero .hn { flex: 1; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 9px 11px; min-width: 0; display: flex; flex-direction: column; }
+/* `overflow-wrap: anywhere` (#370): metric names are localised now, and
+   German and Finnish build single long compounds where English uses several short words. MEASURED at
+   375px, where this box is 71px: `Ø Maalilaukaukset` needs 78 and `Ø Torschussdifferenz` needs 89, so
+   the text ran into the tile's padding with nowhere to break — the default `overflow-wrap: normal`
+   plus `hyphens: manual` gives a 16-character compound no break opportunity at all. `anywhere` rather
+   than `break-word` because it also lowers min-content width, which is what a flex item with
+   `min-width: 0` actually sizes against. Every future compounding locale (Dutch next) needs this. */
+.hero .hn .hl { font-size: 11px; color: var(--muted); line-height: 1.3; overflow-wrap: anywhere; }
+.hero .hn .hv { font-size: 17px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; margin-top: auto; padding-top: 8px; }
+/* Stack the hero tiles on phones (#370). Three side by side leave 71px per label, and
+   `overflow-wrap: anywhere` above then breaks a German or Finnish compound at an arbitrary letter with
+   no hyphen — `Ø / Torschussdiffe / renz`. `hyphens: auto` cannot help: this engine ships no de/fi
+   hyphenation dictionary. Stacked, the label gets ~231px (the 301px tile less padding, the value and
+   the gap, since `.hl` and `.hv` share the row) against the 89px the longest German name needs, so
+   every name fits on one line. Costs 53px of block height. English is unaffected either way.
+   The `anywhere` rule above STAYS as the backstop for `.vs-name`, which is not stacked (#876).
+   560px is a builder choice, not part of the ruling: the shell's breakpoints are all min-width
+   700/900/1010 and the container queries at 560/520 target other selectors, so it collides with none. */
+@media (max-width: 560px) {
+  .hero .heronums { flex-direction: column; gap: 6px; }
+  .hero .hn { flex-direction: row; align-items: baseline; justify-content: space-between; gap: 10px; }
+  .hero .hn .hv { margin-top: 0; padding-top: 0; }
+}
+.hero .cap2 { font-size: 12px; color: var(--muted); line-height: 1.55; margin: 14px 0 0; }
+.sc { width: 100%; height: auto; display: block; overflow: visible; }
+.sc .ax { stroke: var(--div); stroke-width: 1; }
+.sc .axtxt { fill: var(--muted); font: 600 9px system-ui, sans-serif; }
+.sc .trend { stroke: var(--muted); stroke-width: 1.3; stroke-dasharray: 4 3; opacity: .7; }
+.sc .gap { stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 2; opacity: .6; }
+.sc .dot { fill: var(--muted); opacity: .5; }
+.sc .team { fill: var(--ink); }
+.sc .teamtxt { fill: var(--ink); font: 800 10px system-ui, sans-serif; }
+.sc .expl { fill: var(--muted); font: 600 8.5px system-ui, sans-serif; }
+
+/* vs last season (overview headline set) */
+.yoygrid { display: grid; grid-template-columns: 1fr; gap: 2px; }
+@container (min-width: 520px) { .yoygrid { grid-template-columns: 1fr 1fr; gap: 2px 26px; } }
+.yrow { display: grid; grid-template-columns: 1fr auto auto; align-items: baseline; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
+.yrow .yl { font-size: 13px; color: var(--muted); }
+.yrow .yn { font-size: 18px; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
+.yrow .yd { font-size: 12.5px; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; min-width: 96px; color: var(--muted); }
+.yrow .yd.up { color: var(--accent); }
+
+/* fixtures: next-fixture card + recent list (rows reuse the shared .rmatch grid) */
+.nextfx { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 13px; padding: 14px; background: var(--sunk); border: 1px solid var(--line); border-radius: 10px; }
+.nextfx .tag { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); border: 1px solid var(--div); border-radius: 5px; padding: 3px 8px; white-space: nowrap; }
+.nextfx .opp { min-width: 0; }
+.nextfx .opp .nm { font-size: 15px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.nextfx .opp .sub { font-size: 12px; color: var(--muted); margin-top: 2px; }
+.nextfx .when { text-align: right; font-size: 12px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
+.nextfx .when b { display: block; color: var(--ink); font-weight: 700; font-size: 14px; }
+.recent { margin-top: 12px; }
+
+/* ---- Performance tab: two panels behind the JS-free segment ---- */
+/* The segment reuses the shared `.seg-in`/`.seg`/`.seg-btn`/`.win` blocks; these two id
+   rules bind the Performance radios to their panels + active label (same shape as the
+   fixture `#seg-w1`/`#seg-w2` pair). */
+#pf-league:checked ~ .pf-league,
+#pf-season:checked ~ .pf-season { display: block; }
+#pf-league:checked ~ .seg .seg-btn[for="pf-league"],
+#pf-season:checked ~ .seg .seg-btn[for="pf-season"] { background: var(--surface); color: var(--ink); font-weight: 700; box-shadow: 0 1px 3px rgba(0, 0, 0, .25); }
+
+/* one shared grid: name | bar | value+rank | median (the group head carries the Median label) */
+.vs-group { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: 22px 0 6px; }
+/* name | bar | value+rank | median. The value/rank column is wider than the mock's (3.4rem)
+   to fit the spec-required "{rank} of {team_count}" (e.g. "13th of 16"). */
+.vs-grouphead,
+.vs-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(84px, 1.5fr) 4.7rem 3.2rem; align-items: center; column-gap: clamp(8px, 2.2cqw, 14px); }
+.vs-grouphead { align-items: start; }
+.vs-h { font-size: 11px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); text-align: right; }
+.vs-row { padding: 10px 0; border-bottom: 1px solid var(--line); }
+.vs-row:last-child { border-bottom: 0; }
+/* Same rule, same reason, and this is the surface that measured WORST (#370): at 375px this
+   column is 77px and 9 of the 16 Performance rows overflowed it in
+   Finnish, `% Viimeistelytehokkuus` by 53px — far enough to run the label into the bar column beside
+   it. Note that string is from the validated corpus, so the gap is pre-existing in this
+   file and localising the labels merely exposed it. `.mlabel` on the fixture page deliberately does
+   NOT get this: it was measured too and is fine, because `.mmid` centres rather than stretches so its
+   box grows to fit. Fix what measured over, not every label that might. */
+.vs-name { font-size: 14px; color: var(--ink); line-height: 1.25; min-width: 0; overflow-wrap: anywhere; }
+.vs-name .sub { display: block; font-size: 11px; color: var(--muted); }
+.vs-bar { position: relative; height: 6px; background: var(--track); border-radius: 3px; }
+.vs-fill { position: absolute; left: 0; top: 0; bottom: 0; min-width: 3px; background: var(--ink); border-radius: 3px; }
+/* every metric is directional: green when it beats the league median in its better direction, plain ink otherwise (red stays reserved for a Loss) */
+.vs-fill.up { background: var(--accent); }
+.vs-notch { position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: var(--page); transform: translateX(-50%); }
+.vs-vr { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.15; }
+.vs-val { font-size: 16px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
+.vs-rank { font-size: 11px; font-weight: 600; color: var(--muted); font-variant-numeric: tabular-nums; margin-top: 2px; white-space: nowrap; }
+.vs-medv { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; text-align: right; }
+/* vs last season: current value + signed change; green only when the change is in the better direction */
+.ss-row { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); }
+.ss-row:last-child { border-bottom: 0; }
+.ss-rt { display: flex; align-items: baseline; gap: 18px; }
+.ss-chg { min-width: 64px; text-align: right; font-size: 14px; font-weight: 700; font-variant-numeric: tabular-nums; white-space: nowrap; color: var(--muted); }
+.ss-chg.up { color: var(--accent); }
+.ss-chg .u { font-size: 11px; font-weight: 600; opacity: .8; margin-left: 2px; }
+
+/* ================================================================ *
+ *  FOUNDATION SHELL — global header/footer + responsive layout system   *
+ *  (#825). Transcribed from the approved foundation mock (artifact      *
+ *  87d14109, "looks good for now"). Same token contract as above — no   *
+ *  new colours, no new type scale. THE SHELL'S three breakpoints are    *
+ *  all viewport (@media) and min-width, distinct from the component-    *
+ *  level @container queries above: nav goes inline + hamburger/drawer   *
+ *  hide >=700px; the page grid below goes two-column >=900px; the       *
+ *  search field replaces its icon-only button >=1010px. There is also  *
+ *  one max-width query, at .heronums above, outside this shell set.     *
+ *  Nav/drawer items render as <a> OR <span>                             *
+ *  — `.mainnav a, .mainnav span` styles both identically, because most *
+ *  nav items are inert placeholders (no index page built yet) and get *
+ *  the same look as a real link, per the codebase's existing no-dead-  *
+ *  links convention (fixture breadcrumb, team page Explore chips).     *
+ * ================================================================ */
+
+/* ---- global header ---- */
+.site-header {
+  position: sticky; top: 0; z-index: 20;
+  background: color-mix(in srgb, var(--page) 88%, transparent);
+  -webkit-backdrop-filter: saturate(1.4) blur(8px); backdrop-filter: saturate(1.4) blur(8px);
+  border-bottom: 1px solid var(--line);
+}
+.header-in {
+  max-width: 1100px; margin: 0 auto; padding: 0 clamp(16px, 3.5vw, 28px);
+  height: 58px; display: flex; align-items: center; gap: 18px;
+}
+.brand { font-size: 18px; font-weight: 800; letter-spacing: -.01em; color: var(--ink); flex: none; }
+.brand .iq { color: var(--ink-2); font-weight: 700; }
+.mainnav { display: none; align-items: center; gap: 2px; margin-left: 4px; }
+.mainnav a, .mainnav span { font-size: 13px; font-weight: 600; color: var(--muted); padding: 7px 9px; border-radius: 7px; }
+.mainnav a:hover { color: var(--ink); background: var(--surface); }
+.header-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; flex: none; }
+.searchbox {
+  display: none; align-items: center; gap: 8px; background: var(--sunk); border: 1px solid var(--line);
+  border-radius: 8px; padding: 7px 11px; color: var(--muted); font-size: 13px; min-width: 180px;
+}
+.searchbox .ico { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; flex: none; }
+.iconbtn {
+  width: 36px; height: 36px; display: grid; place-items: center; border: 1px solid var(--line);
+  border-radius: 8px; background: var(--sunk); color: var(--ink-2); cursor: pointer;
+}
+.iconbtn:hover { color: var(--ink); border-color: var(--ink-2); }
+.iconbtn svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 2; }
+.iconbtn.search-m { display: grid; }
+.hamburger { display: grid; }
+
+/* mobile nav drawer */
+.drawer { display: none; border-top: 1px solid var(--line); background: var(--surface); }
+.drawer.open { display: block; }
+.drawer a, .drawer span {
+  display: block; font-size: 15px; font-weight: 600; color: var(--ink-2);
+  padding: 13px clamp(16px, 3.5vw, 28px); border-bottom: 1px solid var(--line);
+}
+.drawer a:last-child, .drawer span:last-child { border-bottom: 0; }
+
+/* ---- generic page grid (main + rail) — a system primitive, not yet wired ---- *
+ * into any page: which pages get a rail and what fills it is reserved (§10).   *
+ * Available for a future page (home, competition hub, leaderboards) to opt     *
+ * into via `.shell > .page-grid > main + aside.rail`.                          */
+.shell { max-width: 1100px; margin: 0 auto; padding: 0 clamp(16px, 3.5vw, 28px) 48px; }
+.page-grid { display: grid; grid-template-columns: 1fr; gap: 8px 40px; }
+.rail { min-width: 0; }
+
+/* ---- global footer ---- */
+.site-footer { border-top: 1px solid var(--line); margin-top: 40px; }
+.footer-in {
+  max-width: 1100px; margin: 0 auto; padding: 26px clamp(16px, 3.5vw, 28px) 40px;
+  display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: baseline;
+}
+.site-footer .brand { font-size: 15px; }
+.flinks { display: flex; flex-wrap: wrap; gap: 8px 18px; }
+.flinks a, .flinks span { font-size: 12.5px; color: var(--muted); }
+.flinks a:hover { color: var(--ink-2); }
+.flinks .imp { font-style: italic; }
+.fmeta { margin-left: auto; font-size: 11.5px; color: var(--muted); }
+
+/* nav inline + hamburger/drawer hidden once there's room for the full nav */
+@media (min-width: 700px) {
+  .mainnav { display: flex; }
+  .hamburger { display: none; }
+  .drawer { display: none !important; }
+}
+/* the two-column page grid needs a bit more room than the nav */
+@media (min-width: 900px) {
+  .page-grid { grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr); }
+  .rail { border-left: 1px solid var(--line); padding-left: 36px; }
+}
+/* widest: search becomes a full field instead of an icon. `.iconbtn.search-m`
+ * (not the bare class) matches the base rule's specificity (0,0,2) so this
+ * override actually wins — a bare `.search-m` here loses to `.iconbtn.search-m`
+ * regardless of source order, which is a real bug the reference mock also had
+ * (the icon button silently never hid at its own widest breakpoint). */
+@media (min-width: 1010px) {
+  .searchbox { display: flex; }
+  .iconbtn.search-m { display: none; }
+}
+
+/* ---- landing: fixtures hero (#367) ----
+ * A COMPACT stacked fixture row, which none of the existing patterns provides:
+ * `.nextfx` is a single "next fixture" card (3 columns, teams on one line), `.mast`/`.teams` is the
+ * fixture page's CENTRED hero at 27px names, and `.rmatch` is a played-result row keyed to a W/D/L
+ * chip. A list of twelve upcoming matches needs its own row, so this is a new component (flagged in
+ * the 00_overview census), not a per-page restyle of an existing one.
+ *
+ * Stacking the two teams is what frees the right-hand column for the kickoff, and it is the layout
+ * every comparable fixture list uses. Names are sentence case at 15px: the first version of this
+ * block wrapped each group in `.mgroup`, whose uppercase/letter-spaced/centred/muted rules INHERIT,
+ * so every team name rendered as heading chrome. */
+.fxgroup { margin-top: 26px; }
+.fxgroup:first-of-type { margin-top: 10px; }
+.fxgroup > .gh {
+  display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
+  padding-bottom: 7px; border-bottom: 1px solid var(--div);
+}
+.fxgroup > .gh .nm { font-size: 14px; font-weight: 700; color: var(--ink); }
+
+/* HEADING LINK — a section heading that leads to the thing the section is about
+   (docs/site_architecture.md §3 "Navigation", the header+row rule; GitLab #52).
+   THE CHEVRON IS PRESENT AT REST. That is the whole point: the reader knows it is a link before
+   touching it, which underline-on-hover never told them — and on a phone there is no hover at all,
+   so a hover-only affordance does not exist for most readers.
+   Class name `cnm` is the interaction standard's own, kept so the eventual full port of
+   INTERACTION_CSS under #52 lands without renaming this. */
+/* The padding/negative-margin pair grows the TAP TARGET without moving the text: measured at
+   375px the link was 100x21, and 21px is under the 24x24 CSS-px minimum (WCAG 2.5.8) and far
+   under a comfortable thumb target, while the match row beside it is 81px tall. The margin
+   cancels the padding so the heading sits exactly where the design put it.
+   ⚠ ASYMMETRIC, and the asymmetry is measured, not aesthetic. `.fx a:focus-visible` draws its ring
+   from the BORDER-box this padding moves (outline-offset 2px + width 2px = 4px beyond the edge).
+   A symmetric 6px/6px put the ring's bottom at y=168.2 against `.gh`'s divider at y=165.8 — a
+   2.3px overshoot straight through the line — while leaving 16px unused above. 9px/3px keeps the
+   33px target and spends it where the room actually is.
+   ⭐ The 3px is DERIVED, not tuned: 3px padding + the ring's 4px reach = 7px = `.gh`'s own
+   padding-bottom, so the ring lands exactly on the divider's inner edge and not a pixel past it.
+   That is the largest downward growth available. If `.gh`'s padding-bottom changes, this must
+   change with it — measured clearance today is 0.7px, which is the sub-pixel border, not slack. */
+a.cnm {
+  display: inline-flex; align-items: center; gap: 6px; min-width: 0;
+  padding-block: 9px 3px; margin-block: -9px -3px;
+}
+.chev {
+  width: 15px; height: 15px; flex: 0 0 auto; color: var(--muted);
+  transition: transform .12s ease, color .12s ease;
+}
+/* Rest/hover/active stay on the NEUTRAL ramp; --accent is reserved for "better value" by the
+   colour contract above. The focus ring is the one exception and .fx a:focus-visible already
+   covers this link sitewide. */
+@media (hover: hover) {
+  a.cnm:hover .chev { color: var(--ink-2); transform: translateX(2px); }
+  a.cnm:hover .nm { color: var(--ink); }
+}
+a.cnm:active .chev { color: var(--ink); }
+/* Never underlined: the heading's own shape and its chevron are the signal. */
+a.cnm .nm { text-decoration: none; }
+@media (prefers-reduced-motion: reduce) { .chev { transition: none; } }
+.fxrow {
+  display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 16px;
+  padding: 12px 0; border-bottom: 1px solid var(--line);
+}
+.fxrow:last-child { border-bottom: 0; }
+.fxrow .sides { display: grid; gap: 8px; min-width: 0; }
+.fxrow .side { display: flex; align-items: center; gap: 10px; min-width: 0; }
+.fxrow .side .nm {
+  font-size: 15px; color: var(--ink); min-width: 0;
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.fxrow .when { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
+.fxrow .when .t { display: block; font-size: 16px; font-weight: 700; color: var(--ink); }
+.fxrow .when .d { font-size: 12px; color: var(--muted); }
+/* THE FOLD — a competition's rows past the third sit in a native <details>; the summary is the
+   "show all" control and reads as one more row (same divider, same height rhythm), with the
+   heading's chevron turned down once open. No script: the element does the toggling. */
+.fxmore > summary {
+  display: flex; align-items: center; justify-content: space-between; gap: 12px;
+  padding: 12px 0; cursor: pointer; list-style: none;
+  font-size: 13px; font-weight: 600; color: var(--ink-2);
+}
+.fxmore > summary::-webkit-details-marker { display: none; }
+.fxmore > summary .chev { transform: rotate(90deg); }
+.fxmore[open] > summary .chev { transform: rotate(-90deg); }
+.fxmore > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 6px; }
+.fxmore > .fxrow:first-of-type { border-top: 1px solid var(--line); }
+.fxmore > .fxrow:last-child { border-bottom: 0; }
+/* Small crest for list rows. The base .crest is a 52px block built for the fixture masthead. */
+.crest.xs { width: 24px; height: 24px; border-radius: 4px; font-size: 9px; flex: 0 0 auto; }
+
+/* ============================================================ *
+ *  RANKED BOARD — the Home page's Top players (#40) and, when   *
+ *  it lands, Top teams (#41). ONE metric per board, so there is  *
+ *  no column-header row: the board title is the only label the   *
+ *  number carries. Transcribed from the approved mock            *
+ *  (design-mocks/gen_top_players.py), which is #40's rendering.  *
+ * ============================================================ */
+
+/* Each board is its OWN container, so every measurement below resolves against the BOARD's width
+   and not the page's. Sizing to the page is what broke when the content column was capped
+   narrower than the viewport. */
+.board { margin-top: 26px; container-type: inline-size; }
+.board:first-of-type { margin-top: 10px; }
+
+/* The board head mirrors .fxgroup > .gh, which Next matches already uses on this page, so the two
+   blocks read as siblings rather than introducing a per-page treatment. */
+.bhd { padding-bottom: 7px; border-bottom: 1px solid var(--div); }
+.bt { font-size: 14px; font-weight: 700; color: var(--ink); }
+
+/* ⚠ The track list is written out WHOLE and read with a single var() as the ENTIRE value:
+   `repeat(var(--n), …)` is invalid CSS, because the repeat count must be a literal integer and a
+   custom property there silently invalidates the whole grid-template-columns declaration.
+   ⚠ The value column is a FIXED width, never auto: auto would let a 3-digit value size its track
+   differently from a 2-digit one, so the numbers would stop aligning down the board. */
+.bgrid { --vw: 64px; --gap: 12px; --cols: 18px 24px minmax(0, 1fr) var(--vw); }
+@container (max-width: 430px) { .bgrid { --vw: 56px; --gap: 10px; } }
+
+.brow {
+  display: grid; grid-template-columns: var(--cols);
+  align-items: center; gap: var(--gap);
+  padding: 10px 0; border-bottom: 1px solid var(--line);
+}
+.brow:last-child { border-bottom: 0; }
+.brow .rk { font-size: 12px; font-weight: 700; color: var(--muted); text-align: right; }
+
+/* ONE LINE IF IT FITS, STACKED IF NOT — decided PER BOARD, never per row ("they all stack
+   together or not"). flex-wrap decides it per ROW, which rendered one board with rows
+   1/5/6 inline and 2/3/4/7 stacked: right for each row, ragged as a block. CSS cannot ask whether
+   a SIBLING wrapped, so the trigger must be something every row shares — the board's own width.
+   `nowrap` is what enforces it: without it one over-long row could still wrap alone. */
+.brow .ent { min-width: 0; display: flex; flex-wrap: nowrap; align-items: baseline; column-gap: 8px; }
+@container (max-width: 480px) {
+  /* ⚠ Blockify the CHILDREN, not just the container: .nm/.sub carry no `display` of their own
+     (flex blockifies them in the branch above), so setting only `.ent { display: block }` leaves
+     two INLINE spans that run together — "Bayern MünchenBundesliga". */
+  .brow .ent { display: block; }
+  .board .nm,
+  .board .sub { display: block; }
+  .board .sub { margin-top: 1px; }
+}
+
+/* ⚠ THE NAME MUST NEVER TRUNCATE. `.fxrow .side .nm` ellipsises, which is right on a fixture card
+   and wrong here: a clipped name defeats a block whose whole purpose is to send people to the
+   player's page. The name wraps and the row grows. `min-width: 0` matters — a flex item refuses to
+   shrink below its min-content width, so without it a long name widens the row instead of
+   wrapping inside it. */
+.board .nm {
+  min-width: 0; font-size: 14px; font-weight: 600; color: var(--ink);
+  white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: break-word;
+  line-height: 1.25;
+}
+.board .sub { min-width: 0; font-size: 11.5px; color: var(--muted); overflow-wrap: break-word; }
+/* Right-aligned, matching .pstat. */
+.brow .v { font-size: 15px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
+.brow .v b { color: var(--ink); font-weight: 700; }
+
+/* ROW TARGET (site_architecture.md §3 "Navigation"): the whole row is the link, so the whole row
+   responds — never the name inside it. ⚠ The mock underlined .nm on hover; that predates the
+   navigation rule and is deliberately NOT carried, because it points the affordance at a word
+   inside a target that is the entire row. Neutral ramp only; --accent is reserved. */
+a.brow { border-radius: 9px; margin-inline: -12px; padding-inline: 12px; }
+a.brow .nm { text-decoration: none; }
+/* THE ROW-LINK RULE, site-wide: a row that leads somewhere is ONE link, the whole row, and it
+   lights on hover; an underline is for a word inside text, never for a name inside a row. One
+   selector list for every row link the site has, so a new surface joins it rather than restyling it. */
+@media (hover: hover) {
+  a.brow:hover, a.comp-row:hover, a.fxrow:hover, a.ctab-row:hover, a.frow:hover { background: var(--surface); }
+}
+a.brow:active, a.comp-row:active, a.fxrow:active, a.ctab-row:active, a.frow:active { background: var(--sunk); }
+a.fxrow, a.ctab-row, a.frow { border-radius: 9px; margin-inline: -12px; padding-inline: 12px; color: inherit; text-decoration: none; }
+a.fxrow:focus-visible, a.ctab-row:focus-visible, a.frow:focus-visible { outline-offset: -2px; }
+/* ⚠ THE RING IS DRAWN INSIDE, and the reason is measured, not stylistic — same defect class as
+   `a.cnm` above. `.fx a:focus-visible` draws `outline: 2px solid` at `outline-offset: 2px`, so it
+   reaches 4px BEYOND the border box; a `.brow`'s border-box bottom IS the divider, and the next row
+   sits flush against it. Measured at 375px, focusing row 3 of the Goals board: the ring spanned
+   y=373.5..438.3 against dividers at 377.5 and 434.3 — 4px straight through the line at BOTH ends
+   and into both neighbouring rows. An earlier version shipped exactly this, invisible at desktop width.
+   ⭐ A negative offset rather than padding, and that is DERIVED: `a.cnm` could spend room outward
+   because it had unused space around it, and a row has none — its neighbour is flush, and giving it
+   padding would move the divider it is measured against. So the ring goes inward instead. At -2px
+   the outline occupies 2px to 4px INSIDE the border box, which cannot reach either divider at any
+   row height, so this does not have to be re-derived when a name wraps and the row grows. */
+a.brow:focus-visible { outline-offset: -2px; }
+
+/* Competitions index (#62 step 5, GitLab #54). Two independent single-select filter axes reuse
+   the shared .seg-in/.seg-btn radio pattern; each hides ROWS that don't match the active value
+   via a plain sibling selector. The "all" state of each group has no rule (nothing hides), so
+   the two axes combine for free — no compound selector needed at the row level. Category-level
+   empty-state collapse (a category left with zero rows after BOTH axes apply) needs the two
+   states combined and is handled in the component's small inline script instead; see its comment. */
+/* .seg is shared with the fixture page's W1/W2 toggle (2 short, equal-width labels, never wraps).
+   The region filter has 8 labels of very different lengths ("All" vs "North & Central America")
+   and genuinely overflows at mobile widths without wrapping (measured: scrollWidth 645 vs
+   clientWidth 375 at the 375px preset, #62 step 5). .wrap opts a specific .seg instance
+   into wrapping and lets each button size to its own content instead of sharing width equally —
+   equal-width made no sense once labels stopped being similar lengths. Entity filter (3 short,
+   similar-length labels) stays on the plain .seg behaviour. */
+.seg.wrap { flex-wrap: wrap; }
+.seg.wrap .seg-btn { flex: 0 1 auto; }
+
+.comp-category { margin-bottom: 4px; }
+.comp-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
+  gap: 8px;
+  margin-top: 6px;
+}
+.comp-row {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  padding: 8px 4px;
+  min-width: 0;
+}
+.comp-meta { display: block; min-width: 0; }
+.comp-name {
+  display: block; font-size: 14px; font-weight: 600; color: var(--ink);
+  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
+}
+.comp-region { display: block; font-size: 12px; color: var(--muted); margin-top: 1px; }
+/* The row is a link: hover and active come from the shared row-link rule above `a.brow`; the ring
+   is drawn inside for the same reason (the grid gap is 8px; a 4px outward ring would touch the
+   neighbour). */
+a.comp-row { border-radius: 9px; }
+a.comp-row:focus-visible { outline-offset: -2px; }
+
+#filter-entity-club:checked ~ .categories [data-entity-type="national"] { display: none; }
+#filter-entity-national:checked ~ .categories [data-entity-type="club"] { display: none; }
+#filter-region-uefa:checked ~ .categories [data-confederation]:not([data-confederation="UEFA"]) { display: none; }
+#filter-region-conmebol:checked ~ .categories [data-confederation]:not([data-confederation="CONMEBOL"]) { display: none; }
+#filter-region-concacaf:checked ~ .categories [data-confederation]:not([data-confederation="CONCACAF"]) { display: none; }
+#filter-region-caf:checked ~ .categories [data-confederation]:not([data-confederation="CAF"]) { display: none; }
+#filter-region-afc:checked ~ .categories [data-confederation]:not([data-confederation="AFC"]) { display: none; }
+#filter-region-ofc:checked ~ .categories [data-confederation]:not([data-confederation="OFC"]) { display: none; }
+#filter-region-fifa:checked ~ .categories [data-confederation]:not([data-confederation="FIFA"]) { display: none; }
+
+#filter-entity-all:checked ~ .seg .seg-btn[for="filter-entity-all"],
+#filter-entity-club:checked ~ .seg .seg-btn[for="filter-entity-club"],
+#filter-entity-national:checked ~ .seg .seg-btn[for="filter-entity-national"],
+#filter-region-all:checked ~ .seg .seg-btn[for="filter-region-all"],
+#filter-region-uefa:checked ~ .seg .seg-btn[for="filter-region-uefa"],
+#filter-region-conmebol:checked ~ .seg .seg-btn[for="filter-region-conmebol"],
+#filter-region-concacaf:checked ~ .seg .seg-btn[for="filter-region-concacaf"],
+#filter-region-caf:checked ~ .seg .seg-btn[for="filter-region-caf"],
+#filter-region-afc:checked ~ .seg .seg-btn[for="filter-region-afc"],
+#filter-region-ofc:checked ~ .seg .seg-btn[for="filter-region-ofc"],
+#filter-region-fifa:checked ~ .seg .seg-btn[for="filter-region-fifa"] {
+  background: var(--surface); color: var(--ink); font-weight: 700; box-shadow: 0 1px 3px rgba(0, 0, 0, .25);
+}
+
+/* ---- competition page ---- */
+/* The tab bar as links to standalone pages: the active tab is marked by class, not by a radio,
+   and a tab whose page is not built yet is a label without a link. */
+.comp-tabs .tab.on { color: var(--ink); font-weight: 700; border-bottom-color: var(--ink); }
+.comp-tabs .tab[aria-disabled="true"] { cursor: default; }
+.comp-tabs .tab[aria-disabled="true"]:hover { color: var(--muted); }
+
+/* The standings table. A grid, not a <table>: the heading and every row are one grid each, so the
+   track list is FIXED per breakpoint and shared — self-sizing tracks size per grid and let the
+   heading drift off the numbers. Narrow hides W, D, L and Goals (zero-width tracks, the cells
+   display:none); the crest and the name never hide. Every cell is pinned to its own track so a
+   hidden cell leaves its empty track behind instead of shifting the cells after it. */
+.ctab-section { margin-top: 10px; }
+.ctab-section + .ctab-section { margin-top: 22px; }
+.ctab-section > .gh { padding-bottom: 7px; border-bottom: 1px solid var(--div); }
+.ctab-section > .gh .nm { font-size: 14px; font-weight: 700; color: var(--ink); }
+.ctab { margin-top: 4px; --cols: 2rem minmax(0, 1fr) 2.3rem 0 0 0 0 2.8rem 2.6rem; }
+.ctab-head, .ctab-row { display: grid; grid-template-columns: var(--cols); align-items: center; column-gap: 0; }
+.ctab .n, .ctab .h { padding-left: 8px; }
+.ctab-head { padding-bottom: 8px; border-bottom: 1px solid var(--div); }
+.ctab-row { padding: 9px 0; border-bottom: 1px solid var(--line); }
+.ctab-row:last-child { border-bottom: 0; }
+.ctab-row:nth-child(odd) { background: color-mix(in srgb, var(--ink) 5%, transparent); }
+.ctab-head > :nth-child(1), .ctab-row > :nth-child(1) { grid-column: 1; }
+.ctab-head > :nth-child(2), .ctab-row > :nth-child(2) { grid-column: 2; }
+.ctab-head > :nth-child(3), .ctab-row > :nth-child(3) { grid-column: 3; }
+.ctab-head > :nth-child(4), .ctab-row > :nth-child(4) { grid-column: 4; }
+.ctab-head > :nth-child(5), .ctab-row > :nth-child(5) { grid-column: 5; }
+.ctab-head > :nth-child(6), .ctab-row > :nth-child(6) { grid-column: 6; }
+.ctab-head > :nth-child(7), .ctab-row > :nth-child(7) { grid-column: 7; }
+.ctab-head > :nth-child(8), .ctab-row > :nth-child(8) { grid-column: 8; }
+.ctab-head > :nth-child(9), .ctab-row > :nth-child(9) { grid-column: 9; }
+.ctab .wdl { display: none; }
+@container (min-width: 470px) {
+  .ctab { --cols: 2rem minmax(0, 1fr) 2.3rem 2.3rem 2.3rem 2.3rem 3.9rem 2.8rem 2.6rem; }
+  .ctab .wdl { display: block; }
+}
+.ctab .h { font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--muted); text-align: right; }
+.ctab .rk { font-size: 12px; font-weight: 700; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; padding-right: 8px; }
+.ctab .h.rk { text-align: right; }
+.ctab .n { font-size: 13px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
+/* the number that matters on a league table: points, in the accent */
+.ctab .n.pts { font-size: 15px; font-weight: 700; color: var(--accent); }
+.ctab .n.gd { color: var(--ink-2); }
+.ctab .tm { display: flex; align-items: center; gap: 9px; min-width: 0; }
+/* the name never truncates: system.css ellipsises .nm elsewhere, a table row wraps instead */
+.ctab .tm .nm { min-width: 0; font-size: 14px; font-weight: 600; color: var(--ink); white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: break-word; line-height: 1.25; }
+
+/* The deserved-points boards: the table's rows with three numbers, club · Deserved · Pts · Diff;
+   the bold sits on Diff, the number the board is ordered by. */
+.bsub { margin: 2px 0 8px; font-size: 13px; line-height: 1.45; color: var(--muted); }
+.ctab.dp, .ctab.dp.ctab { --cols: minmax(0, 1fr) 4.2rem 2.8rem 3.4rem; }
+.ctab.dp .n.pts { color: var(--ink); }
+
+/* The fact row: label · value · context. Wide: the label left, value and context right-aligned;
+   a phone stacks the three, left-aligned. Only the value is weighted. */
+.facts { margin-top: 4px; container-type: inline-size; }
+.frow { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 14px; align-items: start; padding: 9px 0; border-bottom: 1px solid var(--line); color: inherit; }
+.frow:last-child { border-bottom: 0; }
+.frow .fl { font-size: 14px; color: var(--ink); line-height: 20px; }
+.frow .fv { min-width: 0; display: flex; flex-direction: column; gap: 1px; text-align: right; }
+.frow .fvv { font-size: 14px; color: var(--ink); font-variant-numeric: tabular-nums; line-height: 20px; }
+.frow .fvv b { font-weight: 600; }
+.frow .sub { font-size: 12px; color: var(--muted); }
+.nb { white-space: nowrap; }
+@container (max-width: 420px) {
+  .frow { grid-template-columns: minmax(0, 1fr); gap: 2px; }
+  .frow .fv { text-align: left; }
+}
+
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
