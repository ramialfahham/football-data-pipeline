+++ b/site_v2/src/components/competition/StandingsTable.astro
@@ -0,0 +1,70 @@
+---
+// The competition's table: one grid per standings section, every value the provider's official
+// row as published (mart_standings). Columns # · crest · club · P · W · D · L · Goals · GD · Pts;
+// the whole row is the link to the team page. The heading and the rows share one fixed track
+// list per breakpoint, so a heading can never sit off its numbers; W, D, L and Goals hide on a
+// narrow phone. The provider's cross-group ranking tables are not sections here.
+import Crest from "../ui/Crest.astro";
+import SectionHead from "../ui/SectionHead.astro";
+import { integer, signedInteger } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { localeHref } from "../../lib/href";
+import { standingsSections } from "../../lib/competitionPayload.mjs";
+import type { StandingRow } from "../../lib/types";
+
+interface Props {
+  standings: StandingRow[];
+  lang: Lang;
+}
+const { standings, lang } = Astro.props;
+const sections = standingsSections(standings);
+const showSectionNames = sections.length > 1;
+---
+
+{sections.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "compSecTable")} />
+    {sections.map((sec) => (
+      <div class="ctab-section">
+        {showSectionNames && <div class="gh"><span class="nm">{sec.name}</span></div>}
+        <div class="ctab">
+          <div class="ctab-head">
+            <span class="h rk">{t(lang, "compColPos")}</span>
+            <span class="h nmh"></span>
