+      "i18n_keys": ["compSecTeamRankings", "compFewestFirst", "perMatch"]
+    },
+    {
+      "block": "Player rankings",
+      "mart": "mart_leaderboards",
+      "i18n_keys": ["compSecPlayerRankings", "compFewestFirst"]
+    }
+  ]
+}
