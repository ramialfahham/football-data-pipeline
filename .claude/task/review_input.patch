diff --git a/site_v2/src/pages/[lang]/competitions/index.astro b/site_v2/src/pages/[lang]/competitions/index.astro
new file mode 100644
index 0000000..0dd8601
--- /dev/null
+++ b/site_v2/src/pages/[lang]/competitions/index.astro
@@ -0,0 +1,60 @@
+---
+// Competitions index (#62 step 5, GitLab #54, spec: docs/wireframes/08_browse.md). Reads the
+// committed competition_index.json (mart_competition_index verbatim, #62 step 3+4) and composes
+// the one block a single-page-per-locale index needs. The page holds no styling and derives no
+// facts — grouping and ordering are lib/competitionOrder.mjs, rendering is
+// CompetitionIndexGrid.astro.
+//
+// H1 and the breadcrumb's own segment both reuse navCompetitions rather than a separate key
+// (#54: "the H1 deliberately reuses the NAV item's key, so the menu and the page it leads to
+// cannot drift apart").
+import Layout from "../../../layouts/Layout.astro";
+import CompetitionIndexGrid from "../../../components/competitions/CompetitionIndexGrid.astro";
+import { t } from "../../../i18n/strings";
+import { localeHref } from "../../../lib/href";
+import type { Lang } from "../../../lib/format";
+import type { CompetitionIndex } from "../../../lib/types";
+import competitionIndex from "../../../data/competition_index.json";
+
+export function getStaticPaths() {
+  return [
+    { params: { lang: "de" } },
+    { params: { lang: "en" } },
+    { params: { lang: "fi" } },
+  ];
+}
+
+const lang = (Astro.params.lang ?? "en") as Lang;
+const data = competitionIndex as unknown as CompetitionIndex;
+
+const title = t(lang, "seoCompetitionsTitle");
+const description = t(lang, "seoCompetitionsDesc");
+
+// schema.org/ItemList (page-spec: schema_org). Format only per page-spec.schema.json's own
+// note — itemListElement is not populated: rows carry no URL yet (see the component's comment
+// on why they're inert), so a list of hrefs would point nowhere.
+const entity = {
+  "@type": "ItemList",
+  name: title,
+  numberOfItems: data.competitions.length,
+};
+
+const crumbs = [
+  { name: t(lang, "crumbHome"), href: localeHref(lang) },
+  { name: t(lang, "navCompetitions") },
+];
+---
+
+<Layout lang={lang} title={title} description={description} entity={entity} crumbs={crumbs}>
+  <div class="inner">
+    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
+      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
+      <span class="sep">›</span>
+      <span class="here">{t(lang, "navCompetitions")}</span>
+    </nav>
+
+    <h1>{t(lang, "navCompetitions")}</h1>
+
+    <CompetitionIndexGrid competitions={data.competitions} lang={lang} />
+  </div>
+</Layout>
