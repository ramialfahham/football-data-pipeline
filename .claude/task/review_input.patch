+version: 2
+
+models:
+  - name: int_momentum_window__team
+    description: >
+      W1 last-5 momentum-window selection — team. One row per (upcoming fixture side, window
+      leg): the team's last 5 finished matches before the upcoming fixture, cross-
+      competition within the same entity_type, season_api_year-capped for clubs and
+      recency-only for national teams. Extracted from int_momentum__team (#323) so the
+      momentum aggregate and the drill-down list mart consume the same selection.
+      Grain: (upcoming_fixture_sk, team_sk, leg_fixture_sk).
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [upcoming_fixture_sk, team_sk, leg_fixture_sk]
+      - dbt_utils.expression_is_true:
+          expression: "recency_rank between 1 and 5"
+          name: momentum_window_team_recency_rank_in_range
+    columns:
+      - name: upcoming_fixture_sk
+        tests: [not_null]
+      - name: team_sk
+        tests: [not_null]
+      - name: leg_fixture_sk
+        description: "The past match this row describes; click-through key for the drill-down."
+        tests: [not_null]
+      - name: recency_rank
+        description: "1 = most recent of the window legs."
+        tests: [not_null]
+      - name: entity_type
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["club", "national"]
+      - name: result
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["W", "D", "L"]
