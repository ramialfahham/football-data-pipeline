@@ -0,0 +1,33 @@
+---
+// Season record: rank · points + form pills; a played/W-D-L · goals · GD line; clean
+// sheets. Single team → no comparison green; form pills carry the reserved W/D/L status
+// colour (form string is standings-derived, this competition). All served facts.
+import { integer, signedInteger } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import type { TeamSeason } from "../../lib/team";
+
+interface Props {
+  season: TeamSeason;
+  lang: Lang;
+}
+const { season: s, lang } = Astro.props;
+const formResults = (s.latest_form ?? "").split("").filter((c) => "WDL".includes(c));
+---
+
+<div class="record">
+  <div class="top">
+    <div class="headline num">
+      {s.latest_rank != null && <>#<b>{integer(s.latest_rank, lang)}</b> · </>}<b>{integer(s.points, lang)}</b> {t(lang, "pts")}
+    </div>
+    {formResults.length > 0 && (
+      <div class="pills">{formResults.map((r) => <span class:list={["pill", r]}>{r}</span>)}</div>
+    )}
+  </div>
+  <div class="line">
+    <b>{integer(s.played, lang)}</b> {t(lang, "teamPlayed")} · <b>{integer(s.wins, lang)}</b>W <b>{integer(s.draws, lang)}</b>D <b>{integer(s.losses, lang)}</b>L · <b>{integer(s.goals_for, lang)}</b>:<b>{integer(s.goals_against, lang)}</b> · <b>{signedInteger(s.goal_diff, lang)}</b>
+  </div>
+  {s.clean_sheets != null && (
+    <div class="line">{t(lang, "cleanSheetsLabel")}: <b>{integer(s.clean_sheets, lang)}</b></div>
+  )}
+</div>
diff --git a/site_v2/src/components/team/SeasonStats.astro b/site_v2/src/components/team/SeasonStats.astro
new file mode 100644
index 0000000..0943a33
--- /dev/null
+++ b/site_v2/src/components/team/SeasonStats.astro
@@ -0,0 +1,32 @@
+---
+// The LOCKED 16-row team table, single-value (one team's season). Same groups + order
+// as the fixture comparison (metricRows.ts); a row missing on the season row is hidden.
+import StatRow from "./StatRow.astro";
+import SectionHead from "../ui/SectionHead.astro";
+import { GROUP_ORDER, METRIC_ROWS } from "../../lib/metricRows";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import type { TeamSeason } from "../../lib/team";
+
+interface Props {
+  season: TeamSeason;
+  lang: Lang;
+}
+const { season, lang } = Astro.props;
+// Render the full LOCKED 16-row table; StatRow shows "–" for any metric the season row
+// lacks (honest absence, wireframe 02 §6) — a single-value row is never hidden.
+const groups = GROUP_ORDER.map((group) => ({
+  group,
+  rows: METRIC_ROWS.filter((r) => r.group === group),
+}));
+---
+
+<section aria-label={t(lang, "secSeasonMetrics")}>
+  <SectionHead label={t(lang, "secSeasonMetrics")} />
+  {groups.map(({ group, rows }) => (
+    <>
+      <div class="mgroup">{group}</div>
+      {rows.map((def) => <StatRow def={def} season={season} lang={lang} />)}
+    </>
+  ))}
+</section>
diff --git a/site_v2/src/components/team/StatRow.astro b/site_v2/src/components/team/StatRow.astro
new file mode 100644
index 0000000..2bbc0f7
--- /dev/null
+++ b/site_v2/src/components/team/StatRow.astro
@@ -0,0 +1,31 @@
+---
+// One single-value season-metric row (label + value). Single team → no bar, no green.
+// Same locked labels/formats as the fixture comparison (metricRows.ts); clean sheets
+// renders as count_fraction over games played. Null → "–" (never a fabricated 0).
+import { formatValue, countFraction, DASH } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { asNumber } from "../../lib/types";
+import type { MetricRowDef } from "../../lib/metricRows";
+import type { TeamSeason } from "../../lib/team";
+
+interface Props {
+  def: MetricRowDef;
+  season: TeamSeason;
+  lang: Lang;
+}
+const { def, season, lang } = Astro.props;
+const row = season as unknown as Record<string, unknown>;
+const v = asNumber(row[def.field]);
+
+let display: string;
+if (def.format === "count_fraction") {
+  display = countFraction(v, asNumber(row["played"]), lang); // season clean sheets: count of games played
+} else {
+  display = v == null ? DASH : formatValue(v, def.format, lang);
+}
+---
+
+<div class="srow">
+  <div class="lbl">{def.label}{def.sublabel && <small>{def.sublabel}</small>}</div>
+  <div class="val">{display}</div>
+</div>
diff --git a/site_v2/src/components/team/Streaks.astro b/site_v2/src/components/team/Streaks.astro
new file mode 100644
index 0000000..4a22c7a
--- /dev/null
+++ b/site_v2/src/components/team/Streaks.astro
@@ -0,0 +1,38 @@
+---
+// Active streak chips — trailing runs ≥ 2 only (positive first; winless is a negative
+// signal, styled red). All runs < 2 → the whole section is omitted. The chip bolds the
+// count (rung-1 number) by splitting the i18n template on {n}.
+import SectionHead from "../ui/SectionHead.astro";
+import { integer } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import type { TeamSeason } from "../../lib/team";
+
+interface Props {
+  season: TeamSeason;
+  lang: Lang;
+}
+const { season: s, lang } = Astro.props;
+
+const chips = [
+  { n: s.unbeaten_run, key: "streakUnbeaten", neg: false },
+  { n: s.win_run, key: "streakWins", neg: false },
+  { n: s.clean_sheet_run, key: "streakCleanSheets", neg: false },
+  { n: s.scoring_run, key: "streakScoring", neg: false },
+  { n: s.winless_run, key: "streakWinless", neg: true },
+].filter((c) => (c.n ?? 0) >= 2);
+---
+
+{chips.length > 0 && (
+  <section aria-label={t(lang, "secStreaks")}>
+    <SectionHead label={t(lang, "secStreaks")} />
+    <div class="streaks">
+      {chips.map((c) => {
+        const [before, after] = t(lang, c.key).split("{n}");
+        return (
+          <span class:list={["streak", { neg: c.neg }]}>{before}<b>{integer(c.n, lang)}</b>{after}</span>
+        );
+      })}
+    </div>
+  </section>
+)}
