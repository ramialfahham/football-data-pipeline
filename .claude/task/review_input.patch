@@ -1074,6 +1073,10 @@ deploy:site-v2:
     # .gcp_auth is pure shell (printf/cat), so it works on the Node image too —
     # firebase-tools reads GOOGLE_APPLICATION_CREDENTIALS like any Google client.
     - *gcp_auth
+    # This checkout holds the committed sample, the MR build's input; the deployed
+    # site is built from the export alone, so the sample leaves the folder first.
+    - find site_v2/src/data -mindepth 1 ! -name README.md -delete
+    - cp -R site_v2/export_data/. site_v2/src/data/
     - cd site_v2
     - npm ci --cache "$CI_PROJECT_DIR/.npm" --prefer-offline
     # The full ~15k-page build OOMs at the default heap (#818 proved this setting).
