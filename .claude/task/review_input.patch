+def _fake_git(files_by_sha: dict[str, list[str]]):
+    """Stand in for `report_process_health._git`, dispatching on the subcommand."""
+    def run(*args: str) -> str:
+        if args[0] == "log":
+            return "\n".join(files_by_sha) + "\n"
+        if args[0] == "diff-tree":
