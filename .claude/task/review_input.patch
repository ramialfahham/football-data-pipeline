+-+@@ -0,0 +1,45 @@
+-++---
+-++// Team identity header (mock f6348775 .thead): crest + name + meta (country ·
+-++// venue, city · founded) + a static competition-season selector. The selector is
+-++// chrome this increment — the interactive multi-season swap is deferred (#362).
+-++// Competition display name comes from the registry-derived competitions map (the
+-++// frontend never generates a slug/name). Facts are all served; no derivation.
+-++import Crest from "../ui/Crest.astro";
+-++import type { Lang } from "../../lib/format";
+-++import { t } from "../../i18n/strings";
+-++import type { Team, TeamSeason } from "../../lib/types";
+-++import competitions from "../../data/competitions.json";
+-++
+-++interface Props {
+-++  team: Team;
+-++  season: TeamSeason;
+-++  lang: Lang;
+-++}
+-++const { team, season, lang } = Astro.props;
+-++
+-++const comp = (competitions as Record<string, { slug: string; name?: string }>)[season.league_code];
+-++const compName = comp?.name ?? season.league_code;
+-++// Season-span label (2024 -> "2024/25"): a display format of the season year, like a
+-++// date format — not an identifier the frontend derives.
+-++const y = season.season_api_year;
+-++const seasonLabel = `${y}/${String((y + 1) % 100).padStart(2, "0")}`;
+-++const hasVenue = Boolean(team.venue?.name);
+-++const hasFounded = team.founded_year != null;
+-++---
+-++
+-++<header class="thead">
+-++  <Crest name={team.name} crest={team.crest} />
+-++  <div class="tid">
+-++    <h1>{team.name}</h1>
+-++    <div class="meta">
+-++      {team.country}
+-++      {hasVenue && (
+-++        <>{team.country && " · "}<b>{team.venue?.name}</b>{team.venue?.city ? `, ${team.venue.city}` : ""}</>
+-++      )}
+-++      {hasFounded && (
+-++        <>{(team.country || hasVenue) && " · "}{`${t(lang, "founded")} ${team.founded_year}`}</>
+-++      )}
+-++    </div>
+-++    <div class="selector">{compName} <span class="yr">{seasonLabel}</span> <span class="chev">▼</span></div>
+-++  </div>
+-++</header>
+-+diff --git a/site_v2/src/components/team/YearOverYear.astro b/site_v2/src/components/team/YearOverYear.astro
+-+new file mode 100644
+-+index 0000000..018c442
+-+--- /dev/null
+-++++ b/site_v2/src/components/team/YearOverYear.astro
+-+@@ -0,0 +1,52 @@
+-++---
+-++// "Vs last season" (mock f6348775 .yoygrid): the games-aligned year-over-year set
+-++// for points / goals / goals against — current value + signed delta. The delta's
+-++// green (.up) is the locked design's direction-aware encoding of "better" (see
+-++// lib/bars.ts rationale: presentation, not a fact) — up for more points/goals, up
+-++// for FEWER goals against. Domestic-only and games-aligned in the mart; when the
+-++// mart served no comparison (no prior season at this cutoff) it renders the honest
+-++// absent state. Rank has no served YoY delta, so it is not shown here (the record
+-++// strip carries the current rank).
+-++import SectionHead from "../ui/SectionHead.astro";
+-++import { integer, signedInteger } from "../../lib/format";
+-++import type { Lang } from "../../lib/format";
+-++import { t } from "../../i18n/strings";
+-++import { asNumber } from "../../lib/types";
+-++import type { TeamSeason } from "../../lib/types";
+-++
+-++interface Props {
+-++  season: TeamSeason;
+-++  lang: Lang;
+-++}
+-++const { season: s, lang } = Astro.props;
+-++
+-++const rows = [
+-++  { label: t(lang, "yoyPoints"), value: s.points_this_season, delta: s.points_delta_yoy, betterUp: true },
+-++  { label: t(lang, "yoyGoalsFor"), value: s.goals_for_this_season, delta: s.goals_for_delta_yoy, betterUp: true },
+-++  { label: t(lang, "yoyGoalsAgainst"), value: s.goals_against_this_season, delta: s.goals_against_delta_yoy, betterUp: false },
+-++];
+-++const hasYoY = rows.some((r) => asNumber(r.value) !== null || asNumber(r.delta) !== null);
+-++const cutoff = s.yoy_games_played_cutoff;
+-++const note = hasYoY && cutoff != null ? t(lang, "yoyThroughGames", { n: cutoff }) : null;
+-++---
+-++
+-++<section aria-label={t(lang, "secYoY")}>
+-++  <SectionHead label={t(lang, "secYoY")} note={note} />
+-++  {hasYoY ? (
+-++    <div class="yoygrid">
+-++      {rows.map((r) => {
+-++        const d = asNumber(r.delta);
+-++        const better = d !== null && d !== 0 && (r.betterUp ? d > 0 : d < 0);
+-++        return (
+-++          <div class="yrow">
+-++            <span class="yl">{r.label}</span>
+-++            <span class="yn num">{integer(r.value, lang)}</span>
+-++            <span class:list={["yd", "num", { up: better }]}>{signedInteger(r.delta, lang)}</span>
+-++          </div>
+-++        );
+-++      })}
+-++    </div>
+-++  ) : (
+-++    <p class="pagecap">{t(lang, "noYoY")}</p>
+-++  )}
+-++</section>
