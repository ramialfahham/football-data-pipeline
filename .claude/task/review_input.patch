+    pathspec = ["--", "."] + [f":(exclude){p}" for p in excludes]
+    diff = subprocess.run(
+        ["git", "diff", "--no-renames", "--no-abbrev", f"{base}...HEAD"] + pathspec,
+        cwd=repo, capture_output=True,
+    ).stdout
+    return hashlib.sha256(diff).hexdigest()
