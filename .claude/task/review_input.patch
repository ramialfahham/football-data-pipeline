diff --git a/dbt_project/seeds/schema.yml b/dbt_project/seeds/schema.yml
index 2ccee1eb..a7dd5031 100644
--- a/dbt_project/seeds/schema.yml
+++ b/dbt_project/seeds/schema.yml
@@ -542,7 +542,7 @@ seeds:
       per match, each naming its source. Applied in base_apif__fixtures_next, which keeps the
       provider's score and status next to it. assert_result_corrections_applied fails when a row
       is not applied, its source is not valid, its award kind or score on the pitch does not fit
-      its award, or it no longer changes anything.
+      its award, or a row that is no award no longer changes anything.
     config:
       column_types:
         fixture_id: int64
@@ -593,6 +593,82 @@ seeds:
         description: "The match and the official decision, in words."
         tests: [not_null]
 
+  - name: fixture_goal_corrections
+    description: >
+      Every goal of a match whose provider goal events do not add up to its score, one row per goal,
+      researched and sourced; a match with no goal has one row at goal_order 0 and no goal fields.
+      Applied in base_apif__fixture_events: the match's goals are these, and
+      the provider's goal events stay beside them, not counted. assert_result_corrections_applied
+      fails when a match's rows are not applied, do not add up to its score, are not sourced, or
+      are no longer needed.
+    config:
+      column_types:
+        fixture_id: int64
+        goal_order: int64
+        team_id: int64
+        player_id: int64
+        player_name: string
+        minute_elapsed: int64
+        minute_extra: int64
+        event_detail: string
+        assist_player_id: int64
+        assist_player_name: string
+        source_kind: string
+        source: string
+        note: string
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [fixture_id, goal_order]
+    columns:
+      - name: fixture_id
+        description: "{{ doc('fixture_api_id') }}"
+        tests: [not_null]
+      - name: goal_order
+        description: "The goal's place in the match, 1 for its first goal; 0 on the one row of a match with no goal."
+        tests: [not_null]
+      - name: team_id
+        description: "{{ doc('team_api_id') }} Here it is the side the goal counts for, own goals included."
+        tests:
+          - not_null:
+              config:
+                where: "goal_order > 0"
+      - name: player_id
+        description: "The scorer's provider player id. NULL where the provider holds no id for the scorer."
+      - name: player_name
+        description: "The scorer's name as the source gives it."
+        tests:
+          - not_null:
+              config:
+                where: "goal_order > 0"
+      - name: minute_elapsed
+        description: "The minute of normal time the goal was scored in. NULL where no source gives it."
+      - name: minute_extra
+        description: "Minutes into added time, on top of minute_elapsed. NULL for a goal in normal play."
+      - name: event_detail
+        description: "Normal Goal, Penalty or Own Goal, as the provider's goal events name them."
