+.ctab.yoyt .tr.flat { color: var(--muted); }
+.yoyt-head { margin-top: 6px; }
+.tsw:not(:checked) ~ * .ctab.yoyt .ctab-row { background: transparent; }
+.tsw:not(:checked) ~ * .ctab.yoyt .ctab-row:nth-child(odd of :not(.nonkey)) { background: color-mix(in srgb, var(--ink) 5%, transparent); }
+
 @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
