-    min(if(not is_starter, lineup_order, null)) as first_substitute
-from {{ ref('fct_fixture_lineup') }}
+    max(lineup_order) as last_order
+from stepped
 group by fixture_sk, team_sk
 having
     min(lineup_order) != 1
     or max(lineup_order) != count(*)
     or count(distinct lineup_order) != count(*)
     or max(if(is_starter, lineup_order, null)) > min(if(not is_starter, lineup_order, null))
+    or max(if(came_on, lineup_order, null)) > min(if(stayed_on_bench, lineup_order, null))
+    or countif(came_on and minute_on_key < previous_minute_on_key) > 0
diff --git a/dbt_project/tests/assert_mart_head_to_head_meetings_are_fixtures.sql b/dbt_project/tests/assert_mart_head_to_head_meetings_are_fixtures.sql
new file mode 100644
index 00000000..1329bbd8
--- /dev/null
+++ b/dbt_project/tests/assert_mart_head_to_head_meetings_are_fixtures.sql
@@ -0,0 +1,14 @@
+-- Every meeting in mart_head_to_head's recent_meetings names a fixture of fct_fixture. Returns a
+-- row (= fails) per meeting whose fixture_api_id is missing or names no fixture.
+{{ config(store_failures = true) }}
+
+select
+    h.team_sk,
+    h.opponent_team_sk,
+    m.fixture_api_id,
+    m.kickoff_datetime
+from {{ ref('mart_head_to_head') }} as h
+cross join unnest(h.recent_meetings) as m
+left join {{ ref('fct_fixture') }} as f
+    on m.fixture_api_id = f.fixture_sk
+where f.fixture_sk is null
