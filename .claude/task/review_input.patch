diff --git a/dbt_project/seeds/schema.yml b/dbt_project/seeds/schema.yml
index 013ae3a2..aa494070 100644
--- a/dbt_project/seeds/schema.yml
+++ b/dbt_project/seeds/schema.yml
@@ -1488,6 +1488,79 @@ seeds:
         tests:
           - not_null
 
+  - name: player_id_overrides
+    description: >
+      One player the provider holds under two ids, one row per duplicate id, naming the id the
+      player keeps.
+    config:
+      column_types:
+        wrong_player_api_id: int64
+        correct_player_api_id: int64
+        mode: string
+        note: string
+    columns:
+      - name: wrong_player_api_id
+        description: "The duplicate id."
+        tests:
+          - not_null
+          - unique
+      - name: correct_player_api_id
+        description: "The id the player keeps."
+        tests:
+          - not_null
+      - name: mode
+        description: "alias: the duplicate id is replaced everywhere."
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["alias"]
+      - name: note
+        description: "What proves the two ids are one person."
+        tests:
+          - not_null
+
+  - name: player_bio_corrections
+    description: >
+      A player's birth date or nationality where the provider's records conflict: one row per
+      player and field. Applied in `base_apif__players` and `base_apif__player_profiles`, and it
+      wins over both. An empty value means no outside source states it, so the player shows none.
+    config:
+      column_types:
