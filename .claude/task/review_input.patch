diff --git a/site_v2/src/pages/[lang]/[teams]/index.astro b/site_v2/src/pages/[lang]/[teams]/index.astro
new file mode 100644
index 00000000..84c24efa
--- /dev/null
+++ b/site_v2/src/pages/[lang]/[teams]/index.astro
@@ -0,0 +1,56 @@
+---
+// The Teams page: every team with a page, in the lists and orders teams_index.json serves
+// (mart_team_index). The page composes; TeamIndex.astro renders, lib/teamIndex.mjs cuts the lists.
+import Layout from "../../../layouts/Layout.astro";
+import TeamIndex from "../../../components/teams/TeamIndex.astro";
+import { t } from "../../../i18n/strings";
+import { localeHref, word } from "../../../lib/href";
+import type { Lang } from "../../../lib/format";
+import type { Team, TeamIndex as TeamIndexData } from "../../../lib/types";
+import teamsIndex from "../../../data/teams_index.json";
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+export function getStaticPaths() {
+  return (["de", "en", "fi"] as const).map((lang) => ({
+    params: { lang, teams: word(lang, "teams") },
+  }));
+}
+
+const lang = (Astro.params.lang ?? "en") as Lang;
+const data = teamsIndex as unknown as TeamIndexData;
+
+// A row links only to a page the build makes: one per team payload.
+const dir = join(process.cwd(), "src/data/teams");
+const built = new Set(
+  readdirSync(dir)
+    .filter((name) => name.endsWith(".json"))
+    .map((name) => (JSON.parse(readFileSync(join(dir, name), "utf8")) as Team).slug),
+);
+
+const title = t(lang, "seoTeamsTitle");
+const description = t(lang, "seoTeamsDesc");
+const entity = {
+  "@type": "ItemList",
+  name: title,
+  numberOfItems: data.teams.length,
+};
+const crumbs = [
+  { name: t(lang, "crumbHome"), href: localeHref(lang) },
+  { name: t(lang, "navTeams") },
+];
+---
+
+<Layout lang={lang} title={title} description={description} entity={entity} crumbs={crumbs} section="teams">
+  <div class="inner">
+    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
+      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
+      <span class="sep">›</span>
+      <span class="here">{t(lang, "navTeams")}</span>
+    </nav>
+
+    <h1>{t(lang, "navTeams")}</h1>
+
+    <TeamIndex data={data} lang={lang} built={built} />
+  </div>
+</Layout>
