+            - team_out_sk
+            - transfer_date
+      # every move has at least one known side (both-null is filtered in base); a single
+      # missing side (team_in_sk OR team_out_sk null) is legitimate provider behaviour
+      - dbt_utils.expression_is_true:
+          expression: "team_in_sk is not null or team_out_sk is not null"
+          name: fct_transfer_has_a_side
+    columns:
+      - name: transfer_sk
+        tests: [unique, not_null]
+      - name: player_sk
+        tests: [not_null]
+      - name: transfer_date
+        tests: [not_null]
+      - name: transfer_type
+        description: "Raw provider transfer type (N/A, Loan, Free, Transfer, fee, …); no canonical taxonomy."
