+version: 2
+
+models:
+  - name: int_competition_season__club_windows
+    description: >
+      The club competitions a player's season and the season before it are made of. For each club
+      competition-season: this_season is every club competition-season whose dates overlap it, and
+      last_season every one overlapping its previous season and not already in this_season. Grain:
+      (anchor_season_sk, window_type, season_sk).
+    config:
+      tags: ["intermediate", "football", "player"]
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [anchor_season_sk, window_type, season_sk]
+    columns:
+      - name: anchor_season_sk
+        description: "The competition-season the windows are drawn around. {{ doc('season_sk') }}"
+        tests:
+          - not_null
+          - relationships:
+              to: ref('dim_competition_season')
+              field: season_sk
+      - name: window_type
+        description: "this_season or last_season."
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["this_season", "last_season"]
+      - name: season_sk
+        description: "A competition-season in the window. {{ doc('season_sk') }}"
+        tests:
+          - not_null
+          - relationships:
+              to: ref('dim_competition_season')
+              field: season_sk
+
+  - name: int_team__current_national_competitions
+    description: >
+      A nation's current competitions: every national-team competition of the nation between its
+      first and last match, or the most recently finished one when none is running. Grain:
+      (team_sk, season_sk).
+    config:
+      tags: ["intermediate", "football", "team"]
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [team_sk, season_sk]
