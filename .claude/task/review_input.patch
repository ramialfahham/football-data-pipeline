+++ b/dbt_project/models/2_base/api_football/base_apif__fixture_events.sql
@@ -17,6 +17,15 @@ with src as (
     from {{ ref('stg_apif__fixture_events') }}
     where
         fixture_id is not null
+),
+
+deduped as (
