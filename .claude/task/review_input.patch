--- /dev/null
+++ b/dbt_project/models/5_marts/shared/mart_roster.sql
@@ -0,0 +1,66 @@
+{{ config(materialized='view') }}
+
+{#
+  mart_roster — identity-only club squad list (the Squad block; content_architecture §3).
+  One row per rostered player per (club team, competition-season), from
+  dim_player_team_season_mapping joined to dim_player for identity. Scoped to CLUB
+  competitions (entity_type = 'club', resolved league_code -> competition_registry ->
+  competition_types — mirrors mart_standings; never a dim_team flag, per the
+  dim_team-is-a-pure-entity ruling).
+
+  Identity only: name, listed position, nationality, birth_date, photo. NO per-club season
+  stats / appearances — that is the deferred per-club grain (#480 §8.3). Age is a render-time
+  derivation, so the mart carries player_birth_date, not a (non-deterministic) stored age.
+
+  dim_player is LEFT-joined so a membership with no resolvable player entity is NOT silently
+  dropped — it surfaces through the player_sk -> dim_player relationships test instead.
+
+  league_code is the partition key. season_sk is nullable (a roster season with no
+  competition-season row in dim_competition_season); season_api_year is always present and
+  anchors the grain. Grain: (team_sk, league_code, season_api_year, player_sk).
+#}
+
+with mapping as (
+    select * from {{ ref('dim_player_team_season_mapping') }}
+),
+
+players as (
+    select * from {{ ref('dim_player') }}
+),
+
+registry as (
+    select
+        league_code,
+        competition_type
+    from {{ ref('competition_registry') }}
+),
+
+types as (
+    select
+        competition_type,
+        entity_type
+    from {{ ref('competition_types') }}
+)
+
+select
+    m.player_team_season_sk,
+    m.team_sk,
+    m.player_sk,
+    m.season_sk,
+    m.league_code,
+    m.season_api_year,
+    reg.competition_type,
+    typ.entity_type,
+    p.player_name,
+    p.player_position,
+    p.player_nationality,
+    p.player_birth_date,
+    p.player_photo_url
+from mapping as m
+left join players as p
+    on m.player_sk = p.player_sk
+left join registry as reg
+    on m.league_code = reg.league_code
+left join types as typ
+    on reg.competition_type = typ.competition_type
+where typ.entity_type = 'club'
diff --git a/dbt_project/models/5_marts/shared/shared.yml b/dbt_project/models/5_marts/shared/shared.yml
index edbc1d7..eb00273 100644
--- a/dbt_project/models/5_marts/shared/shared.yml
+++ b/dbt_project/models/5_marts/shared/shared.yml
@@ -978,3 +978,65 @@ models:
           - accepted_values:
               values: ["W", "D", "L"]
 
+  - name: mart_roster
+    description: >
+      Identity-only club squad list (the Squad block; content_architecture §3). One row per
+      rostered player per (club team, competition-season), from dim_player_team_season_mapping
+      joined to dim_player. Scoped to club competitions (entity_type = 'club', via
+      competition_registry + competition_types — never a dim_team flag). Identity only: name,
+      listed position, nationality, birth_date, photo; NO per-club season stats (the deferred
+      per-club grain, #480 §8.3). Age is derived at render from player_birth_date (a stored age
+      would be non-deterministic). dim_player is LEFT-joined so a membership with no player
+      entity surfaces via the relationships test, not a silent drop. View. league_code is the
+      partition key; season_sk is nullable (roster season with no competition-season row).
+      Grain: (team_sk, league_code, season_api_year, player_sk).
+    config:
+      tags: ["marts", "football", "roster"]
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [team_sk, league_code, season_api_year, player_sk]
+    columns:
+      - name: player_team_season_sk
+        description: "Surrogate carried from dim_player_team_season_mapping (player, team, league_code, season)."
+        tests: [not_null, unique]
+      - name: team_sk
+        description: "FK to dim_team (the club)."
+        tests:
+          - not_null
+          - relationships:
+              to: ref('dim_team')
+              field: team_sk
+      - name: player_sk
+        description: "FK to dim_player."
+        tests:
+          - not_null
+          - relationships:
+              to: ref('dim_player')
+              field: player_sk
+      - name: league_code
+        description: "Partition key — app slices by this to retrieve a club's squad for a competition-season."
+        tests: [not_null]
+      - name: season_api_year
+        description: "The roster season; always present (anchors the grain even when season_sk is null)."
+        tests: [not_null]
+      - name: season_sk
+        description: "FK to dim_competition_season; nullable (roster season with no competition-season row)."
+      - name: competition_type
+        description: "From competition_registry; the mart is filtered to club types."
+      - name: entity_type
+        description: "Always 'club' — the mart is club-scoped via competition_types."
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["club"]
+      - name: player_name
+        description: "Denormalised from dim_player."
+      - name: player_position
+        description: "Listed/bio position from dim_player (general position, not a per-season modal)."
+      - name: player_nationality
+        description: "Denormalised from dim_player."
+      - name: player_birth_date
+        description: "Birth date from dim_player bio; age is computed at render."
+      - name: player_photo_url
+        description: "Player photo URL from dim_player; nullable."
+
