+// Types for the fixture payload (scripts/export_site_data.py :: shape_fixture_payload).
+// Mirrors the served shape; the frontend reads these, never reshapes facts.
+
+export interface WindowStats {
+  window_type?: string | null;
+  games_in_window?: number | null;   // W1
+  games_played?: number | null;      // W2
+  games_with_team_stats?: number | null;
+  contributing_competitions?: string[] | null;
+  points_won?: number | null;
+  wins?: number | null;              // W2
+  draws?: number | null;             // W2
+  losses?: number | null;            // W2
+  season_api_year?: number | null;
+  // metric fields (goals_per_match, pass_accuracy, clean_sheets, games, …)
+  [key: string]: number | string | string[] | null | undefined;
+}
+
+export interface Standing {
+  group_name?: string | null;
+  is_knockout?: boolean | null;
+  league_rank?: number | null;
+  standing_points?: number | null;
+  standing_played?: number | null;
+  standing_goals_diff?: number | null;
+  standing_form?: string | null;
+}
+
+export interface FormMatch {
+  recency_rank: number;
+  played_fixture_sk?: number | null;
+  played_league_code?: string | null;
+  played_kickoff_datetime?: string | null;
+  played_round_name?: string | null;
+  home_away?: string | null;
+  goals_for?: number | null;
+  goals_against?: number | null;
+  result?: string | null;
+  opponent_name?: string | null;
+  opponent_logo_url?: string | null;
+  has_team_stats?: boolean | null;
+  has_player_stats?: boolean | null;
+}
+
+export interface TopPlayer {
+  player_sk: number;
+  position_code?: string | null;
+  goals_total?: number | null;
+  goals_assists?: number | null;
+  saves?: number | null;
+  save_pct?: number | null;
+  shots_on?: number | null;
+  passes_key?: number | null;
+  player_name?: string | null;
+  player_photo_url?: string | null;
+}
+
+export interface Side {
+  team_id: number;
+  name?: string | null;
+  crest?: string | null;
+  country?: string | null;
+  w1?: WindowStats | null;
+  w2?: WindowStats | null;
+  standing?: Standing | null;
+  form_window?: FormMatch[];
+  top_players?: TopPlayer[];
+}
+
+export interface RecentMeeting {
+  kickoff_datetime?: string | null;
+  league_code?: string | null;
+  goals_for?: number | null;
+  goals_against?: number | null;
+  result?: string | null;
+}
+
+export interface HeadToHead {
+  total_meetings?: number | null;
+  wins?: number | null;
+  draws?: number | null;
+  losses?: number | null;
+  goals_for?: number | null;
+  goals_against?: number | null;
+  meetings_last5?: number | null;
+  last_meeting_at?: string | null;
+  last_meeting_league_code?: string | null;
+  last_meeting_goals_for?: number | null;
+  last_meeting_goals_against?: number | null;
+  last_meeting_result?: string | null;
+  recent_meetings?: RecentMeeting[];
+}
+
+export interface Fixture {
+  type: string;
+  fixture_id: number;
+  slug: string;
+  kickoff?: string | null;
+  status?: string | null;
+  league_code: string;
+  league_name?: string | null;
+  season?: number | null;
+  round?: string | null;
+  venue?: string | null;
+  home: Side;
+  away: Side;
+  head_to_head?: HeadToHead | null;
+}
+
+/** Narrow a payload value to a finite number (metric fields arrive as number | null). */
+export function asNumber(v: unknown): number | null {
+  return typeof v === "number" && Number.isFinite(v) ? v : null;
+}
diff --git a/site_v2/src/pages/[lang]/[competition]/matches/[fixture].astro b/site_v2/src/pages/[lang]/[competition]/matches/[fixture].astro
new file mode 100644
index 0000000..950465e
--- /dev/null
+++ b/site_v2/src/pages/[lang]/[competition]/matches/[fixture].astro
@@ -0,0 +1,97 @@
+---
+// Fixture page (screen 01) — the v2 design system's first real screen.
+// URL: /{lang}/{competition-slug}/matches/{yyyy-mm-dd-home-vs-away}/ (site_architecture.md §3).
+// This increment renders ONE committed real fixture across the three locales; at scale
+// getStaticPaths iterates every exported fixture (data/fixtures/*.json). The page only
+// COMPOSES the shared components in order — it holds no styling and derives no facts.
+import Layout from "../../../../layouts/Layout.astro";
+import Breadcrumb from "../../../../components/fixture/Breadcrumb.astro";
+import Masthead from "../../../../components/fixture/Masthead.astro";
+import NarrativeSlot from "../../../../components/fixture/NarrativeSlot.astro";
+import FormSegment from "../../../../components/fixture/FormSegment.astro";
+import SplitSection from "../../../../components/fixture/SplitSection.astro";
+import RecentMatch from "../../../../components/fixture/RecentMatch.astro";
+import PlayerRow from "../../../../components/fixture/PlayerRow.astro";
+import HeadToHead from "../../../../components/fixture/HeadToHead.astro";
+import LinksFooter from "../../../../components/fixture/LinksFooter.astro";
+import { t } from "../../../../i18n/strings";
+import { localeHref } from "../../../../lib/href";
+import type { Lang } from "../../../../lib/format";
+import type { Fixture } from "../../../../lib/types";
+import fixtureData from "../../../../data/fixtures/1492306.json";
+import competitions from "../../../../data/competitions.json";
+
+export function getStaticPaths() {
+  const locales: Lang[] = ["de", "en", "fi"];
+  const fixture = fixtureData as unknown as Fixture;
+  const comp = (competitions as Record<string, { slug: string }>)[fixture.league_code];
+  if (!comp) {
+    throw new Error(
+      `No competition slug for league_code "${fixture.league_code}" in src/data/competitions.json`,
+    );
+  }
+  return locales.map((lang) => ({
+    params: { lang, competition: comp.slug, fixture: fixture.slug },
+    props: { fixture, lang },
+  }));
+}
+
+interface Props {
+  fixture: Fixture;
+  lang: Lang;
+}
+const { fixture, lang } = Astro.props;
+const { home, away } = fixture;
+
+const title = `${home.name} vs ${away.name} — ${fixture.league_name}`;
+const description = t(lang, "aboutNoH2h", {
+  home: home.name ?? "",
+  away: away.name ?? "",
+  round: fixture.round ?? "",
+});
+
+// Home is a real target (the locale landing); competition hub + Matches are not built
+// yet → hrefless (plain text), no dead links.
+const crumbs = [
+  { label: t(lang, "crumbHome"), href: localeHref(lang) },
+  { label: fixture.league_name ?? fixture.league_code },
+  { label: t(lang, "crumbMatches") },
+];
+---
+
+<Layout lang={lang} title={title} description={description}>
+  <div class="inner">
+    <Breadcrumb items={crumbs} />
+    <Masthead fixture={fixture} lang={lang} />
+    <NarrativeSlot fixture={fixture} lang={lang} />
+    <FormSegment fixture={fixture} lang={lang} />
+
+    <SplitSection label={t(lang, "secRecent")} homeLabel={home.name} awayLabel={away.name}>
+      <Fragment slot="home">
+        {(home.form_window ?? []).map((m) => <RecentMatch match={m} lang={lang} />)}
+      </Fragment>
+      <Fragment slot="away">
+        {(away.form_window ?? []).map((m) => <RecentMatch match={m} lang={lang} />)}
+      </Fragment>
+    </SplitSection>
+
+    <SplitSection
+      label={t(lang, "secPlayers")}
+      note={t(lang, "playersWindow")}
+      homeLabel={home.name}
+      awayLabel={away.name}
+    >
+      <Fragment slot="home">
+        {(home.top_players ?? []).map((p) => <PlayerRow player={p} lang={lang} />)}
+      </Fragment>
+      <Fragment slot="away">
+        {(away.top_players ?? []).map((p) => <PlayerRow player={p} lang={lang} />)}
+      </Fragment>
+    </SplitSection>
+
+    <HeadToHead h2h={fixture.head_to_head} homeName={home.name} awayName={away.name} lang={lang} />
+    <LinksFooter fixture={fixture} lang={lang} />
+
+    <div class="footnote">{t(lang, "footnote")}</div>
+  </div>
+</Layout>
diff --git a/site_v2/src/styles/system.css b/site_v2/src/styles/system.css
new file mode 100644
index 0000000..4ae698d
--- /dev/null
+++ b/site_v2/src/styles/system.css
@@ -0,0 +1,197 @@
+/* ================================================================ *
+ *  MATCHDAY IQ — v2 DESIGN SYSTEM  (global; every screen imports it) *
+ *                                                                    *
+ *  Tokens + component classes transcribed VERBATIM from the LOCKED   *
+ *  reference mockup (artifact d70aae67; design memory                *
+ *  project_v2_frontend_design). Imported globally by Layout.astro so *
+ *  every page shares one system → consistency by construction. Do    *
+ *  NOT hand-style screens; emit these class names and style here.     *
+ *                                                                    *
+ *  COLOUR = MEANING ONLY (never hierarchy):                          *
+ *    --accent green = better value / Win · --loss red = Loss         *
+ *    --draw gray = Draw · neutrals = everything else. Green is       *
+ *    RESERVED — links/names/labels never get green.                  *
+ *  HIERARCHY = TONE + WEIGHT + SIZE (never hue). Three rungs:        *
+ *    1 --ink bold    → numbers that matter (values/scores/stats)     *
+ *    2 --ink regular → entity names (players, teams)                 *
+ *    3 --muted       → labels/metadata (metric names, positions,     *
+ *                      dates, section + group headers)               *
+ *  TYPE 11/13/15/18/20 + team-clamp · SPACING 8px base / 36px sec    *
+ *  Dark is default; light = the token swap below.                    *
+ * ================================================================ */
+
+*,
+*::before,
+*::after { box-sizing: border-box; }
+
+/* ---- token host (dark default) ---- */
+.fx {
+  --page: #0d0f13; --surface: #161920; --sunk: #1c1f27; --line: #272b33; --div: #333844;
+  --ink: #f1f3f7; --ink-2: #c1c6ce; --muted: #8b9099;                 /* cool-neutral gray ramp */
+  --accent: #3bb072;                 /* one green: better value · links */
+  --win: #1a854a; --draw: #6b7079; --loss: #b53b3b; --pill-ink: #fff; /* reserved status */
+  --track: #22262e;                                                   /* faint bar track */
+  --sp: 8px;
+  margin: 0;
+  background: var(--page); color: var(--ink);
+  font: 400 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  container-type: inline-size;
+}
+.fx[data-theme="light"] {
+  --page: #f3f3f0; --surface: #fbfbf9; --sunk: #edece7; --line: #e2e1da; --div: #cfcec5;
+  --ink: #141410; --ink-2: #4c4c45; --muted: #77776e;
+  --accent: #0a6e3a;
+  --win: #157f43; --draw: #6f756d; --loss: #b23b3b; --pill-ink: #fff;
+  --track: #e7e6e0;
+}
+
+img { max-width: 100%; }
+
+/* ---- primitives ---- */
+.fx a { color: inherit; text-decoration: none; }
+.fx a.lnk { color: inherit; font-weight: 600; }
+.fx a.lnk:hover { text-decoration: underline; text-underline-offset: 2px; }
+.fx a:focus-visible,
+.fx button:focus-visible,
+.fx .seg-in:focus-visible ~ .seg { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 9px; }
+.inner { max-width: 680px; margin: 0 auto; padding: 0 clamp(16px, 4cqw, 28px) 40px; }
+.num { font-variant-numeric: tabular-nums; }
+.eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
+section { margin-top: 36px; }
+.sechead { display: flex; align-items: baseline; gap: 12px; margin-bottom: 14px; }
+.sechead::after { content: ""; flex: 1; height: 1px; background: var(--line); }
+.win-note { font-size: 11px; font-weight: 600; color: var(--muted); }
+
+.crumb { font-size: 13px; color: var(--muted); padding: 18px 0 0; display: flex; gap: 8px; flex-wrap: wrap; }
+.crumb .sep { opacity: .4; }
+
+/* ---- masthead ---- */
+.mast { text-align: center; padding: 14px 0 26px; border-bottom: 1px solid var(--line); }
+.mast .kick { font-size: 13px; color: var(--muted); margin-top: 8px; }
+.mast .kick b { color: var(--ink-2); font-weight: 600; }
+.teams { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(8px, 3cqw, 20px); margin-top: 20px; }
+.team { display: flex; flex-direction: column; align-items: center; gap: 12px; min-width: 0; }
+.crest { width: 52px; height: 52px; border-radius: 6px; display: grid; place-items: center; background: var(--sunk); border: 1px solid var(--line); color: var(--ink); font-weight: 700; font-size: 17px; overflow: hidden; }
+.crest img { width: 100%; height: 100%; object-fit: contain; }
+.tname { font-size: clamp(20px, 4.4cqw, 27px); font-weight: 700; line-height: 1.05; text-wrap: balance; }
+.vs { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
+.stand { font-size: 13px; color: var(--muted); }
+.stand b { color: var(--ink); font-weight: 700; }
+.mast .venue { font-size: 13px; color: var(--muted); margin-top: 16px; }
+
+/* ---- lede (about, at top) ---- */
+.lede { margin-top: 22px; }
+.lede p { font-size: 16px; line-height: 1.66; margin: 0; color: var(--ink-2); }
+.lede b { color: var(--ink); font-weight: 700; }
+
+/* ---- segment (JS-free radio toggle) ---- */
+.seg-in { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
+.seg { display: flex; background: var(--sunk); border: 1px solid var(--line); border-radius: 9px; padding: 3px; margin-top: 4px; }
+.seg .seg-btn { flex: 1; font: inherit; font-size: 13px; font-weight: 600; color: var(--muted); padding: 9px 12px; border-radius: 6px; cursor: pointer; white-space: nowrap; text-align: center; user-select: none; }
+/* active label + which window shows — driven by the checked radio */
+.win { display: none; }
+#seg-w1:checked ~ .win-w1,
+#seg-w2:checked ~ .win-w2 { display: block; }
+#seg-w1:checked ~ .seg .seg-btn[for="seg-w1"],
+#seg-w2:checked ~ .seg .seg-btn[for="seg-w2"] { background: var(--surface); color: var(--ink); font-weight: 700; box-shadow: 0 1px 3px rgba(0, 0, 0, .25); }
+
+/* ---- form row (pills / counts) ---- */
+.formrow { display: grid; grid-template-columns: 1fr 1fr; align-items: start; gap: 18px; margin-top: 18px; }
+.formrow .side { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
+.formrow .home { align-items: flex-end; }
+.formrow .away { align-items: flex-start; }
+.wmeta { font-size: 13px; color: var(--muted); }
+.wmeta b { color: var(--ink); font-weight: 700; }
+.pills { display: flex; gap: 5px; }
+.pill { width: 24px; height: 24px; border-radius: 5px; display: grid; place-items: center; font-size: 12px; font-weight: 700; color: var(--pill-ink); font-variant-numeric: tabular-nums; }
+.pill.W { background: var(--win); }
+.pill.D { background: var(--draw); }
+.pill.L { background: var(--loss); }
+.cchips { display: flex; gap: 6px; }
+.cchip { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 9px; border-radius: 5px; font-size: 12.5px; font-weight: 700; color: var(--pill-ink); font-variant-numeric: tabular-nums; }
+.cchip.W { background: var(--win); }
+.cchip.D { background: var(--draw); }
+.cchip.L { background: var(--loss); }
+.cchip small { font-weight: 600; opacity: .85; font-size: 11px; }
+.formrow .scope { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); text-align: center; max-width: 12ch; }
+.caption { font-size: 12px; color: var(--muted); text-align: center; margin: 16px 0 4px; }
+
+/* ============================================================ *
+ *  COMPARISON — 3 columns: home value · centred name+bar · away  *
+ *  value. Numbers aligned in their columns; better value green.  *
+ * ============================================================ */
+.cmp { margin-top: 22px; }
+.cmp-head,
+.mrow { display: grid; grid-template-columns: 1fr 1.5fr 1fr; align-items: center; gap: 12px; }
+.cmp-head { padding-bottom: 10px; border-bottom: 1px solid var(--line); margin-bottom: 2px; }
+.cmp-head .h { font-size: 12px; font-weight: 700; color: var(--muted); text-align: center; letter-spacing: .02em; }
+.mgroup { font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); text-align: center; padding: 22px 0 8px; }
+.mrow { padding: 10px 0; }
+.mmid { display: flex; flex-direction: column; align-items: center; gap: 9px; min-width: 0; }
+.mlabel { font-size: 13px; color: var(--muted); line-height: 1.25; text-align: center; }
+.mlabel small { display: block; font-size: 11px; opacity: .8; }
+.mval { font-size: 18px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; text-align: center; }
+.mval.better { color: var(--accent); }
+.mval .sub { display: block; font-size: 11px; font-weight: 600; color: var(--muted); }
+.mbar { display: flex; align-items: center; height: 5px; width: 100%; max-width: 250px; }
+.bside { flex: 1; height: 100%; display: flex; background: var(--track); border-radius: 3px; }
+.bside.home { justify-content: flex-end; margin-right: 1px; }
+.bside.away { justify-content: flex-start; margin-left: 1px; }
+.bside.home .fill { border-radius: 3px 0 0 3px; }
+.bside.away .fill { border-radius: 0 3px 3px 0; }
+.fill { height: 100%; background: var(--ink); transition: width .45s cubic-bezier(.4, 0, .2, 1); }
+.fill.better { background: var(--accent); }
+
+/* ---- two-column sections ---- */
+.split { display: grid; grid-template-columns: 1fr; gap: 8px 30px; margin-top: 4px; }
+@container (min-width: 560px) { .split { grid-template-columns: 1fr 1fr; } }
+.colhead { font-size: 13px; font-weight: 700; color: var(--muted); margin: 14px 0 8px; }
+.rmatch { display: grid; grid-template-columns: 24px 42px 1fr auto; align-items: center; gap: 11px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
+.rmatch:last-child { border-bottom: 0; }
+.res { width: 24px; height: 24px; border-radius: 5px; display: grid; place-items: center; font-weight: 700; font-size: 11px; color: var(--pill-ink); }
+.res.W { background: var(--win); }
+.res.D { background: var(--draw); }
+.res.L { background: var(--loss); }
+.rscore { font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; text-align: right; }
+.ropp { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink); }
+.ropp .ha { color: var(--muted); font-weight: 600; font-size: 11px; margin-left: 5px; }
+.rmeta { color: var(--muted); white-space: nowrap; font-size: 12px; text-align: right; }
+.noclick .rscore,
+.noclick .ropp { opacity: .55; }
+
+.prow { display: grid; grid-template-columns: 34px 1fr auto; align-items: center; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); }
+.prow:last-child { border-bottom: 0; }
+.pphoto { width: 34px; height: 34px; border-radius: 50%; background: var(--sunk); border: 1px solid var(--line); display: grid; place-items: center; font-weight: 700; font-size: 11px; color: var(--muted); overflow: hidden; }
+.pphoto img { width: 100%; height: 100%; object-fit: cover; }
+.pname { min-width: 0; }
+.pname .nm { font-size: 14px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.pname .ps { font-size: 11.5px; color: var(--muted); }
+.pstat { font-size: 13px; color: var(--muted); white-space: nowrap; text-align: right; font-variant-numeric: tabular-nums; }
+.pstat b { color: var(--ink); font-weight: 700; }
+
+/* ---- h2h ---- */
+.h2h-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
+.h2h-rec { font-size: 15px; }
+.h2h-rec b { font-size: 20px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
+.h2h-rec b.cw { color: var(--win); }
+.h2h-rec b.cl { color: var(--loss); }
+.h2h-rec .nm { color: var(--muted); font-size: 13px; }
+.h2h-meta { font-size: 12px; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
+.h2h-bar { display: flex; height: 10px; border-radius: 5px; overflow: hidden; gap: 2px; background: var(--track); }
+.h2h-bar span { display: block; height: 100%; border-radius: 2px; }
+.h2h-bar .w { background: var(--win); }
+.h2h-bar .d { background: var(--draw); }
+.h2h-bar .l { background: var(--loss); }
+.h2h-last { margin-top: 12px; font-size: 13px; color: var(--muted); }
+.h2h-last b { color: var(--ink); font-weight: 700; }
+.h2h-list { margin-top: 14px; }
+
+/* ---- links / footer ---- */
+.linkrow { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
+.linkchip { font-size: 13px; font-weight: 600; color: var(--ink-2); border: 1px solid var(--line); border-radius: 6px; padding: 8px 13px; }
+.linkchip:hover { border-color: var(--ink-2); color: var(--ink); }
+.footnote { margin-top: 30px; font-size: 11px; color: var(--muted); text-align: center; opacity: .8; }
+.err { padding: 40px; color: #f26d6d; font-size: 14px; white-space: pre-wrap; }
+
+@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
