+    subprocess.run(["git", "commit", "-qm", "approved"], cwd=repo, check=True)
+    subprocess.run(["git", "checkout", "-q", "-"], cwd=repo, check=True)
+    monkeypatch.setenv("GOVERNANCE_BASE", "base_main")
