diff --git a/dbt_project/tests/assert_team_position_by_match_matches_final_table.sql b/dbt_project/tests/assert_team_position_by_match_matches_final_table.sql
new file mode 100644
index 00000000..ea75b660
--- /dev/null
+++ b/dbt_project/tests/assert_team_position_by_match_matches_final_table.sql
@@ -0,0 +1,55 @@
+{#
+  The position at a number of matches (int_team_season__position_by_match) against the official
+  table, wherever every team of a section has played the same number of matches: a finished
+  season's final table, or a table between two full matchdays. One row per team whose rank at
+  that number of matches is not its official rank, or that has no rank there. A points deduction
+  or a league's own tie-break is a known reason, so this warns and stores the rows.
+#}
+{{ config(store_failures = true, severity = 'warn') }}
+
+with ranked as (
+    select distinct
+        league_code,
+        season_api_year,
+        group_name
+    from {{ ref('int_team_season__position_by_match') }}
+),
+
+official as (
+    select
+        s.league_code,
+        s.season_api_year,
+        s.group_name,
+        s.team_sk,
+        s.standing_rank,
+        s.played,
+        s.points
+    from {{ ref('fct_standings') }} as s
+    inner join ranked as r
+        on
+            s.league_code = r.league_code
+            and s.season_api_year = r.season_api_year
+            and s.group_name = r.group_name
+    qualify
+        min(s.played) over (partition by s.league_code, s.season_api_year, s.group_name)
+        = max(s.played) over (partition by s.league_code, s.season_api_year, s.group_name)
+)
+
+select
+    o.league_code,
+    o.season_api_year,
+    o.group_name,
+    o.team_sk,
+    o.played,
+    o.standing_rank,
+    p.position_at_match,
+    o.points as official_points,
+    p.points_won
+from official as o
+left join {{ ref('int_team_season__position_by_match') }} as p
+    on
+        o.team_sk = p.team_sk
+        and o.league_code = p.league_code
+        and o.season_api_year = p.season_api_year
+        and o.played = p.match_number
+where p.position_at_match is distinct from o.standing_rank
diff --git a/dbt_project/tests/assert_team_window_holds_the_last_five.sql b/dbt_project/tests/assert_team_window_holds_the_last_five.sql
new file mode 100644
index 00000000..7e733760
--- /dev/null
+++ b/dbt_project/tests/assert_team_window_holds_the_last_five.sql
@@ -0,0 +1,64 @@
+{#
+  The team window (int_team_momentum_window rows with no upcoming fixture) holds every team's last
+  5 finished matches, a club's within the season of its latest finished match, recomputed here from
+  int_legs__team_match. One row per team whose window differs: the model's matches and the
+  expected ones.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with legs as (
+    select
+        team_sk,
+        fixture_sk,
+        season_api_year,
+        entity_type,
+        kickoff_datetime
+    from {{ ref('int_legs__team_match') }}
+),
+
+latest as (
+    select
+        team_sk,
+        season_api_year
+    from legs
+    qualify row_number() over (
+        partition by team_sk
+        order by kickoff_datetime desc, fixture_sk desc
+    ) = 1
+),
+
+expected as (
+    select
+        l.team_sk,
+        l.fixture_sk,
+        row_number() over (partition by l.team_sk order by l.kickoff_datetime desc) as recency_rank
+    from legs as l
+    inner join latest as t
+        on l.team_sk = t.team_sk
+    where l.entity_type = 'national' or l.season_api_year = t.season_api_year
+    qualify recency_rank <= 5
+),
+
+model as (
+    select
+        team_sk,
+        leg_fixture_sk as fixture_sk,
+        recency_rank,
+        window_type
+    from {{ ref('int_team_momentum_window') }}
+    where upcoming_fixture_sk is null
+)
+
+select
+    coalesce(e.team_sk, m.team_sk) as team_sk,
+    array_agg(distinct format('%d %d %s', m.fixture_sk, m.recency_rank, m.window_type) ignore nulls)
+        as model_matches,
+    array_agg(distinct format('%d %d', e.fixture_sk, e.recency_rank) ignore nulls) as expected_matches
+from expected as e
+full outer join model as m
+    on e.team_sk = m.team_sk and e.fixture_sk = m.fixture_sk
+group by 1
+having countif(
+    e.fixture_sk is null or m.fixture_sk is null
+    or e.recency_rank != m.recency_rank or m.window_type != 'last_5'
+) > 0
