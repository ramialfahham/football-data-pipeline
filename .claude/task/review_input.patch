+deploy:nightly-image:
+  # `google/cloud-sdk:slim` — this job talks to the Cloud Run API via the gcloud CLI, not a
+  # client library, same reasoning `build:nightly-image`'s sibling comment above gives.
+  <<: *gcp_job
+  image: google/cloud-sdk:slim
+  stage: deploy
+  # Waits for the image kaniko just pushed, not for validate:governance/test:python directly —
+  # transitively covered, since `build:nightly-image` already needs both. `rules:` below MUST
+  # match `build:nightly-image`'s exactly: GitLab refuses to create a pipeline where a `needs:`
+  # target is absent from it, so if these two `changes:`/`rules:` blocks ever drift apart, the
+  # pipeline stops being constructible rather than silently skipping one job.
+  needs: ["build:nightly-image"]
+  resource_group: deploy-nightly-image
+  timeout: 5m
+  script:
+    - *gcp_auth
+    # *gcp_auth only writes an external_account credentials file for CLIENT LIBRARIES
+    # (google-auth's `google.auth.default()`, which dbt-bigquery and firebase-tools
+    # use). The gcloud CLI does not read GOOGLE_APPLICATION_CREDENTIALS on its own —
+    # it needs an explicit `gcloud auth login --cred-file=...` to activate the same
+    # file for CLI calls, and an explicit project (a human operator's gcloud has both
+    # already; CI's does not).
+    - gcloud auth login --cred-file="$GOOGLE_APPLICATION_CREDENTIALS" --quiet
+    - gcloud config set project football-data-pipeline-gcp --quiet
+    # `update`, not `deploy --source .` — this job does not build anything, it only repoints
+    # the existing Cloud Run job at the image `build:nightly-image` just pushed. `update` only
+    # changes what is specified, so the runtime service account, secret binding, CPU/memory,
+    # task timeout and retry count (all set once via deploy/nightly/README.md's manual command)
+    # are left exactly as they are — nothing here can silently reset them to a default the way
+    # a bare `deploy` on an existing job could.
+    - >
+      gcloud run jobs update fdp-nightly
+      --image="europe-west1-docker.pkg.dev/football-data-pipeline-gcp/cloud-run-source-deploy/fdp-nightly:$CI_COMMIT_SHA"
+      --region europe-west1
+  rules:
+    - *not_on_schedule
+    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH && $CI_PIPELINE_SOURCE == "push"
+      changes: *data_paths_image
