 {% enddocs %}
 
 
+{% docs lineup_order %}
+The player's place on the team sheet, 1 first: the starters, then the substitutes. A provider
+sheet keeps the provider's order. A researched sheet lists its starters by pitch position, row
+then column, and the rest by shirt number.
+{% enddocs %}
+
+
+{% docs shootout_home %}
+The home side's goals in the penalty shoot-out, as the provider gives them. NULL where the match
+had no shoot-out.
+{% enddocs %}
+
+
+{% docs shootout_away %}
+The away side's goals in the penalty shoot-out, as the provider gives them. NULL where the match
+had no shoot-out.
+{% enddocs %}
+
+
+{% docs winner_team %}
+The team that won the match or went through. On an awarded result it is the awarded team, and on
+a match settled on penalties the shoot-out's winner. Otherwise it is the side with more goals.
+NULL on a draw and on a match not played.
+{% enddocs %}
+
+
 {% docs minute_on %}
 The minute of normal time a substitution brought the player on. NULL for a player who did not
 come on as a substitute.
diff --git a/dbt_project/tests/assert_fixture_lineup_order_starters_first.sql b/dbt_project/tests/assert_fixture_lineup_order_starters_first.sql
new file mode 100644
index 00000000..f13d5390
--- /dev/null
+++ b/dbt_project/tests/assert_fixture_lineup_order_starters_first.sql
@@ -0,0 +1,19 @@
+-- A team sheet is numbered 1 to n with every starter before every substitute. Returns a row
+-- (= fails) per team sheet whose lineup_order skips, repeats or lists a substitute first.
+{{ config(store_failures = true) }}
+
+select
+    fixture_sk,
+    team_sk,
+    count(*) as n_players,
+    min(lineup_order) as first_order,
+    max(lineup_order) as last_order,
+    max(if(is_starter, lineup_order, null)) as last_starter,
+    min(if(not is_starter, lineup_order, null)) as first_substitute
+from {{ ref('fct_fixture_lineup') }}
+group by fixture_sk, team_sk
+having
+    min(lineup_order) != 1
+    or max(lineup_order) != count(*)
+    or count(distinct lineup_order) != count(*)
+    or max(if(is_starter, lineup_order, null)) > min(if(not is_starter, lineup_order, null))
