+    - python scripts/export_site_data.py --entities teams,fixtures,competitions,competition_index,landing,matches,metric_groups,metric_rows --out site_v2/export_data
   artifacts:
     paths:
-      - site_v2/src/data
+      - site_v2/export_data
     expire_in: 1 day
   # `web` ONLY, and that restriction is the whole gate. An earlier revision used a
