diff --git a/dbt_project/macros/bio_correction.sql b/dbt_project/macros/bio_correction.sql
new file mode 100644
index 00000000..5090603d
--- /dev/null
+++ b/dbt_project/macros/bio_correction.sql
@@ -0,0 +1,4 @@
+{#- A correction row wins even when its value is empty: empty means no source states the value. -#}
+{% macro bio_correction(correction_alias, value) -%}
+if({{ correction_alias }}.player_api_id is null, {{ value }}, {{ correction_alias }}.corrected_value)
+{%- endmacro %}
diff --git a/dbt_project/macros/player_id_override.sql b/dbt_project/macros/player_id_override.sql
new file mode 100644
index 00000000..5e40d9a9
--- /dev/null
+++ b/dbt_project/macros/player_id_override.sql
@@ -0,0 +1,11 @@
+{#- The id a player keeps when the provider holds that player under two. -#}
+{% macro player_id_override(player_id) -%}
+    coalesce(
+        (
+            select override.correct_player_api_id
+            from {{ ref('player_id_overrides') }} as override
+            where override.wrong_player_api_id = {{ player_id }}
+        ),
+        {{ player_id }}
+    )
+{%- endmacro %}
diff --git a/dbt_project/macros/possible_birth_date.sql b/dbt_project/macros/possible_birth_date.sql
new file mode 100644
index 00000000..ca1903f3
--- /dev/null
+++ b/dbt_project/macros/possible_birth_date.sql
@@ -0,0 +1,8 @@
+{#- A date under 13 years before the record was ingested is the provider's placeholder: empty. -#}
+{% macro possible_birth_date(birth_date, ingested_at) -%}
+    if(
+        {{ birth_date }} > date_sub(date({{ ingested_at }}), interval 13 year),
+        cast(null as date),
+        {{ birth_date }}
+    )
+{%- endmacro %}
