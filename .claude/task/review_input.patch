+.ctl label { display: inline-flex; align-items: center; gap: 7px; cursor: pointer; user-select: none; }
+.ctl .hint { color: #7c828c; font-size: 12px; }
+.toggle { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
