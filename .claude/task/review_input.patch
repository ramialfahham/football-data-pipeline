+/* the deserved table's own track list: # · club · SoG for:against · balance · Deserved · Pts · Diff */
+.ctab.dpt, .ctab.dpt.ctab { --cols: 2rem minmax(0, 1fr) 3.6rem 4.2rem 2.6rem 3.2rem; }
