+# A new person's first two commands, on a clean machine: `python scripts/bootstrap.py`, then
+# `--verify` (pytest, pre-commit on all files, the site build). No cache, so it is a real first run.
+# Never on a schedule: any GitLab schedule also starts the prod `data:nightly`.
+# python:3.11 has no Node, so Node 24 comes from nodejs.org, checked against its published SHA-256.
+setup:clean-clone:
+  image: python:3.11
+  needs: []
+  stage: test
+  script:
+    - |
+      NODE_DIST=https://nodejs.org/dist/latest-v24.x
+      curl -fsSL "$NODE_DIST/SHASUMS256.txt" -o SHASUMS256.txt
+      NODE_TAR=$(grep -o 'node-v24\.[0-9.]*-linux-x64\.tar\.xz' SHASUMS256.txt | head -1)
+      curl -fsSLO "$NODE_DIST/$NODE_TAR"
+      grep " $NODE_TAR\$" SHASUMS256.txt | sha256sum -c -
+      mkdir -p /opt/node
+      tar -xJf "$NODE_TAR" -C /opt/node --strip-components=1
+      rm "$NODE_TAR" SHASUMS256.txt
+    - export PATH="/opt/node/bin:$PATH"
+    - python scripts/bootstrap.py
