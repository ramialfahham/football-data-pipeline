@@ -2261,6 +2261,122 @@ models:
               values: [true, false]
               quote: false
 
+  - name: mart_competition_fixtures
+    description: >
+      Every match of a competition-season, played and unplayed: one row per fixture with both
+      teams named and linked, the round it belongs to, the score once played and the kick-off
+      until then. Grain: fixture_sk.
+
+      Rounds are the provider's labels, ordered within a competition-season by each round's first
+      kick-off; a league round also carries its matchday number. A fixture is played when it has a
+      finished leg in int_legs__team_match, the one definition of a result. The next round is the
+      round of the competition-season's earliest fixture not yet started, by mart_next_matchday's
+      rule, and that mart's match-that-matters flag is carried onto its fixture.
+
+      The fixture slug is the match's permanent URL segment, built from the kick-off date and the
+      two published team slugs. Rebuilt nightly, so the next-round flag is correct as of the
+      morning it was built.
+    meta:
+      owner: "data-platform"
+      domain: "football"
+      criticality: "medium"
+    config:
+      tags: ["marts", "football", "fixtures"]
+    tests:
+      - dbt_utils.expression_is_true:
+          expression: "not is_played or (goals_home is not null and goals_away is not null)"
+          name: competition_fixtures_played_has_a_score
+      - dbt_utils.expression_is_true:
+          expression: "not is_match_that_matters or is_next_round"
+          name: competition_fixtures_top_match_is_in_the_next_round
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [league_code, fixture_slug]
+          name: competition_fixtures_slug_unique_per_competition
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [league_code, season_api_year, fixture_order]
+          name: competition_fixtures_order_unique_per_season
+    columns:
+      - name: fixture_sk
+        description: "{{ doc('fixture_sk') }}"
+        tests:
+          - not_null
+          - unique
+          - relationships:
+              to: ref('fct_fixture')
