+    try:
+        client.get_table(table_id)
+    except NotFound:
+        return {}
+    q = f"SELECT league_code, MAX(ingested_at) AS mx FROM `{table_id}` GROUP BY league_code"
+    return {
+        row.league_code: row.mx
+        for row in client.query(q).result()
+        if row.league_code and row.mx
+    }
