+  // the side away from the gap line where the plot has room, the difference under the name.
+  const nameW = (teamName.length + 1) * labelChar;
+  const fitsRight = cx + nameW <= W - R, fitsLeft = cx - nameW >= L;
+  const right = cx < (L + W - R) / 2 ? fitsRight || !fitsLeft : fitsRight && !fitsLeft;
+  const beside = fitsRight || fitsLeft;
+  const stackH = 5 * labelChar;
+  const above = cl >= cy ? cy - stackH >= T : cy + stackH > H - B;
   const toRight = (side: boolean) => (side ? offset.beside : `-${offset.beside}`);
