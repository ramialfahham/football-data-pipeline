+/* ---- team page ---- */
+/* A tab's opening sentence: the block explainer's style, under the tab bar. */
+.bsub.tab-intro { margin-top: 14px; }
+
+/* The competition row: crest · name with its muted note · the standing or the cup's outcome on the
+   right; under it, for a table, the W/D/L counts and goals and points. Narrow, the standing moves
+   to the second line before the numbers, and the counts take a third. */
+a.lrow.tc, div.lrow.tc { padding-block: 12px; }
+/* A row opening a block carries no space of its own. */
+.sechead + .tcomps > .tc:first-child { padding-top: 0; }
+.sechead + .rlist > .lrow:first-child .resrow { padding-top: 0; }
+.tc .tcin { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto;
+  grid-template-areas: "crest name right" ". extra extra"; column-gap: 12px; row-gap: 8px; align-items: center; }
+.tc .tc-crest { grid-area: crest; }
+.tc .tc-name { grid-area: name; font-size: 15px; font-weight: 600; color: var(--ink); min-width: 0; }
+.tc .tc-ctx { font-size: 12px; font-weight: 400; color: var(--muted); }
+.tc .tc-right { grid-area: right; font-size: 15px; font-weight: 700; color: var(--ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
+.tc .tc-extra { grid-area: extra; display: flex; align-items: center; justify-content: space-between; gap: 8px 14px; flex-wrap: wrap; }
+.tc .tc-rank2 { display: none; font-size: 15px; font-weight: 700; color: var(--ink); }
+.tc .tc-nums { margin-left: auto; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
+.tc .tc-nums b { font-size: 15px; font-weight: 700; color: var(--ink); }
+@container (max-width: 340px) {
+  .tc .tcin { grid-template-areas: "crest name name" ". extra extra"; }
+  .tc .tc-right { display: none; }
+  .tc .tc-extra { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "rank nums" "pills pills";
+    justify-items: start; align-items: baseline; gap: 8px 0; }
+  .tc .tc-rank2 { display: inline; grid-area: rank; }
+  .tc .tc-extra:has(.tc-nums) .tc-rank2::after { content: " ·"; font-size: 12px; font-weight: 400; color: var(--muted); margin-right: 4px; }
+  .tc .tc-nums { grid-area: nums; margin-left: 0; }
+  .tc .tc-extra .cchips { grid-area: pills; }
+}
+
+/* The squad: the player rows in two columns where each keeps 280px, one below. */
+.sqgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, max(280px, calc(50% - 12px))), 1fr)); column-gap: 24px; }
+.sqgrid > .lrow { border-bottom: 1px solid var(--line); min-width: 0; }
+.sqgrid > a.lrow { margin-inline: 0; padding-inline: 0; }
