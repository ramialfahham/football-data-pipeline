+  - name: standings_temporary_results
+    description: >
+      A result the official league table held for a time and that was later annulled, such as an
+      awarded win before the match was ordered replayed. One row per match and period, with its
+      official sources. int_team_season__table_by_time counts the result for both teams at every
+      kick-off from from_date to to_date.
+    config:
+      column_types:
+        league_code: string
+        season: int64
+        home_team_id: int64
+        away_team_id: int64
+        home_goals: int64
+        away_goals: int64
+        from_date: date
+        to_date: date
+        source: string
+        note: string
+    tests:
