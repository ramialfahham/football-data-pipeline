diff --git a/site_v2/src/lib/bars.ts b/site_v2/src/lib/bars.ts
index 5def2d5..dbc98b9 100644
--- a/site_v2/src/lib/bars.ts
+++ b/site_v2/src/lib/bars.ts
@@ -47,3 +47,16 @@ export function stackShares(
   if (total <= 0) return { w: 0, d: 0, l: 0 };
   return { w: (w / total) * 100, d: (d / total) * 100, l: (l / total) * 100 };
 }
+
+// Year-over-year delta display: the arrow (↑/↓ by the raw sign of the change) + a
+// class resolved from the metric's direction (up = better → green, down = worse →
+// red, flat = no change → muted). Display encoding of served values, not a fact.
+export function deltaView(
+  delta: number | null | undefined,
+  lowerIsBetter: boolean,
+): { arrow: string; cls: "up" | "down" | "flat" } {
+  if (!isNum(delta) || delta === 0) return { arrow: "", cls: "flat" };
+  const rose = delta > 0;
+  const better = lowerIsBetter ? !rose : rose;
+  return { arrow: rose ? "↑" : "↓", cls: better ? "up" : "down" };
+}
diff --git a/site_v2/src/lib/team.ts b/site_v2/src/lib/team.ts
new file mode 100644
index 0000000..113c676
--- /dev/null
+++ b/site_v2/src/lib/team.ts
@@ -0,0 +1,87 @@
+// Types for the team payload (scripts/export_site_data.py :: shape_team_payload,
+// over mart_team_profile). The frontend reads these; it never reshapes facts.
+// Metric-rate fields (goals_per_match, …) are read positionally via metricRows.ts
+// and accessed with a Record cast + asNumber — same pattern as the fixture WindowStats.
+
+export interface TeamFixture {
+  opponent_name?: string | null;
+  opponent_logo_url?: string | null;
+  is_home?: boolean | null;
+  kickoff_datetime?: string | null;
+  round_name?: string | null;
+  goals_for?: number | null;
+  goals_against?: number | null;
+  result?: string | null;
+  status_short?: string | null;
+}
+
+export interface Venue {
+  name?: string | null;
+  city?: string | null;
+  capacity?: number | null;
+}
+
+/** One `seasons[]` row: a mart_team_profile row (identity stripped) + fixtures. */
+export interface TeamSeason {
+  league_code: string;
+  season_api_year: number;
+  competition_type?: string | null;
+  // record / rank / form (mart_team_season)
+  latest_rank?: number | null;
+  points?: number | null;
+  played?: number | null;
+  wins?: number | null;
+  draws?: number | null;
+  losses?: number | null;
+  goals_for?: number | null;
+  goals_against?: number | null;
+  goal_diff?: number | null;
+  clean_sheets?: number | null;
+  latest_form?: string | null;
+  // season-metric coverage (captions)
+  season_games_played?: number | null;
+  stat_coverage_season_games?: number | null;
+  player_stat_coverage_season_games?: number | null;
+  // year-over-year (domestic only; null otherwise)
+  yoy_games_played_cutoff?: number | null;
+  points_this_season?: number | null;
+  points_prev_season?: number | null;
+  points_delta_yoy?: number | null;
+  goals_for_this_season?: number | null;
+  goals_for_prev_season?: number | null;
+  goals_for_delta_yoy?: number | null;
+  goals_against_this_season?: number | null;
+  goals_against_prev_season?: number | null;
+  goals_against_delta_yoy?: number | null;
+  // streaks (trailing runs as of the latest match)
+  unbeaten_run?: number | null;
+  win_run?: number | null;
+  winless_run?: number | null;
+  clean_sheet_run?: number | null;
+  scoring_run?: number | null;
+  // fixtures (GAP-15): next fixture + last-5 results
+  next_fixture?: TeamFixture | null;
+  recent_results?: TeamFixture[];
+  // metric-rate fields (goals_per_match … save_ratio) live here too — read via cast.
+}
+
+export interface TeamPayload {
+  type: string;
+  team_id: number;
+  slug: string;
+  name?: string | null;
+  country?: string | null;
+  crest?: string | null;
+  founded_year?: number | null;
+  venue?: Venue | null;
+  seasons: TeamSeason[];
+}
+
+/**
+ * The season shown by default: the most-recent domestic league (seasons[] is served
+ * sorted year desc), else the most-recent season. SELECTION of a served row — not a
+ * derivation. The multi-season selector swap is deferred (island, #362).
+ */
+export function pickDefaultSeason(seasons: TeamSeason[]): TeamSeason | undefined {
+  return seasons.find((s) => s.competition_type === "domestic_league") ?? seasons[0];
+}
diff --git a/site_v2/src/pages/[lang]/teams/[team].astro b/site_v2/src/pages/[lang]/teams/[team].astro
new file mode 100644
index 0000000..0d631bf
--- /dev/null
+++ b/site_v2/src/pages/[lang]/teams/[team].astro
@@ -0,0 +1,78 @@
+---
+// Team profile — Overview (screen 02), reusing the #672 design system. URL:
+// /{lang}/teams/{kebab-name}-{team_id}/ (site_architecture.md §3). This increment
+// renders ONE committed real team's DEFAULT season across three locales; at scale
+// getStaticPaths iterates every exported team. The page only COMPOSES components in
+// order — no styling, no fact derivation. Flagship deserved-vs-actual is deferred.
+import Layout from "../../../layouts/Layout.astro";
+import Breadcrumb from "../../../components/fixture/Breadcrumb.astro";
+import SectionHead from "../../../components/ui/SectionHead.astro";
+import TeamHeader from "../../../components/team/TeamHeader.astro";
+import RecordBlock from "../../../components/team/RecordBlock.astro";
+import YearOverYear from "../../../components/team/YearOverYear.astro";
+import Streaks from "../../../components/team/Streaks.astro";
+import SeasonStats from "../../../components/team/SeasonStats.astro";
+import TeamFixtures from "../../../components/team/TeamFixtures.astro";
+import { t } from "../../../i18n/strings";
+import { localeHref } from "../../../lib/href";
+import type { Lang } from "../../../lib/format";
+import { pickDefaultSeason } from "../../../lib/team";
+import type { TeamPayload } from "../../../lib/team";
+import teamData from "../../../data/teams/42.json";
+
+export function getStaticPaths() {
+  const locales: Lang[] = ["de", "en", "fi"];
+  const team = teamData as unknown as TeamPayload;
+  return locales.map((lang) => ({
+    params: { lang, team: team.slug },
+    props: { team, lang },
+  }));
+}
+
+interface Props {
+  team: TeamPayload;
+  lang: Lang;
+}
+const { team, lang } = Astro.props;
+const season = pickDefaultSeason(team.seasons);
+
+const title = `${team.name} — Matchday IQ`;
+const description = [team.name, team.country].filter(Boolean).join(" · ");
+
+// Home is a real target; Teams index + entity targets are not built yet → hrefless.
+const crumbs = [
+  { label: t(lang, "crumbHome"), href: localeHref(lang) },
+  { label: t(lang, "crumbTeams") },
+  { label: team.name ?? "" },
+];
+const links = [t(lang, "table"), t(lang, "topScorers"), t(lang, "linkSquad"), t(lang, "linkStats")];
+---
+
+<Layout lang={lang} title={title} description={description}>
+  <div class="inner">
+    <Breadcrumb items={crumbs} />
+    {season ? (
+      <>
+        <TeamHeader team={team} season={season} lang={lang} />
+        <RecordBlock season={season} lang={lang} />
+        <div class="tcols">
+          <div>
+            <YearOverYear season={season} lang={lang} />
+            <Streaks season={season} lang={lang} />
+            <TeamFixtures season={season} lang={lang} />
+          </div>
+          <div>
+            <SeasonStats season={season} lang={lang} />
+          </div>
+        </div>
+        <section aria-label={t(lang, "secExplore")}>
+          <SectionHead label={t(lang, "secExplore")} />
+          <div class="linkrow">{links.map((l) => <span class="linkchip">{l}</span>)}</div>
+        </section>
+      </>
+    ) : (
+      <div class="absent">{t(lang, "noSeasonData")}</div>
+    )}
+    <div class="footnote">{t(lang, "footnote")}</div>
+  </div>
+</Layout>
diff --git a/site_v2/src/styles/system.css b/site_v2/src/styles/system.css
index 4ae698d..0024fdd 100644
--- a/site_v2/src/styles/system.css
+++ b/site_v2/src/styles/system.css
@@ -194,4 +194,55 @@ section { margin-top: 36px; }
 .footnote { margin-top: 30px; font-size: 11px; color: var(--muted); text-align: center; opacity: .8; }
 .err { padding: 40px; color: #f26d6d; font-size: 14px; white-space: pre-wrap; }
 
+/* ================================================================ *
+ *  TEAM PROFILE components (extend the system; screen 02).          *
+ *  Single-team surface → no comparison green. Colour = meaning only: *
+ *  form pills = W/D/L status; YoY delta = better/worse; winless = a  *
+ *  negative streak. Hierarchy = tone/weight/size, as everywhere.     *
+ * ================================================================ */
+/* identity header */
+.thead { display: flex; align-items: center; gap: 16px; padding: 18px 0 22px; border-bottom: 1px solid var(--line); }
+.thead .id { min-width: 0; }
+.thead .nm { font-size: clamp(22px, 5cqw, 30px); font-weight: 700; line-height: 1.1; text-wrap: balance; }
+.thead .meta { font-size: 13px; color: var(--muted); margin-top: 5px; }
+.season-chip { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; background: var(--sunk); border: 1px solid var(--line); border-radius: 7px; padding: 6px 11px; font-size: 12.5px; font-weight: 600; color: var(--ink-2); }
+
+/* record block */
+.record { margin-top: 22px; }
+.record .top { display: flex; align-items: baseline; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; }
+.record .headline { font-size: 14px; color: var(--muted); font-variant-numeric: tabular-nums; }
+.record .headline b { font-size: 22px; font-weight: 700; color: var(--ink); }
+.record .line { font-size: 13px; color: var(--muted); margin-top: 12px; font-variant-numeric: tabular-nums; }
+.record .line b { color: var(--ink); font-weight: 700; }
+
+/* single-value stat row (season metrics list) */
+.srow { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 12px; padding: 9px 0; border-bottom: 1px solid var(--line); }
+.srow:last-child { border-bottom: 0; }
+.srow .lbl { font-size: 13px; color: var(--muted); }
+.srow .lbl small { display: block; font-size: 11px; opacity: .8; }
+.srow .val { font-size: 16px; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
+
+/* year-over-year aligned rows */
+.yoy-row { display: grid; grid-template-columns: 1fr auto auto auto; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); font-variant-numeric: tabular-nums; }
+.yoy-row:last-child { border-bottom: 0; }
+.yoy-row .lbl { font-size: 13px; color: var(--muted); }
+.yoy-row .now { font-size: 16px; font-weight: 700; color: var(--ink); }
+.yoy-row .delta { font-size: 13px; font-weight: 700; }
+.yoy-row .delta.up { color: var(--accent); }
+.yoy-row .delta.down { color: var(--loss); }
+.yoy-row .delta.flat { color: var(--muted); }
+.yoy-row .prev { font-size: 12px; color: var(--muted); }
+.absent { font-size: 13px; color: var(--muted); margin-top: 6px; }
+
+/* streak chips */
+.streaks { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
+.streak { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; border-radius: 7px; font-size: 12.5px; font-weight: 600; background: var(--sunk); border: 1px solid var(--line); color: var(--ink-2); font-variant-numeric: tabular-nums; }
+.streak b { color: var(--ink); font-weight: 700; }
+.streak.neg, .streak.neg b { color: var(--loss); }
+
+/* profile body: two columns on wide containers */
+@container (min-width: 720px) {
+  .tcols { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 34px; align-items: start; }
+}
+
 @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
