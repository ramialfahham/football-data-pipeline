diff --git a/dbt_project/seeds/schema.yml b/dbt_project/seeds/schema.yml
index 2caeca5c..852b22b3 100644
--- a/dbt_project/seeds/schema.yml
+++ b/dbt_project/seeds/schema.yml
@@ -1275,6 +1275,42 @@ seeds:
         description: "The hand working: the player-season, the matches counted, each sum, and every cleaning rule that changed an input."
         tests: [not_null]
 
+  - name: competition_season_map
+    description: >
+      Our own placing of every club competition edition in a season, reviewed by hand, so no season
+      depends on the provider's labels or dates. A season is a league season plus every club
+      competition edition that belongs to it. A split-year season runs from 1 July to 30 June, a
+      calendar-year season from 1 January to 31 December. An edition belongs to one season as a
+      whole; the Super Cup and qualifiers open the new season. Each edition carries both seasons,
+      because a split-year league and a calendar-year league read it differently: the CONCACAF
+      Champions Cup 2026 is 2025/26 for Liga MX and 2026 for MLS. A new edition needs a row.
+    tests:
+      - dbt_utils.unique_combination_of_columns:
+          combination_of_columns: [league_code, season_api_year]
+    columns:
+      - name: league_code
+        description: "{{ doc('league_code') }}"
+        tests: [not_null]
+      - name: season_api_year
+        description: "{{ doc('season_api_year') }}"
+        tests: [not_null]
+      - name: season_type
+        description: "The edition's own kind of season: split_year or calendar_year."
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["split_year", "calendar_year"]
+      - name: split_year_season
+        description: "The split-year season the edition belongs to, by its start year: 2025 is 2025/26."
+        tests: [not_null]
+      - name: calendar_year_season
+        description: "The calendar-year season the edition belongs to."
+        tests: [not_null]
+      - name: previous_season_api_year
+        description: "The provider year of the same competition's season before this one. Blank on the first edition held."
+      - name: note
+        description: "Why the row reads as it does, where a plain date reading would not explain it."
+
   - name: player_window_answer_key
     description: >
       Hand-worked values for a real player over a whole window of the Player page, added up from
diff --git a/dbt_project/tests/assert_season_map_covers_club_editions.sql b/dbt_project/tests/assert_season_map_covers_club_editions.sql
new file mode 100644
index 00000000..5b401927
--- /dev/null
+++ b/dbt_project/tests/assert_season_map_covers_club_editions.sql
@@ -0,0 +1,17 @@
+{#
+  Every club competition edition with a fixture has a row in competition_season_map. Returns each
+  edition without one.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+select distinct
+    f.league_code,
+    f.season_api_year
+from {{ ref('fct_fixture') }} as f
+inner join {{ ref('competition_registry') }} as reg
+    on f.league_code = reg.league_code
+inner join {{ ref('competition_types') }} as typ
+    on reg.competition_type = typ.competition_type
+left join {{ ref('competition_season_map') }} as m
+    on f.league_code = m.league_code and f.season_api_year = m.season_api_year
+where typ.entity_type = 'club' and m.league_code is null
diff --git a/dbt_project/tests/assert_season_map_places_known_editions.sql b/dbt_project/tests/assert_season_map_places_known_editions.sql
new file mode 100644
index 00000000..8ed467cc
--- /dev/null
+++ b/dbt_project/tests/assert_season_map_places_known_editions.sql
@@ -0,0 +1,62 @@
+{#
+  Known placings a fan can check: which editions a league season holds and which it must not.
+  Returns each case the windows get wrong.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with cases as (
+    select
+        anchor_league,
+        anchor_year,
+        window_type,
+        member_league,
+        member_year,
+        expected
+    from unnest([
+        struct(
+            'BL1' as anchor_league, 2025 as anchor_year, 'this_season' as window_type,
+            'UCL' as member_league, 2025 as member_year, true as expected
+        ),
+        ('BL1', 2025, 'this_season', 'UESC', 2025, true),
+        ('BL1', 2025, 'this_season', 'CWC', 2025, false),
+        ('BL1', 2024, 'this_season', 'CWC', 2025, true),
+        ('BL1', 2026, 'last_season', 'DFBP', 2025, true),
+        ('VL', 2026, 'this_season', 'UECL', 2026, true),
+        ('VL', 2026, 'this_season', 'UECL', 2025, false),
+        ('VL', 2026, 'last_season', 'UECL', 2025, true),
+        ('LMX', 2025, 'this_season', 'CCCU', 2026, true),
+        ('MLS', 2026, 'this_season', 'CCCU', 2026, true),
+        ('KL1', 2025, 'this_season', 'AFCCL', 2025, true),
+        ('KL1', 2026, 'this_season', 'AFCCL', 2025, false),
+        ('J1', 2027, 'this_season', 'AFCCL', 2026, true),
+        ('J1', 2027, 'last_season', 'J1', 2026, true)
+    ])
+),
+
+seasons as (
+    select
+        season_sk,
+        league_code,
+        season_api_year
+    from {{ ref('dim_competition_season') }}
+),
+
+found as (
+    select
+        c.*,
+        w.season_sk is not null as is_member
+    from cases as c
+    left join seasons as a
+        on c.anchor_league = a.league_code and c.anchor_year = a.season_api_year
+    left join seasons as m
+        on c.member_league = m.league_code and c.member_year = m.season_api_year
+    left join {{ ref('int_competition_season__club_windows') }} as w
+        on
+            a.season_sk = w.anchor_season_sk
+            and m.season_sk = w.season_sk
+            and c.window_type = w.window_type
+)
+
+select *
+from found
+where is_member != expected
