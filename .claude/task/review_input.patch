+        description: "GK/DEF/MID/ATT, mapped from the match-time position_code (G/D/M/F)."
+        tests:
+          - not_null
+          - accepted_values:
+              values: ["GK", "DEF", "MID", "ATT"]
+      - name: minutes
+        description: "Minutes played IN this position this competition-season (the >= 270 benchmark floor)."
+        tests: [not_null]
