+        tests: [not_null]
+      - name: category_label_en
+        description: "From competition_types.label_en — the category heading text."
+        tests: [not_null]
+      - name: category_label_i18n_key
+        description: "From competition_types.label_i18n_key — the category heading's i18n key."
+        tests: [not_null]
+      - name: confederation
+        description: "From competition_registry.confederation — also a page filter axis."
+        tests:
+          - not_null
+          - relationships:
