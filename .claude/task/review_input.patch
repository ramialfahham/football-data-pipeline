+---
+// Breadcrumb: Home › {competition} › Matches. Items with an href render as links;
+// targets not yet built in v2 (competition hub) are passed hrefless → plain text
+// (no dead links this increment; wire hrefs when those pages land).
+export interface Crumb {
+  label: string;
+  href?: string;
+}
+interface Props {
+  items: Crumb[];
+}
+const { items } = Astro.props;
+---
+
+<nav class="crumb" aria-label="Breadcrumb">
+  {items.map((c, i) => (
+    <>
+      {i > 0 && <span class="sep">›</span>}
+      {c.href ? <a class="lnk" href={c.href}>{c.label}</a> : <span>{c.label}</span>}
+    </>
+  ))}
+</nav>
diff --git a/site_v2/src/components/fixture/FormSegment.astro b/site_v2/src/components/fixture/FormSegment.astro
new file mode 100644
index 0000000..294cc1a
--- /dev/null
+++ b/site_v2/src/components/fixture/FormSegment.astro
@@ -0,0 +1,108 @@
+---
+// Form comparison: the Last-5 (W1) / This-season (W2) segment + both windows'
+// headers, form strings, captions and the 16-row comparison. The toggle is JS-FREE
+// — two hidden radios drive a CSS `:checked` sibling switch (both windows are in the
+// HTML and crawlable), which defers the island-framework decision (#362). W1 shows
+// result pills; W2 shows W/D/L count chips (falls back to the header when the counts
+// are absent). Captions declare the window's scope (all-competitions vs this league).
+import SectionHead from "../ui/SectionHead.astro";
+import MetricComparison from "./MetricComparison.astro";
+import { pointsFraction } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { asNumber } from "../../lib/types";
+import type { Fixture, Side } from "../../lib/types";
+
+interface Props {
+  fixture: Fixture;
+  lang: Lang;
+}
+const { fixture, lang } = Astro.props;
+const { home, away } = fixture;
+
+// form_window is served already ordered by recency_rank (export_site_data.py) — the
+// display order is the served order; no client-side sort (never re-rank served rows).
+const results = (side: Side): string[] =>
+  (side.form_window ?? []).map((m) => m.result ?? "").filter(Boolean);
+
+// W1 scope caption: cross-competition, plus any competitions beyond this fixture's own
+// (unioned across both sides, from the served contributing_competitions), plus a
+// coverage note when a window has fewer stat-covered games than games played.
+function w1Caption(): string {
+  const own = fixture.league_code;
+  const others = new Set<string>();
+  for (const s of [home, away]) {
+    for (const c of s.w1?.contributing_competitions ?? []) if (c !== own) others.add(c);
+  }
+  let cap = others.size
+    ? `${t(lang, "scopeAllComps")} · ${t(lang, "incl")} ${[...others].join(", ")}`
+    : t(lang, "scopeAllComps");
+  for (const s of [home, away]) {
+    const gts = asNumber(s.w1?.games_with_team_stats);
+    const giw = asNumber(s.w1?.games_in_window);
+    if (gts != null && giw != null && gts < giw) {
+      cap += ` · ${t(lang, "statsCoverage", { a: gts, b: giw })}`;
+      break;
+    }
+  }
+  return cap;
+}
+
+function w2Caption(): string {
+  const n = asNumber(home.w2?.games_played) ?? asNumber(away.w2?.games_played);
+  const league = fixture.league_name ?? fixture.league_code;
+  return n != null ? `${league} · ${t(lang, "throughMatchday", { n })}` : league;
+}
+---
+
+<section aria-label={t(lang, "secForm")}>
+  <SectionHead label={t(lang, "secForm")} />
+  <input class="seg-in" type="radio" name="win" id="seg-w1" checked />
+  <input class="seg-in" type="radio" name="win" id="seg-w2" />
+  <div class="seg" role="group" aria-label={t(lang, "secForm")}>
+    <label class="seg-btn" for="seg-w1">{t(lang, "segLast5")}</label>
+    <label class="seg-btn" for="seg-w2">{t(lang, "segSeason")}</label>
+  </div>
+
+  <div class="win win-w1">
+    <div class="formrow">
+      {[home, away].map((side, i) => (
+        <div class:list={["side", i === 0 ? "home" : "away"]}>
+          <div class="wmeta">
+            <b>{pointsFraction(side.w1?.points_won, side.w1?.games_in_window, lang)}</b> {t(lang, "pts")}
+          </div>
+          {results(side).length ? (
+            <div class="pills">
+              {results(side).map((r) => <span class:list={["pill", r]}>{r}</span>)}
+            </div>
+          ) : (
+            <div class="scope">{t(lang, "noRecentForm")}</div>
+          )}
+        </div>
+      ))}
+    </div>
+    <div class="caption">{w1Caption()}</div>
+    <MetricComparison home={home.w1} away={away.w1} windowKey="w1" lang={lang} homeName={home.name} awayName={away.name} />
+  </div>
+
+  <div class="win win-w2">
+    <div class="formrow">
+      {[home, away].map((side, i) => (
+        <div class:list={["side", i === 0 ? "home" : "away"]}>
+          <div class="wmeta">
+            <b>{pointsFraction(side.w2?.points_won, side.w2?.games_played, lang)}</b> {t(lang, "pts")}
+          </div>
+          {side.w2?.wins != null && side.w2?.draws != null && side.w2?.losses != null && (
+            <div class="cchips">
+              <span class="cchip W">{side.w2.wins} <small>W</small></span>
+              <span class="cchip D">{side.w2.draws} <small>D</small></span>
+              <span class="cchip L">{side.w2.losses} <small>L</small></span>
+            </div>
+          )}
+        </div>
+      ))}
+    </div>
+    <div class="caption">{w2Caption()}</div>
+    <MetricComparison home={home.w2} away={away.w2} windowKey="w2" lang={lang} homeName={home.name} awayName={away.name} />
+  </div>
+</section>
diff --git a/site_v2/src/components/fixture/HeadToHead.astro b/site_v2/src/components/fixture/HeadToHead.astro
new file mode 100644
index 0000000..c4399b3
--- /dev/null
+++ b/site_v2/src/components/fixture/HeadToHead.astro
@@ -0,0 +1,59 @@
+---
+// Head-to-head (perspective = home team): record numbers coloured to the W/D/L bar,
+// the stacked record bar, and the recent-meetings list (which leads with the last
+// meeting — the separate "last meeting" line was dropped as a duplicate). "First-ever
+// meeting" when there is no record. All raw served facts; the bar widths are display.
+import SectionHead from "../ui/SectionHead.astro";
+import { formatShortDate } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { stackShares } from "../../lib/bars";
+import { t } from "../../i18n/strings";
+import type { HeadToHead } from "../../lib/types";
+
+interface Props {
+  h2h?: HeadToHead | null;
+  homeName?: string | null;
+  awayName?: string | null;
+  lang: Lang;
+}
+const { h2h, homeName, awayName, lang } = Astro.props;
+const has = Boolean(h2h && (h2h.total_meetings ?? 0) > 0);
+const shares = stackShares(h2h?.wins, h2h?.draws, h2h?.losses);
+const meetings = h2h?.recent_meetings ?? [];
+---
+
+<section aria-label={t(lang, "secH2H")}>
+  <SectionHead label={t(lang, "secH2H")} />
+  {has ? (
+    <>
+      <div class="h2h-top">
+        <div class="h2h-rec">
+          <b class="cw">{h2h?.wins}</b> <span class="nm">{homeName}</span> &nbsp;·&nbsp;
+          <b>{h2h?.draws}</b> <span class="nm">{t(lang, "draws")}</span> &nbsp;·&nbsp;
+          <b class="cl">{h2h?.losses}</b> <span class="nm">{awayName}</span>
+        </div>
+        <div class="h2h-meta">
+          {h2h?.total_meetings} {t(lang, "meetings")}<br />
+          {h2h?.goals_for}:{h2h?.goals_against} {t(lang, "goalsWord")}
+        </div>
+      </div>
+      <div class="h2h-bar" aria-hidden="true">
+        <span class="w" style={`width:${shares.w}%`}></span>
+        <span class="d" style={`width:${shares.d}%`}></span>
+        <span class="l" style={`width:${shares.l}%`}></span>
+      </div>
+      <div class="h2h-list">
+        {meetings.map((m) => (
+          <div class="rmatch">
+            <span class:list={["res", m.result]}>{m.result}</span>
+            <span class="rscore">{m.goals_for}–{m.goals_against}</span>
+            <span class="ropp">{m.league_code}</span>
+            <span class="rmeta">{formatShortDate(m.kickoff_datetime, lang)}</span>
+          </div>
+        ))}
+      </div>
+    </>
+  ) : (
+    <div class="h2h-last">{t(lang, "firstMeeting")}</div>
+  )}
+</section>
