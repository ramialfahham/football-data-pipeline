+++ b/site_v2/src/components/fixture/NarrativeSlot.astro
@@ -0,0 +1,33 @@
+---
+// "About this match" — sits at the TOP under the header (design memory
+// project_v2_frontend_design). A TEMPLATED factual sentence built only from served
+// values (matchup, round, h2h count + record); never fabricated prose. The
+// data-to-text / grounded-generation version is GAP-03 (a future AI consumer).
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import type { Fixture } from "../../lib/types";
+
+interface Props {
+  fixture: Fixture;
+  lang: Lang;
+}
+const { fixture, lang } = Astro.props;
+const h2h = fixture.head_to_head;
+const base = {
+  home: fixture.home.name ?? "",
+  away: fixture.away.name ?? "",
+  round: fixture.round ?? "",
+};
+
+let text: string;
+if (h2h && h2h.total_meetings != null) {
+  const record = `${h2h.wins ?? 0}–${h2h.draws ?? 0}–${h2h.losses ?? 0}`;
+  text = t(lang, "aboutWithH2h", { ...base, meetings: h2h.total_meetings, record });
+} else {
+  text = t(lang, "aboutNoH2h", base);
+}
+---
+
+<div class="lede">
+  <p>{text}</p>
+</div>
diff --git a/site_v2/src/components/fixture/PlayerRow.astro b/site_v2/src/components/fixture/PlayerRow.astro
