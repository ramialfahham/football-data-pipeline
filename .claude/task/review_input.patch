diff --git a/dbt_project/tests/assert_knockout_tie_has_one_winner.sql b/dbt_project/tests/assert_knockout_tie_has_one_winner.sql
new file mode 100644
index 00000000..76e1ef81
--- /dev/null
+++ b/dbt_project/tests/assert_knockout_tie_has_one_winner.sql
@@ -0,0 +1,33 @@
+-- A decided knockout tie has exactly one winner: of its two team rows one won and one lost, and
+-- both read the same decision. Returns each tie whose two rows disagree.
+
+{{ config(store_failures = true) }}
+
+with ties as (
+    select
+        league_code,
+        season_api_year,
+        round_name,
+        won,
+        decided_by,
+        least(team_sk, opponent_team_sk) as team_a,
+        greatest(team_sk, opponent_team_sk) as team_b
+    from {{ ref('int_knockout_ties') }}
+)
+
+select
+    league_code,
+    season_api_year,
+    round_name,
+    team_a,
+    team_b,
+    count(*) as team_rows,
+    countif(won) as winners,
+    countif(not won) as losers,
+    count(distinct coalesce(decided_by, 'undecided')) as decisions
+from ties
+group by league_code, season_api_year, round_name, team_a, team_b
+having
+    count(*) != 2
+    or count(distinct coalesce(decided_by, 'undecided')) != 1
+    or (countif(won is not null) > 0 and (countif(won) != 1 or countif(not won) != 1))
diff --git a/dbt_project/tests/assert_team_competitions_knocked_out_has_no_later_fixture.sql b/dbt_project/tests/assert_team_competitions_knocked_out_has_no_later_fixture.sql
new file mode 100644
index 00000000..8bea7107
--- /dev/null
+++ b/dbt_project/tests/assert_team_competitions_knocked_out_has_no_later_fixture.sql
@@ -0,0 +1,73 @@
+-- A team knocked out of a competition has no fixture in a later round of it that season, and a
+-- winner neither; a third-place match is not a later round, as the mart leaves it out of the
+-- round reached. Returns each such team with the later fixture.
+
+{{ config(store_failures = true) }}
+
+with competitions as (
+    select
+        team_sk,
+        league_code,
+        season_api_year,
+        reached_round_name,
+        cup_status
+    from {{ ref('mart_team_competitions') }}
+    where cup_status in ('knocked_out', 'winners')
+),
+
+round_kinds as (
+    select
+        league_code,
+        season_api_year,
+        round_name,
+        round_stage_kind
+    from {{ ref('int_round_names') }}
+),
+
+fixtures as (
+    select
+        f.fixture_sk,
+        f.league_code,
+        f.season_api_year,
+        f.round_name,
+        f.round_sequence,
+        f.home_team_sk,
+        f.away_team_sk
+    from {{ ref('mart_competition_fixtures') }} as f
+    left join round_kinds as rk
+        on
+            f.league_code = rk.league_code
+            and f.season_api_year = rk.season_api_year
+            and f.round_name = rk.round_name
+    where coalesce(rk.round_stage_kind, '') != 'placement'
+),
+
+reached_sequence as (
+    select distinct
+        c.team_sk,
+        c.league_code,
+        c.season_api_year,
+        c.cup_status,
+        f.round_sequence
+    from competitions as c
+    inner join fixtures as f
+        on
+            c.league_code = f.league_code
+            and c.season_api_year = f.season_api_year
+            and c.reached_round_name = f.round_name
+)
+
+select
+    r.team_sk,
+    r.league_code,
+    r.season_api_year,
+    r.cup_status,
+    f.fixture_sk as later_fixture_sk,
+    f.round_name as later_round_name
+from reached_sequence as r
+inner join fixtures as f
+    on
+        r.league_code = f.league_code
+        and r.season_api_year = f.season_api_year
+        and r.team_sk in (f.home_team_sk, f.away_team_sk)
+        and r.round_sequence < f.round_sequence
diff --git a/dbt_project/tests/assert_team_competitions_one_winner.sql b/dbt_project/tests/assert_team_competitions_one_winner.sql
