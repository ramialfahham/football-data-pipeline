+-++// team's perspective) + opponent + H/A + competition-round · date. Deep-links to the
+-++// per-match page are inert this increment (GAP-19). All served facts; round_name is
+-++// shown as served (no prettifying — that would be a derivation).
+-++import { formatShortDate, integer } from "../../lib/format";
+-++import type { Lang } from "../../lib/format";
+-++import type { TeamFixture } from "../../lib/types";
+-++
+-++interface Props {
+-++  fx: TeamFixture;
+-++  lang: Lang;
+-++}
+-++const { fx, lang } = Astro.props;
+-++
+-++const played = fx.result != null;
+-++const ha = fx.is_home === true ? "H" : fx.is_home === false ? "A" : "";
+-++const meta = [fx.round_name, formatShortDate(fx.kickoff_datetime, lang)].filter(Boolean).join(" · ");
+-++---
+-++
+-++<div class="rmatch">
+-++  {played ? <span class:list={["res", fx.result]}>{fx.result}</span> : <span class="res">–</span>}
+-++  <span class="rscore">{played ? `${integer(fx.goals_for, lang)}–${integer(fx.goals_against, lang)}` : ""}</span>
+-++  <span class="ropp">{fx.opponent_name}{ha && <span class="ha">{ha}</span>}</span>
+-++  <span class="rmeta">{meta}</span>
+-++</div>
+-+diff --git a/site_v2/src/components/team/TeamFixtures.astro b/site_v2/src/components/team/TeamFixtures.astro
+-+new file mode 100644
+-+index 0000000..5377545
+-+--- /dev/null
+-++++ b/site_v2/src/components/team/TeamFixtures.astro
+-+@@ -0,0 +1,44 @@
+-++---
+-++// Fixtures block (mock f6348775 .nextfx + .recent): the next fixture as a highlighted
+-++// card (when present) + the last-5 results list (GAP-15). Each is an honest absent
+-++// state — the card is omitted when there is no upcoming fixture, the list when there
+-++// are no recent results, the whole section when neither. All served facts.
+-++import SectionHead from "../ui/SectionHead.astro";
+-++import TeamFixtureRow from "./TeamFixtureRow.astro";
+-++import { formatShortDate, formatTime } from "../../lib/format";
+-++import type { Lang } from "../../lib/format";
+-++import { t } from "../../i18n/strings";
+-++import type { TeamSeason } from "../../lib/types";
+-++
+-++interface Props {
+-++  season: TeamSeason;
+-++  lang: Lang;
+-++}
+-++const { season: s, lang } = Astro.props;
+-++
+-++const nxt = s.next_fixture ?? null;
+-++const recent = s.recent_results ?? [];
+-++const hasAny = Boolean(nxt) || recent.length > 0;
+-++const nextHa = nxt?.is_home === true ? t(lang, "fxHome") : nxt?.is_home === false ? t(lang, "fxAway") : "";
+-++---
+-++
+-++{hasAny && (
+-++  <section aria-label={t(lang, "secFixtures")}>
+-++    <SectionHead label={t(lang, "secFixtures")} />
+-++    {nxt && (
+-++      <div class="nextfx">
+-++        <span class="tag">{nxt.round_name ?? t(lang, "fxNext")}</span>
+-++        <div class="opp">
+-++          <div class="nm">{nxt.opponent_name}</div>
+-++          {nextHa && <div class="sub">{nextHa}</div>}
+-++        </div>
+-++        <div class="when"><b>{formatTime(nxt.kickoff_datetime, lang)}</b>{formatShortDate(nxt.kickoff_datetime, lang)}</div>
+-++      </div>
+-++    )}
+-++    {recent.length > 0 && (
+-++      <div class="recent">
+-++        {recent.map((fx) => <TeamFixtureRow fx={fx} lang={lang} />)}
+-++      </div>
+-++    )}
+-++  </section>
+-++)}
+-+diff --git a/site_v2/src/components/team/TeamHeader.astro b/site_v2/src/components/team/TeamHeader.astro
+-+new file mode 100644
