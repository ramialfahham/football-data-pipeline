+        client.get_table(f"{GCP_PROJECT_ID}.{DATASET_ID}.{raw_table(entity)}")
+        return True
+    except NotFound:
+        return False
+
+
+def per_team_expectations_from_results(results: list[Any]) -> dict[str, dict[str, Any]]:
