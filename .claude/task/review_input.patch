+def _lineup(starters: int = 11) -> dict:
+    return {"startXI": [{"player": {"id": i}} for i in range(starters)], "substitutes": []}
+
+
+def _player(conceded=None) -> dict:
+    return {"player": {"id": 1}, "statistics": [{"goals": {"conceded": conceded}}]}
