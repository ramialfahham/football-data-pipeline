+---
+// The one chart legend, above its chart: a key per mark, each followed by its name. The keys are the
+// chart's own marks: the team's dot, the other teams' dot, a reference line, a gap line.
+interface Props {
+  keys: { mark: "team" | "other" | "ref" | "gap"; label: string }[];
+}
+const { keys } = Astro.props;
+const MARK = { team: "chart-dot chart-me", other: "chart-dot", ref: "chart-line chart-ref", gap: "chart-line chart-gap" };
+---
+
+<div class="chart-legend" aria-hidden="true">
+  {keys.map((k) => <span class="chart-key"><i class={MARK[k.mark]}></i>{k.label}</span>)}
+</div>
