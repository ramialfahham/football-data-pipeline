+#mk-prop:checked ~ .mk-page .mk-cur { color: var(--ink) !important; font-weight: 700 !important; }
+#mk-prop:checked ~ .mk-page .mainnav .mk-cur { border-radius: 0; box-shadow: inset 0 -2px 0 var(--ink); }
