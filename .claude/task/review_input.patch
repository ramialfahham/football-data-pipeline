diff --git a/site_v2/src/components/competition/CompetitionHeader.astro b/site_v2/src/components/competition/CompetitionHeader.astro
new file mode 100644
index 00000000..7e07d5db
--- /dev/null
+++ b/site_v2/src/components/competition/CompetitionHeader.astro
@@ -0,0 +1,35 @@
+---
+// The competition page's header: crest, name, and the meta line region · season · round. Every
+// value is a served field; the region label falls back to its English form until every region
+// has a copy key, and the round is the provider's text until the warehouse serves a phase the
+// site can translate. A part that is not served is left out of the line.
+import Crest from "../ui/Crest.astro";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+
+interface Props {
+  name: string | null;
+  crest: string | null;
+  regionLabelEn: string | null;
+  regionLabelI18nKey: string | null;
+  season: number | null;
+  round: string | null;
+  lang: Lang;
+}
+const { name, crest, regionLabelEn, regionLabelI18nKey, season, round, lang } = Astro.props;
+
+const region = regionLabelI18nKey ? t(lang, regionLabelI18nKey) : regionLabelEn;
+const meta = [
+  region,
+  season != null ? t(lang, "compSeason", { season }) : null,
+  round,
+].filter(Boolean);
+---
+
+<header class="thead">
+  <Crest name={name} crest={crest} />
+  <div class="tid">
+    <h1>{name}</h1>
+    {meta.length > 0 && <div class="meta">{meta.join(" · ")}</div>}
+  </div>
+</header>
diff --git a/site_v2/src/components/competition/CompetitionTabs.astro b/site_v2/src/components/competition/CompetitionTabs.astro
new file mode 100644
index 00000000..e5849ed9
--- /dev/null
+++ b/site_v2/src/components/competition/CompetitionTabs.astro
@@ -0,0 +1,31 @@
+---
+// The competition page's tab bar. Each tab is a standalone page; only the Overview exists, so the
+// other three render as labels without a link until each page is built — the build refuses a link
+// to a page it did not emit, and a tab's URL is settled with that tab's review. A cup or tournament
+// reads "Rounds" where a league reads "Matchdays".
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+
+interface Props {
+  lang: Lang;
+  hasMatchdays: boolean;
+}
+const { lang, hasMatchdays } = Astro.props;
+
+const tabs = [
+  { key: "overview", label: t(lang, "compTabOverview"), active: true },
+  { key: "matchdays", label: t(lang, hasMatchdays ? "compTabMatchdays" : "compTabRounds"), active: false },
+  { key: "teams", label: t(lang, "compTabTeams"), active: false },
+  { key: "players", label: t(lang, "compTabPlayers"), active: false },
+];
+---
+
+<nav class="tabs comp-tabs" aria-label={t(lang, "compTabsAria")}>
+  {tabs.map((tb) =>
+    tb.active ? (
+      <span class="tab on" aria-current="page">{tb.label}</span>
+    ) : (
+      <span class="tab" aria-disabled="true">{tb.label}</span>
+    ),
+  )}
+</nav>
diff --git a/site_v2/src/components/competition/DeservedPoints.astro b/site_v2/src/components/competition/DeservedPoints.astro
new file mode 100644
index 00000000..16669050
--- /dev/null
+++ b/site_v2/src/components/competition/DeservedPoints.astro
@@ -0,0 +1,59 @@
+---
+// Deserved points on the competition page: the explanation, then two three-row boards from the
+// served deserved order (mart_team_profile: points, deserved_points, deserved_points_gap). The gap
+// is the catalogue's, actual minus deserved, so "better than the table says" carries the negative
+// numbers and "worse" the positive ones. Rows in the table's style; the bold sits on Diff, the
+// number the boards are ordered by. Renders nothing unless the model fitted this competition.
+import Crest from "../ui/Crest.astro";
+import SectionHead from "../ui/SectionHead.astro";
+import { decimal1, integer, signedDelta } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { localeHref } from "../../lib/href";
+import { deservedBoards } from "../../lib/competitionPayload.mjs";
+import type { DeservedRow } from "../../lib/types";
+
+interface Props {
+  deserved: DeservedRow[];
+  lang: Lang;
+}
+const { deserved, lang } = Astro.props;
+const boards = deservedBoards(deserved);
+const list = boards
+  ? [
+      { key: "compBetter", rows: boards.better as DeservedRow[] },
+      { key: "compWorse", rows: boards.worse as DeservedRow[] },
+    ]
+  : [];
+---
+
+{boards && (
+  <section>
+    <SectionHead label={t(lang, "compSecDeserved")} />
+    <p class="bsub">{t(lang, "compDeservedExplainer")}</p>
+    {list.map((board) => (
+      <div class="board">
+        <div class="bhd"><span class="bt">{t(lang, board.key)}</span></div>
+        <div class="ctab dp">
+          <div class="ctab-head">
+            <span class="h nmh"></span>
+            <span class="h">{t(lang, "compColDeserved")}</span>
+            <span class="h">{t(lang, "compColPoints")}</span>
+            <span class="h">{t(lang, "compColDiff")}</span>
+          </div>
+          {board.rows.map((row) => (
+            <a class="ctab-row" href={row.slug ? localeHref(lang, `teams/${row.slug}/`) : undefined}>
+              <span class="tm">
+                <Crest name={row.name} crest={row.crest} size="xs" />
+                <span class="nm">{row.name}</span>
+              </span>
+              <span class="n num">{decimal1(row.deserved_points, lang)}</span>
+              <span class="n num">{integer(row.points, lang)}</span>
+              <span class="n num pts">{signedDelta(row.deserved_points_gap, "decimal_1", lang).value}</span>
+            </a>
+          ))}
+        </div>
+      </div>
+    ))}
+  </section>
+)}
diff --git a/site_v2/src/components/competition/NextMatchday.astro b/site_v2/src/components/competition/NextMatchday.astro
new file mode 100644
index 00000000..45555345
--- /dev/null
+++ b/site_v2/src/components/competition/NextMatchday.astro
@@ -0,0 +1,26 @@
+---
+// Next matches on the competition page: Home's block for one competition, the same row, every
+// row a link to its match page, no fold and no competition heading (the competition is the page's
+// h1). Renders nothing when the payload carries no next matchday.
+import FixtureRow from "../home/FixtureRow.astro";
+import SectionHead from "../ui/SectionHead.astro";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import type { FixtureRef } from "../../lib/types";
+
+interface Props {
+  fixtures: FixtureRef[];
+  competitionSlug: string | null;
+  lang: Lang;
+}
+const { fixtures, competitionSlug, lang } = Astro.props;
+---
+
+{fixtures.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "compSecNext")} />
+    <div class="fxgroup">
+      {fixtures.map((fx) => <FixtureRow fx={fx} competitionSlug={competitionSlug} lang={lang} />)}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/competition/SeasonFacts.astro b/site_v2/src/components/competition/SeasonFacts.astro
new file mode 100644
index 00000000..75683569
--- /dev/null
+++ b/site_v2/src/components/competition/SeasonFacts.astro
@@ -0,0 +1,131 @@
+---
+// The season in numbers: one fact row per served fact (mart_competition_season_summary, plus the
+// next matchday's flagged fixture). A fact row is label · value · context; wide screens put the
+// value and its context on the right, a phone stacks them. A null served value is no row. Team
+// facts link to the first team named; the match that matters links to its match page; a played
+// match has no page and its row does not link. Names, rounds and dates never break inside
+// themselves. A score reads home–away with the en dash, as every score on the site does.
+import SectionHead from "../ui/SectionHead.astro";
+import { decimal1, formatShortDate, formatTime, integer } from "../../lib/format";
+import type { Lang } from "../../lib/format";
+import { t } from "../../i18n/strings";
+import { localeHref } from "../../lib/href";
+import { matchThatMatters, seasonFacts } from "../../lib/competitionPayload.mjs";
+import type { FixtureRef, SeasonSummary, TeamRef } from "../../lib/types";
+
+interface Props {
+  summary: SeasonSummary | null;
+  nextMatchday: FixtureRef[];
+  competitionSlug: string | null;
+  lang: Lang;
+}
+const { summary, nextMatchday, competitionSlug, lang } = Astro.props;
+
+interface Piece {
+  text: string;
+  nb?: boolean;
+}
+interface Row {
+  label: string;
+  value: Piece[];
+  context: Piece[];
+  href?: string;
+}
+
+const vs = t(lang, "compVs");
+
+function teamHref(team: TeamRef | undefined): string | undefined {
+  return team?.slug ? localeHref(lang, `teams/${team.slug}/`) : undefined;
+}
+function score(fx: FixtureRef): string {
+  return `${integer(fx.goals_home, lang)}–${integer(fx.goals_away, lang)}`;
+}
+function matchPieces(fx: FixtureRef): Piece[] {
+  const pieces: Piece[] = [
+    { text: fx.home.name ?? "", nb: true },
+    { text: ` ${vs} ` },
+    { text: fx.away.name ?? "", nb: true },
+  ];
+  if (fx.round) pieces.push({ text: ", " }, { text: fx.round, nb: true });
+  return pieces;
+}
+function teamPieces(teams: TeamRef[]): Piece[] {
+  return teams.flatMap((team, i) =>
+    i < teams.length - 1
+      ? [{ text: team.name ?? "", nb: true }, { text: ", " }]
+      : [{ text: team.name ?? "", nb: true }],
+  );
+}
+
+const rows: Row[] = [];
+for (const fact of seasonFacts(summary)) {
+  const v = fact.value;
+  const c = fact.context;
+  if (fact.key === "goalsPerMatch") {
+    rows.push({
+      label: t(lang, "compFactGoalsPerMatch"),
+      value: [{ text: decimal1(v.number, lang) }],
+      context: [{ text: t(lang, "compFactGoalsInMatches", { goals: integer(c.goals, lang), matches: integer(c.matches, lang) }) }],
+    });
+  } else if (fact.key === "homeWins") {
+    rows.push({
+      label: t(lang, "compFactHomeWins"),
+      value: [{ text: t(lang, "compFactOf", { count: integer(v.count, lang), of: integer(v.of, lang) }) }],
+      context: [{ text: t(lang, "compFactDrawsAway", { draws: integer(c.draws, lang), awayWins: integer(c.awayWins, lang) }) }],
+    });
+  } else if (fact.key === "biggestMargin" || fact.key === "mostGoals") {
+    rows.push({
+      label: t(lang, fact.key === "biggestMargin" ? "compFactBiggestMargin" : "compFactMostGoals"),
+      value: [{ text: score(c.match) }],
+      context: matchPieces(c.match),
+    });
+  } else {
+    rows.push({
+      label: t(lang, fact.key === "longestUnbeaten" ? "compFactLongestUnbeaten" : "compFactLongestWinless"),
+      value: [{ text: t(lang, "compFactMatches", { n: integer(v.matches, lang) }) }],
+      context: teamPieces(c.teams),
+      href: teamHref(c.teams[0]),
+    });
+  }
+}
+const matters = matchThatMatters(nextMatchday);
+if (matters) {
+  rows.push({
+    label: t(lang, "compFactMatchThatMatters"),
+    value: [
+      { text: matters.home.name ?? "", nb: true },
+      { text: ` ${vs} ` },
+      { text: matters.away.name ?? "", nb: true },
+    ],
+    context: [{ text: formatShortDate(matters.kickoff, lang), nb: true }, { text: `, ${formatTime(matters.kickoff, lang)}` }],
+    href: competitionSlug ? localeHref(lang, `${competitionSlug}/matches/${matters.slug}/`) : undefined,
+  });
+}
+---
+
+{rows.length > 0 && (
+  <section>
+    <SectionHead label={t(lang, "compSecFacts")} />
+    <div class="facts">
+      {rows.map((row) =>
+        row.href ? (
+          <a class="frow" href={row.href}>
+            <span class="fl">{row.label}</span>
+            <span class="fv">
+              <span class="fvv"><b>{row.value.map((p) => (p.nb ? <span class="nb">{p.text}</span> : p.text))}</b></span>
+              <span class="sub">{row.context.map((p) => (p.nb ? <span class="nb">{p.text}</span> : p.text))}</span>
+            </span>
+          </a>
+        ) : (
+          <div class="frow">
+            <span class="fl">{row.label}</span>
+            <span class="fv">
+              <span class="fvv"><b>{row.value.map((p) => (p.nb ? <span class="nb">{p.text}</span> : p.text))}</b></span>
+              <span class="sub">{row.context.map((p) => (p.nb ? <span class="nb">{p.text}</span> : p.text))}</span>
+            </span>
+          </div>
+        ),
+      )}
+    </div>
+  </section>
+)}
diff --git a/site_v2/src/components/competition/StandingsTable.astro b/site_v2/src/components/competition/StandingsTable.astro
