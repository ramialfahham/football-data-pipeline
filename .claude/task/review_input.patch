+    # query entirely and report everything as uncovered, which on such a run is the truth.
+    if blocks:
+        q = (
+            "SELECT DISTINCT entity, league_code, team_id FROM (\n"
+            + "\nUNION ALL\n".join(blocks)
+            + "\n)"
