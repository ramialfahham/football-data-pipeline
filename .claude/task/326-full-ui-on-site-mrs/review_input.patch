+
+def _gap(widths, off, note=""):
+    return f"{STAMP}gap counts: 14334 pages counted at {widths} px · {note}{off} off the baseline\n"
+
+
+def _off(line):
+    return f"{STAMP}FAIL  (counts) · 0 · - · (baseline) · {line}\n"
