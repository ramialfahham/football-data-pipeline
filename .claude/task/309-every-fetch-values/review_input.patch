+        coalesce(d.shots_on_target, if(d.shots_on_target_fill_allowed, d.donated_shots_on_target, null))
+            as shots_on_target,
+        coalesce(d.passes_accurate, d.donated_passes_accurate) as passes_accurate
+    from shot_totals as d
