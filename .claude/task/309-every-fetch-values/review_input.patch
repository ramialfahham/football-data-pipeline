+    'interceptions': 'tackles_interceptions', 'duels': 'duels_total', 'duels_won': 'duels_won',
+    'dribbles': 'dribbles_attempts', 'dribbles_success': 'dribbles_success',
+    'dribbles_against': 'dribbles_past', 'fouls': 'fouls_committed', 'fouls_against': 'fouls_drawn'
+} %}
+{%- set results = [
+    'goals_total', 'goals_assists', 'cards_yellow', 'cards_red', 'minutes_played', 'goals_against', 'saves',
+    'penalty_won', 'penalty_committed', 'penalty_scored', 'penalty_missed', 'penalty_saved'
+] %}
+
+with fetch_rows as (
+    select
+        stat_line.* replace (
+            if(stat_line.position_code in ('G', 'D', 'M', 'F'), stat_line.position_code, null) as position_code
+        ),
+        {{ fixture_player_id(
+            'stat_line.player_id', 'stat_line.fixture_id', 'stat_line.team_id', 'stat_line.shirt_number'
+        ) }} as kept_player_id,
+        logical_or(stat_line.goals_against is not null)
+            over (partition by stat_line.league_code, stat_line.fixture_id, stat_line.raw_ingested_at)
+            as fetch_is_complete
+    from {{ ref('stg_apif__fixture_players') }} as stat_line
+    where stat_line.fixture_id is not null and stat_line.team_id is not null
+),
+
+one_row_per_fetch as (
+    select
+        *,
+        raw_ingested_at = coalesce(
+            max(if(fetch_is_complete, raw_ingested_at, null)) over (partition by league_code, fixture_id),
+            max(raw_ingested_at) over (partition by league_code, fixture_id)
+        ) as is_picked
+    from fetch_rows
+    where kept_player_id is not null and kept_player_id != 0
+    qualify row_number() over (
+        partition by league_code, fixture_id, kept_player_id, raw_ingested_at
+        order by
+            (
+                select countif(stat is not null)
+                from unnest([
+                    {%- for column in results + (stats.values() | list) %}
+                    cast({{ column }} as string){{ ',' if not loop.last }}
+                    {%- endfor %}
+                ]) as stat
+            ) desc,
+            to_json_string(fetch_rows) asc
+    ) = 1
+),
+
+picked as (
+    select *
+    from one_row_per_fetch
+    where is_picked
+),
+
+donors as (
+    select o.*
+    from one_row_per_fetch as o
+    inner join picked as p
+        on o.league_code = p.league_code and o.fixture_id = p.fixture_id and o.kept_player_id = p.kept_player_id
+    where
+        not o.is_picked
+        and coalesce(o.goals_total, 0) = coalesce(p.goals_total, 0)
+        and coalesce(o.goals_assists, 0) = coalesce(p.goals_assists, 0)
+        and coalesce(o.cards_yellow, 0) = coalesce(p.cards_yellow, 0)
+        and coalesce(o.cards_red, 0) = coalesce(p.cards_red, 0)
+        and coalesce(o.minutes_played, 0) = coalesce(p.minutes_played, 0)
+        and coalesce(o.goals_against, 0) = coalesce(p.goals_against, 0)
+        and coalesce(o.saves, 0) = coalesce(p.saves, 0)
+        and coalesce(o.penalty_won, 0) = coalesce(p.penalty_won, 0)
+        and coalesce(o.penalty_committed, 0) = coalesce(p.penalty_committed, 0)
+        and coalesce(o.penalty_scored, 0) = coalesce(p.penalty_scored, 0)
+        and coalesce(o.penalty_missed, 0) = coalesce(p.penalty_missed, 0)
+        and coalesce(o.penalty_saved, 0) = coalesce(p.penalty_saved, 0)
+),
+
+donor_values as (
+    select
+        league_code,
+        fixture_id,
+        kept_player_id,
+        {%- for column in stats.values() %}
+        array_agg(cast({{ column }} as string) ignore nulls order by raw_ingested_at desc limit 1)[safe_offset(0)]
+            as {{ column }},
+        {%- endfor %}
+        count(*) as donor_fetches
+    from donors
+    group by league_code, fixture_id, kept_player_id
+),
+
+expected as (
+    select
+        p.league_code,
+        p.fixture_id,
+        p.kept_player_id as player_id,
+        stat.stat_name,
+        stat.donated
+    from picked as p
+    inner join donor_values as d
+        on p.league_code = d.league_code and p.fixture_id = d.fixture_id and p.kept_player_id = d.kept_player_id
+    cross join
+        unnest([
+            {%- for name, column in stats.items() %}
+            struct(
+                '{{ name }}' as stat_name,
+                cast(p.{{ column }} as string) as picked_value,
+                d.{{ column }} as donated
+            ){{ ',' if not loop.last }}
+            {%- endfor %}
+        ]) as stat
+    where stat.picked_value is null and stat.donated is not null
+),
+
+held as (
+    select
+        b.league_code,
+        b.fixture_id,
+        b.team_id,
+        b.player_id,
+        b.stat_corrections,
+        b.goals,
+        b.assists,
+        b.cards_yellow,
+        b.cards_red,
+        stat.stat_name,
+        stat.stat_value
+    from {{ ref('base_apif__fixture_players') }} as b
+    cross join
+        unnest([
+            {%- for name in stats %}
+            struct('{{ name }}' as stat_name, cast(b.{{ name }} as string) as stat_value){{ ',' if not loop.last }}
+            {%- endfor %}
+        ]) as stat
+),
+
+picked_shots as (
+    select
+        p.league_code,
+        p.fixture_id,
+        p.kept_player_id as player_id,
+        shot.stat_name,
+        shot.stat_value
+    from picked as p
+    cross join
+        unnest([
+            struct('shots' as stat_name, p.shots_total as stat_value),
+            struct('shots_on_target', p.shots_on)
+        ]) as shot
+),
+
+team_sums as (
+    select
+        h.fixture_id,
+        h.team_id,
+        h.stat_name,
+        sum(coalesce(p.stat_value, safe_cast(e.donated as int64), 0)) as with_fills,
+        sum(coalesce(p.stat_value, 0)) as without_fills
+    from held as h
+    left join picked_shots as p
+        on
+            h.league_code = p.league_code and h.fixture_id = p.fixture_id
+            and h.player_id = p.player_id and h.stat_name = p.stat_name
+    left join expected as e
+        on
+            h.league_code = e.league_code and h.fixture_id = e.fixture_id
+            and h.player_id = e.player_id and h.stat_name = e.stat_name
+    where h.stat_name in ('shots', 'shots_on_target')
+    group by h.fixture_id, h.team_id, h.stat_name
+),
+
+team_lines as (
+    select
+        fixture_id,
+        team_id,
+        line.stat_name,
+        line.stat_value
+    from {{ ref('base_apif__fixture_statistics') }}
+    cross join unnest([
+        struct('shots' as stat_name, shots as stat_value),
+        struct('shots_on_target', shots_on_target)
+    ]) as line
+)
+
+select
+    h.league_code,
+    h.fixture_id,
+    h.player_id,
+    h.stat_name,
+    e.donated,
+    h.stat_value
+from expected as e
+inner join held as h
+    on
+        e.league_code = h.league_code and e.fixture_id = h.fixture_id
+        and e.player_id = h.player_id and e.stat_name = h.stat_name
+inner join picked as p
+    on e.league_code = p.league_code and e.fixture_id = p.fixture_id and e.player_id = p.kept_player_id
+left join team_sums as s
+    on h.fixture_id = s.fixture_id and h.team_id = s.team_id and h.stat_name = s.stat_name
+left join team_lines as t
+    on h.fixture_id = t.fixture_id and h.team_id = t.team_id and h.stat_name = t.stat_name
+where
+    h.stat_value is distinct from e.donated
+    and h.stat_name not in (select c.stat from unnest(h.stat_corrections) as c)
+    and coalesce(h.goals, 0) = coalesce(p.goals_total, 0)
+    and coalesce(h.assists, 0) = coalesce(p.goals_assists, 0)
+    and coalesce(h.cards_yellow, 0) = coalesce(p.cards_yellow, 0)
+    and coalesce(h.cards_red, 0) = coalesce(p.cards_red, 0)
+    and (
+        h.stat_name not in ('shots', 'shots_on_target')
+        or coalesce(abs(s.with_fills - t.stat_value) <= abs(s.without_fills - t.stat_value), false)
+    )
diff --git a/dbt_project/tests/assert_fixture_players_results_follow_events.sql b/dbt_project/tests/assert_fixture_players_results_follow_events.sql
new file mode 100644
index 00000000..9bfbdaee
--- /dev/null
+++ b/dbt_project/tests/assert_fixture_players_results_follow_events.sql
@@ -0,0 +1,207 @@
+{#
+  Where another fetch gives a player the goals, assists or cards of the match's events and the
+  match's picked fetch does not, the events' count is his. Where the picked fetch leaves his minutes
+  blank, another fetch's minutes are his when a substitution brought him on that many minutes before
+  the 90th, the minute of entry counted or not. Returns one row per player-match and result where
+  base_apif__fixture_players shows something else, unless the cleaning changed that result (a
+  stat_corrections entry).
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with fetch_rows as (
+    select
+        stat_line.league_code,
+        stat_line.fixture_id,
+        stat_line.raw_ingested_at,
+        stat_line.goals_total,
+        stat_line.goals_assists,
+        stat_line.cards_yellow,
+        stat_line.cards_red,
+        stat_line.minutes_played,
+        {{ fixture_player_id(
+            'stat_line.player_id', 'stat_line.fixture_id', 'stat_line.team_id', 'stat_line.shirt_number'
+        ) }} as player_id,
+        logical_or(stat_line.goals_against is not null)
+            over (partition by stat_line.league_code, stat_line.fixture_id, stat_line.raw_ingested_at)
+            as fetch_is_complete
+    from {{ ref('stg_apif__fixture_players') }} as stat_line
+    where stat_line.fixture_id is not null and stat_line.team_id is not null
+),
+
+per_fetch as (
+    select
+        league_code,
+        fixture_id,
+        player_id,
+        raw_ingested_at,
+        goals_total,
+        goals_assists,
+        cards_yellow,
+        cards_red,
+        minutes_played,
+        raw_ingested_at = coalesce(
+            max(if(fetch_is_complete, raw_ingested_at, null)) over (partition by league_code, fixture_id),
+            max(raw_ingested_at) over (partition by league_code, fixture_id)
+        ) as is_picked
+    from fetch_rows
+    where player_id is not null and player_id != 0
+),
+
+matches_with_events as (
+    select fixture_id
+    from {{ ref('base_apif__fixture_events') }}
+    group by fixture_id
+    having logical_or(has_full_events)
+),
+
+event_counts as (
+    select
+        e.fixture_id,
+        counted.player_id,
+        countif(counted.result_name = 'goals') as goals,
+        countif(counted.result_name = 'assists') as assists,
+        countif(counted.result_name = 'cards_yellow') as cards_yellow,
+        countif(counted.result_name = 'cards_red') as cards_red
+    from {{ ref('base_apif__fixture_events') }} as e
+    inner join matches_with_events as m
+        on e.fixture_id = m.fixture_id
+    cross join
+        unnest([
+            struct(
+                'goals' as result_name,
+                if(e.is_goal and not e.is_own_goal, e.player_id, null) as player_id
+            ),
+            struct('assists', if(e.is_goal and not e.is_own_goal, e.assist_player_id, null)),
+            struct(
+                'cards_yellow',
+                if(
+                    e.event_type = 'Card' and e.event_detail = 'Yellow Card'
+                    and coalesce(e.event_comments, '') != 'Not on pitch' and e.has_full_events,
+                    e.player_id,
+                    null
+                )
+            ),
+            struct(
+                'cards_red',
+                if(
+                    e.event_type = 'Card' and e.event_detail = 'Red Card'
+                    and coalesce(e.event_comments, '') != 'Not on pitch' and e.has_full_events,
+                    e.player_id,
+                    null
+                )
+            )
+        ]) as counted
+    where counted.player_id is not null
+    group by e.fixture_id, counted.player_id
+),
+
+fetch_results as (
+    select
+        f.league_code,
+        f.fixture_id,
+        f.player_id,
+        f.is_picked,
+        fetched.result_name,
+        coalesce(fetched.result_value, 0) as result_value,
+        coalesce(
+            case fetched.result_name
+                when 'goals' then c.goals
+                when 'assists' then c.assists
+                when 'cards_yellow' then c.cards_yellow
+                when 'cards_red' then c.cards_red
+            end,
+            0
+        ) as event_value
+    from per_fetch as f
+    inner join matches_with_events as m
+        on f.fixture_id = m.fixture_id
+    left join event_counts as c
+        on f.fixture_id = c.fixture_id and f.player_id = c.player_id
+    cross join
+        unnest([
+            struct('goals' as result_name, f.goals_total as result_value),
+            struct('assists', f.goals_assists),
+            struct('cards_yellow', f.cards_yellow),
+            struct('cards_red', f.cards_red)
+        ]) as fetched
+),
+
+settled as (
+    select
+        league_code,
+        fixture_id,
+        player_id,
+        result_name,
+        min(event_value) as events_count
+    from fetch_results
+    group by league_code, fixture_id, player_id, result_name
+    having
+        logical_or(is_picked)
+        and logical_and(not is_picked or result_value != event_value)
+        and logical_or(not is_picked and result_value = event_value)
+),
+
+minutes_on as (
+    select
+        fixture_id,
+        assist_player_id as player_id,
+        max(minute_elapsed) as minute_on
+    from {{ ref('base_apif__fixture_events') }}
+    where event_type = 'subst' and assist_player_id is not null
+    group by fixture_id, assist_player_id
+),
+
+minutes_settled as (
+    select
+        f.league_code,
+        f.fixture_id,
+        f.player_id,
+        array_agg(
+            if(
+                not f.is_picked and f.minutes_played between 90 - s.minute_on and 91 - s.minute_on,
+                f.minutes_played,
+                null
+            ) ignore nulls order by f.raw_ingested_at desc limit 1
+        )[safe_offset(0)] as minutes
+    from per_fetch as f
+    inner join minutes_on as s
+        on f.fixture_id = s.fixture_id and f.player_id = s.player_id
+    group by f.league_code, f.fixture_id, f.player_id
+    having logical_or(f.is_picked) and logical_and(not f.is_picked or f.minutes_played is null)
+)
+
+select
+    m.league_code,
+    m.fixture_id,
+    m.player_id,
+    'minutes' as result_name,
+    m.minutes as events_count,
+    b.minutes as result_value
+from minutes_settled as m
+inner join {{ ref('base_apif__fixture_players') }} as b
+    on m.league_code = b.league_code and m.fixture_id = b.fixture_id and m.player_id = b.player_id
+where m.minutes is not null and b.minutes is distinct from m.minutes
+
+union all
+
+select
+    s.league_code,
+    s.fixture_id,
+    s.player_id,
+    s.result_name,
+    s.events_count,
+    held.result_value
+from settled as s
+inner join {{ ref('base_apif__fixture_players') }} as b
+    on s.league_code = b.league_code and s.fixture_id = b.fixture_id and s.player_id = b.player_id
+cross join
+    unnest([
+        struct('goals' as result_name, b.goals as result_value),
+        struct('assists', b.assists),
+        struct('cards_yellow', b.cards_yellow),
+        struct('cards_red', b.cards_red)
+    ]) as held
+where
+    held.result_name = s.result_name
+    and held.result_value is distinct from s.events_count
+    and s.result_name not in (select c.stat from unnest(b.stat_corrections) as c)
diff --git a/dbt_project/tests/assert_fixture_statistics_from_every_fetch.sql b/dbt_project/tests/assert_fixture_statistics_from_every_fetch.sql
new file mode 100644
index 00000000..8aaea854
--- /dev/null
+++ b/dbt_project/tests/assert_fixture_statistics_from_every_fetch.sql
@@ -0,0 +1,128 @@
+{#
+  A team's match stat is the newest value any fetch's line carried. Returns one row per team-match
+  and stat blank in base_apif__fixture_statistics while a fetch in stg_apif__fixture_statistics
+  carries it, unless the cleaning blanked it (a stat_corrections entry) or, for a card count, the
+  match's events hold fewer cards that could be of that colour, or more that certainly are.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with carried as (
+    select
+        league_code,
+        fixture_id,
+        team_id,
+        stat_type
+    from {{ ref('stg_apif__fixture_statistics') }}
+    where fixture_id is not null and team_id is not null and stat_value_raw is not null
+    group by league_code, fixture_id, team_id, stat_type
+),
+
+newest_card_counts as (
+    select
+        fixture_id,
+        team_id,
+        stat_type,
+        array_agg(safe_cast(stat_value_raw as int64) order by raw_ingested_at desc limit 1)[offset(0)] as cards
+    from {{ ref('stg_apif__fixture_statistics') }}
+    where stat_type in ('Yellow Cards', 'Red Cards') and stat_value_raw is not null
+    group by fixture_id, team_id, stat_type
+),
+
+matches_with_events as (
+    select fixture_id
+    from {{ ref('base_apif__fixture_events') }}
+    group by fixture_id
+    having logical_or(has_full_events)
+),
+
+card_bounds as (
+    select
+        e.fixture_id,
+        e.team_id,
+        countif(e.event_type = 'Card' and e.event_detail = 'Yellow Card') as yellow_certain,
+        countif(
+            (e.event_type = 'Card' and coalesce(e.event_detail, '') != 'Red Card')
+            or (e.event_type = 'Var' and e.event_detail = 'Card reviewed')
+        ) as yellow_possible,
+        countif(e.event_type = 'Card' and e.event_detail = 'Red Card') as red_certain,
+        countif(
+            (e.event_type = 'Card' and coalesce(e.event_detail, '') != 'Yellow Card')
+            or (
+                e.event_type = 'Var'
+                and (
+                    starts_with(e.event_detail, 'Card upgrade')
+                    or e.event_detail in ('Red card cancelled', 'Card reviewed')
+                )
+            )
+        ) as red_possible
+    from {{ ref('base_apif__fixture_events') }} as e
+    inner join matches_with_events as m
+        on e.fixture_id = m.fixture_id
+    where e.team_id is not null
+    group by e.fixture_id, e.team_id
+),
+
+held as (
+    select
+        b.league_code,
+        b.fixture_id,
+        b.team_id,
+        stat.stat_type,
+        stat.stat_name
+    from {{ ref('base_apif__fixture_statistics') }} as b
+    cross join
+        unnest([
+            struct('Shots on Goal' as stat_type, 'shots_on_target' as stat_name, b.shots_on_target as stat_value),
+            struct('Shots off Goal', 'shots_off_target', b.shots_off_target),
+            struct('Total Shots', 'shots', b.shots),
+            struct('Blocked Shots', 'shots_blocked', b.shots_blocked),
+            struct('Shots insidebox', 'shots_inside_box', b.shots_inside_box),
+            struct('Shots outsidebox', 'shots_outside_box', b.shots_outside_box),
+            struct('Fouls', 'fouls', b.fouls),
+            struct('Corner Kicks', 'corners', b.corners),
+            struct('Offsides', 'offsides', b.offsides),
+            struct('Free Kicks', 'free_kicks', b.free_kicks),
+            struct('Ball Possession', 'possession_pct', b.possession_pct),
+            struct('Yellow Cards', 'cards_yellow', b.cards_yellow),
+            struct('Red Cards', 'cards_red', b.cards_red),
+            struct('Goalkeeper Saves', 'saves', b.saves),
+            struct('Total passes', 'passes', b.passes),
+            struct('Passes accurate', 'passes_accurate', b.passes_accurate)
+        ]) as stat
+    where
+        stat.stat_value is null
+        and stat.stat_name not in (select c.stat from unnest(b.stat_corrections) as c)
+)
+
+select
+    held.league_code,
+    held.fixture_id,
+    held.team_id,
+    held.stat_name
+from held
+inner join carried
+    on
+        held.league_code = carried.league_code
+        and held.fixture_id = carried.fixture_id
+        and held.team_id = carried.team_id
+        and held.stat_type = carried.stat_type
+left join newest_card_counts as cards
+    on
+        held.fixture_id = cards.fixture_id
+        and held.team_id = cards.team_id
+        and held.stat_type = cards.stat_type
+left join matches_with_events as m
+    on held.fixture_id = m.fixture_id
+left join card_bounds as bounds
+    on held.fixture_id = bounds.fixture_id and held.team_id = bounds.team_id
+where not coalesce(
+    m.fixture_id is not null
+    and case held.stat_type
+        when 'Yellow Cards'
+            then cards.cards not between coalesce(bounds.yellow_certain, 0) and coalesce(bounds.yellow_possible, 0)
+        when 'Red Cards'
+            then cards.cards not between coalesce(bounds.red_certain, 0) and coalesce(bounds.red_possible, 0)
+        else false
+    end,
+    false
+)
diff --git a/docs/data_contract.md b/docs/data_contract.md
index 0026e3e9..4103b886 100644
--- a/docs/data_contract.md
+++ b/docs/data_contract.md
@@ -133,7 +133,7 @@ quota is still discarded whole and retried next run, in `batch_fixtures`, `coach
 
 **Second fetch.** The provider completes some player stats days after the match, so a finished fixture whose latest fetch came under 3 days (72 hours) after kickoff is fetched once more when it is 3 days old, in every competition, idle ones included (`coverage.second_fetch_due`). From the moment that fetch is due until it is made, the fixture's player stats count as not covered. A fixture whose latest fetch is in the provider's newer player-stats format (players listed, none with goals conceded) and came under 14 days after kickoff is fetched once more when it is 14 days old (`coverage.newer_format_refetch_due`): that format never carries goals conceded or dribbled past, and the provider replaces it with the complete one for many matches later.
 
-**Both versions are kept deliberately, and base picks.** The bundle carries lineups, events, statistics and player stats *together*, so a retry chasing late statistics can come back richer in one section and poorer in another. `base_apif__fixture_statistics` dedups newest per `(…, team_id)`, so a team line present only in the older payload survives and one present in both takes the newer. `base_apif__fixture_players` takes all of a match's player rows from one fetch: its newest fetch in the complete format (any player with goals conceded), else its newest fetch. `base_apif__fixture_events` keeps the event list of the fixture's latest fetch that has events: positions past the end of a shorter later list are not kept.
+**Both versions are kept deliberately, and base picks.** The bundle carries lineups, events, statistics and player stats *together*, so a retry chasing late statistics can come back richer in one section and poorer in another. `base_apif__fixture_statistics` takes each stat of a team line from the newest fetch that carries it. A card count is taken only as the cleaning rules' "Fetches" line allows. `base_apif__fixture_players` takes a match's player rows from one fetch, its newest fetch in the complete format (any player with goals conceded), else its newest fetch. The "Fetches" line says where a player's value comes from another fetch or from the events instead. `base_apif__coaches` takes each bio field from the newest fetch that carries it. `base_apif__fixture_events` keeps the event list of the fixture's latest fetch that has events: positions past the end of a shorter later list are not kept.
 
