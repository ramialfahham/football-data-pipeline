+-- The minute a substitution brought the player on.
+minutes_on as (
+    select
+        fixture_id,
+        assist_player_id as player_id,
+        max(minute_elapsed) as minute_on
+    from events
+    where event_type = 'subst' and assist_player_id is not null
+    group by fixture_id, assist_player_id
