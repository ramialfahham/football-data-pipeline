diff --git a/dbt_project/tests/assert_player_index_covers_every_player_page.sql b/dbt_project/tests/assert_player_index_covers_every_player_page.sql
new file mode 100644
index 00000000..1a549d1a
--- /dev/null
+++ b/dbt_project/tests/assert_player_index_covers_every_player_page.sql
@@ -0,0 +1,59 @@
+-- Every player with a Player page has his row in mart_player_index, and none else, with the values
+-- of their sources: his featured row of mart_player_profile, his nation's confederation in
+-- dim_country, his club's club_order in mart_team_index and his minutes for his nation's team in
+-- int_player__national_team_minutes. Returns every player that is missing, extra or differs.
+
+with pages as (
+    select
+        player_sk,
+        league_code,
+        player_name,
+        player_photo_url,
+        position_group,
+        player_nationality,
+        nationality_team_sk,
+        current_club_team_sk,
+        current_club_name
+    from {{ ref('mart_player_profile') }}
+    where has_player_page and is_featured_season
+),
+
+expected as (
+    select
+        p.*,
+        c.confederation as region_key,
+        t.club_order,
+        m.national_team_minutes,
+        m.national_team_match_minutes
+    from pages as p
+    left join {{ ref('dim_country') }} as c
+        on p.player_nationality = c.country_name
+    left join {{ ref('mart_team_index') }} as t
+        on p.current_club_team_sk = t.team_sk
+    left join {{ ref('int_player__national_team_minutes') }} as m
+        on p.player_sk = m.player_sk and p.nationality_team_sk = m.team_sk
+),
+
+served as (
+    select * from {{ ref('mart_player_index') }}
+)
+
+select coalesce(e.player_sk, s.player_sk) as player_sk
+from expected as e
+full outer join served as s
+    on e.player_sk = s.player_sk
+where
+    e.player_sk is null
+    or s.player_sk is null
+    or e.league_code != s.league_code
+    or e.player_name is distinct from s.player_name
+    or e.player_photo_url is distinct from s.player_photo_url
+    or e.position_group is distinct from s.position_group
+    or e.player_nationality is distinct from s.player_nationality
+    or e.nationality_team_sk is distinct from s.nationality_team_sk
+    or e.region_key is distinct from s.region_key
+    or e.current_club_team_sk is distinct from s.current_club_team_sk
+    or e.current_club_name is distinct from s.current_club_name
+    or e.club_order is distinct from s.club_order
+    or e.national_team_minutes is distinct from s.national_team_minutes
+    or e.national_team_match_minutes is distinct from s.national_team_match_minutes
diff --git a/dbt_project/tests/assert_player_index_nation_order_follows_the_rule.sql b/dbt_project/tests/assert_player_index_nation_order_follows_the_rule.sql
new file mode 100644
index 00000000..4bf878ae
--- /dev/null
+++ b/dbt_project/tests/assert_player_index_nation_order_follows_the_rule.sql
@@ -0,0 +1,64 @@
+-- mart_player_index.nation_order: one value per nation, 1 to n over the nations, the nations by
+-- their national team's national_team_rank in mart_team_index, a shared rank by name, then the
+-- nations without one A to Z, then no nationality last. Returns every nation out of that order, a
+-- nation with two orders or a wrong rank, and a gap.
+
+with rows_ as (
+    select
+        p.player_nationality,
+        p.nation_order,
+        p.national_team_rank,
+        t.national_team_rank as index_rank
+    from {{ ref('mart_player_index') }} as p
+    left join {{ ref('mart_team_index') }} as t
+        on p.nationality_team_sk = t.team_sk
+),
+
+nations as (
+    select
+        player_nationality,
+        min(nation_order) as nation_order,
+        min(national_team_rank) as national_team_rank,
+        count(distinct nation_order) as orders,
+        countif(national_team_rank is distinct from index_rank) as wrong_ranks
+    from rows_
+    group by player_nationality
+),
+
+pairs as (
+    select
+        *,
+        lag(player_nationality) over by_order as prev_nationality,
+        lag(national_team_rank) over by_order as prev_rank,
+        lag(nation_order) over by_order as prev_order
+    from nations
+    window by_order as (order by nation_order)
+)
+
+select
+    player_nationality,
+    'out of order, two orders or a wrong rank' as failure
+from pairs
+where
+    orders != 1
+    or wrong_ranks > 0
+    or prev_order = nation_order
+    or (prev_order is not null and prev_nationality is null)
+    or (prev_rank is null and national_team_rank is not null and prev_order is not null)
+    or prev_rank > national_team_rank
+    or (prev_rank = national_team_rank and prev_nationality > player_nationality)
+    or (prev_rank is null and national_team_rank is null and prev_nationality > player_nationality)
+
+union all
+
+select
+    cast(null as string) as player_nationality,
+    'nation_order is not 1 to n' as failure
+from (
+    select
+        min(nation_order) as first_order,
+        max(nation_order) as last_order,
+        count(*) as nations
+    from nations
+)
+where first_order != 1 or last_order != nations
diff --git a/dbt_project/tests/assert_player_index_order_in_nation_follows_the_rule.sql b/dbt_project/tests/assert_player_index_order_in_nation_follows_the_rule.sql
new file mode 100644
index 00000000..e2d42a40
--- /dev/null
+++ b/dbt_project/tests/assert_player_index_order_in_nation_follows_the_rule.sql
@@ -0,0 +1,47 @@
+-- mart_player_index.order_in_nation runs 1 to n inside each nation: the national team's regulars
+-- by national_team_minutes, then the others by club_order with no club last, then
+-- club_minutes_this_season inside one club. Returns every player placed after one he should
+-- follow, and a nation with a gap.
+
+with pairs as (
+    select
+        player_sk,
+        player_nationality,
+        order_in_nation,
+        is_national_team_regular,
+        national_team_minutes,
+        club_order,
+        club_minutes_this_season,
+        lag(is_national_team_regular) over by_order as prev_regular,
+        lag(national_team_minutes) over by_order as prev_minutes,
+        lag(club_order) over by_order as prev_club_order,
+        lag(club_minutes_this_season) over by_order as prev_club_minutes,
+        lag(order_in_nation) over by_order as prev_order
+    from {{ ref('mart_player_index') }}
+    window by_order as (partition by player_nationality order by order_in_nation)
+)
+
+select
+    player_sk,
+    'placed after a player he should precede' as failure
+from pairs
+where
+    (not prev_regular and is_national_team_regular)
+    or (prev_regular and is_national_team_regular and prev_minutes < national_team_minutes)
+    or (
+        not prev_regular and not is_national_team_regular
+        and (
+            (prev_order is not null and prev_club_order is null and club_order is not null)
+            or prev_club_order > club_order
+            or (prev_club_order = club_order and prev_club_minutes < club_minutes_this_season)
+        )
+    )
+
+union all
+
+select
+    cast(null as int64) as player_sk,
+    'order_in_nation is not 1 to n' as failure
+from {{ ref('mart_player_index') }}
+group by player_nationality
+having max(order_in_nation) != count(*) or min(order_in_nation) != 1
diff --git a/dbt_project/tests/assert_player_index_worlds_best_follows_the_seed.sql b/dbt_project/tests/assert_player_index_worlds_best_follows_the_seed.sql
new file mode 100644
index 00000000..493403cf
--- /dev/null
+++ b/dbt_project/tests/assert_player_index_worlds_best_follows_the_seed.sql
@@ -0,0 +1,120 @@
+-- mart_player_index's World's best against player_award_results: the nominees with a Player page
+-- of each award's latest edition, the Yashin Trophy ones in the GK list and the Ballon d'Or ones
+-- who are not goalkeepers in their position's list, none missing and none extra; inside a list,
+-- 1 to n by club_order, then placing. Returns every nominee that differs or is out of order, a
+-- Ballon d'Or nominee with a page and no position, and a list with a gap.
+
+with pages as (
+    select distinct
+        player_sk,
+        position_group
+    from {{ ref('mart_player_profile') }}
+    where has_player_page and is_featured_season
+),
+
+seed_rows as (
+    select
+        award,
+        edition_year,
+        placing,
+        player_api_id as player_sk
+    from {{ ref('player_award_results') }}
+),
+
+latest as (
+    select
+        award,
+        max(edition_year) as edition_year
+    from seed_rows
+    group by award
+),
+
+expected as (
+    select
+        s.player_sk,
+        s.award,
+        s.edition_year,
+        s.placing,
+        if(s.award = 'yashin_trophy', 'GK', p.position_group) as list
+    from seed_rows as s
+    inner join latest as l
+        on s.award = l.award and s.edition_year = l.edition_year
+    inner join pages as p
+        on s.player_sk = p.player_sk
+    where s.award = 'yashin_trophy' or p.position_group != 'GK'
+),
+
+served as (
+    select
+        player_sk,
+        award,
+        award_edition_year,
+        award_placing,
+        worlds_best_list,
+        worlds_best_order,
+        club_order
+    from {{ ref('mart_player_index') }}
+    where worlds_best_list is not null
+),
+
+pairs as (
+    select
+        *,
+        lag(club_order) over by_order as prev_club_order,
+        lag(award_placing) over by_order as prev_placing,
+        lag(worlds_best_order) over by_order as prev_order
+    from served
+    window by_order as (partition by worlds_best_list order by worlds_best_order)
+)
+
+select
+    coalesce(e.player_sk, s.player_sk) as player_sk,
+    'differs from the seed' as failure
+from expected as e
+full outer join served as s
+    on e.player_sk = s.player_sk
+where
+    e.player_sk is null
+    or s.player_sk is null
+    or e.award != s.award
+    or e.edition_year != s.award_edition_year
+    or e.placing is distinct from s.award_placing
+    or e.list != s.worlds_best_list
+
+union all
+
+select
+    player_sk,
+    'placed after a nominee he should follow' as failure
+from pairs
+where
+    (prev_order is not null and prev_club_order is null and club_order is not null)
+    or prev_club_order > club_order
+    or (
+        prev_club_order is not distinct from club_order
+        and (
+            (prev_placing is null and award_placing is not null)
+            or prev_placing > award_placing
+        )
+    )
+
+union all
+
+select
+    s.player_sk,
+    'a ballon_dor nominee with a page has no position' as failure
+from seed_rows as s
+inner join latest as l
+    on s.award = l.award and s.edition_year = l.edition_year
+inner join pages as p
+    on s.player_sk = p.player_sk
+where s.award = 'ballon_dor' and p.position_group is null
+
+union all
+
+select
+    cast(null as int64) as player_sk,
+    'worlds_best_order is not 1 to n' as failure
+from served
+group by worlds_best_list
+having max(worlds_best_order) != count(*) or min(worlds_best_order) != 1
diff --git a/dbt_project/tests/assert_player_national_team_minutes_recomputed.sql b/dbt_project/tests/assert_player_national_team_minutes_recomputed.sql
new file mode 100644
index 00000000..a761eae5
--- /dev/null
+++ b/dbt_project/tests/assert_player_national_team_minutes_recomputed.sql
@@ -0,0 +1,69 @@
+-- int_player__national_team_minutes against a recount from the core stat lines: every player's
+-- minutes for a national team since 1 July 2025 and the team's minutes over its matches with stat
+-- lines, 90 a match, 120 after extra time. Returns every pair that differs or is missing.
+
+with lines as (
+    select
+        s.player_sk,
+        s.team_sk,
+        s.fixture_sk,
+        s.minutes,
+        f.status_short
+    from {{ ref('fct_fixture_player_stats') }} as s
+    inner join {{ ref('fct_fixture') }} as f
+        on s.fixture_sk = f.fixture_sk
+    inner join {{ ref('dim_league') }} as c
+        on s.league_code = c.league_code
+    where
+        c.entity_type = 'national'
+        and f.status_short in ('FT', 'AET', 'PEN')
+        and f.goals_home is not null
+        and f.goals_away is not null
+        and date(f.kickoff_datetime) >= date '2025-07-01'
+),
+
+team_minutes as (
+    select
+        team_sk,
+        sum(if(status_short in ('AET', 'PEN'), 120, 90)) as match_minutes
+    from (
+        select distinct
+            team_sk,
+            fixture_sk,
+            status_short
+        from lines
+    )
+    group by team_sk
+),
+
+expected as (
+    select
+        l.player_sk,
+        l.team_sk,
+        coalesce(sum(l.minutes), 0) as minutes,
+        min(t.match_minutes) as match_minutes
+    from lines as l
+    inner join team_minutes as t
+        on l.team_sk = t.team_sk
+    group by l.player_sk, l.team_sk
+),
+
+served as (
+    select * from {{ ref('int_player__national_team_minutes') }}
+)
+
+select
+    e.minutes as expected_minutes,
+    s.national_team_minutes,
+    e.match_minutes as expected_match_minutes,
+    s.national_team_match_minutes,
+    coalesce(e.player_sk, s.player_sk) as player_sk,
+    coalesce(e.team_sk, s.team_sk) as team_sk
+from expected as e
+full outer join served as s
+    on e.player_sk = s.player_sk and e.team_sk = s.team_sk
+where
+    e.player_sk is null
+    or s.player_sk is null
+    or e.minutes != s.national_team_minutes
+    or e.match_minutes != s.national_team_match_minutes
diff --git a/dbt_project/tests/assert_team_index_club_order_follows_the_rule.sql b/dbt_project/tests/assert_team_index_club_order_follows_the_rule.sql
new file mode 100644
index 00000000..58785757
--- /dev/null
+++ b/dbt_project/tests/assert_team_index_club_order_follows_the_rule.sql
@@ -0,0 +1,69 @@
+-- mart_team_index.club_order runs 1 to n over the clubs: the clubs with a top_club_rank first, by
+-- region_rank then that rank, then the others by country_order and, inside a country,
+-- team_order_in_country. Returns every club placed after one it should precede, and a gap.
+
+with clubs as (
+    select
+        team_sk,
+        club_order,
+        top_club_rank,
+        country_order,
+        team_country,
+        team_order_in_country,
+        top_club_rank is not null as is_ranked,
+        coalesce(region_rank, 1000) as region_place
+    from {{ ref('mart_team_index') }}
+    where entity_type = 'club'
+),
+
+pairs as (
+    select
+        *,
+        lag(is_ranked) over by_order as prev_is_ranked,
+        lag(region_place) over by_order as prev_region_place,
+        lag(top_club_rank) over by_order as prev_top_club_rank,
+        lag(country_order) over by_order as prev_country_order,
+        lag(team_country) over by_order as prev_team_country,
+        lag(team_order_in_country) over by_order as prev_team_order_in_country
+    from clubs
+    window by_order as (order by club_order)
+)
+
+select
+    team_sk,
+    'placed after a club it should precede' as failure
+from pairs
+where
+    (not prev_is_ranked and is_ranked)
+    or (
+        prev_is_ranked and is_ranked
+        and (
+            prev_region_place > region_place
+            or (prev_region_place = region_place and prev_top_club_rank > top_club_rank)
+        )
+    )
+    or (
+        not prev_is_ranked and not is_ranked
+        and (
+            prev_country_order > country_order
+            or (
+                prev_country_order = country_order
+                and prev_team_country is not distinct from team_country
+                and prev_team_order_in_country > team_order_in_country
+            )
+        )
+    )
+
+union all
+
+select
+    cast(null as int64) as team_sk,
+    'club_order is not 1 to n' as failure
+from (
+    select
+        min(club_order) as first_order,
+        max(club_order) as last_order,
+        count(*) as clubs
+    from clubs
+)
+where first_order != 1 or last_order != clubs
diff --git a/scripts/export_site_data.py b/scripts/export_site_data.py
index 4e969183..2a63d129 100644
--- a/scripts/export_site_data.py
+++ b/scripts/export_site_data.py
@@ -38,7 +38,7 @@ MARTS_DATASET = "marts"
 DEFAULT_OUT = "artifacts/site_data"
 ENTITY_TYPES = ("teams", "players", "fixtures", "competitions", "nav",
                 "leaderboards", "glossary", "metric_groups", "metric_rows", "landing",
-                "competition_index", "matches", "teams_index")
+                "competition_index", "matches", "teams_index", "players_index")
 REGISTRY_PATH = "docs/competition_registry.yml"
 CATALOGUE_SEED_PATH = "dbt_project/seeds/metric_catalogue.csv"
 METRIC_MAP_PATH = "dbt_project/seeds/metric_map.csv"
@@ -1786,6 +1786,44 @@ def fetch_team_index(client) -> dict:
     return shape_team_index(rows)
 
 
+_PLAYER_INDEX_COLUMNS = (
+    "player_sk, player_name, player_photo_url, position_group, player_nationality, region_key, "
+    "nation_order, order_in_nation, current_club_name, award, award_edition_year, "
+    "worlds_best_list, worlds_best_order"
+)
+
+
+def shape_player_index(rows: list[dict]) -> dict:
+    """mart_player_index rows as the Players page reads them: every player in the served nation
+    order, and the World's best nominees by list and served place."""
+    nominees = sorted((r for r in rows if r.get("worlds_best_list") is not None),
+                      key=lambda r: (r["worlds_best_list"], r["worlds_best_order"]))
+    return {
+        "type": "players_index",
+        "worlds_best": [{"player_id": r["player_sk"], "list": r["worlds_best_list"],
