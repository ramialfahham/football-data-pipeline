+          expression: "(worlds_best_list is null) = (worlds_best_order is null) and (worlds_best_list is null or award is not null)"
+          name: player_index_worlds_best_order_exactly_on_its_lists
+      - dbt_utils.expression_is_true:
+          expression: "coalesce(worlds_best_list = 'GK', false) = coalesce(award = 'yashin_trophy', false)"
+          name: player_index_goalkeepers_are_the_yashin_nominees
+      - dbt_utils.expression_is_true:
+          expression: "is_national_team_regular = coalesce(national_team_minutes * 3 >= national_team_match_minutes, false)"
+          name: player_index_regular_is_a_third_of_the_minutes
+      - dbt_utils.expression_is_true:
+          expression: "(current_club_team_sk is null) = (club_order is null)"
+          name: player_index_every_club_has_its_order
+    columns:
+      - name: player_sk
