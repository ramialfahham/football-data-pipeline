+              to: ref('mart_team_index')
+              field: team_sk
+      - name: current_club_name
+        description: "That club's name."
+      - name: club_order
+        description: "That club's place in mart_team_index.club_order. NULL without a club."
+      - name: club_minutes_this_season
+        description: "The player's minutes in club competitions this season, the season his page opens on and the other club competitions of the same season."
+        tests: [not_null]
+      - name: award
