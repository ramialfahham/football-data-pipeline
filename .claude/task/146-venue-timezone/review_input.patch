diff --git a/site_v2/src/lib/format.test.mjs b/site_v2/src/lib/format.test.mjs
new file mode 100644
index 00000000..610ec416
--- /dev/null
+++ b/site_v2/src/lib/format.test.mjs
@@ -0,0 +1,51 @@
+// Pins the kick-off clock a match row prints: the served venue wall clock and its zone label,
+// read as the digits they show on every machine; a row served without them keeps its UTC kick-off.
+
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { formatDate, formatTime, kickoffClock, kickoffDay } from "./format.ts";
+
+const SERVED = {
+  kickoff: "2026-11-21 23:30:00+00:00",
+  kickoff_local: "2026-11-22 00:30:00",
+  kickoff_zone_label: "CET",
+};
+
+test("a row prints its served local kick-off and its zone label", () => {
+  assert.deepEqual(kickoffClock(SERVED), { at: "2026-11-22 00:30:00", zone: "CET" });
+  assert.equal(formatTime(kickoffClock(SERVED).at, "en"), "00:30");
+});
+
+test("a served wall clock is read as its digits, whatever the machine's zone", () => {
+  const was = process.env.TZ;
+  try {
+    for (const zone of ["America/Los_Angeles", "Asia/Tokyo", "UTC"]) {
+      process.env.TZ = zone;
+      assert.equal(formatTime("2026-07-05 20:00:00", "en"), "20:00");
+    }
+  } finally {
+    if (was === undefined) delete process.env.TZ;
+    else process.env.TZ = was;
+  }
+});
+
+test("the day heading groups a row under the date of its local clock", () => {
+  assert.equal(kickoffDay(SERVED), "2026-11-22");
+  assert.match(formatDate(kickoffClock(SERVED).at, "en"), /22/);
+});
+
+test("a row served without a local clock keeps its UTC kick-off and says UTC", () => {
+  const row = { kickoff: "2026-11-21 23:30:00+00:00" };
+  assert.deepEqual(kickoffClock(row), { at: "2026-11-21 23:30:00+00:00", zone: "UTC" });
+  assert.equal(formatTime(kickoffClock(row).at, "en"), "23:30");
+  assert.equal(kickoffDay(row), "2026-11-21");
+});
+
+test("a row with a local clock and no label says UTC, never a blank", () => {
+  assert.equal(kickoffClock({ kickoff_local: "2026-11-22 00:30:00" }).zone, "UTC");
+});
+
+test("a row with no kick-off at all has no clock and no day", () => {
+  assert.deepEqual(kickoffClock({}), { at: null, zone: "UTC" });
+  assert.equal(kickoffDay({}), null);
+});
diff --git a/site_v2/src/lib/format.ts b/site_v2/src/lib/format.ts
index 4f154bb3..4ec823e2 100644
--- a/site_v2/src/lib/format.ts
+++ b/site_v2/src/lib/format.ts
@@ -131,14 +131,33 @@ export function signedDelta(
   return { value, unit: null };
 }
 
-// ---- dates ---- kickoff is served as a UTC ISO string ("2026-07-26 22:30:00+00:00").
-// Rendered in UTC so the static build is deterministic across machines and matches the
-// stored kickoff; local-timezone display is a later enhancement (01_fixture_page.md §5.2).
+// ---- dates ---- kickoff is served as a UTC ISO string ("2026-07-26 22:30:00+00:00"), and
+// kickoff_local as the venue's wall clock with no offset ("2026-07-26 20:30:00"). Both are
+// rendered through UTC so the static build is deterministic across machines: a served wall
+// clock is read as the digits it shows, never converted.
+const WALL_CLOCK = /^\d{4}-\d\d-\d\d[ T]\d\d:\d\d(:\d\d(\.\d+)?)?$/;
 function toDate(iso: string | null | undefined): Date | null {
   if (!iso) return null;
-  const d = new Date(iso.replace(" ", "T"));
+  const text = iso.replace(" ", "T");
+  const d = new Date(WALL_CLOCK.test(iso) ? `${text}Z` : text);
   return Number.isNaN(d.getTime()) ? null : d;
 }
+
+/** The clock a match row prints: the served local kick-off and its zone label. A row served
+ *  without them keeps its UTC kick-off and says UTC. */
+export function kickoffClock(fx: {
+  kickoff?: string | null;
+  kickoff_local?: string | null;
+  kickoff_zone_label?: string | null;
+}): { at: string | null; zone: string } {
+  if (fx.kickoff_local) return { at: fx.kickoff_local, zone: fx.kickoff_zone_label ?? "UTC" };
+  return { at: fx.kickoff ?? null, zone: "UTC" };
+}
+
+/** The date a day heading groups a row under: the date of its printed clock. */
+export function kickoffDay(fx: Parameters<typeof kickoffClock>[0]): string | null {
+  return kickoffClock(fx).at?.slice(0, 10) ?? null;
+}
