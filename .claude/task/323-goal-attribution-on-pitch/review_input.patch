diff --git a/dbt_project/tests/assert_goal_added_minute_from_newest_fetch.sql b/dbt_project/tests/assert_goal_added_minute_from_newest_fetch.sql
new file mode 100644
index 00000000..13db8712
--- /dev/null
+++ b/dbt_project/tests/assert_goal_added_minute_from_newest_fetch.sql
@@ -0,0 +1,51 @@
+{#
+  A goal keeps the newest added minute any fetch carried. Returns one row per scorer, detail and
+  minute of a match where fct_fixture_event holds provider goals with no added minute while one
+  fetch gave every such goal an added minute.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with fetched as (
+    select
+        fixture_id,
+        raw_ingested_at,
+        player_id,
+        event_detail,
+        minute_elapsed,
+        countif(minute_extra is not null) as goals_with_added_minute
+    from {{ ref('stg_apif__fixture_events') }}
+    where event_type = 'Goal' and player_id is not null and minute_elapsed is not null
+    group by fixture_id, raw_ingested_at, player_id, event_detail, minute_elapsed
+),
+
+served as (
+    select
+        fixture_api_id as fixture_id,
+        player_api_id as player_id,
+        event_detail,
+        minute_elapsed,
+        count(*) as goals,
+        countif(minute_extra is null) as goals_without_added_minute
+    from {{ ref('fct_fixture_event') }}
+    where event_type = 'Goal' and goal_correction_source is null and player_api_id is not null
+    group by fixture_api_id, player_api_id, event_detail, minute_elapsed
+)
+
+select
+    s.fixture_id,
+    s.player_id,
+    s.event_detail,
+    s.minute_elapsed,
+    s.goals,
+    s.goals_without_added_minute,
+    max(f.goals_with_added_minute) as most_goals_with_added_minute_in_one_fetch
+from served as s
+inner join fetched as f
+    on
+        s.fixture_id = f.fixture_id
+        and s.player_id = f.player_id
+        and s.event_detail = f.event_detail
+        and s.minute_elapsed = f.minute_elapsed
+where s.goals_without_added_minute > 0
+group by s.fixture_id, s.player_id, s.event_detail, s.minute_elapsed, s.goals, s.goals_without_added_minute
+having max(f.goals_with_added_minute) >= s.goals
diff --git a/dbt_project/tests/assert_goal_attributions_on_the_pitch.sql b/dbt_project/tests/assert_goal_attributions_on_the_pitch.sql
new file mode 100644
index 00000000..5a9c5594
--- /dev/null
+++ b/dbt_project/tests/assert_goal_attributions_on_the_pitch.sql
@@ -0,0 +1,71 @@
+{#
+  A goal names a scorer or assister only where the match's confirmed or researched line-up has him
+  on the pitch at the goal's minute. Returns one row per provider goal in fct_fixture_event that
+  names a player of the sheet who was not: such a player is withheld (scorer_needs_research,
+  assist_needs_research). Minutes are elapsed * 100 + added time; a minute at the end of a period
+  with no added minute can be any minute of that period's added time. A goal from
+  fixture_goal_corrections is sourced and is not checked.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with sheet as (
+    select
+        fixture_api_id,
+        player_api_id,
+        if(is_starter, 0, minute_on * 100 + coalesce(minute_on_extra, 0)) as on_from,
+        if(
+            minute_off is null,
+            99999,
+            minute_off * 100 + coalesce(minute_off_extra, if(minute_off in (45, 90, 105, 120), 99, 0))
+        ) as off_to
+    from {{ ref('fct_fixture_lineup') }}
+    where lineup_state in ('confirmed', 'researched')
+),
+
+goals as (
+    select
+        fixture_api_id,
+        event_index,
+        player_api_id,
+        assist_player_api_id,
+        minute_elapsed * 100 + coalesce(minute_extra, 0) as goal_from,
+        minute_elapsed * 100 + coalesce(minute_extra, if(minute_elapsed in (45, 90, 105, 120), 99, 0)) as goal_to
+    from {{ ref('fct_fixture_event') }}
+    where is_goal and goal_correction_source is null and minute_elapsed is not null
+),
+
+named as (
+    select
+        fixture_api_id,
+        event_index,
+        'scorer' as attribution,
+        player_api_id,
+        goal_from,
+        goal_to
+    from goals
+    where player_api_id is not null
+    union all
+    select
+        fixture_api_id,
+        event_index,
+        'assister' as attribution,
+        assist_player_api_id as player_api_id,
+        goal_from,
+        goal_to
+    from goals
+    where assist_player_api_id is not null
+)
+
+select
+    n.fixture_api_id,
+    n.event_index,
+    n.attribution,
+    n.player_api_id,
+    n.goal_from,
+    n.goal_to,
+    s.on_from,
+    s.off_to
+from named as n
+inner join sheet as s
+    on n.fixture_api_id = s.fixture_api_id and n.player_api_id = s.player_api_id
+where s.on_from is null or s.on_from > n.goal_to or s.off_to < n.goal_from
