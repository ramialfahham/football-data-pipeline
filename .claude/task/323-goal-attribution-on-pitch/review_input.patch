diff --git a/dbt_project/models/2_base/api_football/base_apif__fixture_events_checked.sql b/dbt_project/models/2_base/api_football/base_apif__fixture_events_checked.sql
new file mode 100644
index 00000000..4e3be3db
--- /dev/null
+++ b/dbt_project/models/2_base/api_football/base_apif__fixture_events_checked.sql
@@ -0,0 +1,95 @@
+with events as (
+    select * from {{ ref('base_apif__fixture_events') }}
+),
+
+-- Minutes as elapsed * 100 + added time. A minute at the end of a period with no added minute can
+-- be any minute of that period's added time.
+sheet as (
+    select
+        league_code,
+        fixture_id,
+        player_id,
+        if(is_starter, 0, minute_on * 100 + coalesce(minute_on_extra, 0)) as on_from,
+        if(
+            minute_off is null,
+            99999,
+            minute_off * 100 + coalesce(minute_off_extra, if(minute_off in (45, 90, 105, 120), 99, 0))
+        ) as off_to
+    from {{ ref('base_apif__lineups') }}
+    where lineup_state in ('confirmed', 'researched')
+    qualify row_number() over (
+        partition by league_code, fixture_id, player_id
+        order by team_id
+    ) = 1
+),
+
+goals as (
+    select
+        league_code,
+        fixture_id,
+        event_index,
+        player_id,
+        assist_player_id,
+        minute_elapsed * 100 + coalesce(minute_extra, 0) as goal_from,
+        minute_elapsed * 100 + coalesce(minute_extra, if(minute_elapsed in (45, 90, 105, 120), 99, 0)) as goal_to
+    from events
+    where is_provider_goal and minute_elapsed is not null
+),
+
+checked as (
+    select
+        goals.league_code,
+        goals.fixture_id,
+        goals.event_index,
+        scorer.player_id is not null
+        and (scorer.on_from is null or scorer.on_from > goals.goal_to or scorer.off_to < goals.goal_from)
+            as scorer_needs_research,
+        assister.player_id is not null
+        and (assister.on_from is null or assister.on_from > goals.goal_to or assister.off_to < goals.goal_from)
+            as assist_needs_research
+    from goals
+    left join sheet as scorer
+        on
+            goals.league_code = scorer.league_code
+            and goals.fixture_id = scorer.fixture_id
+            and goals.player_id = scorer.player_id
+    left join sheet as assister
+        on
+            goals.league_code = assister.league_code
+            and goals.fixture_id = assister.fixture_id
+            and goals.assist_player_id = assister.player_id
+)
+
+select
+    events.league_code,
+    events.fixture_id,
+    events.event_index,
+    events.minute_elapsed,
+    events.minute_extra,
+    events.event_type,
+    events.event_detail,
+    events.event_comments,
+    events.raw_ingested_at,
+    events.resolved_player_team_id,
+    events.team_id,
+    events.team_name,
+    events.goal_correction_source,
+    events.card_correction_source,
+    events.is_shootout_kick,
+    events.is_own_goal,
+    events.is_provider_goal,
+    events.is_goal,
+    events.is_missed_penalty,
+    events.has_full_events,
+    if(coalesce(checked.scorer_needs_research, false), null, events.player_id) as player_id,
+    if(coalesce(checked.scorer_needs_research, false), null, events.player_name) as player_name,
+    if(coalesce(checked.assist_needs_research, false), null, events.assist_player_id) as assist_player_id,
+    if(coalesce(checked.assist_needs_research, false), null, events.assist_player_name) as assist_player_name,
+    coalesce(checked.scorer_needs_research, false) as scorer_needs_research,
+    coalesce(checked.assist_needs_research, false) as assist_needs_research
+from events
+left join checked
+    on
+        events.league_code = checked.league_code
+        and events.fixture_id = checked.fixture_id
+        and events.event_index = checked.event_index
diff --git a/dbt_project/models/2_base/api_football/base_apif__fixture_players_checked.sql b/dbt_project/models/2_base/api_football/base_apif__fixture_players_checked.sql
new file mode 100644
index 00000000..33361eda
--- /dev/null
+++ b/dbt_project/models/2_base/api_football/base_apif__fixture_players_checked.sql
@@ -0,0 +1,115 @@
+{#
+  The rows of base_apif__fixture_players, with a player's goals withheld where
+  base_apif__fixture_events_checked withholds him as the scorer of a goal that counts, and his
+  assists where it withholds him as the assister. This is its own model because base_apif__lineups
+  reads base_apif__fixture_players. The columns keep base_apif__fixture_players' order, which
+  fct_fixture_player_stats unions by position.
+
+  Grain: (league_code, fixture_id, team_id, player_id).
+#}
+
+with withheld_goals as (
+    select
+        events.league_code,
+        events.fixture_id,
+        events.player_id,
+        events.assist_player_id,
+        checked.assist_needs_research,
+        checked.scorer_needs_research and not checked.is_own_goal as scorer_needs_research
+    from {{ ref('base_apif__fixture_events') }} as events
+    inner join {{ ref('base_apif__fixture_events_checked') }} as checked
+        on
+            events.league_code = checked.league_code
+            and events.fixture_id = checked.fixture_id
+            and events.event_index = checked.event_index
+    where checked.is_goal and (checked.scorer_needs_research or checked.assist_needs_research)
+),
+
+withheld_roles as (
+    select
+        league_code,
+        fixture_id,
+        player_id,
+        true as is_scorer,
+        false as is_assister
+    from withheld_goals
+    where scorer_needs_research and player_id is not null
+    union all
+    select
+        league_code,
+        fixture_id,
+        assist_player_id as player_id,
+        false as is_scorer,
+        true as is_assister
+    from withheld_goals
+    where assist_needs_research and assist_player_id is not null
+),
+
+withheld_players as (
+    select
+        league_code,
+        fixture_id,
+        player_id,
+        logical_or(is_scorer) as scorer_withheld,
+        logical_or(is_assister) as assister_withheld
+    from withheld_roles
+    group by league_code, fixture_id, player_id
+),
+
+checked_players as (
+    select
+        players.*,
+        if(coalesce(withheld.scorer_withheld, false), null, players.goals) as checked_goals,
+        if(coalesce(withheld.scorer_withheld, false), null, players.goals_penalty) as checked_goals_penalty,
+        if(coalesce(withheld.scorer_withheld, false), null, players.penalties_scored) as checked_penalties_scored,
+        if(coalesce(withheld.assister_withheld, false), null, players.assists) as checked_assists
+    from {{ ref('base_apif__fixture_players') }} as players
+    left join withheld_players as withheld
