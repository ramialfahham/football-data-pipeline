diff --git a/scripts/check_sweep_superseded.py b/scripts/check_sweep_superseded.py
new file mode 100644
index 00000000..60cacb25
--- /dev/null
+++ b/scripts/check_sweep_superseded.py
@@ -0,0 +1,90 @@
+"""Exit 0 when a newer main commit already has its own design sweep, so this older one can stop.
+
+`validate:ui` on main runs in the `validate-ui-main` resource group, newest first. A newer push to
+main whose changes match the job's main `changes:` list has its own `validate:ui`, and that sweep
+checks a tree containing this commit. Each push to main is one first-parent commit, so the files of
+each newer push are that commit's first-parent diff. Any other outcome, an error included, exits
+non-zero and the full sweep runs.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+import yaml
+
+REPO = Path(__file__).resolve().parents[1]
+JOB = "validate:ui"
+
+
+def main_changes(ci: dict) -> list[str]:
+    """The `changes:` list of the job's rule that admits a push to the default branch."""
+    for rule in ci[JOB]["rules"]:
+        if "$CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH" in str(rule.get("if", "")) and "changes" in rule:
+            return list(rule["changes"])
+    raise LookupError(f"{JOB} has no default-branch rule with changes:")
+
+
+def _glob_regex(pattern: str) -> re.Pattern[str]:
+    """GitLab's `changes:` glob: `**/` spans any number of folders, `*` and `?` stay inside one."""
+    out, i = "", 0
+    while i < len(pattern):
+        if pattern.startswith("**/", i):
+            out, i = out + "(?:.*/)?", i + 3
+        elif pattern.startswith("**", i):
+            out, i = out + ".*", i + 2
+        elif pattern[i] == "*":
+            out, i = out + "[^/]*", i + 1
+        elif pattern[i] == "?":
+            out, i = out + "[^/]", i + 1
+        else:
+            out, i = out + re.escape(pattern[i]), i + 1
+    return re.compile(out + r"\Z")
+
+
+def matches(path: str, patterns: list[str]) -> bool:
+    return any(_glob_regex(p).match(path) for p in patterns)
+
+
+def newer_pushes(git, this_sha: str, tip: str) -> list[tuple[str, list[str]]]:
+    """(commit, files) for each first-parent commit after `this_sha` up to `tip`, newest first."""
+    shas = git("rev-list", "--first-parent", f"{this_sha}..{tip}").split()
+    return [
+        (sha, git("diff-tree", "--no-commit-id", "--name-only", "-r", f"{sha}^1", sha).split())
+        for sha in shas
+    ]
+
+
+def superseding_push(pushes: list[tuple[str, list[str]]], patterns: list[str]) -> str | None:
+    for sha, files in pushes:
+        if any(matches(f, patterns) for f in files):
+            return sha
+    return None
+
+
+def _git(*args: str) -> str:
+    return subprocess.run(
+        ["git", "-c", "safe.directory=*", *args], cwd=REPO, capture_output=True, text=True, check=True
+    ).stdout
+
+
+def main() -> int:
+    this_sha = os.environ["CI_COMMIT_SHA"]
+    branch = os.environ["CI_DEFAULT_BRANCH"]
+    _git("fetch", "--quiet", "--no-tags", "origin", branch)
+    tip = _git("rev-parse", "FETCH_HEAD").strip()
+    ci = yaml.safe_load((REPO / ".gitlab-ci.yml").read_text(encoding="utf-8"))
+    newer = superseding_push(newer_pushes(_git, this_sha, tip), main_changes(ci))
+    if newer is None:
+        print(f"No newer {branch} commit has its own design sweep; running the full sweep.")
+        return 1
+    print(f"Superseded: {branch} commit {newer} has its own design sweep, which covers {this_sha}.")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/list_mr_scratch.py b/scripts/list_mr_scratch.py
new file mode 100644
index 00000000..3097d261
--- /dev/null
+++ b/scripts/list_mr_scratch.py
@@ -0,0 +1,103 @@
+"""List the merge-request scratch datasets nothing reads any more. Lists only; deletes nothing.
+
+`data:build:mr` writes `ci_mr<IID>_<SHA>` and its layer datasets (`ci_mr<IID>_<SHA>_marts`, ...),
+where <SHA> is the first 8 characters of the target commit its pipeline merged in. A set is listed
+when its merge request is no longer open, when an open merge request has a newer set, or when its
+name carries no target commit. Each open merge request keeps its newest set.
+
+Reads the BigQuery dataset list (metadata, no query) and the open merge requests through `glab`.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import subprocess
+import sys
+from collections.abc import Callable
+from datetime import datetime
+
+PROJECT = "football-data-pipeline-gcp"
+GITLAB_PROJECT = "85168767"
+
+_NAME_RE = re.compile(r"^ci_mr(?P<iid>\d+)(?:_(?P<sha>[0-9a-f]{8})(?=_|$))?(?:_.+)?$")
+
+
+def parse(name: str) -> tuple[int, str | None] | None:
+    """Return (merge request IID, target SHA or None) for a scratch dataset name, else None."""
+    m = _NAME_RE.match(name)
+    if not m:
+        return None
+    return int(m["iid"]), m["sha"]
+
+
+def classify(
+    datasets: list[str], open_iids: set[int], created: Callable[[list[str]], datetime]
+) -> list[tuple[str, str]]:
+    """Return (dataset, reason) for every scratch dataset nothing reads any more, sorted by name.
+
+    `created` gives the creation time of a set from its dataset names; it is called only for open
+    merge requests with more than one set.
+    """
+    sets: dict[tuple[int, str | None], list[str]] = {}
+    for name in datasets:
+        key = parse(name)
+        if key is not None:
+            sets.setdefault(key, []).append(name)
+
+    listed: list[tuple[str, str]] = []
+    by_mr: dict[int, list[str]] = {}
+    for (iid, sha), names in sets.items():
+        if iid not in open_iids:
+            listed += [(n, f"MR !{iid} is not open") for n in names]
+        elif sha is None:
+            listed += [(n, f"MR !{iid}: no target commit in the name") for n in names]
+        else:
+            by_mr.setdefault(iid, []).append(sha)
+
+    for iid, shas in by_mr.items():
+        if len(shas) < 2:
+            continue
+        newest = max(shas, key=lambda s: created(sets[(iid, s)]))
+        for sha in shas:
+            if sha != newest:
+                listed += [(n, f"MR !{iid}: superseded by its {newest} set") for n in sets[(iid, sha)]]
+    return sorted(listed)
+
+
+def open_merge_request_iids(project: str = GITLAB_PROJECT) -> set[int]:
+    iids: set[int] = set()
+    page = 1
+    while True:
+        path = f"projects/{project}/merge_requests?state=opened&per_page=100&page={page}"
+        r = subprocess.run(["glab", "api", path], capture_output=True)
+        if r.returncode != 0:
+            sys.exit(f"glab api {path} failed: {r.stderr.decode('utf-8', 'replace')[:300]}")
+        batch = json.loads(r.stdout.decode("utf-8"))
+        iids.update(mr["iid"] for mr in batch)
+        if len(batch) < 100:
+            return iids
+        page += 1
+
+
+def main(argv: list[str] | None = None) -> int:
+    argparse.ArgumentParser(description=__doc__.splitlines()[0]).parse_args(argv)
+    from google.cloud import bigquery
+
+    client = bigquery.Client(project=PROJECT)
+    datasets = [d.dataset_id for d in client.list_datasets(PROJECT)]
+    open_iids = open_merge_request_iids()
+
+    def created(names: list[str]) -> datetime:
+        return min(client.get_dataset(f"{PROJECT}.{n}").created for n in names)
+
+    listed = classify(datasets, open_iids, created)
+    for name, reason in listed:
+        print(f"{name}\t{reason}")
+    print(f"{len(listed)} datasets listed; nothing was deleted.", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
