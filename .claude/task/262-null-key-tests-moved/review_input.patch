+def _read_bodies(text, stg):
+    bodies = []
+    for match in re.finditer(r"ref\(\s*['\"]" + stg + r"['\"]\s*\)", text):
+        after = text[match.end():]
+        ends = [after.find(mark) for mark in ("union all", "), ", ") select")]
+        bodies.append(after[: min(end for end in ends if end >= 0)])
+    return bodies
