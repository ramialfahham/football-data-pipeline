+        (base_file, stg)
+    )
+    bodies = _read_bodies(_sql(BASE_SQL / base_file), stg)
+    assert index < len(bodies), (base_file, stg, index)
+    for condition in filters:
+        assert condition in bodies[index], (base_file, stg, condition)
