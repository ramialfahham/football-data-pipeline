+def _stays_at_error(body):
+    config = body.get("config") or {}
+    return (
+        not (FORBIDDEN_IN_A_PROOF & set(body))
+        and not (FORBIDDEN_IN_A_PROOF & set(config))
+        and config.get("severity", "error") == "error"
+        and body.get("severity", "error") == "error"
+    )
