diff --git a/dbt_project/tests/assert_player_page_answer_key.sql b/dbt_project/tests/assert_player_page_answer_key.sql
new file mode 100644
index 00000000..23ddbcde
--- /dev/null
+++ b/dbt_project/tests/assert_player_page_answer_key.sql
@@ -0,0 +1,136 @@
+{#
+  Hand-worked Player page values (seeds/player_page_answer_key.csv): real players and squads in seasons
+  that are over, each answer worked out from the cleaned player-match lines, the team matches and the
+  fixtures, never from a Player page mart. The marts must return exactly the expected value, or a blank
+  where the key is blank. A number compares at 1e-9. Returns each case whose value differs and each
+  case whose row is missing from the mart.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with answer_key as (
+    select * from {{ ref('player_page_answer_key') }}
+),
+
+header as (
+    select
+        'header' as block,
+        p.player_sk as player_id,
+        'featured' as scope,
+        f.field,
+        f.actual_text
+    from {{ ref('mart_player_profile') }} as p,
+        unnest([
+            struct('full_name' as field, p.player_full_name as actual_text),
+            ('season_label', p.season_label),
+            ('league_code', p.league_code),
+            ('current_club_name', p.current_club_name),
+            ('position_group', p.position_group),
+            ('has_club_tab', cast(p.has_club_tab as string)),
+            ('has_national_team_tab', cast(p.has_national_team_tab as string))
+        ]) as f
+    where p.is_featured_season
+),
+
+position_counts as (
+    select distinct
+        'position_count' as block,
+        cast(null as int64) as player_id,
+        concat(league_code, '|', season_api_year, '|', position_group) as scope,
+        'position_player_count' as field,
+        cast(position_player_count as string) as actual_text
+    from {{ ref('mart_player_competition_benchmarks') }}
+),
+
+filter_order as (
+    select distinct
+        'competition_order' as block,
+        player_sk as player_id,
+        concat(league_code, '|', season_api_year) as scope,
+        'competition_order' as field,
+        cast(competition_order as string) as actual_text
+    from {{ ref('mart_player_competition_benchmarks') }}
+    where page_tab is not null
+),
+
+club_window as (
+    select
+        'club_window' as block,
+        w.player_sk as player_id,
+        w.metric_key as scope,
+        f.field,
+        f.actual_text
+    from {{ ref('mart_player_window_metrics') }} as w,
+        unnest([
+            struct('value' as field, cast(w.metric_value as string) as actual_text),
+            ('minutes', cast(w.minutes as string)),
+            ('minutes_prev_season', cast(w.minutes_prev_season as string))
+        ]) as f
+    where w.page_tab = 'club'
+),
+
+squad as (
+    select distinct
+        'squad' as block,
+        cast(null as int64) as player_id,
+        squad_sk as scope,
+        'squad_player_count' as field,
+        cast(squad_player_count as string) as actual_text
+    from {{ ref('mart_player_squad_benchmarks') }}
+    union distinct
+    select distinct
+        'squad' as block,
+        cast(null as int64) as player_id,
+        squad_sk as scope,
+        concat(metric_key, '.squad_median') as field,
+        cast(squad_median as string) as actual_text
+    from {{ ref('mart_player_squad_benchmarks') }}
+    union distinct
+    select distinct
+        'squad' as block,
+        player_sk as player_id,
+        squad_sk as scope,
+        concat(metric_key, '.rank') as field,
+        cast(rank as string) as actual_text
+    from {{ ref('mart_player_squad_benchmarks') }}
+),
+
+actual as (
+    select
+        *,
+        safe_cast(actual_text as float64) as actual_number
+    from (
+        select * from header
+        union all
+        select * from position_counts
+        union all
+        select * from filter_order
+        union all
+        select * from club_window
+        union all
+        select * from squad
+    )
+)
+
+select
+    k.block,
+    k.player_id,
+    k.scope,
+    k.field,
+    k.expected,
+    a.actual_text,
+    a.block is not null as row_found
+from answer_key as k
+left join actual as a
+    on
+        k.block = a.block
+        and k.scope = a.scope
+        and k.field = a.field
+        and k.player_id is not distinct from a.player_id
+where
+    a.block is null
+    or case
+        when k.expected is null then a.actual_text is not null
+        when safe_cast(k.expected as float64) is not null and a.actual_number is not null
+            then abs(safe_cast(k.expected as float64) - a.actual_number) > 1e-9
+        else k.expected is distinct from a.actual_text
+    end
diff --git a/dbt_project/tests/assert_player_page_blocks_follow_the_rule.sql b/dbt_project/tests/assert_player_page_blocks_follow_the_rule.sql
new file mode 100644
index 00000000..7cf777f7
--- /dev/null
+++ b/dbt_project/tests/assert_player_page_blocks_follow_the_rule.sql
@@ -0,0 +1,166 @@
+{#
+  The Player page's comparison blocks, recomputed here for every player and squad, one failing row per
+  broken case: a competition in the Club or National team filter that is not in its place (domestic league
+  first, then the later last match of the competition, then the code), a Squad whose count is not the
+  players who reached a third of the team's minutes, a Squad rank that is not one more than the players
+  with a higher value, a Squad median that is not the middle of its values, and a Club tab whose minutes
+  this season or last season are not the player's minutes in the competitions of the window.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with shown_competitions as (
+    select distinct
+        b.player_sk,
+        b.season_sk,
+        b.league_code,
+        b.page_tab,
+        b.competition_order,
+        w.competition_type,
+        w.last_match_at
+    from {{ ref('mart_player_competition_benchmarks') }} as b
+    inner join {{ ref('int_player_page__window_seasons') }} as w
+        on
+            b.player_sk = w.player_sk
+            and b.season_sk = w.season_sk
+            and w.window_type = if(b.page_tab = 'club', 'this_season', 'current_competitions')
+    where b.page_tab is not null
+),
+
+filter_order_wrong as (
+    select
+        'filter order' as failure,
+        concat(cast(player_sk as string), ' ', page_tab, ' ', season_sk) as grain
+    from (
+        select
+            *,
+            row_number() over (
+                partition by player_sk, page_tab
+                order by
+                    case competition_type
+                        when 'domestic_league' then 1
+                        when 'domestic_cup' then 2
+                        when 'domestic_super_cup' then 3
+                        else 4
+                    end asc,
+                    last_match_at desc,
+                    league_code asc,
+                    season_sk asc
+            ) as expected_order
+        from shown_competitions
+    )
+    where competition_order != expected_order
+),
+
+squad_rows as (
+    select
+        squad_sk,
+        player_sk,
+        metric_key,
+        metric_value,
+        squad_player_count,
+        squad_median,
+        rank
+    from {{ ref('mart_player_squad_benchmarks') }}
+),
+
+squad_members as (
+    select
+        squad_sk,
+        count(*) as members
+    from {{ ref('int_player_squad_window__metrics') }}
+    where minutes >= team_matches * 90 / 3 and not stats_need_research
+    group by squad_sk
+),
+
+squad_count_wrong as (
+    select
+        'squad count' as failure,
+        r.squad_sk as grain
+    from (
+        select
+            squad_sk,
+            min(squad_player_count) as lowest,
+            max(squad_player_count) as highest
+        from squad_rows
+        group by squad_sk
+    ) as r
+    left join squad_members as m
+        on r.squad_sk = m.squad_sk
+    where r.lowest != r.highest or r.highest is distinct from m.members
+),
+
+squad_rank_wrong as (
+    select
+        'squad rank' as failure,
+        concat(s.squad_sk, ' ', s.metric_key, ' ', cast(s.player_sk as string)) as grain
+    from squad_rows as s
+    inner join squad_rows as o
+        on s.squad_sk = o.squad_sk and s.metric_key = o.metric_key
+    group by s.squad_sk, s.metric_key, s.player_sk, s.rank
+    having s.rank != 1 + countif(o.metric_value > s.metric_value)
+),
+
+squad_median_wrong as (
+    select
+        'squad median' as failure,
+        concat(squad_sk, ' ', metric_key) as grain
+    from (
+        select
+            squad_sk,
+            metric_key,
+            squad_median,
+            metric_value,
+            row_number() over (partition by squad_sk, metric_key order by metric_value asc) as position_in_order,
+            count(*) over (partition by squad_sk, metric_key) as values_counted
+        from squad_rows
+    )
+    where position_in_order in (div(values_counted + 1, 2), div(values_counted, 2) + 1)
+    group by squad_sk, metric_key, squad_median
+    having squad_median is null or abs(avg(metric_value) - squad_median) > 1e-9
+),
+
+window_minutes as (
+    select
+        p.player_sk,
+        w.window_type,
+        sum(l.minutes) as minutes
+    from {{ ref('int_player__page_profile') }} as p
+    inner join {{ ref('int_competition_season__club_windows') }} as w
+        on p.featured_season_sk = w.anchor_season_sk
+    inner join {{ ref('int_legs__player_match') }} as l
+        on p.player_sk = l.player_sk and w.season_sk = l.season_sk
+    group by p.player_sk, w.window_type
+),
+
+club_tabs as (
+    select distinct
+        player_sk,
+        minutes,
+        minutes_prev_season
+    from {{ ref('mart_player_window_metrics') }}
+    where page_tab = 'club'
+),
+
+tab_minutes_wrong as (
+    select
+        'club tab minutes' as failure,
+        cast(t.player_sk as string) as grain
+    from club_tabs as t
+    left join window_minutes as this_season
+        on t.player_sk = this_season.player_sk and this_season.window_type = 'this_season'
+    left join window_minutes as last_season
+        on t.player_sk = last_season.player_sk and last_season.window_type = 'last_season'
+    where
+        (t.minutes is not null and t.minutes is distinct from this_season.minutes)
+        or (t.minutes_prev_season is not null and t.minutes_prev_season is distinct from last_season.minutes)
+)
+
+select * from filter_order_wrong
+union all
+select * from squad_count_wrong
+union all
+select * from squad_rank_wrong
+union all
+select * from squad_median_wrong
+union all
+select * from tab_minutes_wrong
diff --git a/dbt_project/tests/assert_player_page_choices_follow_the_rule.sql b/dbt_project/tests/assert_player_page_choices_follow_the_rule.sql
new file mode 100644
index 00000000..b0af844e
--- /dev/null
+++ b/dbt_project/tests/assert_player_page_choices_follow_the_rule.sql
@@ -0,0 +1,244 @@
+{#
+  The Player page's header and choices, recomputed here for every player, one failing row per broken case:
+  an age that is not the whole years since the birth date, a full name that is not first and last name
+  joined (the player name when either is missing), a featured season that another season of the player
+  beats (club before national, domestic league before any other, the later year, the later last match),
+  a nation whose current competitions are not those running now or, with none running, the one that
+  finished last, a club tab for a player with no club match, and a national-team tab that differs from
+  the player's presence on a team sheet or stat line of a current competition, or on its squad list.
+  A nation with a competition starting or ending within a day of the run is left out, because the
+  models read the clock when they were built. A birth date on 29 February is left out of the age check,
+  because a whole-year step from it lands on 28 February in a common year, and so is a birthday today,
+  because the marts are built once a day and a build before midnight holds yesterday's age.
+#}
+{{ config(store_failures = true, severity = 'error') }}
+
+with people as (
+    select distinct
+        player_sk,
+        player_name,
+        player_first_name,
+        player_last_name,
+        player_full_name,
+        player_birth_date,
+        player_age
+    from {{ ref('mart_player_profile') }}
+),
+
+age_wrong as (
+    select
+        'age' as failure,
+        cast(p.player_sk as string) as grain
+    from people as p
+    cross join unnest(generate_array(0, 130)) as n
+    where
+        p.player_birth_date <= current_date()
+        and format_date('%m%d', p.player_birth_date) not in ('0229', format_date('%m%d', current_date()))
+        and date_add(p.player_birth_date, interval n year) <= current_date()
+    group by p.player_sk, p.player_age
+    having p.player_age is distinct from max(n)
+),
+
+full_name_wrong as (
+    select
+        'full name' as failure,
+        cast(player_sk as string) as grain
+    from people
+    where
+        player_full_name is distinct from if(
+            player_first_name is not null and player_last_name is not null,
+            concat(player_first_name, ' ', player_last_name),
+            player_name
+        )
+),
+
+player_seasons as (
+    select
+        player_sk,
+        season_sk,
+        season_api_year,
+        if(entity_type = 'club', 0, 1) as kind_rank,
+        if(competition_type = 'domestic_league', 0, 1) as type_rank,
+        max(kickoff_datetime) as last_match_at
+    from {{ ref('int_legs__player_match') }}
+    group by player_sk, season_sk, season_api_year, entity_type, competition_type
+),
+
+featured_beaten as (
+    select
+        'featured season beaten' as failure,
+        concat(cast(f.player_sk as string), ' ', f.season_sk, ' by ', o.season_sk) as grain
+    from {{ ref('int_player__page_profile') }} as p
+    inner join player_seasons as f
+        on p.player_sk = f.player_sk and p.featured_season_sk = f.season_sk
+    inner join player_seasons as o
+        on f.player_sk = o.player_sk and f.season_sk != o.season_sk
+    where
+        o.kind_rank < f.kind_rank
+        or (
+            o.kind_rank = f.kind_rank
+            and (
+                o.type_rank < f.type_rank
+                or (
+                    o.type_rank = f.type_rank
+                    and (
+                        o.season_api_year > f.season_api_year
+                        or (o.season_api_year = f.season_api_year and o.last_match_at > f.last_match_at)
+                    )
+                )
+            )
+        )
+),
+
+national_seasons as (
+    select
+        f.season_sk,
+        f.league_code,
+        min(f.kickoff_datetime) as first_match_at,
+        max(f.kickoff_datetime) as last_match_at
+    from {{ ref('fct_fixture') }} as f
+    inner join {{ ref('dim_league') }} as leagues
+        on f.league_code = leagues.league_code
+    where leagues.entity_type = 'national'
+    group by f.season_sk, f.league_code
+),
+
+team_national_seasons as (
+    select distinct
+        s.season_sk,
+        s.league_code,
+        s.first_match_at,
+        s.last_match_at,
+        team_sk
+    from {{ ref('fct_fixture') }} as f
+    inner join national_seasons as s
+        on f.season_sk = s.season_sk,
+        unnest([f.home_team_sk, f.away_team_sk]) as team_sk
+    where team_sk is not null
+),
+
+unsettled_teams as (
+    select distinct team_sk
+    from team_national_seasons
+    where
+        first_match_at between timestamp_sub(current_timestamp(), interval 1 day) and timestamp_add(current_timestamp(), interval 1 day)
+        or last_match_at between timestamp_sub(current_timestamp(), interval 1 day) and timestamp_add(current_timestamp(), interval 1 day)
+),
+
+started as (
+    select *
+    from team_national_seasons
+    where
+        first_match_at <= current_timestamp()
+        and team_sk not in (select team_sk from unsettled_teams)
+),
+
+expected_current as (
+    select
+        team_sk,
+        season_sk
+    from started
+    where last_match_at >= current_timestamp()
+    union all
+    select
+        team_sk,
+        latest.season_sk
+    from (
+        select
+            team_sk,
+            array_agg(struct(season_sk) order by last_match_at desc, league_code asc, season_sk asc limit 1)[offset(0)] as latest,
+            logical_or(last_match_at >= current_timestamp()) as any_running
+        from started
+        group by team_sk
+    )
+    where not any_running
+),
+
+actual_current as (
+    select
+        team_sk,
+        season_sk
+    from {{ ref('int_team__current_national_competitions') }}
+    where team_sk not in (select team_sk from unsettled_teams)
+),
+
+current_wrong as (
+    select
+        'current competition' as failure,
+        concat(cast(coalesce(e.team_sk, a.team_sk) as string), ' ', coalesce(e.season_sk, a.season_sk)) as grain
+    from expected_current as e
+    full outer join actual_current as a
+        on e.team_sk = a.team_sk and e.season_sk = a.season_sk
+    where e.team_sk is null or a.team_sk is null
+),
+
+club_players as (
+    select distinct player_sk
+    from {{ ref('int_legs__player_match') }}
+    where entity_type = 'club'
+),
+
+club_tab_wrong as (
+    select
+        'club tab' as failure,
+        cast(p.player_sk as string) as grain
+    from {{ ref('int_player__page_profile') }} as p
+    left join club_players as c
+        on p.player_sk = c.player_sk
+    where p.has_club_tab != (c.player_sk is not null)
+),
+
+team_sheets as (
+    select
+        fixture_sk,
+        team_sk,
+        player_sk
+    from {{ ref('fct_fixture_lineup') }}
+    where lineup_state in ('confirmed', 'researched') and player_sk is not null
+    union distinct
+    select
+        fixture_sk,
+        team_sk,
+        player_sk
+    from {{ ref('fct_fixture_player_stats') }}
+),
+
+expected_national as (
+    select distinct s.player_sk
+    from team_sheets as s
+    inner join {{ ref('fct_fixture') }} as f
+        on s.fixture_sk = f.fixture_sk
+    inner join expected_current as c
+        on s.team_sk = c.team_sk and f.season_sk = c.season_sk
+    union distinct
+    select distinct cast(sq.player_api_id as int64) as player_sk
+    from {{ ref('base_apif__squads') }} as sq
+    inner join expected_current as c
+        on cast(sq.team_api_id as int64) = c.team_sk
+    inner join national_seasons as n
+        on c.season_sk = n.season_sk and sq.league_code = n.league_code
+),
+
+national_tab_wrong as (
+    select
+        'national-team tab' as failure,
+        cast(p.player_sk as string) as grain
+    from {{ ref('int_player__page_profile') }} as p
+    left join expected_national as e
+        on p.player_sk = e.player_sk
+    where
+        (p.national_team_sk is null or p.national_team_sk not in (select team_sk from unsettled_teams))
+        and p.has_national_team_tab != (e.player_sk is not null)
+)
+
+select * from age_wrong
+union all
+select * from full_name_wrong
+union all
+select * from featured_beaten
+union all
+select * from current_wrong
+union all
+select * from club_tab_wrong
+union all
+select * from national_tab_wrong
