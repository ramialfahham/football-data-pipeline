+def visible_rows(path: Path = MATCHES_DAY) -> int:
+    """The rows a competition group shows before its Fold, as the page's own code sets them."""
+    m = re.search(r"\bVISIBLE_ROWS\s*=\s*(\d+)", path.read_text(encoding="utf-8"))
