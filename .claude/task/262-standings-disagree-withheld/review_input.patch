diff --git a/dbt_project/macros/published_table_mismatches.sql b/dbt_project/macros/published_table_mismatches.sql
new file mode 100644
index 00000000..c5c2dd15
--- /dev/null
+++ b/dbt_project/macros/published_table_mismatches.sql
@@ -0,0 +1,92 @@
+{#
+  The teams whose rebuilt table differs from a table the provider published, among the teams that are
+  not withheld. A team-season withheld against the standings (int_team_season__metrics) is left out.
+  Every other team is a mismatch where its rebuilt points differ from its published points, or its
+  rebuilt place differs from its published place.
+
+  The places are compared within one published section (league_code, season_api_year, group_name,
+  ingested_at). A team's place on a side is its rank on that side, less the number of withheld teams
+  of the section ranked above it on that side. That is the rank itself when no team is withheld, so a
+  place error is red next to a team with no rebuilt place or a place the league's rule does not fix.
+  A withheld team's points cannot move the places of the others: they all move up by one on the side
+  where the withheld team was ranked above them. A team with no published rank or no rebuilt rank, and
+  a team whose place the league's rule does not fix, stays in the section and is left out of the place
+  comparison.
+
+  compared: a relation with league_code, season_api_year, group_name, ingested_at, team_sk,
+      published_rank, rebuilt_rank, published_points, rebuilt_points, is_place_not_compared,
+      is_comparable and is_withheld, one row per team of a published section.
+  Returns a select with the section, the team, and the two places and the two points.
+#}
+{% macro published_table_mismatches(compared) -%}
+    with section_teams as (
+        select * from {{ compared }}
+        where is_comparable
+    ),
+
+    place_counted as (
+        select
+            t.league_code,
+            t.season_api_year,
+            t.group_name,
+            t.ingested_at,
+            t.team_sk,
+            t.published_rank,
+            t.rebuilt_rank,
+            t.published_points,
+            t.rebuilt_points,
+            t.is_place_not_compared,
+            t.is_withheld,
+            t.published_rank - countif(w.team_sk is not null and w.published_rank < t.published_rank) as published_place,
+            t.rebuilt_rank - countif(w.team_sk is not null and w.rebuilt_rank < t.rebuilt_rank) as rebuilt_place
+        from section_teams as t
+        left join section_teams as w
+            on
+                t.league_code = w.league_code
+                and t.season_api_year = w.season_api_year
+                and t.group_name = w.group_name
+                and t.ingested_at = w.ingested_at
+                and w.is_withheld
+        group by
+            t.league_code,
+            t.season_api_year,
+            t.group_name,
+            t.ingested_at,
+            t.team_sk,
+            t.published_rank,
+            t.rebuilt_rank,
+            t.published_points,
+            t.rebuilt_points,
+            t.is_place_not_compared,
+            t.is_withheld
+    )
+
+    select
+        league_code,
+        season_api_year,
+        group_name,
+        ingested_at,
+        team_sk,
+        published_rank,
+        rebuilt_rank,
+        published_points,
+        rebuilt_points
+    from place_counted
+    where
+        not is_withheld
+        and published_place != rebuilt_place
+        and not is_place_not_compared
+    union distinct
+    select
+        league_code,
+        season_api_year,
+        group_name,
+        ingested_at,
+        team_sk,
+        published_rank,
+        rebuilt_rank,
+        published_points,
+        rebuilt_points
+    from section_teams
+    where not is_withheld and rebuilt_points != published_points
+{%- endmacro %}
diff --git a/dbt_project/macros/team_season_counts_from_legs.sql b/dbt_project/macros/team_season_counts_from_legs.sql
new file mode 100644
index 00000000..b888c927
--- /dev/null
+++ b/dbt_project/macros/team_season_counts_from_legs.sql
@@ -0,0 +1,26 @@
+{#
+  A team-season's counts built from its legs, the inputs team_seasons_off_standings compares with the
+  provider's standings: games played, wins, draws, losses, goals, goals against and points. The
+  rules are those of int_team_season__metrics_cumulative for the whole season: a count is blank when
+  one match of the season has no value for it, and the points are three per win and one per draw plus
+  the matches the table counts as won on a shoot-out.
+
+  legs: a relation with one row per team-match leg (int_legs__team_match): team_sk, season_sk,
+      result, goals, goals_against and is_table_shootout_win.
+  Returns a select, so call it inside a CTE or a subquery.
+#}
+{% macro team_season_counts_from_legs(legs) -%}
+    select
+        team_sk,
+        season_sk,
+        count(*) as season_games_played,
+        countif(result = 'W') as wins,
+        countif(result = 'D') as draws,
+        countif(result = 'L') as losses,
+        if(logical_and(goals is not null), sum(goals), null) as goals,
+        if(logical_and(goals_against is not null), sum(goals_against), null) as goals_against,
+        sum(case result when 'W' then 3 when 'D' then 1 else 0 end)
+        + if(logical_and(is_table_shootout_win is not null), countif(is_table_shootout_win), null) as points_won
+    from {{ legs }}
+    group by team_sk, season_sk
+{%- endmacro %}
diff --git a/dbt_project/macros/team_seasons_off_standings.sql b/dbt_project/macros/team_seasons_off_standings.sql
new file mode 100644
index 00000000..06682b95
--- /dev/null
+++ b/dbt_project/macros/team_seasons_off_standings.sql
@@ -0,0 +1,82 @@
+{#
+  The team-seasons whose results disagree with the provider's standings. One row per team-season and
+  reason, two reasons:
+    counts_differ - a standings row that counts the same games as our season (its played equals our
+        games played) carries other wins, draws, losses, goals or goals against, or other points
+        than ours plus the points the league took, declared in standings_points_adjustments;
+    games_short - our games played are fewer than the most any standings row of the team-season
+        counts. The maximum is used because one team-season can hold several standings rows (a
+        group table and a play-off table) that count different numbers of games, and any one of
+        them says the team played that many.
+  A standings row that counts other games, a snapshot older than our last match or a section that
+  counts other games, is not compared: ours being ahead of it is the normal state.
+
+  counts: a relation with team_sk, season_sk, season_games_played, wins, draws, losses, goals,
+      goals_against and points_won, one row per team-season.
+  standings: a relation with team_sk, season_sk, league_code, season_api_year, team_api_id,
+      group_name, played, wins, draws, losses, goals_scored, goals_conceded and points.
+  adjustments: a relation with league_code, season, team_id, group_name and points_taken.
+  Returns a select, so call it inside a CTE or a subquery.
+#}
+{% macro team_seasons_off_standings(counts, standings, adjustments) -%}
+    with off_adjusted as (
+        select
+            league_code,
+            season,
+            team_id,
+            trim(group_name) as group_name,
+            sum(points_taken) as points_taken
+        from {{ adjustments }}
+        group by league_code, season, team_id, trim(group_name)
+    ),
+
+    off_same_games as (
+        select distinct
+            o.team_sk,
+            o.season_sk,
+            'counts_differ' as reason
+        from {{ counts }} as o
+        inner join {{ standings }} as t
+            on
+                o.team_sk = t.team_sk
+                and o.season_sk = t.season_sk
+                and o.season_games_played = t.played
+        left join off_adjusted as a
+            on
+                t.league_code = a.league_code
+                and t.season_api_year = a.season
+                and t.team_api_id = a.team_id
+                and trim(t.group_name) = a.group_name
+        where
+            o.wins is distinct from t.wins
+            or o.draws is distinct from t.draws
+            or o.losses is distinct from t.losses
+            or o.goals is distinct from t.goals_scored
+            or o.goals_against is distinct from t.goals_conceded
+            or o.points_won is distinct from t.points + coalesce(a.points_taken, 0)
+    ),
+
+    off_most_played as (
+        select
+            team_sk,
+            season_sk,
+            max(played) as played
+        from {{ standings }}
+        group by team_sk, season_sk
+    ),
+
+    off_short as (
+        select distinct
+            o.team_sk,
+            o.season_sk,
+            'games_short' as reason
+        from {{ counts }} as o
+        inner join off_most_played as s
+            on o.team_sk = s.team_sk and o.season_sk = s.season_sk
+        where s.played is not null and o.season_games_played < s.played
+    )
+
+    select * from off_same_games
+    union all
+    select * from off_short
+{%- endmacro %}
