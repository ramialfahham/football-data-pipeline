+
+fixture_sides as (
+    select
+        league_code,
+        home_team_id as team_api_id
+    from import_base_apif__fixtures_next
+    union distinct
+    select
+        league_code,
+        away_team_id as team_api_id
+    from import_base_apif__fixtures_next
