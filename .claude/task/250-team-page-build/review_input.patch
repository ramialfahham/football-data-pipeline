diff --git a/site_v2/src/components/ui/LastSeasonTable.astro b/site_v2/src/components/ui/LastSeasonTable.astro
new file mode 100644
index 00000000..6d4bc87a
--- /dev/null
+++ b/site_v2/src/components/ui/LastSeasonTable.astro
@@ -0,0 +1,64 @@
+---
+// THE last-season table: the metrics in their groups, each row this season / last season / the
+// trend. ▲ when this season is better by the metric's direction, ▼ when worse, "–" when the shown
+// values are equal, empty when either season has no value or the metric has no direction. A
+// non-key row carries the switch's mark.
+import TableRow from "./TableRow.astro";
+import Group from "./Group.astro";
+import GroupHead from "./GroupHead.astro";
+import { DASH, formatValue } from "../../lib/format";
+import { t, metricLabel } from "../../i18n/strings";
+import { betterSide } from "../../lib/bars";
+import type { Lang } from "../../lib/format";
+
+interface Row {
+  label: string;
+  now: number | null | undefined;
+  prev: number | null | undefined;
+  format: Parameters<typeof formatValue>[1];
+  direction: Parameters<typeof betterSide>[2];
+  nonkey: boolean;
+}
+interface Props {
+  lang: Lang;
+  groups: { key: string; nonkey: boolean; rows: Row[] }[];
+}
+const { lang, groups } = Astro.props;
+const shown = (v: number | null | undefined, format: Row["format"]) =>
+  typeof v === "number" ? formatValue(v, format, lang) : DASH;
+---
+
+<div class="yoy-list">
+  {groups.map((g) => (
+    <Group metric nonkey={g.nonkey}>
+      <GroupHead lang={lang} name={metricLabel(lang, `metricGroups.${g.key}.label`)} statistics={g.key} />
+      <div class="ctab yoyt">
+        <div class="ctab-head">
+          <span class="h nmh"></span>
+          <span class="h">{t(lang, "teamThisSeasonHead")}</span>
+          <span class="h">{t(lang, "teamLastSeasonHead")}</span>
+          <span class="h tr">{t(lang, "teamTrend")}</span>
+        </div>
+        {g.rows.map((r) => {
+          const a = shown(r.now, r.format);
+          const b = shown(r.prev, r.format);
+          const blank = a === DASH || b === DASH;
+          const side = blank || a === b ? null : betterSide(r.now as number, r.prev as number, r.direction);
+          const trend = blank || (r.direction === "neutral" && a !== b)
+            ? { text: "", kind: "tr" }
+            : side === "home" ? { text: "▲", kind: "tr up", label: t(lang, "teamTrendBetter") }
+            : side === "away" ? { text: "▼", kind: "tr down", label: t(lang, "teamTrendWorse") }
+            : { text: "–", kind: "tr flat", label: t(lang, "teamTrendSame") };
+          return (
+            <TableRow
+              lang={lang}
+              name={r.label}
+              cells={[{ text: a, kind: "now" }, { text: b, kind: "prev" }, trend]}
+              nonkey={r.nonkey}
+            />
+          );
+        })}
+      </div>
+    </Group>
+  ))}
+</div>
diff --git a/site_v2/src/components/ui/StripPlot.astro b/site_v2/src/components/ui/StripPlot.astro
new file mode 100644
index 00000000..81f8a1ce
--- /dev/null
+++ b/site_v2/src/components/ui/StripPlot.astro
@@ -0,0 +1,43 @@
+---
+// THE strip plot row: the metric's name, a line from the lowest to the highest value with every
+// other entity a light dot, the median a tick with its value, the entity itself the solid dot, and
+// its rank over its value on the right. A non-key row carries the switch's mark.
+import { stripInset } from "../../lib/chartTheme";
+import { formatValue, ordinal } from "../../lib/format";
+import { medianAnchor, placeOnLine } from "../../lib/playerPage";
+import type { Lang } from "../../lib/format";
+
+interface Props {
+  lang: Lang;
+  metricId: string;
+  label: string;
+  value: number;
+  rank: number | null | undefined;
+  /** Every value of the compared set. */
+  peers: number[];
+  median: number | null | undefined;
+  format: Parameters<typeof formatValue>[1];
+  nonkey: boolean;
+}
+const { lang, metricId, label, value, rank, peers, median, format, nonkey } = Astro.props;
+const lo = Math.min(...peers, value);
+const hi = Math.max(...peers, value);
+const at = (x: number) => `${Number(placeOnLine(x, lo, hi, stripInset).toFixed(1))}%`;
+const tick = median != null ? at(median) : null;
+---
+
+<div class:list={["rs-row", { nonkey }]} data-metric={metricId}>
+  <span class="chart-name">{label}</span>
+  <span class="rs-band">
+    <svg class="rs-plot" aria-hidden="true" focusable="false">
+      <line class="chart-axis" x1="0" x2="100%" y1="50%" y2="50%"></line>
+      <g class="rs-peers">{peers.map((x) => <circle cx={at(x)}></circle>)}</g>
+      {tick != null && <line class="rs-tick" x1={tick} x2={tick} y1="2" y2="12"></line>}
+      {tick != null && (
+        <text class="rs-tick-value" x={tick} y="27" text-anchor={medianAnchor(parseFloat(tick))}>{formatValue(median, format, lang)}</text>
+      )}
+      <circle class="chart-dot chart-me" cx={at(value)} cy="50%"></circle>
+    </svg>
+  </span>
+  <span class="rs-val">{ordinal(rank, lang)}<small>{formatValue(value, format, lang)}</small></span>
+</div>
