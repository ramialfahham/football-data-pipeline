+const { season, seasonLabel, lang } = Astro.props;
+const count = (v: number | null | undefined) => (v == null ? DASH : integer(v, lang));
+const cards = [
+  { value: count(season.matches), label: t(lang, "teamCardMatches") },
+  { value: count(season.wins), label: t(lang, "wins") },
+  { value: count(season.cards.goals), label: t(lang, "goals") },
+  { value: count(season.cards.goals_against), label: t(lang, "goalsAgainst") },
+  { value: count(season.cards.cards_yellow), label: t(lang, "yellowCards") },
+  { value: count(season.cards.cards_red), label: t(lang, "redCards") },
+];
+const competitions = listOf(season.league_codes.map((c) => competitionInfo(c).name), lang);
+---
+
+<section>
+  <SectionHead label={t(lang, "teamThisSeasonHead")} />
+  <Explainer text={t(lang, "teamThisSeasonIntro", { season: seasonLabel, competitions })} />
+  <StatCards cards={cards} />
