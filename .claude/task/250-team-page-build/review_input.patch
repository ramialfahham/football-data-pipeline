-.rs-band > span:not([class]) { position: absolute; top: 50%; translate: -50% -50%; display: flex; }
-.rs-band > .chart-tick { position: absolute; top: 16px; left: 0; white-space: nowrap; }
-.rs-band > .chart-tick.chart-end { left: auto; right: 0; }
 .rs-val { align-self: start; text-align: right; font-size: var(--chart-text-value); font-weight: 700; color: var(--chart-team); font-variant-numeric: tabular-nums; line-height: 1.25; }
 .rs-val small { display: block; font-size: var(--chart-text); font-weight: 400; color: var(--muted); }
 
