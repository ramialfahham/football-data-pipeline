+    (repo / ".claude" / "task" / "40-delta").mkdir()
+    (repo / ".claude" / "task" / "40-delta" / "notes.md").write_text("x\n", encoding="utf-8")
+    git(repo, "add", "-A")
+    git(repo, "commit", "-qm", "second folder")
+    code, out = ci(repo)
+    assert code == 1 and "exactly one task folder" in out
