{
  "permissions": {
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(git clean *)",
      "Bash(bq rm *)",
      "Bash(gcloud projects delete *)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Read(.env)",
      "Read(.envrc)",
      "Read(**/*.secrets.env)",
      "Read(**/*.local.env)",
      "Edit(.env)",
      "Edit(.envrc)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_discipline.py\"",
            "statusMessage": "Checking git discipline..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_gate.py\"",
            "statusMessage": "Checking task contract (shell)..."
          }
        ]
      },
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_gate.py\"",
            "statusMessage": "Checking task contract (artifact)..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/dbt_layer_gate.py\"",
            "statusMessage": "Checking dbt layer contract..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_gate.py\"",
            "statusMessage": "Checking task contract..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/comment_history_gate.py\"",
            "statusMessage": "Checking comments for decision history..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory_budget_gate.py\"",
            "statusMessage": "Checking the memory budget..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/host_fingerprint_gate.py\"",
            "statusMessage": "Checking for a host address..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_workflow.py\"",
            "statusMessage": "Enforcing branch workflow..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/task_contract_gate.py\"",
            "statusMessage": "Verifying tree matches contract..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_gate.py\"",
            "statusMessage": "Stop gate: contract check..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/handover_in.py\"",
            "statusMessage": "Loading the active-work handover..."
          }
        ]
      }
    ]
  }
}
