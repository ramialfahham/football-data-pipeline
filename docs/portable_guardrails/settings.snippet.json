{
  "_comment": "Portable agent guardrails. Merge the `hooks` block below into your ~/.claude/settings.json (global, applies to every project) or a project's .claude/settings.json. Copy hooks/*.py into the matching hooks dir ($HOME/.claude/hooks for global). All hooks are project-agnostic and fail open. The handover hooks read/remind about a per-project .claude/active_work.md. See ../agent_guardrails.md.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$HOME/.claude/hooks/handover_in.py\"",
            "statusMessage": "Loading active-work handover..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$HOME/.claude/hooks/pre_push_gate.py\"",
            "statusMessage": "Pre-push checklist..."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$HOME/.claude/hooks/handover_out.py\"",
            "statusMessage": "Handover write-out reminder..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$HOME/.claude/hooks/handover_plan_gate.py\"",
            "statusMessage": "Plan-back gate..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$HOME/.claude/hooks/plan_implement_gate.py\"",
            "statusMessage": "Plan to implementation checklist..."
          }
        ]
      }
    ]
  }
}
