#!/usr/bin/env bash
# Enforces working_agreement.md section 3: every commit must be pushed and have an open PR.

BRANCH=$(git rev-parse --abbrev-ref HEAD)

# Skip main/master — direct commits there are blocked by agreement, not this hook
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; then
  exit 0
fi

echo ""
echo "==> [post-commit] Pushing $BRANCH to gitlab..."
git push gitlab "$BRANCH"

PUSH_EXIT=$?
if [ $PUSH_EXIT -ne 0 ]; then
  echo "==> [post-commit] Push failed (exit $PUSH_EXIT). Fix the push manually, then run: glab mr create"
  exit 0
fi

echo ""
echo "==> [post-commit] Checking for an OPEN MR..."
# `mr list --source-branch` defaults to OPEN merge requests and returns [] when there are none.
# `mr view` was wrong twice: it resolves a MERGED MR and reports it as open (GitLab #29), and it
# cannot resolve a branch carrying more than one MR at all. Ask the question directly.
MR_URL=$(glab mr list --source-branch "$BRANCH" --output json --jq '.[0].web_url // empty' 2>/dev/null)
LIST_EXIT=$?

if [ $LIST_EXIT -eq 0 ] && [ -n "$MR_URL" ]; then
  echo "==> [post-commit] MR already open: $MR_URL"
else
  # Every other outcome — no MR, only merged/closed ones, or the lookup failing — opens one.
  # A duplicate MR is visible and cheap; a false "already open" is neither.
  echo "==> [post-commit] No open MR for $BRANCH. Opening one..."
  glab mr create --target-branch main --fill --yes
fi
