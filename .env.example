# Copy this file to ".env" in the repo root (same folder as README.md).
# ".env" is gitignored — put secrets there once, then run: python -m ingestion.api_football.main

API_FOOTBALL_API_KEY=

# Ingest profile: unset = full warehouse (all API-listed seasons + paid-friendly defaults).
# Use "default" or "economy" for free-tier (~single season + slow pacing).
# API_FOOTBALL_INGEST_PROFILE=default

# BigQuery dataset id for 1:1 API loads (must match dbt sources schema; default raw).
# API_FOOTBALL_BIGQUERY_DATASET=raw

# Optional (see docs/api_football_mvp_scope.md):
# API_FOOTBALL_FIXTURES_MODE=season
# API_FOOTBALL_FIXTURE_USE_PAGE=0
# API_FOOTBALL_LINEUPS_MAX_FIXTURES=
# API_FOOTBALL_FANOUT_SOFT_CAP_FIXTURES_NO_HEADER=6
# API_FOOTBALL_FETCH_TRANSFERS=1
# API_FOOTBALL_FANOUT_PRIORITY=upcoming
# API_FOOTBALL_FRESH_HORIZON_DAYS=14
# API_FOOTBALL_SKIP_PLAYERS=0
# API_FOOTBALL_REQUEST_PAUSE_MS=

# Single-flight (BigQuery RAW_APIF_INGEST_LOCK) and post-run fanout completeness:
# API_FOOTBALL_SKIP_INGEST_LOCK=0
# API_FOOTBALL_INGEST_LEASE_MINUTES=180
# API_FOOTBALL_SKIP_COMPLETENESS_CHECK=0
# API_FOOTBALL_FAIL_ON_INCOMPLETE=1
