---
// Compared with last season: this season so far against the whole of last season, over all the
// club's competitions, per match, from the first match, on the last-season table. The key metrics
// show; the switch shows every row in its place. Absent when the club played no match last season
// or every value is blank. Data: mart_team_page_window_metrics, through the payload's last_season.
import SectionHead from "../ui/SectionHead.astro";
import Explainer from "../ui/Explainer.astro";
import MetricSwitch from "../ui/MetricSwitch.astro";
import LastSeasonTable from "../ui/LastSeasonTable.astro";
import type { Lang } from "../../lib/format";
import { integer } from "../../lib/format";
import { t, boardTitle } from "../../i18n/strings";
import { needsSwitch } from "../../lib/comparisonGroups";
import { teamComparisonGroups } from "../../lib/metricRows";
import type { TeamLastSeasonWindow } from "../../lib/types";

interface Props {
  lastSeason: TeamLastSeasonWindow | null | undefined;
  /** The club's comparison metrics, served. */
  compared: string[];
  lang: Lang;
}
const { lastSeason, compared, lang } = Astro.props;

const byKey = new Map((lastSeason?.metrics ?? []).map((m) => [m.metric_key, m]));
const groups = lastSeason
  ? teamComparisonGroups(compared, (id) => byKey.get(id)?.value != null || byKey.get(id)?.value_prev != null)
  : [];
const showSwitch = needsSwitch(groups);
const table = groups.map((g) => ({
  key: g.key,
  nonkey: !g.hasKey,
  rows: g.rows.map((r) => ({
    label: boardTitle(lang, r.label_i18n_key, r.per_match),
    now: byKey.get(r.metric_id)?.value,
    prev: byKey.get(r.metric_id)?.value_prev,
    format: r.format,
    direction: r.direction,
    nonkey: !r.is_key_metric,
  })),
}));
const matches = (n: number) => t(lang, n === 1 ? "teamMatchOne" : "compFactMatches", { n: integer(n, lang) });
---

{groups.length > 0 && (
  <section>
    <SectionHead label={t(lang, "teamVsLastSeason")} />
    <Explainer text={t(lang, "teamVsLastSeasonIntro", { now: matches(lastSeason!.matches), prev: integer(lastSeason!.matches_prev, lang) })} />
    {showSwitch && <MetricSwitch id="tsw-season" lang={lang} />}
    <LastSeasonTable lang={lang} groups={table} />
  </section>
)}
