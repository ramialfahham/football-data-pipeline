---
// The Team page's tabs: Overview, Matches and Performance, each present when its page has a block.
// Each tab is a `<label>` bound to a hidden `#tab-*` radio the page renders; the checked radio marks
// its label and shows its `.page` panel in CSS. No client script.
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";

interface Props {
  lang: Lang;
  pages: ("overview" | "matches" | "performance")[];
}
const { lang, pages } = Astro.props;

const LABEL = { overview: "tabOverview", matches: "navMatches", performance: "tabPerformance" };
---

<nav class="tabs comp-tabs" aria-label={t(lang, "tabsAria")}>
  {pages.map((go) => (
    <label class="tab" for={`tab-${go}`}>{t(lang, LABEL[go])}</label>
  ))}
</nav>
