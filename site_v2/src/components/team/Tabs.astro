---
// The Team page's tabs: Overview, Matches and Performance, each present when its page has a block,
// on the tab band's radios; the checked radio shows its `.page` panel in CSS.
import TabBand from "../ui/TabBand.astro";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";

interface Props {
  lang: Lang;
  pages: ("overview" | "matches" | "performance")[];
}
const { lang, pages } = Astro.props;

const LABEL = { overview: "overview", matches: "navMatches", performance: "tabPerformance" };
---

<TabBand label={t(lang, "tabsAria")} group="team-tab" tabs={pages.map((go) => ({ key: go, label: t(lang, LABEL[go]) }))} />
