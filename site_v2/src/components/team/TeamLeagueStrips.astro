---
// Compared with other teams (a club) or Compared with the league (a national team): each metric of
// the served list as a strip plot of the competition's teams this season, the median ticked, the
// team's rank over its value on the right. A club chooses among its league and each competition of
// the season benchmarked over its table rounds, each a panel; the choice shows from two of them.
// A row without a value for the team is left out. The key metrics show; the switch shows every
// row in its place. Data: mart_team_competition_benchmarks and its every-club strip.
import SectionHead from "../ui/SectionHead.astro";
import Explainer from "../ui/Explainer.astro";
import MetricSwitch from "../ui/MetricSwitch.astro";
import ChartLegend from "../ui/ChartLegend.astro";
import FilterBar from "../ui/FilterBar.astro";
import Group from "../ui/Group.astro";
import GroupHead from "../ui/GroupHead.astro";
import StripPlot from "../ui/StripPlot.astro";
import type { Lang } from "../../lib/format";
import { integer } from "../../lib/format";
import { t, metricLabel, boardTitle } from "../../i18n/strings";
import { comparisonGroups, needsSwitch } from "../../lib/comparisonGroups";
import { teamBinding, teamComparisonGroups } from "../../lib/metricRows";
import { competitionInfo } from "../../lib/teamFixtures";
import type { TeamSeason, WindowStats } from "../../lib/types";

interface Props {
  /** The featured season first, then each competition the club is compared in. */
  seasons: TeamSeason[];
  teamName: string;
  club: boolean;
  /** A club's comparison metrics, served. */
  compared?: string[];
  lang: Lang;
}
const { seasons, teamName, club, compared = [], lang } = Astro.props;

const panels = seasons.map((s, i) => {
  const bench = new Map((s.benchmarks ?? []).map((b) => [b.metric_key, b]));
  const strips = new Map((s.league_strip ?? []).map((x) => [x.metric_key, x.clubs]));
  const has = (id: string) => bench.get(id)?.metric_value != null;
  const groups = club
    ? teamComparisonGroups(compared, has)
    : comparisonGroups(Object.fromEntries([...bench].map(([k, b]) => [k, b.metric_value ?? null])) as WindowStats, null)
      .map((g) => ({ ...g, rows: g.rows.map(teamBinding).filter((r) => has(r.metric_id)) }))
      .filter((g) => g.rows.length > 0);
  const comp = competitionInfo(s.league_code).name;
  // Every team of the pool is ranked on some metric, so the pool is the largest count of any metric.
  const teamCount = Math.max(0, ...(s.benchmarks ?? []).map((b) => b.team_count ?? 0));
  return {
    slot: i + 1,
    league: s.league_code,
    comp,
    groups,
    bench,
    strips,
    intro: club
      ? t(lang, "teamVsOthersIntro", { n: integer(teamCount, lang), competition: comp, season: s.season_label ?? "" })
      : t(lang, "teamVsLeagueIntro", { competition: comp }),
    others: t(lang, i === 0 ? "teamOtherTeams" : "teamOtherTeamsInternational", { competition: comp }),
  };
}).filter((p) => p.groups.length > 0);
const showSwitch = needsSwitch(panels.flatMap((p) => p.groups));
const group = "team-compare";
---

{panels.length > 0 && (
  <section>
    <SectionHead label={t(lang, club ? "teamVsOthers" : "teamVsLeague")} />
    <FilterBar filters={[{
      name: group,
      aria: t(lang, "playerComparedWith"),
      choices: panels.map((p) => ({ id: `${group}-${p.slot}`, value: String(p.slot), label: p.comp, attrs: { "data-cmp": p.slot } })),
    }]} />
    <div class="cmp-panels">
      {panels.map((p) => <Explainer text={p.intro} class="cmp-p" data-cmp={p.slot} />)}
    </div>
    {showSwitch && <MetricSwitch id="tsw-league" lang={lang} />}
    <div class="cmp-panels">
      {panels.map((p) => (
        <div class="cmp-p" data-cmp={p.slot} data-league={p.league}>
          <div class="chart">
            <ChartLegend keys={[
              { mark: "team", label: teamName },
              { mark: "other", label: p.others },
              { mark: "median", label: t(lang, "median") },
            ]} />
            {p.groups.map((g) => (
              <Group metric nonkey={!g.hasKey}>
                <GroupHead lang={lang} name={metricLabel(lang, `metricGroups.${g.key}.label`)} statistics={g.key} />
                {g.rows.map((r) => {
                  const b = p.bench.get(r.metric_id)!;
                  const peers = (p.strips.get(r.metric_id) ?? [])
                    .filter((c) => !c.is_self && c.value != null)
                    .map((c) => c.value as number);
                  return (
                    <StripPlot
                      lang={lang}
                      metricId={r.metric_id}
                      label={boardTitle(lang, r.label_i18n_key, r.per_match)}
                      value={b.metric_value as number}
                      rank={b.rank}
                      peers={peers}
                      median={b.league_median}
                      format={r.format}
                      nonkey={!r.is_key_metric}
                    />
                  );
                })}
              </Group>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}
