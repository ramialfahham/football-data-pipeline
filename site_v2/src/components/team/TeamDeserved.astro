---
// Deserved points: the competition page's explainer, a table of the team's four values (shots on
// target difference per match, points, deserved points, the difference), then the league's
// scatter plot: every team's shots on target difference per match against its points, the
// deserved points line, the team as the one solid dot with its difference as a dotted line. The
// line joins the served deserved points of the two teams at the ends of the axis; deserved points
// lie on it by the model. Marks keep their pixel size at every width (chartMarks.mjs). Present
// only where the model fitted the league (mart_team_profile, deserved_scatter).
import SectionHead from "../ui/SectionHead.astro";
import type { Lang } from "../../lib/format";
import { decimal1, integer, signedDelta } from "../../lib/format";
import { t, metricLabel, metricInSentence } from "../../i18n/strings";
import type { ScatterDot, TeamSeason } from "../../lib/types";

interface Props {
  season: TeamSeason;
  teamName: string;
  compName: string;
  lang: Lang;
}
const { season: s, teamName, compName, lang } = Astro.props;

const SOTD = "metrics.shots_on_goal_difference_per_match.label";
const DESERVED = "metrics.deserved_points.label";
const POINTS = "metrics.points_won.label";
const GAP = "metrics.deserved_points_gap.label";
const names = {
  deservedName: metricLabel(lang, DESERVED),
  sotdName: metricInSentence(lang, SOTD),
  sotdNameStart: metricLabel(lang, SOTD),
  sotName: metricInSentence(lang, "metrics.shots_on_target_per_match.label"),
};
const signed = (v: number | null | undefined) => signedDelta(v, "decimal_1", lang).value;

const dots = (s.deserved_scatter ?? []).filter(
  (d): d is ScatterDot & { sotd: number; points: number; deserved: number } =>
    d.sotd != null && d.points != null && d.deserved != null,
);
const me = dots.find((d) => d.is_self);
const rows = [
  { name: metricLabel(lang, SOTD), sub: t(lang, "perMatch"), value: signed(s.shots_on_goal_difference_per_match) },
  { name: metricLabel(lang, POINTS), sub: "", value: integer(s.points, lang) },
  { name: metricLabel(lang, DESERVED), sub: "", value: decimal1(s.deserved_points, lang) },
  { name: metricLabel(lang, GAP), sub: "", value: signed(s.deserved_points_gap) },
];

// Drawing geometry: axes round outward to whole numbers, the y axis in steps of 3 points.
const lo = dots.length ? [...dots].sort((a, b) => a.sotd - b.sotd)[0] : null;
const hi = dots.length ? [...dots].sort((a, b) => b.sotd - a.sotd)[0] : null;
function chart(W: number, H: number, fs: number) {
  if (!lo || !hi || !me) return null;
  const L = W > 400 ? 46 : 34, R = 14, T = 12, B = 58;
  const x0 = Math.floor(lo.sotd) - 1, x1 = Math.ceil(hi.sotd) + 1;
  const y1 = Math.ceil((Math.max(...dots.map((d) => Math.max(d.points, d.deserved))) + 2) / 3) * 3;
  const sx = (x: number) => L + ((x - x0) / (x1 - x0)) * (W - L - R);
  const sy = (y: number) => T + (1 - y / y1) * (H - T - B);
  const slope = hi.sotd === lo.sotd ? 0 : (hi.deserved - lo.deserved) / (hi.sotd - lo.sotd);
  const onLine = (x: number) => lo.deserved + slope * (x - lo.sotd);
  const xTicks = [];
  for (let x = x0; x <= x1; x += 1) if ((x - x0) % 2 === 0) xTicks.push(x);
  const yTicks = [];
  for (let y = 0; y <= y1; y += 3) yTicks.push(y);
  const cx = sx(me.sotd), cy = sy(me.points), cl = sy(onLine(me.sotd));
  const right = cx < (L + W - R) / 2;
  return {
    W, H, fs, L, R, T, B, sx, sy, xTicks, yTicks,
    line: { x1: sx(x0), y1: sy(onLine(x0)), x2: sx(x1), y2: sy(onLine(x1)) },
    me: { cx, cy, cl, lx: right ? cx + 7 : cx - 7, anchor: right ? "start" : "end" },
  };
}
const charts = [{ cls: "dp-wide", c: chart(560, 330, 12) }, { cls: "dp-narrow", c: chart(280, 230, 11) }];
const tip = (d: ScatterDot & { sotd: number; points: number; deserved: number }) =>
  `${d.name ?? ""} · ${metricLabel(lang, SOTD)} ${signed(d.sotd)} ${t(lang, "perMatch")} · ${metricLabel(lang, POINTS)} ${integer(d.points, lang)} · ${metricLabel(lang, DESERVED)} ${decimal1(d.deserved, lang)}`;
const fmtTick = (x: number) => (x > 0 ? `+${integer(x, lang)}` : integer(x, lang));
---

{me && s.deserved_points != null && (
  <section>
    <SectionHead label={metricLabel(lang, DESERVED)} />
    <p class="bsub">{t(lang, "compDeservedExplainer", names)}</p>
    <div class="ctab dpm">
      <div class="ctab-head"><span class="h nmh">{t(lang, "teamAfterMatches", { competition: compName, n: integer(s.played, lang) })}</span><span class="h"></span></div>
      {rows.map((r) => (
        <div class="ctab-row"><span class="tm"><span class="nm">{r.name}{r.sub && <span class="dpm-sub">{r.sub}</span>}</span></span><span class="n dpm-v">{r.value}</span></div>
      ))}
    </div>
    <div class="dp-wrap">
      <div class="dp-legend" aria-hidden="true">
        <span><svg width="22" height="8"><line x1="0" y1="4" x2="22" y2="4" class="dp-fit" /></svg>{metricLabel(lang, DESERVED)}</span>
        <span><svg width="10" height="14"><line x1="5" y1="1" x2="5" y2="13" class="dp-gap" /></svg>{metricLabel(lang, GAP)}</span>
        <span><i class="dp-k-me"></i>{teamName}</span>
        <span><i class="dp-k-club"></i>{t(lang, "teamOtherTeams", { competition: compName })}</span>
      </div>
      {charts.map(({ cls, c }) => c && (
        <svg class:list={["dp-chart", cls]} viewBox={`0 0 ${c.W} ${c.H}`} role="img" aria-label={t(lang, "teamScatterAria", { competition: compName, pointsName: metricLabel(lang, POINTS), sotdName: metricInSentence(lang, SOTD), deservedName: metricInSentence(lang, DESERVED) })}>
          <line class="dp-axis" x1={c.L} x2={c.W - c.R} y1={c.H - c.B} y2={c.H - c.B} />
          <line class="dp-axis" x1={c.L} x2={c.L} y1={c.T} y2={c.H - c.B} />
          {c.xTicks.map((x) => (
            <>
              <line class="dp-axis" x1={c.sx(x)} x2={c.sx(x)} y1={c.H - c.B} y2={c.H - c.B + 4} />
              <text class="dp-tick" x={c.sx(x)} y={c.H - c.B + c.fs + 6} font-size={c.fs} text-anchor="middle">{fmtTick(x)}</text>
            </>
          ))}
          {c.yTicks.map((y) => (
            <>
              <line class="dp-axis" x1={c.L - 4} x2={c.L} y1={c.sy(y)} y2={c.sy(y)} />
              <text class="dp-tick" x={c.L - 7} y={c.sy(y) + c.fs * 0.35} font-size={c.fs} text-anchor="end">{integer(y, lang)}</text>
            </>
          ))}
          <text class="dp-title" x={(c.L + c.W - c.R) / 2} y={c.H - 20} font-size={c.fs} text-anchor="middle">{metricLabel(lang, SOTD)}</text>
          <text class="dp-tick" x={(c.L + c.W - c.R) / 2} y={c.H - 5} font-size={c.fs - 1} text-anchor="middle">{t(lang, "perMatch")}</text>
          <text class="dp-title" transform={`translate(13 ${(c.T + c.H - c.B) / 2}) rotate(-90)`} font-size={c.fs} text-anchor="middle">{metricLabel(lang, POINTS)}</text>
          <line class="dp-fit" x1={c.line.x1} y1={c.line.y1} x2={c.line.x2} y2={c.line.y2} />
          {dots.filter((d) => !d.is_self).map((d) => (
            <circle class="dp-club" cx={c.sx(d.sotd)} cy={c.sy(d.points)} r="3" data-px="3"><title>{tip(d)}</title></circle>
          ))}
          <line class="dp-gap" x1={c.me.cx} x2={c.me.cx} y1={c.me.cy} y2={c.me.cl} />
          <circle class="dp-me" cx={c.me.cx} cy={c.me.cy} r="5" data-px="5" data-halo="2"><title>{tip(me)}</title></circle>
          <text class="dp-note" x={c.me.lx} y={(c.me.cy + c.me.cl) / 2 + c.fs * 0.35} font-size={c.fs} text-anchor={c.me.anchor}>{signed(s.deserved_points_gap)}</text>
          <text class="dp-name" x={c.me.lx} y={c.me.cy + c.fs * 0.35} font-size={c.fs} text-anchor={c.me.anchor}>{teamName}</text>
        </svg>
      ))}
    </div>
  </section>
)}

<script>
  import "../../lib/chartMarks.mjs";
</script>
