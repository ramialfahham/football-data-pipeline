---
// The team's header: crest, name, and one meta line (country · venue, city · founded · the season
// the page shows). The season's label is the warehouse's, as its competition names it.
import Crest from "../ui/Crest.astro";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import type { Team, TeamSeason } from "../../lib/types";

interface Props {
  team: Team;
  season: TeamSeason;
  lang: Lang;
}
const { team, season, lang } = Astro.props;

const parts = [
  team.country ? { text: team.country } : null,
  team.venue?.name ? { bold: team.venue.name, text: team.venue.city ? `, ${team.venue.city}` : "" } : null,
  team.founded_year != null ? { text: `${t(lang, "founded")} ${team.founded_year}` } : null,
  season.season_label ? { text: t(lang, "compSeason", { season: season.season_label }) } : null,
].filter((p): p is { bold?: string; text: string } => p !== null);
---

<header class="thead">
  <Crest name={team.name} crest={team.crest} />
  <div class="tid">
    <h1>{team.name}</h1>
    <div class="meta">
      {parts.map((p, i) => <>{i > 0 && " · "}{p.bold && <b>{p.bold}</b>}{p.text}</>)}
    </div>
  </div>
</header>
