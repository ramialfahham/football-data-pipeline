---
// Squad: the whole roster of the featured season (mart_roster), by position (goalkeepers,
// defenders, midfielders, forwards, other), each player as the match page's player row without
// goals or assists: photo · name, then country · age · appearances · minutes per appearance (no
// minutes without an appearance). The appearances are served: 0 where every finished match carries
// player data, otherwise empty, shown "–". Two columns where they fit. A row links to the player's
// page when this build makes one.
import SectionHead from "../ui/SectionHead.astro";
import { decimal0, integer, DASH } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t, metricInSentence } from "../../i18n/strings";
import { localeHref, word } from "../../lib/href";
import { builtPlayers } from "../../lib/builtPlayers.mjs";
import type { SquadMember } from "../../lib/types";

interface Props {
  squad: SquadMember[];
  lang: Lang;
}
const { squad, lang } = Astro.props;
const MINUTES = "playerMetrics.minutesPerAppearance.label";

// The provider's position word -> the display group; "Attacker" and "Forward" are both forwards.
const GROUPS = [
  { key: "gk", label: "squadGk", match: ["goalkeeper"] },
  { key: "def", label: "squadDef", match: ["defender"] },
  { key: "mid", label: "squadMid", match: ["midfielder"] },
  { key: "fwd", label: "squadFwd", match: ["attacker", "forward"] },
  { key: "other", label: "squadOther", match: [] as string[] },
];
function groupOf(position: string | null | undefined): string {
  const p = (position ?? "").trim().toLowerCase();
  return GROUPS.find((g) => g.match.includes(p))?.key ?? "other";
}

// The age on the day of the build, a display of the served birth date.
const NOW = new Date();
function age(birth: string | null | undefined): number | null {
  if (!birth) return null;
  const d = new Date(birth);
  if (Number.isNaN(d.getTime())) return null;
  const before = NOW.getMonth() < d.getMonth() || (NOW.getMonth() === d.getMonth() && NOW.getDate() < d.getDate());
  return NOW.getFullYear() - d.getFullYear() - (before ? 1 : 0);
}
function initials(name: string | null | undefined): string {
  return (name ?? "").split(/\s+/).map((w) => w[0] ?? "").join("").slice(0, 2).toUpperCase();
}
function line(m: SquadMember): string {
  const a = age(m.birth_date);
  const apps = m.appearances == null
    ? t(lang, "appearanceCount", { n: DASH })
    : t(lang, m.appearances === 1 ? "appearanceCountOne" : "appearanceCount", { n: integer(m.appearances, lang) });
  const mins = (m.appearances ?? 0) > 0 && m.minutes_per_appearance != null
    ? `${decimal0(m.minutes_per_appearance, lang)} ${metricInSentence(lang, MINUTES)}`
    : null;
  return [m.nationality, a === null ? null : String(a), apps, mins].filter(Boolean).join(" · ");
}

const groups = GROUPS.map((g) => ({
  label: g.label,
  members: squad
    .filter((m) => m.name && groupOf(m.position) === g.key)
    .sort((a, b) => (b.appearances ?? 0) - (a.appearances ?? 0) || (a.name ?? "").localeCompare(b.name ?? "")),
})).filter((g) => g.members.length > 0);
---

{groups.length > 0 && (
  <section>
    <SectionHead label={t(lang, "tabSquad")} />
    {groups.map((g) => (
      <>
        <div class="colhead">{t(lang, g.label)}</div>
        <div class="sqgrid">
          {g.members.map((m) => {
            const slug = builtPlayers().get(m.player_id);
            const Row = slug ? "a" : "div";
            return (
              <Row class="lrow" href={slug ? localeHref(lang, `${word(lang, "players")}/${slug}/`) : undefined}>
                <div class="plrow">
                  <span class="pphoto">{m.photo ? <img src={m.photo} alt="" loading="lazy" width="34" height="34" /> : initials(m.name)}</span>
                  <span class="pname"><span class="nm">{m.name}</span><span class="ps">{line(m)}</span></span>
                </div>
              </Row>
            );
          })}
        </div>
      </>
    ))}
  </section>
)}
