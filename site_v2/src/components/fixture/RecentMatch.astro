---
// One Recent matches row: the result row from this team's side, with the opponent, the competition
// and the date.
import ResultRow from "../ui/ResultRow.astro";
import { formatShortDate } from "../../lib/format";
import type { Lang } from "../../lib/format";
import type { FormMatch } from "../../lib/types";
import competitions from "../../data/competitions.json";

interface Props {
  match: FormMatch;
  lang: Lang;
  /** The competition filter's mark (the Team page's Matches tab). */
  competitionSlot?: number;
}
const { match, lang, competitionSlot } = Astro.props;
const comp = (competitions as Record<string, { name?: string }>)[match.played_league_code ?? ""]?.name;
---

<ResultRow
  lang={lang}
  result={match.result}
  score={`${match.goals_for}–${match.goals_against}`}
  clubs={[{ name: match.opponent_name, crest: match.opponent_logo_url }]}
  homeAway={match.home_away}
  facts={[comp || null, formatShortDate(match.played_kickoff_datetime, lang)]}
  fixture={match.played_fixture_sk}
  competitionSlot={competitionSlot}
/>
