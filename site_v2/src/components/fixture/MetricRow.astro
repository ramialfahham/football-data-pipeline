---
// One comparison row: home value · centred label + diverging bar · away value.
// All arithmetic here is DISPLAY (format the served value; bar width = relative
// share; green = the served `direction`'s better side) — no metric facts computed.
import { formatValue, DASH } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { barWidth, betterSide } from "../../lib/bars";
import { asNumber } from "../../lib/types";
import type { ServedMetricRow, WindowStats } from "../../lib/types";
import { metricLabel, metricSubline } from "../../i18n/strings";

interface Props {
  def: ServedMetricRow;
  home?: WindowStats | null;
  away?: WindowStats | null;
  lang: Lang;
  /** A window of one match: an average over it is the match's own count, with no "per match" line. */
  oneMatch?: boolean;
}
const { def, home, away, lang, oneMatch = false } = Astro.props;

const hv = asNumber(home?.[def.metric_id]);
const av = asNumber(away?.[def.metric_id]);

// Over one match an average per match is the match's own count, so it shows whole.
const format = oneMatch && def.format === "decimal_1" ? "decimal_0" : def.format;
function display(v: number | null): string {
  return v == null ? DASH : formatValue(v, format, lang);
}

const hDisp = display(hv);
const aDisp = display(av);
const better = betterSide(hv, av, def.direction);
const hWidth = barWidth(hv, av);
const aWidth = barWidth(av, hv);
const sub = metricSubline(lang, def.label_i18n_key, def.per_match && !oneMatch);
---

<div class:list={["cmp-row", { nonkey: !def.is_key_metric }]}>
  <div class:list={["cmp-val", "cmp-home", { "chart-better": better === "home" }]}>{hDisp}</div>
  <div class="cmp-mid">
    <div class="cmp-label"><span class="chart-name">{metricLabel(lang, def.label_i18n_key)}</span>{sub && <span class="chart-tick">{sub}</span>}</div>
    <div class="chart-bar" aria-hidden="true">
      <span class:list={[{ "chart-better": better === "home" }]}><span style={`width:${hWidth}%`}></span></span>
      <span class:list={[{ "chart-better": better === "away" }]}><span style={`width:${aWidth}%`}></span></span>
    </div>
  </div>
  <div class:list={["cmp-val", "cmp-away", { "chart-better": better === "away" }]}>{aDisp}</div>
</div>
