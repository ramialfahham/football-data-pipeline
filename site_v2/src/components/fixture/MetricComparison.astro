---
// The team comparison for one window (W1 or W2). Rows, groups and their order are served from the
// catalogue (src/data/metric_rows.json, src/data/metric_groups.json). A row whose value is missing
// on BOTH sides is hidden (avoid a wall of dashes); a row missing on one side shows "-" there.
// No reordering by value.
import MetricRow from "./MetricRow.astro";
import metricRows from "../../data/metric_rows.json";
import metricGroups from "../../data/metric_groups.json";
import { metricLabel } from "../../i18n/strings";
import { asNumber } from "../../lib/types";
import type { ServedMetricRow, WindowStats } from "../../lib/types";
import type { Lang } from "../../lib/format";

interface Props {
  home?: WindowStats | null;
  away?: WindowStats | null;
  lang: Lang;
  homeName?: string | null;
  awayName?: string | null;
}
const { home, away, lang, homeName, awayName } = Astro.props;

const served = metricRows.rows as ServedMetricRow[];
const hasData = (def: ServedMetricRow): boolean =>
  asNumber(home?.[def.metric_id]) !== null || asNumber(away?.[def.metric_id]) !== null;

const groups = [...metricGroups.groups]
  .sort((a, b) => a.order - b.order)
  .map((g) => ({
    group: metricLabel(lang, `metricGroups.${g.key}.label`),
    rows: served.filter((r) => r.metric_group === g.key && hasData(r)),
  }))
  .filter((g) => g.rows.length > 0);
---

<div class="cmp">
  <div class="cmp-head">
    <div class="h">{homeName}</div>
    <div></div>
    <div class="h">{awayName}</div>
  </div>
  {groups.map(({ group, rows }) => (
    <>
      <div class="mgroup">{group}</div>
      {rows.map((def) => (
        <MetricRow def={def} home={home} away={away} lang={lang} />
      ))}
    </>
  ))}
</div>
