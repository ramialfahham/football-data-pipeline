---
// One Players to watch row, the player row: photo · name over position · goals and assists (a
// goalkeeper's saves). A count the warehouse leaves blank shows as a dash.
import { DASH, integer } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t, positionLabel } from "../../i18n/strings";
import type { TopPlayer } from "../../lib/types";

interface Props {
  player: TopPlayer;
  lang: Lang;
}
const { player, lang } = Astro.props;
const isGK = player.position_code === "G";
const initials = (player.player_name ?? "")
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 2)
  .toUpperCase();
const count = (v: number | null | undefined) => (v == null ? DASH : integer(v, lang));
const word = (v: number | null | undefined, one: string, many: string) => t(lang, v === 1 ? one : many);
---

<div class="lrow">
  <div class="plrow">
    <span class="pphoto">
      {player.player_photo_url
        ? <img src={player.player_photo_url} alt="" loading="lazy" width="34" height="34" />
        : <span>{initials}</span>}
    </span>
    <span class="pname">
      <span class="nm">{player.player_name}</span>
      <span class="ps">{positionLabel(lang, player.position_code)}</span>
    </span>
    <span class="pstat">
      {isGK ? (
        <span class="nb"><b>{count(player.saves_player)}</b> {t(lang, "saves")}</span>
      ) : (
        <>
          <span class="nb"><b>{count(player.goals_total)}</b> {word(player.goals_total, "goalOne", "goals")}</span> ·{" "}
          <span class="nb"><b>{count(player.goals_assists)}</b> {word(player.goals_assists, "assistOne", "assists")}</span>
        </>
      )}
    </span>
  </div>
</div>
