---
// Head to head: the served intro, then the last meetings as meeting rows: the score in the match's
// order, the side that was at home first, competition / date with its year. "No meetings on record."
// when the warehouse holds none.
import SectionHead from "../ui/SectionHead.astro";
import ResultRow from "../ui/ResultRow.astro";
import RowList from "../ui/RowList.astro";
import { formatDayYear } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import type { HeadToHead, Side } from "../../lib/types";
import competitions from "../../data/competitions.json";

interface Props {
  h2h?: HeadToHead | null;
  home: Side;
  away: Side;
  lang: Lang;
}
const { h2h, home, away, lang } = Astro.props;
const meetings = (h2h?.recent_meetings ?? []).slice(0, 5);
const intro = h2h ? h2h.intro?.[lang] : t(lang, "h2hNone");
const names = competitions as Record<string, { name?: string }>;
const rows = meetings.map((m) => {
  const homeFirst = m.home_away === "home";
  return {
    clubs: homeFirst ? [home, away] : [away, home],
    score: homeFirst ? `${m.goals_for}–${m.goals_against}` : `${m.goals_against}–${m.goals_for}`,
    comp: names[m.league_code ?? ""]?.name,
    date: formatDayYear(m.kickoff_datetime, lang),
    fixture: m.fixture_api_id,
  };
});
---

<section aria-label={t(lang, "secH2H")}>
  <SectionHead label={t(lang, "secH2H")} />
  {intro && <p class="bsub">{intro}</p>}
  <RowList kind="results">
    {rows.map((r) => (
      <ResultRow
        lang={lang}
        kind="meeting"
        score={r.score}
        clubs={r.clubs.map((c) => ({ name: c.name, crest: c.crest }))}
        facts={[r.comp || null, r.date]}
        fixture={r.fixture}
      />
    ))}
  </RowList>
</section>
