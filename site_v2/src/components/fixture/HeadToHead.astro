---
// Head to head: the served intro, then the last meetings as the result row without its chip (the chip
// would take one side): the score in the match's order, the side that was at home first, competition ·
// date with its year. "No meetings on record." when the warehouse holds none. Unlinked until
// played-match pages exist.
import SectionHead from "../ui/SectionHead.astro";
import Crest from "../ui/Crest.astro";
import { formatDayYear } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import type { HeadToHead, Side } from "../../lib/types";
import competitions from "../../data/competitions.json";

interface Props {
  h2h?: HeadToHead | null;
  home: Side;
  away: Side;
  lang: Lang;
}
const { h2h, home, away, lang } = Astro.props;
const meetings = (h2h?.recent_meetings ?? []).slice(0, 5);
const intro = h2h ? h2h.intro?.[lang] : t(lang, "h2hNone");
const names = competitions as Record<string, { name?: string }>;
const rows = meetings.map((m) => {
  const homeFirst = m.home_away === "home";
  return {
    first: homeFirst ? home : away,
    second: homeFirst ? away : home,
    score: homeFirst ? `${m.goals_for}–${m.goals_against}` : `${m.goals_against}–${m.goals_for}`,
    comp: names[m.league_code ?? ""]?.name,
    date: formatDayYear(m.kickoff_datetime, lang),
  };
});
---

<section aria-label={t(lang, "secH2H")}>
  <SectionHead label={t(lang, "secH2H")} />
  {intro && <p class="bsub">{intro}</p>}
  <div class="rlist">
    {rows.map((r) => (
      <div class="lrow">
        <div class="resrow meet">
          <span class="rscore">{r.score}</span>
          <span class="ropp">
            <span class="club"><Crest name={r.first.name} crest={r.first.crest} size="xs" /><span class="cn">{r.first.name}</span></span>
            {" – "}
            <span class="club"><Crest name={r.second.name} crest={r.second.crest} size="xs" /><span class="cn">{r.second.name}</span></span>
          </span>
          <span class="rmeta">
            {r.comp && <><span class="nb">{r.comp}</span> · </>}
            <span class="nb">{r.date}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>
