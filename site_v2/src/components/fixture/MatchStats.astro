---
// Match stats: the Form comparison's element over the match itself — each team's name over its
// column, the catalogue's rows less the Goals group, which the Goals block shows. Over one match a
// rate per match is the match's own count, so no row carries "per match". Without team stats the
// heading says so in one line.
import SectionHead from "../ui/SectionHead.astro";
import MetricSwitch from "../ui/MetricSwitch.astro";
import MetricComparison from "./MetricComparison.astro";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import { comparisonGroups, needsSwitch } from "../../lib/comparisonGroups";
import type { PlayedFixture } from "../../lib/types";

interface Props {
  fixture: PlayedFixture;
  lang: Lang;
}
const { fixture, lang } = Astro.props;
const { home, away } = fixture;
const groups = comparisonGroups(home.match_stats, away.match_stats, ["goals"]);
---

<section aria-label={t(lang, "secMatchStats")}>
  <SectionHead label={t(lang, "secMatchStats")} />
  {groups.length > 0 ? (
    <>
      <p class="bsub">{t(lang, "matchStatsIntro")}</p>
      {needsSwitch(groups) && <MetricSwitch id="tsw-stats" lang={lang} />}
      <MetricComparison names={[home.name, away.name]} groups={groups} home={home.match_stats} away={away.match_stats} lang={lang} oneMatch />
    </>
  ) : (
    <p class="bsub">{t(lang, "matchStatsNotRecorded")}</p>
  )}
</section>
