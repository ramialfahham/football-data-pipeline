---
// Form comparison: each side's served form block, the one the warehouse flags as that side's window
// (docs/metrics_context_model.md section 4), under one head row of each team's name and its W/D/L pills.
// A side whose window is last season's record shows no pills: they are its recent matches, not its window.
import SectionHead from "../ui/SectionHead.astro";
import MetricSwitch from "../ui/MetricSwitch.astro";
import MetricComparison from "./MetricComparison.astro";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import { comparisonGroups, needsSwitch } from "../../lib/comparisonGroups";
import type { Fixture, Side } from "../../lib/types";

interface Props {
  fixture: Fixture;
  lang: Lang;
  compName: string;
}
const { fixture, lang, compName } = Astro.props;
const { home, away } = fixture;

const LETTER: Record<string, string> = { W: "compColWins", D: "compColDraws", L: "compColLosses" };
const results = (side: Side): string[] =>
  side.form?.window_type === "prev_season"
    ? []
    : (side.form_window ?? []).map((m) => m.result ?? "").filter((r) => r in LETTER);
const prev = [home, away].some((s) => s.form?.window_type === "prev_season");
const intro = prev ? t(lang, "formIntroPrev", { competition: compName }) : t(lang, "formIntro");
const shown = Boolean(home.form || away.form);
const groups = comparisonGroups(home.form, away.form);
---

{shown && (
  <section aria-label={t(lang, "secForm")}>
    <SectionHead label={t(lang, "secForm")} />
    <p class="bsub">{intro}</p>
    {needsSwitch(groups) && <MetricSwitch id="tsw-form" lang={lang} />}
    <MetricComparison names={[home.name, away.name]} groups={groups} home={home.form} away={away.form} lang={lang}>
      {results(home).length > 0 && (
        <div class="pills" slot="home">{results(home).map((r) => <span class:list={["pill", r]}>{t(lang, LETTER[r])}</span>)}</div>
      )}
      {results(away).length > 0 && (
        <div class="pills" slot="away">{results(away).map((r) => <span class:list={["pill", r]}>{t(lang, LETTER[r])}</span>)}</div>
      )}
    </MetricComparison>
  </section>
)}
