---
// The match header: the competition's group head (a heading link), the kick-off line (round · date ·
// time UTC · venue, each unit whole when the line wraps), and the two teams, each one link to its team
// page when that page is built, with the standing chip only when the table position is served.
import Crest from "../ui/Crest.astro";
import Chevron from "./Chevron.astro";
import { formatDate, formatTime, signedInteger } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import type { Fixture, Side } from "../../lib/types";

interface Props {
  fixture: Fixture;
  lang: Lang;
  title: string;
  round: string;
  compName: string;
  compLogo?: string | null;
  compHref?: string;
  teamHrefs: { home?: string; away?: string };
}
const { fixture, lang, title, round, compName, compLogo, compHref, teamHrefs } = Astro.props;
const { home, away } = fixture;

const time = fixture.status === "TBD" ? t(lang, "timeTBD") : `${formatTime(fixture.kickoff, lang)} UTC`;
const kick = [round, formatDate(fixture.kickoff, lang), time, fixture.venue].filter(Boolean);

function nameParts(name: string | null | undefined): [string, string] {
  const words = (name ?? "").trim().split(/\s+/);
  const last = words.pop() ?? "";
  return [words.length ? `${words.join(" ")} ` : "", last];
}
const sides: { side: Side; href?: string }[] = [
  { side: home, href: teamHrefs.home },
  { side: away, href: teamHrefs.away },
];
---

<header class="mast">
  <div class="mcomp">
    <div class="gh">
      {compHref ? (
        <a class="cnm" href={compHref}>
          <span class="clogo"><Crest name={compName} crest={compLogo} size="xs" /></span>
          <span class="nm">{compName}</span>
          <Chevron />
        </a>
      ) : (
        <span class="cnm">
          <span class="clogo"><Crest name={compName} crest={compLogo} size="xs" /></span>
          <span class="nm">{compName}</span>
        </span>
      )}
    </div>
  </div>
  <h1 class="vh">{title}</h1>
  <div class="eyebrow">{t(lang, "eyebrowPreview")}</div>
  <div class="kick">
    {kick.map((unit, i) => (
      <>
        {i > 0 && " · "}
        <span class="nb">{unit}</span>
      </>
    ))}
  </div>
  <div class="teams">
    {sides.map(({ side, href }, i) => {
      const Tag = href ? "a" : "div";
      const [lead, last] = nameParts(side.name);
      const st = side.standing;
      return (
        <>
          {i === 1 && <div class="vs">{t(lang, "vs")}</div>}
          <Tag class="team" href={href}>
            <Crest name={side.name} crest={side.crest} />
            <span class="tname">
              {lead}
              <span class="nb">
                {last}
                {href && <Chevron />}
              </span>
            </span>
            {st?.league_rank != null && (
              <div class="stand num">
                <span class="nb">#<b>{st.league_rank}</b></span> ·{" "}
                <span class="nb"><b>{st.standing_points}</b> {t(lang, "pts")}</span> ·{" "}
                <span class="nb">
                  {t(lang, "compColGoalDiff")} <b>{signedInteger(st.standing_goals_diff, lang)}</b>
                </span>
              </div>
            )}
          </Tag>
        </>
      );
    })}
  </div>
</header>
