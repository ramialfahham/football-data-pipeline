---
// The match header: the competition's group head (a heading link), the kick-off line (round · date ·
// time UTC · venue, each unit whole when the line wraps), and the two teams, each one link to its team
// page when that page is built, with the standing chip only on the next match and when the table
// position is served: today's table is not the position going into a match further out.
// A played match shows its status word, the final score where "vs" stands with the winner by weight,
// and under 700px each team's goals close its line. After penalties the big score is the shoot-out's
// and the score after extra time stands under it; an awarded result says there how it came about.
import Crest from "../ui/Crest.astro";
import Chevron from "./Chevron.astro";
import { formatDate, formatTime, scoreLine, signedInteger } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t, playedStatusWord } from "../../i18n/strings";
import type { Fixture, PlayedFixture, Side } from "../../lib/types";

interface Props {
  fixture: Fixture | PlayedFixture;
  lang: Lang;
  title: string;
  round: string;
  compName: string;
  compLogo?: string | null;
  compHref?: string;
  teamHrefs: { home?: string; away?: string };
  showStanding: boolean;
}
const { fixture, lang, title, round, compName, compLogo, compHref, teamHrefs, showStanding } = Astro.props;
const { home, away } = fixture;

const time = fixture.status === "TBD" ? t(lang, "timeTBD") : `${formatTime(fixture.kickoff, lang)} UTC`;
const kick = [round, formatDate(fixture.kickoff, lang), time, fixture.venue].filter(Boolean);

const result = fixture.is_played ? fixture.result : null;
const awarded = Boolean(result && (result.award_kind || fixture.status === "AWD" || fixture.status === "WO"));
const onPenalties = Boolean(result && !awarded && fixture.status === "PEN");
const eyebrow = result ? playedStatusWord(lang, fixture.status, result.award_kind) : t(lang, "eyebrowPreview");
const big = result
  ? onPenalties
    ? { home: result.shootout_home, away: result.shootout_away }
    : { home: result.goals_home, away: result.goals_away }
  : null;
const isWinner = (side: Side) => result?.winner_team_id != null && result.winner_team_id === side.team_id;
// Where the league set no score, the line names the team it awarded the match to.
const awardedTo = [home, away].find((s) => result?.awarded_to_team_id != null && s.team_id === result.awarded_to_team_id);
const AWARD_KEY = {
  not_played: ["awardNotPlayed", "awardNotPlayedTo"],
  played: ["awardPlayed", "awardPlayedTo"],
  abandoned: ["awardAbandoned", "awardAbandonedTo"],
} as const;
const awardLine = !result?.award_kind
  ? null
  : t(lang, AWARD_KEY[result.award_kind][awardedTo ? 1 : 0], {
      onPitch: scoreLine(result.on_pitch_home, result.on_pitch_away),
      awarded: scoreLine(result.goals_home, result.goals_away),
      team: awardedTo?.name ?? "",
    });

function nameParts(name: string | null | undefined): [string, string] {
  const words = (name ?? "").trim().split(/\s+/);
  const last = words.pop() ?? "";
  return [words.length ? `${words.join(" ")} ` : "", last];
}
const sides: { side: Side; href?: string }[] = [
  { side: home, href: teamHrefs.home },
  { side: away, href: teamHrefs.away },
];
---

<header class="mast">
  <div class="mcomp">
    <div class="gh">
      {compHref ? (
        <a class="cnm" href={compHref}>
          <span class="clogo"><Crest name={compName} crest={compLogo} size="xs" /></span>
          <span class="nm">{compName}</span>
          <Chevron />
        </a>
      ) : (
        <span class="cnm">
          <span class="clogo"><Crest name={compName} crest={compLogo} size="xs" /></span>
          <span class="nm">{compName}</span>
        </span>
      )}
    </div>
  </div>
  <h1 class="vh">{title}</h1>
  <div class="eyebrow">{eyebrow}</div>
  <div class="kick">
    {kick.map((unit, i) => (
      <>
        {i > 0 && " · "}
        <span class="nb">{unit}</span>
      </>
    ))}
  </div>
  <div class:list={["teams", { played: big }]}>
    {sides.map(({ side, href }, i) => {
      const Tag = href ? "a" : "div";
      const [lead, last] = nameParts(side.name);
      const st = side.standing;
      const goals = big ? (i === 0 ? big.home : big.away) : null;
      return (
        <>
          {i === 1 && (big ? (
            <div class="vs score num">
              <span class:list={[{ winner: isWinner(home) }]}>{big.home ?? "–"}</span>
              <span class="dash">–</span>
              <span class:list={[{ winner: isWinner(away) }]}>{big.away ?? "–"}</span>
            </div>
          ) : (
            <div class="vs">{t(lang, "vs")}</div>
          ))}
          <Tag class="team" href={href}>
            <Crest name={side.name} crest={side.crest} />
            <span class="tname">
              {lead}
              <span class="nb">
                {last}
                {href && <Chevron />}
              </span>
            </span>
            {showStanding && st?.league_rank != null && (
              <div class="stand num">
                <span class="nb">#<b>{st.league_rank}</b></span> ·{" "}
                <span class="nb"><b>{st.standing_points}</b> {t(lang, "pts")}</span> ·{" "}
                <span class="nb">
                  {t(lang, "compColGoalDiff")} <b>{signedInteger(st.standing_goals_diff, lang)}</b>
                </span>
              </div>
            )}
            {big && <span class:list={["sg", "num", { winner: isWinner(side) }]}>{goals ?? "–"}</span>}
          </Tag>
        </>
      );
    })}
  </div>
  {onPenalties && result && (
    <div class="resline">
      <b class="num">{result.goals_home ?? "–"}</b>–<b class="num">{result.goals_away ?? "–"}</b>
    </div>
  )}
  {awardLine && <div class="resline">{awardLine}</div>}
</header>
