---
// Two lists, home and away, side by side where the block is 560px wide or more, their rows level
// with each other; one above the other below. The rows come through the `home` and `away` slots.
import SectionHead from "../ui/SectionHead.astro";

interface Props {
  label: string;
  intro?: string | null;
  homeLabel?: string | null;
  awayLabel?: string | null;
}
const { label, intro, homeLabel, awayLabel } = Astro.props;
---

<section aria-label={label}>
  <SectionHead label={label} />
  {intro && <p class="bsub">{intro}</p>}
  <div class="rsplit">
    <div class="rcol">
      <div class="colhead">{homeLabel}</div>
      <slot name="home" />
    </div>
    <div class="rcol">
      <div class="colhead">{awayLabel}</div>
      <slot name="away" />
    </div>
  </div>
</section>
