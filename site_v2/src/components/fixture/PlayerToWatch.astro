---
// One Players to watch row: the player row with the board's value alone, in the catalogue's format.
import PlayerRow from "../ui/PlayerRow.astro";
import { formatValue } from "../../lib/format";
import type { Lang, SingleFormat } from "../../lib/format";
import { positionLabel } from "../../i18n/strings";
import type { WatchPlayer } from "../../lib/types";

interface Props {
  player: WatchPlayer;
  format: SingleFormat;
  lang: Lang;
}
const { player, format, lang } = Astro.props;
---

<PlayerRow
  lang={lang}
  name={player.player_name}
  photo={player.player_photo_url}
  line={[positionLabel(lang, player.position_code)]}
  value={formatValue(player.value, format, lang)}
  id={player.player_sk}
/>
