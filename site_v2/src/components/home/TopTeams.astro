---
// Top teams, Home's third block: four boards, one team per league of the pool, each board the
// competition Rankings tab's board unchanged. The warehouse picks each league's team and orders
// the rows; the number shown is the row's place on the board as served, since the served rank is
// the team's rank within its own league, 1 on every row. The format and the "per match" in the
// title are the catalogue's, carried per board.
//
// The leagues named in the intro are the ones on the boards, in the order shown, read from the
// data so the sentence follows the pool.
//
// A board with no data never arrives, and index.astro leaves the block out when none survived.
import SectionHead from "../ui/SectionHead.astro";
import RankingBoard from "../competition/RankingBoard.astro";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import type { LandingTeamBoard } from "../../lib/types";

interface Props {
  boards: LandingTeamBoard[];
  lang: Lang;
}
const { boards, lang } = Astro.props;

const leagueNames = [
  ...new Map(
    boards.flatMap((b) => b.rows).map((r) => [r.league_code, r.league_name]),
  ).values(),
].filter(Boolean);
---

<section>
  <SectionHead label={t(lang, "homeTopTeams")} />
  <p class="bsub">{t(lang, "homeTopTeamsIntro", { leagues: leagueNames.join(", ") })}</p>
  {boards.map((board) => (
    <RankingBoard
      board={{ ...board, rows: board.rows.map((row, i) => ({ ...row, rank: i + 1 })) }}
      entity="team"
      lang={lang}
    />
  ))}
</section>
