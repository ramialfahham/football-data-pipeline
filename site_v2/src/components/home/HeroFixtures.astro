---
// Next matches, Home's first block: every competition's next matchday, in the order the warehouse
// serves (mart_next_matchday.competition_order). Each competition sits under its group head
// (crest · name · chevron, the 2px line), then its matches as THE match row: a date heading
// wherever the day changes, the kick-off with its zone, the Top match tag on the flagged match.
// The first three matches show, the rest sit under "Show all {n}" in a native <details>, so every
// match is in the HTML and none needs a script to reach.
//
// No round on the row: the provider's round name is English in every locale.
import SectionHead from "../ui/SectionHead.astro";
import MatchRow from "../ui/MatchRow.astro";
import Crest from "../ui/Crest.astro";
import type { Lang } from "../../lib/format";
import { formatDate } from "../../lib/format";
import { t } from "../../i18n/strings";
import { localeHref } from "../../lib/href";
import type { CompetitionFixture, LandingUpcomingGroup } from "../../lib/types";

interface Props {
  groups: LandingUpcomingGroup[];
  lang: Lang;
}
const { groups, lang } = Astro.props;

const VISIBLE_ROWS = 3;

const dayOf = (fx: CompetitionFixture) => (fx.kickoff ? fx.kickoff.slice(0, 10) : null);
const opensDay = (fixtures: CompetitionFixture[], i: number) =>
  i === 0 || dayOf(fixtures[i]) !== dayOf(fixtures[i - 1]);
---

<section>
  <SectionHead label={t(lang, "homeNext")} />

  {groups.length === 0 && <p class="caption">{t(lang, "homeNoFixtures")}</p>}

  {groups.map((group) => {
    const rows = (from: number, to?: number) =>
      group.fixtures.slice(from, to).map((fx, j) => (
        <>
          {opensDay(group.fixtures, from + j) && <div class="dh">{formatDate(fx.kickoff, lang)}</div>}
          <MatchRow fx={fx} competitionSlug={group.competition_slug ?? null} lang={lang} topMatch={fx.is_match_that_matters} />
        </>
      ));
    return (
      <div class="fxgroup">
        <div class="gh">
          {group.competition_slug ? (
            <a class="cnm" href={localeHref(lang, `${group.competition_slug}/`)}>
              <span class="clogo"><Crest name={group.league_name ?? group.league_code} crest={group.crest} size="xs" /></span>
              <span class="nm">{group.league_name ?? group.league_code}</span>
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2"
                      stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          ) : (
            <span class="nm">{group.league_name ?? group.league_code}</span>
          )}
        </div>

        {rows(0, VISIBLE_ROWS)}

        {group.fixtures.length > VISIBLE_ROWS && (
          <details class="fxmore">
            <summary>
              <span class="lbl">{t(lang, "homeShowAll", { n: group.fixtures.length })}</span>
              <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2"
                      stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </summary>
            {rows(VISIBLE_ROWS)}
          </details>
        )}
      </div>
    );
  })}
</section>
