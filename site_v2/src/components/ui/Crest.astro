---
// Team crest. Uses the served logo URL; falls back to a monogram of the served
// name when there is no crest (a display fallback — not an identifier).
//
// `size="xs"` is the 24px list-row variant (#367). The default 52px block is built for the fixture
// masthead and is far too heavy for a twelve-row fixture list.
interface Props {
  name?: string | null;
  crest?: string | null;
  size?: "xs" | null;
}
const { name, crest, size } = Astro.props;
const px = size === "xs" ? 24 : 52;
const mono = (name ?? "")
  .split(/\s+/)
  .map((w) => w[0] ?? "")
  .join("")
  .slice(0, 3)
  .toUpperCase();
---

<div class:list={["crest", size]}>
  {crest ? <img src={crest} alt="" loading="lazy" width={px} height={px} /> : <span>{mono}</span>}
</div>
