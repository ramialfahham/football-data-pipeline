---
// The Filter bar: a filter by type (clubs or national teams) and one by region, each offering only
// the values the page's rows carry, and absent with fewer than two. The radios come first because
// the stylesheet hides whatever carries a non-matching `data-entity-type` / `data-confederation`
// inside the `.categories` element that must follow them as a sibling. The buttons and the
// dropdowns are two forms of the same radios: fitBlocks.mjs picks the form that fits, filterBar.mjs
// keeps the dropdowns on the radios and removes the choices that would leave no row.
import { t } from "../../i18n/strings";
import type { Lang } from "../../lib/format";
import { offered } from "../../lib/filterBar.mjs";

interface Props {
  lang: Lang;
  rows: { entity_type?: string | null; confederation?: string | null }[];
}
const { lang, rows } = Astro.props;

const ENTITY_LABELS: Record<string, string> = { club: "filterClubs", national: "filterNational" };
const REGION_LABELS: Record<string, string> = {
  UEFA: "confedUefa", CONMEBOL: "confedConmebol", CONCACAF: "confedConcacaf", CAF: "confedCaf",
  AFC: "confedAfc", OFC: "confedOfc", FIFA: "confedFifa",
};

const filter = (name: string, idPart: string, labels: Record<string, string>, carried: (string | null | undefined)[],
                aria: string, first: string) => {
  const values = offered(Object.keys(labels), carried);
  return {
    name, aria, first,
    shown: values.length >= 2,
    choices: [
      { id: `filter-${idPart}-all`, value: "", label: t(lang, "filterAll") },
      ...values.map((v) => ({ id: `filter-${idPart}-${v.toLowerCase()}`, value: v, label: t(lang, labels[v]) })),
    ],
  };
};
const filters = [
  filter("entity-filter", "entity", ENTITY_LABELS, rows.map((r) => r.entity_type), t(lang, "filterByType"), t(lang, "filterAllTypes")),
  filter("region-filter", "region", REGION_LABELS, rows.map((r) => r.confederation), t(lang, "filterByRegion"), t(lang, "filterAllRegions")),
].filter((f) => f.shown);
---

{filters.map((f) => f.choices.map((c) => (
  <input class="seg-in" type="radio" name={f.name} id={c.id} value={c.value} checked={c.value === ""} />
)))}

{filters.length > 0 && (
  <div class="fbar">
    {filters.map((f) => (
      <div class="seg" role="group" aria-label={f.aria}>
        {f.choices.map((c) => <label class="seg-btn" for={c.id}>{c.label}</label>)}
      </div>
    ))}
    <div class="selbar">
      {filters.map((f) => (
        <div class="seg sel">
          <select class="sel-in" data-filter={f.name} aria-label={f.aria}>
            {f.choices.map((c) => <option value={c.value} selected={c.value === ""}>{c.value ? c.label : f.first}</option>)}
          </select>
          <svg class="chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </div>
      ))}
    </div>
  </div>
)}

<script>
  import "../../lib/filterBar.mjs";
</script>
