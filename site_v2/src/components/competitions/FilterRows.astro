---
// The Filter bar: a filter by type (clubs or national teams) and one by region, each offering only
// the values the page's rows carry, or one by competition; each is absent with fewer than two
// choices. The radios come first because the stylesheet hides whatever carries a non-matching
// `data-entity-type` / `data-confederation` / `data-competition-slot` inside the `.categories`
// element that must follow them as a sibling. The buttons and the
// dropdowns are two forms of the same radios: fitBlocks.mjs picks the form that fits, filterBar.mjs
// keeps the dropdowns on the radios and removes the choices that would leave no row.
import FilterBar from "../ui/FilterBar.astro";
import { t } from "../../i18n/strings";
import type { Lang } from "../../lib/format";
import { offered } from "../../lib/filterBar.mjs";

interface Props {
  lang: Lang;
  rows: { entity_type?: string | null; confederation?: string | null }[];
  /** A filter by competition (the Team page's Matches tab): each competition in its order, its
   *  rows marked `data-competition-slot` with its place, 1 to COMPETITION_SLOTS. */
  competitions?: { name: string }[];
  /** The same slots read as positions (the Players pages): the filter's words name positions. */
  slotsArePositions?: boolean;
}
const { lang, rows, competitions = [], slotsArePositions = false } = Astro.props;

// system.css carries one rule per slot.
const COMPETITION_SLOTS = 8;
if (competitions.length > COMPETITION_SLOTS) {
  throw new Error(`FilterRows: ${competitions.length} competitions, system.css has rules for ${COMPETITION_SLOTS}`);
}

const ENTITY_LABELS: Record<string, string> = { club: "filterClubs", national: "filterNational" };
const REGION_LABELS: Record<string, string> = {
  UEFA: "confedUefa", CONMEBOL: "confedConmebol", CONCACAF: "confedConcacaf", CAF: "confedCaf",
  AFC: "confedAfc", OFC: "confedOfc", FIFA: "confedFifa",
};

const filter = (name: string, idPart: string, labels: Record<string, string>, carried: (string | null | undefined)[],
                aria: string, first: string) => {
  const values = offered(Object.keys(labels), carried);
  return {
    name, aria, first,
    shown: values.length >= 2,
    choices: [
      { id: `filter-${idPart}-all`, value: "", label: t(lang, "filterAll") },
      ...values.map((v) => ({ id: `filter-${idPart}-${v.toLowerCase()}`, value: v, label: t(lang, labels[v]) })),
    ],
  };
};
const competitionFilter = {
  name: "competition-filter",
  aria: t(lang, slotsArePositions ? "filterByPosition" : "filterByCompetition"),
  first: t(lang, slotsArePositions ? "filterAllPositions" : "filterAllCompetitions"),
  shown: competitions.length >= 2,
  choices: [
    { id: "filter-competition-all", value: "", label: t(lang, "filterAll") },
    ...competitions.map((c, i) => ({ id: `filter-competition-${i + 1}`, value: String(i + 1), label: c.name })),
  ],
};
const filters = [
  filter("entity-filter", "entity", ENTITY_LABELS, rows.map((r) => r.entity_type), t(lang, "filterByType"), t(lang, "filterAllTypes")),
  filter("region-filter", "region", REGION_LABELS, rows.map((r) => r.confederation), t(lang, "filterByRegion"), t(lang, "filterAllRegions")),
  competitionFilter,
].filter((f) => f.shown);
const bar = filters.map((f) => ({
  name: f.name,
  aria: f.aria,
  choices: f.choices.map((c) => ({ ...c, option: c.value ? c.label : f.first })),
}));
---

{Astro.slots.has("default") ? <FilterBar filters={bar}><slot /></FilterBar> : <FilterBar filters={bar} />}
