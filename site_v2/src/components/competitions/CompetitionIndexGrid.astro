---
// The competitions index page's single block (#62 step 5, GitLab #54). Groups
// competition_index.json by competition_type into always-shown category headings, applies the
// site-wide order (lib/competitionOrder.mjs) to both rows and categories, and offers two
// single-select filter axes (entity_type, confederation) via the zero-JS `.seg-in`/`.seg-btn`
// radio pattern already used elsewhere (system.css) for the row-hiding itself.
//
// Every row is a link to its competition's page (GitLab #128); the page exists for every row
// because `[competition]/index.astro` builds one per competition_index.json row.
//
// Category disappearance under a filter needs the count of rows that SURVIVE BOTH axes at once
// (e.g. "Clubs + Oceania" can legitimately empty a category that neither axis alone would empty)
// — a check pure CSS :checked sibling selectors can't express without an unreadable combinatorial
// blow-up (3 entity states x 8 region states). A small inline script decides it from the FILTER
// STATE: the two checked radios' values against each row's data attributes. Never from on-screen
// visibility — `offsetParent` is null for every row while the tab is not displayed, so a page
// loaded in a background tab hid all eight categories until a filter was touched.
// The unfiltered page (no JS) already shows every non-empty category correctly; JS only handles
// filtering, so nothing breaks if it fails to load.
import Crest from "../ui/Crest.astro";
import FilterRows from "./FilterRows.astro";
import { t } from "../../i18n/strings";
import { localeHref } from "../../lib/href";
import { groupAndOrderCompetitions } from "../../lib/competitionOrder";
import type { Lang } from "../../lib/format";
import type { CompetitionIndexRow } from "../../lib/types";

interface Props {
  competitions: CompetitionIndexRow[];
  lang: Lang;
}
const { competitions, lang } = Astro.props;
const categories = groupAndOrderCompetitions(competitions);
---

<section class="compindex">
  <FilterRows lang={lang} />

  <div class="categories">
    {categories.map((cat) => (
      <div class="comp-category">
        <div class="colhead">{t(lang, cat.labelI18nKey)}</div>
        <div class="comp-grid">
          {cat.rows.map((row) => (
            <a
              class="comp-row"
              href={localeHref(lang, `${row.slug}/`)}
              data-entity-type={row.entity_type}
              data-confederation={row.confederation}
            >
              <Crest name={row.competition_name} crest={row.logo_url} size="xs" />
              <span class="comp-meta">
                <span class="comp-name">{row.competition_name}</span>
                <span class="comp-region">
                  {row.region_label_i18n_key ? t(lang, row.region_label_i18n_key) : row.region_label_en}
                </span>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  // Progressive enhancement only — see the frontmatter comment above. The unfiltered page is
  // already correct without this: every category present in the DOM has at least one row.
  // Decided from the FILTER STATE (the two checked radios against each row's data attributes),
  // never from layout: `offsetParent` is null for every row while the tab is not displayed.
  function checkedValue(name: string): string {
    const el = document.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`);
    return el?.value ?? "";
  }
  function applyEmptyCategoryCollapse() {
    const entity = checkedValue("entity-filter");
    const region = checkedValue("region-filter");
    document.querySelectorAll<HTMLElement>(".comp-category").forEach((cat) => {
      const rows = Array.from(cat.querySelectorAll<HTMLElement>(".comp-row"));
      const anyMatch = rows.some(
        (r) =>
          (!entity || r.dataset.entityType === entity) &&
          (!region || r.dataset.confederation === region),
      );
      cat.hidden = rows.length > 0 && !anyMatch;
    });
  }
  document
    .querySelectorAll('input[name="entity-filter"], input[name="region-filter"]')
    .forEach((el) => el.addEventListener("change", applyEmptyCategoryCollapse));
  applyEmptyCategoryCollapse();
</script>
