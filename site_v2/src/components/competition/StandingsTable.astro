---
// The competition's table: one grid per standings section, every value the provider's official
// row as published (mart_standings). Columns # / crest / club / P / W / D / L / Goals / GD / Pts;
// the whole row is the link to the team page. The heading and the rows share one fixed track
// list per breakpoint, so a heading can never sit off its numbers; W, D, L and Goals hide on a
// narrow phone. The provider's cross-group ranking tables are not sections here.
import SectionHead from "../ui/SectionHead.astro";
import TableRow from "../ui/TableRow.astro";
import GroupHead from "../ui/GroupHead.astro";
import { integer, signedInteger } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { t } from "../../i18n/strings";
import { standingsSections } from "../../lib/competitionPayload.mjs";
import type { StandingRow } from "../../lib/types";

interface Props {
  standings: StandingRow[];
  lang: Lang;
}
const { standings, lang } = Astro.props;
const sections = standingsSections(standings);
const showSectionNames = sections.length > 1;
---

{sections.length > 0 && (
  <section>
    <SectionHead label={t(lang, "table")} />
    {sections.map((sec) => (
      <div class="ctab-section">
        {showSectionNames && <GroupHead lang={lang} name={sec.name} />}
        <div class="ctab">
          <div class="ctab-head">
            <span class="h rk">{t(lang, "positionShort")}</span>
            <span class="h nmh"></span>
            <span class="h">{t(lang, "playedShort")}</span>
            <span class="h wdl">{t(lang, "winsShort")}</span>
            <span class="h wdl">{t(lang, "drawsShort")}</span>
            <span class="h wdl">{t(lang, "lossesShort")}</span>
            <span class="h wdl">{t(lang, "goals")}</span>
            <span class="h">{t(lang, "goalDifferenceShort")}</span>
            <span class="h">{t(lang, "points")}</span>
          </div>
          {sec.rows.map((row) => (
            <TableRow
              lang={lang}
              team={row.team_slug}
              rank={row.standing_rank}
              crest={{ name: row.team_name, url: row.team_logo_url }}
              name={row.team_name}
              cells={[
                { text: integer(row.played, lang), num: true },
                { text: integer(row.wins, lang), num: true, kind: "wdl" },
                { text: integer(row.draws, lang), num: true, kind: "wdl" },
                { text: integer(row.losses, lang), num: true, kind: "wdl" },
                { text: row.goals_scored != null && row.goals_conceded != null
                    ? `${integer(row.goals_scored, lang)}:${integer(row.goals_conceded, lang)}`
                    : "–", num: true, kind: "wdl" },
                { text: signedInteger(row.goals_diff, lang), num: true, kind: "gd" },
                { text: integer(row.points, lang), num: true, kind: "pts" },
              ]}
            />
          ))}
        </div>
      </div>
    ))}
  </section>
)}
