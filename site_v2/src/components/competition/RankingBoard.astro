---
// One board of the competition page's Rankings tab (GitLab #129 board rules; #151 builds it): a
// single-value table in the block standard's `.ctab.rkt` shape — the board's name in the head
// row, then up to five rows of rank · crest · name · value. Everything shown is served: the dense
// rank as the warehouse ranks it (equal values share a rank), the value in the catalogue's format,
// the club under a player's name. The row is the link, to the team or the player page. The board
// does not say which way it ranks: a board named "Goals against per match" showing 0.5 at rank 1
// has already said it.
//
// The heading is a plain name until the Leaderboards pages exist (#140): a chevron says a heading
// leads somewhere, and nothing here does yet.
import Crest from "../ui/Crest.astro";
import { formatValue } from "../../lib/format";
import type { Lang } from "../../lib/format";
import { boardTitle } from "../../i18n/strings";
import { localeHref, word } from "../../lib/href";
import type { CompetitionBoard, LandingRankedBoard, MatchLeaderBoard } from "../../lib/types";

interface Props {
  board: CompetitionBoard | MatchLeaderBoard | LandingRankedBoard;
  entity: "team" | "player";
  lang: Lang;
  /** Where a row leads; by default the team or player page its slug names. */
  rowHref?: (slug: string | null | undefined) => string | undefined;
}
const { board, entity, lang, rowHref } = Astro.props;

// A per-match board says so in its title ("Goals per match"), only where the catalogue says the
// metric is per match — the export carries that fact.
const title = boardTitle(lang, board.label_i18n_key, "per_match" in board ? board.per_match : false);

function href(slug: string | null | undefined): string | undefined {
  if (rowHref) return rowHref(slug);
  if (!slug) return undefined;
  return localeHref(lang, `${word(lang, entity === "team" ? "teams" : "players")}/${slug}/`);
}
const Row = (slug: string | null | undefined) => (href(slug) ? "a" : "div");
---

<div class="board">
  <div class="ctab rkt">
    <div class="ctab-head">
      <span class="h rk"></span>
      <span class="h nmh">
        <span class="bt"><span class="nm">{title}</span></span>
      </span>
      <span class="h"></span>
    </div>
    {board.rows.map((row) => {
      const slug = "slug" in row ? row.slug : null;
      const Tag = Row(slug);
      return (
      <Tag class="ctab-row" href={href(slug)}>
        <span class="rk num">{row.rank}</span>
        <span class="tm">
          <Crest name={entity === "team" ? row.name : row.club} crest={row.crest} size="xs" />
          {entity === "player" ? (
            <span class="ent">
              <span class="nm">{row.name}</span>
              <span class="sub">{row.club}</span>
            </span>
          ) : (
            <span class="nm">{row.name}</span>
          )}
        </span>
        <span class="n num pts">{formatValue(row.value, board.format, lang)}</span>
      </Tag>
      );
    })}
  </div>
</div>
