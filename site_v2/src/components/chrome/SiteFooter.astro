---
// Global site footer (foundation shell, #825) — brand, a link row, and static
// locale/data-source meta text. Markup transcribed from the CPO-approved
// foundation mock (artifact 87d14109); classes are system.css's.
//
// Every link-row item is an inert <span> (no index page built for any of
// them yet — same "no dead links" convention as the header nav). The Imprint
// slot stays labelled pending: publication is blocked on the operator/address
// question (#799), a reserved CPO call, not resolved here. "EN · DE · FI" is
// locale-invariant literal text (language codes, not translated copy).
import { t } from "../../i18n/strings";
import { localeHref } from "../../lib/href";
import type { Lang } from "../../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const flinks = [
  t(lang, "navCompetitions"),
  t(lang, "navTeams"),
  t(lang, "navPlayers"),
  t(lang, "navStats"),
  t(lang, "footerAbout"),
];
---

<footer class="site-footer">
  <div class="footer-in">
    <a class="brand" href={localeHref(lang)}>Matchday<span class="iq">IQ</span></a>
    <div class="flinks">
      {flinks.map((label) => <span>{label}</span>)}
      <span class="imp">{t(lang, "footerImprintPending")}</span>
    </div>
    <div class="fmeta">EN · DE · FI &nbsp;·&nbsp; {t(lang, "footerDataSource")}</div>
  </div>
</footer>
