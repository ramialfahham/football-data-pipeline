---
// Global site footer (foundation shell, #825) — brand, a link row, and static
// locale/data-source meta text. Markup transcribed from the approved
// foundation mock (artifact 87d14109); classes are system.css's.
//
// The link row repeats the menu (lib/menu.ts), each item a link exactly when the menu's is, then
// About, inert until its page exists. The Imprint
// slot stays labelled pending: publication is blocked on the operator/address
// question (#799), a reserved product call, not resolved here. "EN · DE · FI" is
// locale-invariant literal text (language codes, not translated copy).
import { t } from "../../i18n/strings";
import { localeHref } from "../../lib/href";
import { menuItems } from "../../lib/menu";
import type { Lang } from "../../lib/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const flinks: { label: string; href?: string }[] = [...menuItems(lang), { label: t(lang, "footerAbout") }];
---

<footer class="site-footer">
  <div class="footer-in">
    {/* Wordmark — must stay in lockstep with SiteHeader. The `.iq` class and its two-tone treatment
        are kept deliberately: system.css is the locked design system, so a rename changes the WORD
        and nothing visual. Note the brand is SPLIT by the span, so a source grep for the joined
        product name cannot find it — verify any future rename against RENDERED TEXT. That blind
        spot is exactly how this instance was missed and caught in review.
        An Astro expression comment, not `<!-- -->`, because HTML comments are EMITTED to the built
        page — a note naming the old brand would ship it straight back into the output. */}
    <a class="brand" href={localeHref(lang)}>Matchday<span class="iq">Pilot</span></a>
    <div class="flinks">
      {flinks.map((item) => item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>)}
      <span class="imp">{t(lang, "footerImprintPending")}</span>
    </div>
    <div class="fmeta">EN · DE · FI &nbsp;·&nbsp; {t(lang, "footerDataSource")}</div>
  </div>
</footer>
