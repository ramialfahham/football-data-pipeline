---
// One row of the Players page and a nation page, the player row without numbers: photo / name over
// position / club. `view`, `slot` and `region` mark the views it shows in, for the stylesheet's
// position and region filters.
import PlayerRow from "../ui/PlayerRow.astro";
import { positionLabel } from "../../i18n/strings";
import { codeOf } from "../../lib/playerIndex.mjs";
import type { Lang } from "../../lib/format";
import type { PlayerIndexRow } from "../../lib/types";

interface Props {
  player: PlayerIndexRow;
  lang: Lang;
  view?: string | null;
  slot?: number;
  region?: string;
}
const { player, lang, view, slot, region } = Astro.props;
const code = codeOf(player.position_group);
const position = player.position_role ?? code;
const line = [position ? positionLabel(lang, position) : null, player.club].filter((s): s is string => Boolean(s));
---

<PlayerRow
  lang={lang}
  name={player.name}
  photo={player.photo}
  line={line}
  id={player.player_id}
  slug={player.slug}
  data-hub={view ?? undefined}
  data-competition-slot={slot === undefined ? undefined : String(slot)}
  data-confederation={region}
/>
