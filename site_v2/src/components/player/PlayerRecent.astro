---
// Recent matches: the result row with the player's own line under it: minutes, goals and assists
// above 0, ball actions, or On the bench. Five rows show, the fold holds the rest. fitBlocks keeps a
// row on one line while every row fits; otherwise the score sits right after the chip.
import Fold from "../ui/Fold.astro";
import ResultRow from "../ui/ResultRow.astro";
import RowList from "../ui/RowList.astro";
import SectionHead from "../ui/SectionHead.astro";
import { formatShortDate } from "../../lib/format";
import { t } from "../../i18n/strings";
import { competitionInfo } from "../../lib/teamFixtures";
import type { Lang } from "../../lib/format";
import type { PlayerMatch } from "../../lib/playerPage";

interface Props {
  matches: PlayerMatch[];
  id: string;
  lang: Lang;
}
const { matches, id, lang } = Astro.props;

const SHOWN = 5;
type Part = { value: number; term: "minutes" | "goals" | "assists" | "ballActions" };
const line = (m: PlayerMatch): Part[] => [
  m.minutes != null ? { value: m.minutes, term: "minutes" as const } : null,
  m.goals ? { value: m.goals, term: "goals" as const } : null,
  m.assists ? { value: m.assists, term: "assists" as const } : null,
  m.ball_actions != null ? { value: m.ball_actions, term: "ballActions" as const } : null,
].filter((p): p is Part => p !== null);
---

{matches.length > 0 && (
  <section>
    <SectionHead label={t(lang, "secRecent")} />
    <RowList kind="player-results">
      {[matches.slice(0, SHOWN), matches.slice(SHOWN)].map((part, i) => {
        const list = part.map((m) => (
          <ResultRow
            lang={lang}
            result={m.result}
            score={`${m.goals_for}–${m.goals_against}`}
            clubs={[{ name: m.opponent_name, crest: m.opponent_logo_url }]}
            homeAway={m.home_away}
            facts={[competitionInfo(m.played_league_code ?? "").name || null, formatShortDate(m.played_kickoff_datetime, lang)]}
            player={{ onBench: Boolean(m.on_bench), parts: m.on_bench ? [] : line(m) }}
            fixture={m.played_fixture_sk}
          />
        ));
        if (i === 0) return list;
        return part.length > 0 ? <Fold id={id} n={matches.length} lang={lang}>{list}</Fold> : null;
      })}
    </RowList>
  </section>
)}
