{
  "$schema": "../../page-spec.schema.json",
  "page": "[lang]/[competition]/[matches]/[fixture].astro",
  "entity": "fixture",
  "seo": {
    "canonical": "self",
    "hreflang": "all-locales",
    "title": "seoFixtureTitle",
    "description": "aboutNoH2h",
    "schema_org": "SportsEvent",
    "links": {
      "inbound_hub": "competition",
      "outbound": ["team", "competition"]
    },
    "minimum_data": "Both sides resolvable with a name, and a kickoff. #845 sets the real threshold.",
    "url_permanence": "permanent",
    "url_permanence_note": "One URL serves the match before it is played (fetch_fixture_payloads: status NS or TBD, kick-off today or later) and after (fetch_played_fixture_payloads: every played match), so the page survives the match being played. The played page's description is its status word and its result line.",
    "page_count_driver": "count(src/data/fixtures/*.json) x count(locales) -- CHANGES DAILY, which is why this field is a formula and not a number"
  },
  "blocks": [
    {
      "block": "Breadcrumb and header",
      "mart": [
        "mart_competition_fixtures",
        "mart_competition_index",
        "mart_fixture_standing_context"
      ],
      "i18n_keys": [
        "crumbHome",
        "navCompetitions",
        "compTabMatchdays",
        "compTabRounds",
        "compFactMatchday",
        "eyebrowPreview",
        "vs",
        "timeTBD",
        "pts",
        "compColGoalDiff"
      ]
    },
    {
      "block": "Form comparison",
      "mart": [
        "mart_team_window_metrics",
        "mart_team_season_record",
        "mart_team_momentum_window"
      ],
      "i18n_keys": [
        "secForm",
        "formIntro",
        "formIntroPrev",
        "compColWins",
        "compColDraws",
        "compColLosses",
        "perMatch",
        "percentage"
      ]
    },
    {
      "block": "Recent matches",
      "mart": "mart_team_momentum_window",
      "i18n_keys": [
        "secRecent",
        "haHome",
        "haAway"
      ]
    },
    {
      "block": "Players to watch",
      "mart": "mart_player_season_record",
      "i18n_keys": [
        "secPlayers",
        "playersIntro",
        "playersIntroPrev",
        "compIn",
        "compInMasculine",
        "posF",
        "posM",
        "posD",
        "posG",
        "goals",
        "goalOne",
        "assists",
        "assistOne",
        "saves"
      ]
    },
    {
      "block": "Head to head",
      "mart": "mart_head_to_head",
      "i18n_keys": [
        "secH2H",
        "h2hNone"
      ]
    },
    {
      "block": "Next matches",
      "mart": "mart_competition_fixtures",
      "i18n_keys": [
        "homeNext",
        "compTBC"
      ]
    },
    {
      "block": "Played match: header",
      "mart": "mart_competition_fixtures",
      "i18n_keys": [
        "playedFullTime",
        "playedAfterExtraTime",
        "playedAfterPenalties",
        "playedAwarded",
        "awardNotPlayed",
        "awardPlayed",
        "awardAbandoned",
        "awardNotPlayedTo",
        "awardPlayedTo",
        "awardAbandonedTo"
      ]
    },
    {
      "block": "Played match: Goals",
      "mart": "mart_competition_fixtures",
      "i18n_keys": [
        "secGoals",
        "goalPenalty",
        "goalOwnGoal",
        "goalAssist",
        "goalsNoMinutes",
        "goalsNotRecorded",
        "goals"
      ]
    },
    {
      "block": "Played match: Match leaders",
      "mart": "mart_leaderboards",
      "i18n_keys": [
        "secMatchLeaders",
        "leadersIntro",
        "leadersNotRecorded",
        "leadersSideNotRecorded"
      ]
    },
    {
      "block": "Played match: Match stats",
      "mart": "mart_team_window_metrics",
      "i18n_keys": [
        "secMatchStats",
        "matchStatsIntro",
        "matchStatsNotRecorded",
        "percentage"
      ]
    },
    {
      "block": "Played match: Line-ups",
      "mart": [
        "mart_player_fixture_stats",
        "mart_competition_fixtures"
      ],
      "i18n_keys": [
        "secLineups",
        "lineupSubstitutes",
        "lineupOff",
        "lineupOn",
        "lineupMinutes",
        "lineupsNotRecorded",
        "posF",
        "posM",
        "posD",
        "posG"
      ]
    }
  ]
}
