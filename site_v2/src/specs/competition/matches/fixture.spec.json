{
  "$schema": "../../page-spec.schema.json",
  "page": "[lang]/[competition]/[matches]/[fixture].astro",
  "entity": "fixture",
  "seo": {
    "canonical": "self",
    "hreflang": "all-locales",
    "title": "seoFixtureTitle",
    "description": "aboutNoH2h",
    "schema_org": "SportsEvent",
    "links": {
      "inbound_hub": "competition",
      "outbound": ["team", "competition"]
    },
    "minimum_data": "Both sides resolvable with a name, and a kickoff. #845 sets the real threshold.",
    "url_permanence": "ephemeral",
    "url_permanence_note": "DECLARED FALSE ON PURPOSE (#861). fetch_fixture_payloads exports only status_short in ('NS','TBD') AND kickoff >= today, so a fixture page EXISTS for a few weeks and then vanishes when the match is played -- 4,598 live against 52,585 finished with no page. One URL is meant to serve preview AND report (01_fixture_page.md). Harmless while every page is noindex; it destroys accumulated URLs the moment INDEXABLE flips. The gate records this rather than refusing the page, because refusing would block #844 on #861 instead of surfacing it.",
    "page_count_driver": "count(src/data/fixtures/*.json) x count(locales) -- CHANGES DAILY, which is why this field is a formula and not a number"
  },
  "blocks": [
    {
      "block": "Match preview (two sides)",
      "mart": "mart_fixture_standing_context",
      "i18n_keys": ["crumbMatches", "eyebrowPreview", "vs", "timeTBD"]
    },
    {
      "block": "Form (recent)",
      "mart": ["mart_team_momentum", "mart_team_season_record", "mart_team_momentum_window"],
      "i18n_keys": [
        "secForm",
        "segLast5",
        "segSeason",
        "scopeAllComps",
        "secRecent",
        "noRecentForm",
        "noMatchStats",
        "metrics.goals_per_match.label",
        "metrics.goals_against_per_match.label",
        "metrics.clean_sheets.label",
        "metrics.shots_per_match.label",
        "metrics.shots_inside_box_pct.label",
        "metrics.shots_on_target_per_match.label",
        "metrics.finishing_efficiency_pct.label",
        "metrics.duels_per_match.label",
        "metrics.duels_won_pct.label",
        "metrics.defensive_actions_per_match.label",
        "metrics.passes_per_match.label",
        "metrics.passes_accuracy_pct.label",
        "metrics.passes_key_per_match.label",
        "metrics.corners_per_match.label",
        "metrics.corners_against_per_match.label",
        "metrics.saves_pct.label"
      ]
    },
    {
      "block": "Lineups / key players",
      "mart": "mart_player_momentum",
      "i18n_keys": ["secPlayers", "playersWindow", "posF", "posM", "posD", "posG"]
    },
    {
      "block": "Head-to-head",
      "mart": "mart_head_to_head",
      "i18n_keys": ["secH2H", "meetings", "draws", "lastMeeting", "firstMeeting", "fullH2H"]
    }
  ]
}
