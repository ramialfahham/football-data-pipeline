{
  "$schema": "../page-spec.schema.json",
  "page": "[lang]/[players]/[player].astro",
  "entity": "player",
  "seo": {
    "canonical": "self",
    "hreflang": "all-locales",
    "title": "seoPlayerTitle",
    "description": "seoPlayerDesc",
    "schema_org": "Person",
    "links": {
      "inbound_hub": "home",
      "outbound": []
    },
    "minimum_data": "3 matches played this season or last, in any competition the site holds, club or national team, with at least one tab: mart_player_profile.has_player_page.",
    "page_count_driver": "count(player_pages.json .pages) x count(locales)",
    "url_permanence": "permanent",
    "url_permanence_note": "The URL is permanent and is the one site_architecture.md section 3 already reserves for the player profile. The SLUG is {kebab-name}-{player_api_id} and still carries the id because 18.5% of provider player names collide (1.6% on the full name), so the team scheme does not transfer unchanged; moving player slugs into the warehouse the way team slugs moved is its own work (#843/#852). The id suffix is what anchors identity across a name correction."
  },
  "blocks": [
    {
      "block": "Player header and tabs",
      "mart": "mart_player_profile",
      "i18n_keys": ["seoPlayerTitleClub", "seoPlayerTitleName", "crumbHome", "navPlayers", "compSeason", "playerAge", "playerHeight", "playerTabClub", "playerTabNational", "playerTabsAria"]
    },
    {
      "block": "This season and Current competitions",
      "mart": "mart_player_window_metrics",
      "i18n_keys": ["teamThisSeasonHead", "playerCurrentCompetitions"]
    },
    {
      "block": "Next matches",
      "mart": "mart_team_fixtures",
      "i18n_keys": ["homeNext"]
    },
    {
      "block": "Compared with other players",
      "mart": "mart_player_competition_benchmarks",
      "i18n_keys": ["playerVsOthers", "playerComparedWith", "tabSquad", "median", "playerPer90", "playerPeerIntro", "playerSquadClubIntro", "playerSquadNationalIntro", "playerOthers", "playerOtherTeam", "showAllMetrics"]
    },
    {
      "block": "Compared with last season",
      "mart": "mart_player_window_metrics",
      "i18n_keys": ["teamVsLastSeason", "playerLastSeasonIntro", "playerPer90", "teamThisSeasonHead", "teamLastSeasonHead", "teamTrend", "showAllMetrics"]
    },
    {
      "block": "Recent matches",
      "mart": "mart_player_fixture_stats",
      "i18n_keys": ["secRecent", "minutesShort", "assistsOne", "assistsMany", "ballActionsOne", "ballActionsMany", "playerOnBench", "homeShowAll", "homeShowLess"]
    }
  ]
}
