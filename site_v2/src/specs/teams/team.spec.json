{
  "$schema": "../page-spec.schema.json",
  "page": "[lang]/[teams]/[team].astro",
  "entity": "team",
  "seo": {
    "canonical": "self",
    "hreflang": "all-locales",
    "title": "seoTeamTitle",
    "description": "seoTeamDesc",
    "schema_org": "SportsTeam",
    "links": {
      "inbound_hub": "competition",
      "outbound": ["fixture", "competition", "player"]
    },
    "minimum_data": "At least one season row with a played count. #845 will set the real threshold; today the export only writes teams that have a mart_team_profile row at all.",
    "page_count_driver": "count(src/data/teams/*.json) x count(locales)",
    "url_permanence": "permanent",
    "url_permanence_note": "A team URL survives its entity's state changes. It is NOT yet stable across a RENAME: the slug is re-derived every build (#843/#852). Nothing is published, so no equity is at risk today."
  },
  "blocks": [
    {
      "block": "Team header and tabs",
      "mart": "mart_team_profile",
      "i18n_keys": ["crumbTeams", "founded", "compSeason", "tabOverview", "navMatches", "tabPerformance", "tabsAria"]
    },
    {
      "block": "Competitions",
      "mart": "mart_team_competitions",
      "i18n_keys": ["navCompetitions", "teamLeaguePhase", "teamThrough", "teamKnockedOut", "teamWinners", "compColWins", "compColDraws", "compColLosses", "compColGoals", "compColPoints"]
    },
    {
      "block": "Recent matches",
      "mart": "mart_team_momentum_window",
      "i18n_keys": ["secRecent", "haHome", "haAway"]
    },
    {
      "block": "Next matches, Upcoming and Results",
      "mart": "mart_team_fixtures",
      "i18n_keys": ["homeNext", "compNextTag", "teamUpcoming", "teamResults", "filterByCompetition", "filterAllCompetitions", "filterAll"]
    },
    {
      "block": "Highs and lows",
      "mart": "mart_team_profile",
      "i18n_keys": ["teamHighsLows", "teamBiggestWin", "teamHeaviestDefeat", "teamVsHome", "teamAtAway", "compFactLongestUnbeaten", "compFactLongestWinless", "compFactMatches"]
    },
    {
      "block": "Squad",
      "mart": ["mart_roster", "mart_player_career"],
      "i18n_keys": ["tabSquad", "squadGk", "squadDef", "squadMid", "squadFwd", "squadOther", "appearanceCountOne", "appearanceCount", "playerMetrics.minutesPerAppearance.label"]
    },
    {
      "block": "Standing",
      "mart": "mart_team_profile",
      "i18n_keys": ["teamPerfIntro", "teamStanding", "teamPosition", "teamSeasonBefore", "metrics.points_won.label"]
    },
    {
      "block": "Deserved points",
      "mart": "mart_team_profile",
      "i18n_keys": [
        "compDeservedExplainer",
        "teamAfterMatches",
        "teamOtherTeams",
        "teamScatterAria",
        "perMatch",
        "metrics.shots_on_goal_difference_per_match.label",
        "metrics.shots_on_target_per_match.label",
        "metrics.points_won.label",
        "metrics.deserved_points.label",
        "metrics.deserved_points_gap.label"
      ]
    },
    {
      "block": "Compared with the league and with last season",
      "mart": "mart_team_competition_benchmarks",
      "i18n_keys": [
        "teamVsLeague",
        "teamVsLeagueIntro",
        "teamLeagueMedian",
        "teamBetterLeft",
        "teamBetterRight",
        "teamVsLastSeason",
        "teamVsLastSeasonIntro",
        "teamThisSeasonHead",
        "teamLastSeasonHead",
        "teamTrend",
        "teamTrendBetter",
        "teamTrendWorse",
        "teamTrendSame",
        "showAllMetrics"
      ]
    }
  ]
}
