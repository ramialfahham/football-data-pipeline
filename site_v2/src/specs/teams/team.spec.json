{
  "$schema": "../page-spec.schema.json",
  "page": "[lang]/[teams]/[team].astro",
  "entity": "team",
  "seo": {
    "canonical": "self",
    "hreflang": "all-locales",
    "title": "seoTeamTitle",
    "description": "seoTeamDesc",
    "schema_org": "SportsTeam",
    "links": {
      "inbound_hub": "competition",
      "outbound": ["fixture", "competition", "player"]
    },
    "minimum_data": "At least one season row with a played count. #845 will set the real threshold; today the export only writes teams that have a mart_team_profile row at all.",
    "page_count_driver": "count(src/data/teams/*.json) x count(locales)",
    "url_permanence": "permanent",
    "url_permanence_note": "A team URL survives its entity's state changes. It is NOT yet stable across a RENAME: the slug is re-derived every build (#843/#852). Nothing is published, so no equity is at risk today."
  },
  "blocks": [
    {
      "block": "Team header",
      "mart": "mart_team_profile",
      "i18n_keys": ["crumbTeams", "founded", "teamPlayed"]
    },
    {
      "block": "Deserved-vs-actual (flagship)",
      "mart": "mart_team_profile",
      "i18n_keys": [
        "secDeserved",
        "metrics.shots_on_target_per_match.label",
        "metrics.shots_on_goal_against_per_match.label",
        "metrics.shots_on_goal_difference_per_match.label",
        "heroVerdictUnder",
        "heroVerdictOver",
        "heroCaption",
        "heroNoData",
        "axPoints",
        "axPlay",
        "trendLabel"
      ]
    },
    {
      "block": "Season-over-season",
      "mart": "mart_team_profile",
      "i18n_keys": ["secYoY", "yoyPoints", "yoyGoalsFor", "yoyGoalsAgainst", "yoyThroughGames", "noYoY"]
    },
    {
      "block": "Upcoming / Results",
      "mart": "mart_team_fixtures",
      "i18n_keys": ["secFixtures", "fxHome", "fxAway", "fxNext", "linkFixtures"]
    },
    {
      "block": "Vs-benchmark (bars vs league avg + percentile)",
      "mart": "mart_team_competition_benchmarks",
      "i18n_keys": [
        "vsLeague",
        "vsLastSeason",
        "median",
        "rankOfCount",
        "notRankable",
        "rankedInLeague",
        "vsPriorSeasonGames",
        "unitPp",
        "noYoY",
        "metrics.goals_per_match.label",
        "metrics.goals_against_per_match.label",
        "metrics.clean_sheets_pct.label",
        "metrics.shots_per_match.label",
        "metrics.shots_inside_box_pct.label",
        "metrics.shots_on_target_per_match.label",
        "metrics.finishing_efficiency_pct.label",
        "metrics.duels_per_match.label",
        "metrics.duels_won_pct.label",
        "metrics.defensive_actions_per_match.label",
        "metrics.passes_per_match.label",
        "metrics.passes_accuracy_pct.label",
        "metrics.passes_key_per_match.label",
        "metrics.corners_per_match.label",
        "metrics.corners_against_per_match.label",
        "metrics.saves_pct.label"
      ]
    },
    {
      "block": "Squad / roster",
      "mart": ["mart_roster", "mart_player_career"],
      "i18n_keys": ["squadGk", "squadDef", "squadMid", "squadFwd", "squadShown", "squadEmpty", "appOne", "appMany", "minsPerApp"]
    }
  ]
}
