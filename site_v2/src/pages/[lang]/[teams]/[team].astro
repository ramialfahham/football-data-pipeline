---
// The Team page (screen 02). URL: /{lang}/{teams word}/{team-slug}/ (site_architecture.md).
// One season, the featured one (`is_featured_season`); only the blocks that look ahead show what
// comes next. Three tabs: Overview (Competitions, Recent matches, Next matches, Highs and lows,
// Squad), Matches (the Filter bar, Upcoming, Results) and Performance (the tab's explainer,
// Standing, Deserved points, Compared with the league, Compared with last season). The page
// composes the shared elements; it holds no styling and derives no facts.
import Layout from "../../../layouts/Layout.astro";
import TeamHeader from "../../../components/team/TeamHeader.astro";
import Tabs from "../../../components/team/Tabs.astro";
import TeamCompetitions from "../../../components/team/TeamCompetitions.astro";
import TeamFixtureGroup from "../../../components/team/TeamFixtureGroup.astro";
import TeamHighsLows from "../../../components/team/TeamHighsLows.astro";
import TeamSquad from "../../../components/team/TeamSquad.astro";
import TeamMatches from "../../../components/team/TeamMatches.astro";
import TeamStanding from "../../../components/team/TeamStanding.astro";
import TeamDeserved from "../../../components/team/TeamDeserved.astro";
import TeamLeagueStrips from "../../../components/team/TeamLeagueStrips.astro";
import TeamLastSeason from "../../../components/team/TeamLastSeason.astro";
import RecentMatch from "../../../components/fixture/RecentMatch.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import { t } from "../../../i18n/strings";
import { localeHref, word } from "../../../lib/href";
import { competitionInfo } from "../../../lib/teamFixtures";
import type { Lang } from "../../../lib/format";
import type { Team, TeamRef, TeamSeason } from "../../../lib/types";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

export function getStaticPaths() {
  const locales: Lang[] = ["de", "en", "fi"];
  // Every team the export wrote to src/data/teams/*.json becomes a page, per locale. Read from disk
  // inside getStaticPaths (Astro extracts this function alone); an import would bundle every team
  // file into the build's JavaScript, which runs out of memory. Only the file name travels as a
  // prop: Astro holds every route's props until the build ends.
  const dir = join(process.cwd(), "src/data/teams");
  const teams = readdirSync(dir)
    .filter((name) => name.endsWith(".json"))
    .sort()
    .map((file) => ({ file, slug: (JSON.parse(readFileSync(join(dir, file), "utf8")) as Team).slug }));
  return teams.flatMap(({ file, slug }) =>
    locales.map((lang) => ({
      params: { lang, teams: word(lang, "teams"), team: slug },
      props: { file, lang },
    })),
  );
}

interface Props {
  file: string;
  lang: Lang;
}
const { file, lang } = Astro.props;
const team = JSON.parse(readFileSync(join(process.cwd(), "src/data/teams", file), "utf8")) as Team;

// Exactly one season carries the flag, asserted by a dbt test.
const season: TeamSeason = team.seasons.find((s) => s.is_featured_season)!;
const compName = competitionInfo(season.league_code).name;
const name = team.name ?? "";
const self: TeamRef = { team_id: team.team_id, name, slug: team.slug, crest: team.crest ?? null };
const schedule = team.schedule ?? { upcoming: [], results: [] };
const competitions = season.competitions ?? [];
const recent = team.recent_matches ?? [];
const nextMatches = schedule.upcoming.filter((fx) => fx.upcoming_rank === 1);

const hasMatches = schedule.upcoming.length > 0 || schedule.results.length > 0;
const hasPerformance = season.latest_rank != null || season.points_this_season != null
  || (season.benchmarks ?? []).some((b) => b.metric_value != null);
const pages = (["overview", "matches", "performance"] as const).filter(
  (p) => p === "overview" || (p === "matches" ? hasMatches : hasPerformance),
);

const title = t(lang, "seoTeamTitle", { team: name });
const description = t(lang, "seoTeamDesc", { team: name, competition: compName });
const entity = {
  "@type": "SportsTeam",
  name: team.name ?? undefined,
  sport: "Football",
  ...(team.crest ? { logo: team.crest } : {}),
  ...(team.founded_year ? { foundingDate: String(team.founded_year) } : {}),
  ...(team.country ? { location: { "@type": "Place", name: team.country } } : {}),
  memberOf: { "@type": "SportsOrganization", name: compName },
};
const teamsHref = localeHref(lang, `${word(lang, "teams")}/`);
const crumbs = [
  { name: t(lang, "crumbHome"), href: localeHref(lang) },
  { name: t(lang, "crumbTeams"), href: teamsHref },
  { name },
];
---

<Layout
  lang={lang}
  title={title}
  description={description}
  entity={entity}
  crumbs={crumbs}
  image={team.crest ?? undefined}
  section="teams"
>
  <div class="inner">
    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
      <span class="sep">›</span>
      <a class="lnk" href={teamsHref}>{t(lang, "crumbTeams")}</a>
      <span class="sep">›</span>
      <span class="here">{name}</span>
    </nav>

    <TeamHeader team={team} season={season} lang={lang} />

    {pages.map((p) => <input type="radio" name="team-tab" id={`tab-${p}`} class="tab-in" checked={p === "overview"} />)}
    <Tabs lang={lang} pages={[...pages]} />

    <div class="page" data-page="overview">
      <TeamCompetitions competitions={competitions} lang={lang} />
      {recent.length > 0 && (
        <section>
          <SectionHead label={t(lang, "secRecent")} />
          <div class="rlist">{recent.map((m) => <RecentMatch match={m} lang={lang} />)}</div>
        </section>
      )}
      {nextMatches.length > 0 && (
        <section>
          <SectionHead label={t(lang, "homeNext")} />
          {nextMatches.map((fx) => (
            <TeamFixtureGroup code={fx.league_code} fixtures={[fx]} team={self} lang={lang} nextId={nextMatches[0].fixture_id} />
          ))}
        </section>
      )}
      <TeamHighsLows season={season} lang={lang} />
      <TeamSquad squad={season.squad ?? []} lang={lang} />
    </div>

    {hasMatches && (
      <div class="page" data-page="matches">
        <TeamMatches schedule={schedule} competitions={competitions} team={self} lang={lang} />
      </div>
    )}

    {hasPerformance && (
      <div class="page" data-page="performance">
        <p class="bsub tab-intro">{t(lang, "teamPerfIntro", { competition: compName, season: season.season_label ?? "", team: name })}</p>
        <TeamStanding season={season} lang={lang} />
        <TeamDeserved season={season} teamName={name} compName={compName} lang={lang} />
        <TeamLeagueStrips season={season} teamName={name} compName={compName} lang={lang} />
        <TeamLastSeason season={season} lang={lang} />
      </div>
    )}
  </div>
</Layout>
