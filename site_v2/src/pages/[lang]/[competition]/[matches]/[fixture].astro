---
// The next match page (screen 01, render match-page_2026-10-07_75). URL:
// /{lang}/{competition-slug}/{matches word}/{yyyy-mm-dd-home-vs-away}/ (site_architecture.md §3).
// One page per exported fixture and locale. The page composes the blocks in order; a link exists
// only where its page is built.
import Layout from "../../../../layouts/Layout.astro";
import Breadcrumb from "../../../../components/fixture/Breadcrumb.astro";
import Masthead from "../../../../components/fixture/Masthead.astro";
import FormSegment from "../../../../components/fixture/FormSegment.astro";
import SplitSection from "../../../../components/fixture/SplitSection.astro";
import RecentMatch from "../../../../components/fixture/RecentMatch.astro";
import PlayerRow from "../../../../components/fixture/PlayerRow.astro";
import HeadToHead from "../../../../components/fixture/HeadToHead.astro";
import NextMatches from "../../../../components/fixture/NextMatches.astro";
import { t, inCompetition } from "../../../../i18n/strings";
import { localeHref, word } from "../../../../lib/href";
import { formatShortDate } from "../../../../lib/format";
import type { Lang } from "../../../../lib/format";
import type { CompetitionIndex, CompetitionPayload, Fixture, Team } from "../../../../lib/types";
import { latestSeasonPayload } from "../../../../lib/competitionPayload.mjs";
import competitions from "../../../../data/competitions.json";
import competitionIndex from "../../../../data/competition_index.json";
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";

interface Built {
  competitionPage: boolean;
  matchdaysPage: boolean;
  teamSlugs: string[];
}

export function getStaticPaths() {
  const locales: Lang[] = ["de", "en", "fi"];
  const comps = competitions as Record<string, { slug: string }>;
  // Read from disk, not imported: an import bundles every payload into the build's JavaScript,
  // and the build then runs out of memory long before every match has its page.
  const dir = join(process.cwd(), "src/data/fixtures");
  const fixtures = readdirSync(dir)
    .filter((name) => name.endsWith(".json"))
    .sort()
    .map((name) => JSON.parse(readFileSync(join(dir, name), "utf8")) as Fixture);
  const payloads = import.meta.glob<CompetitionPayload>("/src/data/competitions/*/*.json", {
    eager: true,
    import: "default",
  });
  const teamDir = join(process.cwd(), "src/data/teams");
  const teamSlugs = readdirSync(teamDir)
    .filter((name) => name.endsWith(".json"))
    .map((name) => (JSON.parse(readFileSync(join(teamDir, name), "utf8")) as Team).slug);
  const indexed = new Set((competitionIndex as unknown as CompetitionIndex).competitions.map((c) => c.league_code));
  return fixtures.flatMap((fixture) => {
    const comp = comps[fixture.league_code];
    if (!comp) {
      throw new Error(`No competition slug for league_code "${fixture.league_code}" in src/data/competitions.json`);
    }
    const payload = latestSeasonPayload(Object.values(payloads).filter((p) => p.league_code === fixture.league_code));
    const built: Built = {
      competitionPage: indexed.has(fixture.league_code),
      matchdaysPage: indexed.has(fixture.league_code) && Boolean(payload?.fixtures?.length),
      teamSlugs,
    };
    return locales.map((lang) => ({
      params: { lang, competition: comp.slug, matches: word(lang, "matches"), fixture: fixture.slug },
      props: { fixture, lang, built },
    }));
  });
}

interface Props {
  fixture: Fixture;
  lang: Lang;
  built: Built;
}
const { fixture, lang, built } = Astro.props;
const { home, away } = fixture;
// The next matchday's match gets the full preview; a match further out waits for it.
const isNext = fixture.is_next_round !== false;

const comp = (competitions as Record<string, { slug: string; name?: string }>)[fixture.league_code];
const compName = comp?.name ?? fixture.league_name ?? fixture.league_code;
const indexRow = (competitionIndex as unknown as CompetitionIndex).competitions.find(
  (c) => c.league_code === fixture.league_code,
);
const isLeague = indexRow?.competition_type === "domestic_league";
const matchLabel = `${home.name ?? ""} ${t(lang, "vs")} ${away.name ?? ""}`;
const round = isLeague && fixture.round_order != null
  ? t(lang, "compFactMatchday", { n: fixture.round_order })
  : fixture.round ?? "";

const title = t(lang, "seoFixtureTitle", {
  home: home.name ?? "",
  away: away.name ?? "",
  date: formatShortDate(fixture.kickoff, lang),
});
const description = t(lang, "aboutNoH2h", { home: home.name ?? "", away: away.name ?? "", round });

const compHref = built.competitionPage ? localeHref(lang, `${comp.slug}/`) : undefined;
const crumbs = [
  { label: t(lang, "crumbHome"), href: localeHref(lang) },
  { label: t(lang, "navCompetitions"), href: localeHref(lang, `${word(lang, "competitions")}/`) },
  { label: compName, href: compHref },
  {
    label: t(lang, isLeague ? "compTabMatchdays" : "compTabRounds"),
    href: built.matchdaysPage ? localeHref(lang, `${comp.slug}/${word(lang, "matches")}/`) : undefined,
  },
  { label: matchLabel },
];
const teamHref = (slug?: string | null) =>
  slug && built.teamSlugs.includes(slug) ? localeHref(lang, `${word(lang, "teams")}/${slug}/`) : undefined;

const playersPrev = [home, away].some((s) => (s.top_players ?? []).some((p) => p.window_type === "prev_season"));
const playersIntro = t(lang, playersPrev ? "playersIntroPrev" : "playersIntro", {
  in: inCompetition(lang, fixture.league_code, compName),
});

// schema.org/SportsEvent per 01_fixture_page.md section 8; every value a served payload field, an
// optional member omitted rather than emitted empty.
const entity = {
  "@type": "SportsEvent",
  name: `${home.name} vs ${away.name}`,
  sport: "Football",
  ...(fixture.kickoff ? { startDate: fixture.kickoff } : {}),
  ...(fixture.venue ? { location: { "@type": "Place", name: fixture.venue } } : {}),
  ...(compName ? { superEvent: { "@type": "SportsOrganization", name: compName } } : {}),
  competitor: [home, away]
    .filter((s) => s?.name)
    .map((s) => ({ "@type": "SportsTeam", name: s.name, ...(s.crest ? { logo: s.crest } : {}) })),
};
---

<Layout
  lang={lang}
  title={title}
  description={description}
  entity={entity}
  crumbs={crumbs.map((c) => ({ name: c.label, href: c.href }))}
  image={home.crest ?? undefined}
  section="competitions"
>
  <div class="inner mp">
    <Breadcrumb items={crumbs} lang={lang} />
    <Masthead
      fixture={fixture}
      lang={lang}
      title={title}
      round={round}
      compName={compName}
      compLogo={indexRow?.logo_url}
      compHref={compHref}
      teamHrefs={{ home: teamHref(home.slug), away: teamHref(away.slug) }}
      showStanding={isNext}
    />
    {isNext && (
      <>
        <FormSegment fixture={fixture} lang={lang} compName={compName} />

        <SplitSection label={t(lang, "secRecent")} homeLabel={home.name} awayLabel={away.name}>
          <Fragment slot="home">
            {(home.form_window ?? []).slice(0, 5).map((m) => <RecentMatch match={m} lang={lang} />)}
          </Fragment>
          <Fragment slot="away">
            {(away.form_window ?? []).slice(0, 5).map((m) => <RecentMatch match={m} lang={lang} />)}
          </Fragment>
        </SplitSection>

        <SplitSection label={t(lang, "secPlayers")} intro={playersIntro} homeLabel={home.name} awayLabel={away.name}>
          <Fragment slot="home">
            {(home.top_players ?? []).slice(0, 5).map((p) => <PlayerRow player={p} lang={lang} />)}
          </Fragment>
          <Fragment slot="away">
            {(away.top_players ?? []).slice(0, 5).map((p) => <PlayerRow player={p} lang={lang} />)}
          </Fragment>
        </SplitSection>
      </>
    )}

    <HeadToHead h2h={fixture.head_to_head} home={home} away={away} lang={lang} />
    {!isNext && <NextMatches home={home} away={away} lang={lang} />}
  </div>
</Layout>
