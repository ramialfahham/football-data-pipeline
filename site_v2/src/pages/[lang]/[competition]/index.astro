---
// Competition page, Overview tab (spec: src/specs/competition/index.spec.json).
//
// One page per competition per locale, iterated from competition_index.json — the same served
// set the competitions index lists, so a competition added to the registry gets its page with no
// code change. The page's content comes from competitions/{league_code}/{season}.json; the
// latest served season is the one shown, so after a season ends the final table and the season's
// numbers stay until the next season's first data arrives. A competition with no payload yet
// renders its header and tab bar only.
//
// Blocks, in the approved order: Table · Deserved points table · The season in numbers. Each block
// renders only when its mart served something; a block with nothing to show is absent, never an
// empty heading. A tab whose page is not emitted for this competition is an inert label.
//
// Nothing on this page is derived: the slug, the name, the crest, every number is a served field.
import Layout from "../../../layouts/Layout.astro";
import CompetitionHeader from "../../../components/competition/CompetitionHeader.astro";
import CompetitionTabs from "../../../components/competition/CompetitionTabs.astro";
import StandingsTable from "../../../components/competition/StandingsTable.astro";
import DeservedTable from "../../../components/competition/DeservedTable.astro";
import SeasonFacts from "../../../components/competition/SeasonFacts.astro";
import { t } from "../../../i18n/strings";
import { localeHref, LOCALES } from "../../../lib/href";
import type { Lang } from "../../../lib/format";
import type { CompetitionIndex, CompetitionIndexRow, CompetitionPayload } from "../../../lib/types";
import { latestSeasonPayload, nextRound } from "../../../lib/competitionPayload.mjs";
import competitionIndex from "../../../data/competition_index.json";

export function getStaticPaths() {
  const data = competitionIndex as unknown as CompetitionIndex;
  const payloads = import.meta.glob<CompetitionPayload>("/src/data/competitions/*/*.json", {
    eager: true,
    import: "default",
  });
  return data.competitions.flatMap((competition) =>
    LOCALES.map((lang) => ({
      params: { lang, competition: competition.slug },
      props: {
        competition,
        lang,
        payload: latestSeasonPayload(
          Object.values(payloads).filter((p) => p.league_code === competition.league_code),
        ),
      },
    })),
  );
}

interface Props {
  competition: CompetitionIndexRow;
  lang: Lang;
  payload: CompetitionPayload | null;
}
const { competition, lang, payload } = Astro.props;

const name = competition.competition_name ?? "";

const title = t(lang, "seoCompetitionTitle", { competition: name });
const description = t(lang, "seoCompetitionDesc", { competition: name });

// schema.org/SportsOrganization — a competition is the organising body, not one event. Selection
// only; every value is a served payload field. Undefined rather than null on a missing name: the
// audit fails a JSON-LD node carrying empty or placeholder values.
const entity = {
  "@type": "SportsOrganization",
  name: name || undefined,
  sport: "Football",
};

const crumbs = [
  { name: t(lang, "crumbHome"), href: localeHref(lang) },
  { name: t(lang, "navCompetitions"), href: localeHref(lang, "competitions/") },
  { name },
];

// The header reads the payload when there is one and the index row otherwise: both are the same
// mart's fields, the payload adding the season and the next round.
const competitionType = payload?.competition_type ?? competition.competition_type;
---

<Layout lang={lang} title={title} description={description} entity={entity} crumbs={crumbs}>
  <div class="inner">
    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
      <span class="sep">›</span>
      <a class="lnk" href={localeHref(lang, "competitions/")}>{t(lang, "navCompetitions")}</a>
      <span class="sep">›</span>
      <span class="here">{name}</span>
    </nav>

    <CompetitionHeader
      name={payload?.name ?? competition.competition_name}
      crest={payload?.crest ?? competition.logo_url}
      regionLabelEn={payload?.region_label_en ?? competition.region_label_en}
      regionLabelI18nKey={payload?.region_label_i18n_key ?? competition.region_label_i18n_key}
      season={payload?.season ?? null}
      round={nextRound(payload?.fixtures)?.round ?? null}
      lang={lang}
    />
    <CompetitionTabs
      lang={lang}
      hasMatchdays={competitionType === "domestic_league"}
      active="overview"
      competitionSlug={competition.slug}
      hasFixturesPage={Boolean(payload?.fixtures?.length)}
      hasRankingsPage={Boolean(payload?.team_boards?.length || payload?.player_boards?.length)}
    />

    {payload && (
      <>
        <StandingsTable standings={payload.standings} lang={lang} />
        <DeservedTable deserved={payload.deserved} lang={lang} />
        <SeasonFacts summary={payload.summary} lang={lang} />
      </>
    )}
  </div>
</Layout>
