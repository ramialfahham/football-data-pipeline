---
// The Player page. URL: /{lang}/{players word}/{player-slug}/ (site_architecture.md). The header,
// then a tab per football the data marks: Club (This season, Next matches, Compared with other
// players, Compared with last season, Recent matches) and National team (Current competitions, Next
// matches, Compared with other players, Recent matches). The season shown is the featured one. The
// page composes the shared elements; it holds no styling and derives no facts.
import Layout from "../../../layouts/Layout.astro";
import PlayerHeader from "../../../components/player/PlayerHeader.astro";
import PlayerComparison from "../../../components/player/PlayerComparison.astro";
import PlayerLastSeason from "../../../components/player/PlayerLastSeason.astro";
import PlayerRecent from "../../../components/player/PlayerRecent.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import StatCards from "../../../components/ui/StatCards.astro";
import TeamFixtureGroup from "../../../components/team/TeamFixtureGroup.astro";
import { t, metricInSentence, metricLabel } from "../../../i18n/strings";
import { localeHref, LOCALES, word } from "../../../lib/href";
import { DASH, formatValue, integer } from "../../../lib/format";
import { builtPlayers } from "../../../lib/builtPlayers.mjs";
import { titleWidthPx, TITLE_PX_HARD } from "../../../../scripts/audit-seo.mjs";
import { positionWord } from "../../../lib/playerPage";
import type { Lang } from "../../../lib/format";
import type { Player, PlayerTab } from "../../../lib/playerPage";
import { readFileSync } from "node:fs";
import { join } from "node:path";

export function getStaticPaths() {
  // One page per player the boards link to, per locale. Only the id travels as a prop: Astro holds
  // every route's props until the build ends.
  return [...builtPlayers()].flatMap(([id, slug]) =>
    LOCALES.map((lang) => ({
      params: { lang, players: word(lang, "players"), player: slug },
      props: { id, lang },
    })),
  );
}

interface Props {
  id: number;
  lang: Lang;
}
const { id, lang } = Astro.props;
const dataDir = join(process.cwd(), "src/data");
const player = JSON.parse(readFileSync(join(dataDir, "players", `${id}.json`), "utf8")) as Player;

const name = player.name ?? "";
const isGoalkeeper = player.position_group === "GK";
const tabs = player.tabs;
const primary = tabs[0];
const team = player.club?.name ?? primary?.team?.name ?? player.nationality ?? "";
const season = player.season_label ?? "";

const CARDS = [
  { key: "appearances", label: metricLabel(lang, "playerMetrics.appearances.label"), format: "integer" },
  { key: "minutes_per_appearance", label: metricLabel(lang, "playerMetrics.minutesPerAppearance.label"), format: "decimal_0" },
  ...(isGoalkeeper
    ? [
      { key: "saves_player_pct", label: metricLabel(lang, "playerMetrics.savePct.label"), format: "percent" },
      { key: "goals_against_player", label: metricLabel(lang, "playerMetrics.goalsConceded.label"), format: "integer" },
    ]
    : [
      { key: "goals_player", label: metricLabel(lang, "playerMetrics.scorerPoints.goals"), format: "integer" },
      { key: "assists_player", label: metricLabel(lang, "playerMetrics.scorerPoints.assists"), format: "integer" },
    ]),
  { key: "cards_yellow_player", label: metricLabel(lang, "playerMetrics.cards.yellow"), format: "integer" },
  { key: "cards_red_player", label: metricLabel(lang, "playerMetrics.cards.red"), format: "integer" },
] as const;
const cardsOf = (tab: PlayerTab) => CARDS.map((c) => ({
  value: tab.cards[c.key] == null ? DASH : formatValue(tab.cards[c.key], c.format, lang),
  label: c.label,
}));
const peersOf = (tab: PlayerTab) => tab.competitions.map((c) => (JSON.parse(readFileSync(
  join(dataDir, "player_peers", c.league_code, String(c.season), `${c.position_group}.json`), "utf8",
)) as { values: Record<string, number[]> }).values);

const description = (() => {
  const apps = primary?.cards.appearances;
  const position = positionWord(lang, "One", player.position_group);
  const base = { player: name, position, club: team, season };
  const stat = (key: string) => primary?.cards[key];
  if (apps && isGoalkeeper && stat("saves_player_pct") != null && stat("goals_against_player") != null) {
    return t(lang, "seoPlayerDescGk", {
      ...base,
      apps: integer(apps, lang),
      saves: formatValue(stat("saves_player_pct"), "percent", lang).replace("%", ""),
      ga: integer(stat("goals_against_player"), lang),
      goalsAgainst: metricInSentence(lang, "playerMetrics.goalsConceded.label"),
      savesWord: metricInSentence(lang, "playerMetrics.savePct.label"),
    });
  }
  const goals = stat("goals_player");
  const assists = stat("assists_player");
  if (apps && !isGoalkeeper && goals != null && assists != null) {
    return t(lang, "seoPlayerDesc", {
      ...base,
      apps: integer(apps, lang),
      goals: t(lang, goals === 1 ? "seoPlayerGoalOne" : "seoPlayerGoals", { n: integer(goals, lang) }),
      assists: t(lang, assists === 1 ? "seoPlayerAssistOne" : "seoPlayerAssists", { n: integer(assists, lang) }),
    });
  }
  return t(lang, "seoPlayerDescPlain", base);
})();

const titleClub = player.shares_name_at_club ? `${team}, ${positionWord(lang, "One", player.position_group)}` : team;
const withClub = team ? ["seoPlayerTitle", "seoPlayerTitleClub"].map((key) => t(lang, key, { player: name, club: titleClub })) : [];
const title = withClub.find((text) => titleWidthPx(text) <= TITLE_PX_HARD) ?? t(lang, "seoPlayerTitleName", { player: name });
const entity = {
  "@type": "Person",
  name: name || undefined,
  affiliation: team || undefined,
  ...(player.photo ? { image: player.photo } : {}),
};
const crumbs = [
  { name: t(lang, "crumbHome"), href: localeHref(lang) },
  { name: t(lang, "navPlayers"), href: localeHref(lang, `${word(lang, "players")}/`) },
  { name },
];
const TAB = {
  club: { id: "tab-club", page: "club", label: "playerTabClub", head: "teamThisSeasonHead" },
  national_team: { id: "tab-national", page: "national", label: "playerTabNational", head: "playerCurrentCompetitions" },
} as const;
---

<Layout
  lang={lang}
  title={title}
  description={description}
  entity={entity}
  crumbs={crumbs}
  image={player.photo ?? undefined}
  section="players"
>
  <div class="inner">
    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
      <span class="sep">›</span>
      <a class="lnk" href={localeHref(lang, `${word(lang, "players")}/`)}>{t(lang, "navPlayers")}</a>
      <span class="sep">›</span>
      <span class="here">{name}</span>
    </nav>

    <PlayerHeader player={player} lang={lang} />

    {tabs.map((tab, i) => <input type="radio" name="player-tab" id={TAB[tab.tab].id} class="tab-in" checked={i === 0} />)}
    <nav class="tabs comp-tabs" aria-label={t(lang, "playerTabsAria")}>
      {tabs.map((tab) => <label class="tab" for={TAB[tab.tab].id}>{t(lang, TAB[tab.tab].label)}</label>)}
    </nav>

    {tabs.map((tab) => (
      <div class="page" data-page={TAB[tab.tab].page}>
        <section>
          <SectionHead label={t(lang, TAB[tab.tab].head)} />
          <StatCards cards={cardsOf(tab)} />
        </section>
        {tab.next_matches.length > 0 && tab.team && (
          <section>
            <SectionHead label={t(lang, "homeNext")} />
            {tab.next_matches.map((fx) => (
              <TeamFixtureGroup
                code={fx.league_code}
                fixtures={[fx]}
                team={{ team_id: tab.team!.team_id, name: tab.team!.name ?? "", slug: tab.team!.slug, crest: tab.team!.crest ?? null }}
                lang={lang}
                nextId={tab.next_matches[0].fixture_id}
              />
            ))}
          </section>
        )}
        <PlayerComparison tab={tab} peers={peersOf(tab)} name={name} positionGroup={player.position_group} lang={lang} />
        {tab.tab === "club" && (
          <PlayerLastSeason lastSeason={tab.last_season} name={name} isGoalkeeper={isGoalkeeper} lang={lang} />
        )}
        <PlayerRecent matches={tab.recent_matches} id={`${TAB[tab.tab].page}-recent-fold`} lang={lang} />
      </div>
    ))}
  </div>
</Layout>
