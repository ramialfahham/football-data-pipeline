---
// A nation's page: every player of a nation the Players page cannot show whole, in the served order,
// with the position filter. URL: /{lang}/{players word}/{nation slug}/, beside the player pages;
// lib/playerIndex.mjs refuses a nation slug a player page uses, so the two never share an address.
import Layout from "../../../layouts/Layout.astro";
import FilterRows from "../../../components/competitions/FilterRows.astro";
import SectionHead from "../../../components/ui/SectionHead.astro";
import PlayerIndexRow from "../../../components/player/PlayerIndexRow.astro";
import { t } from "../../../i18n/strings";
import { localeHref, LOCALES, word } from "../../../lib/href";
import { builtPlayers } from "../../../lib/builtPlayers.mjs";
import { POSITIONS, nationPages, slotOf } from "../../../lib/playerIndex.mjs";
import type { Lang } from "../../../lib/format";
import type { PlayerIndex as PlayerIndexData } from "../../../lib/types";
import playersIndex from "../../../data/players_index.json";

export function getStaticPaths() {
  const data = playersIndex as unknown as PlayerIndexData;
  return nationPages(data, [...builtPlayers().values()]).flatMap((page) =>
    LOCALES.map((lang) => ({
      params: { lang, players: word(lang, "players"), nation: page.slug },
      props: { slug: page.slug },
    })),
  );
}

interface Props {
  slug: string;
}
const lang = (Astro.params.lang ?? "en") as Lang;
const { slug } = Astro.props;
const data = playersIndex as unknown as PlayerIndexData;
const page = nationPages(data, [...builtPlayers().values()]).find((p) => p.slug === slug)!;
const nation = page.nation ?? "";
const playersHref = localeHref(lang, `${word(lang, "players")}/`);

const title = t(lang, "seoNationTitle", { nation });
const description = t(lang, "seoNationDesc", { nation });
const entity = {
  "@type": "ItemList",
  name: title,
  numberOfItems: page.rows.length,
};
const crumbs = [
  { name: t(lang, "crumbHome"), href: localeHref(lang) },
  { name: t(lang, "navPlayers"), href: playersHref },
  { name: nation },
];
---

<Layout lang={lang} title={title} description={description} entity={entity} crumbs={crumbs} section="players">
  <div class="inner">
    <nav class="crumb" aria-label={t(lang, "crumbAria")}>
      <a class="lnk" href={localeHref(lang)}>{t(lang, "crumbHome")}</a>
      <span class="sep">›</span>
      <a class="lnk" href={playersHref}>{t(lang, "navPlayers")}</a>
      <span class="sep">›</span>
      <span class="here">{nation}</span>
    </nav>

    <h1>{nation}</h1>

    <section class="teamindex">
      <FilterRows
        lang={lang}
        rows={[{ confederation: page.region }]}
        competitions={POSITIONS.map((p) => ({ name: t(lang, p.label) }))}
        slotsArePositions
      />
      <div class="categories">
        <section class="tblock">
          <SectionHead label={t(lang, "navPlayers")} />
          <div>
            <div class="comp-grid">
              {page.rows.map((player) => (
                <PlayerIndexRow player={player} lang={lang} slot={slotOf(player.position_group)} />
              ))}
            </div>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layout>
