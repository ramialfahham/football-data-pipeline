---
// Landing page (screen 10, #367). Spec: docs/wireframes/10_home.md.
//
// Replaces the "under construction" scaffold. That scaffold was the ONLY entry in `STUB_PAGES`,
// and the SEO audit refuses `INDEXABLE = true` while that array is non-empty, so this page is what
// unblocks go-live. `INDEXABLE` itself stays `false`: flipping it is #377, gated on #799, #852/#843,
// #845 and #861, none of which this PR touches.
//
// ALL THREE modules of the composition (10_home.md §0, that spec's stated authority): next
// matches -> Top players (#40) -> Top teams (#41). Both boards blocks read served leaderboard
// rows; their registered gaps are closed.
//
// Browse (the fourth module in the original composition) is DROPPED, not deferred: its only real
// value was reachability into the long-tail team/player pages, and those
// are exactly the entity types blocked on the team/player-name data-quality work, so a
// competitions-only version had nothing left to solve — the competitions pool is small enough that
// the competitions index page already covers it. The Browse component (formerly this file's
// import), the `browse` payload key, `build_nav`'s use in `shape_landing_payload`, and the
// `homeBrowse`/`homeByCountry`/`group*` i18n
// keys are removed with it. `build_nav`/`fetch_nav`/`nav.json` themselves are NOT removed — that
// export target is independently selectable (`--entities nav`) and outlives this block.
//
// One block was dropped earlier. The stats teasers (the original order's fourth module, before
// browse became the fourth) were ruled useless and are replaced by Top players/Top teams.
// Trending is absent from the composition, and the version built here was stale against the last
// streak ruling anyway (winless runs dropped; the mart still served them).
//
// The page COMPOSES components and holds no styling; it derives no facts and performs no
// arithmetic. Everything it shows is a served value from landing.json, which the export shaped and
// the warehouse decided.
import Layout from "../../layouts/Layout.astro";
import HeroFixtures from "../../components/home/HeroFixtures.astro";
import TopPlayers from "../../components/home/TopPlayers.astro";
import TopTeams from "../../components/home/TopTeams.astro";
import { t } from "../../i18n/strings";
import type { Lang } from "../../lib/format";
import type { Landing } from "../../lib/types";
import landing from "../../data/landing.json";

export function getStaticPaths() {
  return [
    { params: { lang: "de" } },
    { params: { lang: "en" } },
    { params: { lang: "fi" } },
  ];
}

const lang = (Astro.params.lang ?? "en") as Lang;
const data = landing as unknown as Landing;

// Title/description per 10_home.md §8, THROUGH t(). Not built by concatenating payload fields:
// the payload is locale-independent, so a concatenation would ship three byte-identical <title>
// tags — exactly the defect the scaffold had and #844's gate exists to catch. The descriptive
// words ARE the locale signal.
const title = t(lang, "seoHomeTitle");
const description = t(lang, "seoHomeDesc");

// schema.org/WebSite, not SportsEvent: this page is not one match. No BreadcrumbList — the home
// page is the breadcrumb ROOT that every other page points back to, so a trail of one is noise.
const entity = {
  "@type": "WebSite",
  name: "Matchday Pilot",
  inLanguage: lang,
};
---

<Layout lang={lang} title={title} description={description} entity={entity}>
  <div class="inner">
    <HeroFixtures groups={data.upcoming} lang={lang} />
    {/* The KEY IS ABSENT, not empty, when no board had data (#40, #41) — the export omits it, so
        each guard is the whole "block does not render" rule and neither block has an empty state.
        This is the complete composition: next matches, Top players, Top teams (10_home.md §0). */}
    {data.top_players && <TopPlayers boards={data.top_players} lang={lang} />}
    {data.top_teams && <TopTeams boards={data.top_teams} lang={lang} />}
  </div>
</Layout>
