---
// Root: browser-language redirect with `en` fallback (site_architecture.md §3).
// Renders a language chooser for no-JS clients and crawlers.
const locales = ["de", "en", "fi"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Matchday Pilot</title>
    <script is:inline>
      (function () {
        var supported = ["de", "en", "fi"];
        var lang = (navigator.language || "en").slice(0, 2).toLowerCase();
        if (supported.indexOf(lang) === -1) lang = "en";
        window.location.replace("./" + lang + "/");
      })();
    </script>
  </head>
  <body>
    <h1>Matchday Pilot</h1>
    <ul>
      {locales.map((l) => (
        <li><a href={`./${l}/`}>{l.toUpperCase()}</a></li>
      ))}
    </ul>
  </body>
</html>
